module Zevic1.Expr

// Literals and runtime helpers: a port of zevic0/gen.c from "Literals" on (the rest follows).

import Zevic.Math
import Zevic.Text
import Zevic1.Ast as Ast
import Zevic1.Ctx as Ctx
import Zevic1.Gen as Gen
import Zevic1.Resolve as Resolve
import Zevic1.Token as Token
import Zevic1.Types as Types

// The type a number literal takes when a union is expected: its only integer (or decimal) member; otherwise the
// default type (`I64`, `F64`), which then has to be a member.
fn litMember(expect: Option<Types.Type>, isFloat: Bool) -> Option<Types.Type> {
    let e: Types.Type = match (expect) {
        Some(x) => x,
        None => return None,
    }
    if (e.Kind != Types.TKind.Union) {
        return expect
    }
    mut found: Option<Types.Type> = None
    mut cnt: I32 = 0
    for (m in e.Args) {
        if (if (isFloat) { m.IsFloat() } else { m.IsInt() }) {
            found = Some(m)
            cnt += 1
        }
    }
    if (cnt == 1) { found } else { None }
}

fn genIntLitRaw(mut F: Ctx.FnCtx, n: Ast.Node, expectIn: Option<Types.Type>, neg: Bool) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let expect: Option<Types.Type> = litMember(expectIn, false)
    mut t: Types.Type = g.Tt.I64
    if (n.Suffix != "") {
        match (g.Tt.PrimByName(n.Suffix)) {
            Some(x) => { t = x },
            None => {},
        }
    } else {
        match (expect) {
            Some(e) => {
                if (e.IsInt()) {
                    t = e
                } else if (e.IsFloat()) {
                    g.Diag.Error(n.Pos, "expected `${e.Name}`, found an integer (write `${n.Ival}.0` for a decimal number)")
                    return F.ErrVal()
                }
            },
            None => {},
        }
    }
    let bits: I32 = t.Bits()
    let v: U64 = n.Ival
    if (t.IsSigned()) {
        let maxPos: U64 = (1_U64 << (bits - 1)) - 1_U64
        let limit: U64 = maxPos + (if (neg) { 1_U64 } else { 0_U64 })
        if (v > limit) {
            let hi: I64 = maxPos.ToI64Wrap()
            g.Diag.Error(n.Pos, "the number ${if (neg) { "-" } else { "" }}${v} does not fit in `${t.Name}` (range ${-hi - 1} to ${hi})")
            return F.ErrVal()
        }
    } else {
        if (neg && v != 0_U64) {
            g.Diag.Error(n.Pos, "an unsigned type (`${t.Name}`) cannot hold a negative number")
            return F.ErrVal()
        }
        let max: U64 = if (bits == 64) { 0xFFFFFFFFFFFFFFFF_U64 } else { (1_U64 << bits) - 1_U64 }
        if (v > max) {
            g.Diag.Error(n.Pos, "the number ${v} does not fit in `${t.Name}` (maximum ${max})")
            return F.ErrVal()
        }
    }
    let sv: I64 = if (neg) { (0_U64).WrapSub(v).ToI64Wrap() } else { v.ToI64Wrap() }
    Ctx.Val.New(t, "${sv}")
}

fn doubleHex(d: F64) -> String { "0x${Gen.HexN(Math.F64Bits(d), 16)}" }

fn genFloatLitRaw(mut F: Ctx.FnCtx, n: Ast.Node, expectIn: Option<Types.Type>, neg: Bool) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let expect: Option<Types.Type> = litMember(expectIn, true)
    mut t: Types.Type = g.Tt.F64
    if (n.Suffix != "") {
        match (g.Tt.PrimByName(n.Suffix)) {
            Some(x) => { t = x },
            None => {},
        }
    } else {
        match (expect) {
            Some(e) => {
                if (e.IsFloat()) {
                    t = e
                } else if (e.IsInt()) {
                    g.Diag.Error(n.Pos, "expected `${e.Name}`, found a decimal number")
                    return F.ErrVal()
                }
            },
            None => {},
        }
    }
    mut d: F64 = if (neg) { -n.Fval } else { n.Fval }
    // f32 constants are written as doubles that are exactly representable
    if (t.Id == g.Tt.F32.Id) {
        d = d.ToF32().ToF64()
    }
    Ctx.Val.New(t, doubleHex(d))
}

// The Zevic type with the same representation as a C number type.
fn cNative(g: Gen.Gen, t: Types.Type) -> Option<Types.Type> {
    if (t.Kind != Types.TKind.CType) {
        return None
    }
    if (t.Ll == "float") {
        return Some(g.Tt.F32)
    }
    if (t.Ll == "double") {
        return Some(g.Tt.F64)
    }
    if (t.Ll.ByteAt(0) != 105_U8 || t.Name == "CBool") {
        return None
    }
    let sgn: Bool = t.PayloadWords == 1
    match (t.Size) {
        1 => Some(if (sgn) { g.Tt.I8 } else { g.Tt.U8 }),
        2 => Some(if (sgn) { g.Tt.I16 } else { g.Tt.U16 }),
        4 => Some(if (sgn) { g.Tt.I32 } else { g.Tt.U32 }),
        _ => Some(if (sgn) { g.Tt.I64 } else { g.Tt.U64 }),
    }
}

// An unsuffixed literal where a C number is expected becomes that C type.
fn genIntLit(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>, neg: Bool) -> Ctx.Val {
    match (expect) {
        Some(e) => {
            if (n.Suffix == "") {
                match (cNative(F.G, e)) {
                    Some(nat) => {
                        if (nat.IsInt()) {
                            let v: Ctx.Val = genIntLitRaw(F, n, Some(nat), neg)
                            if (!F.G.IsErr(v.T)) {
                                return Ctx.Val.New(e, v.V)
                            }
                            return v
                        }
                    },
                    None => {},
                }
            }
        },
        None => {},
    }
    genIntLitRaw(F, n, expect, neg)
}

fn genFloatLit(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>, neg: Bool) -> Ctx.Val {
    match (expect) {
        Some(e) => {
            if (n.Suffix == "") {
                match (cNative(F.G, e)) {
                    Some(nat) => {
                        if (nat.IsFloat()) {
                            let v: Ctx.Val = genFloatLitRaw(F, n, Some(nat), neg)
                            if (!F.G.IsErr(v.T)) {
                                return Ctx.Val.New(e, v.V)
                            }
                            return v
                        }
                    },
                    None => {},
                }
            }
        },
        None => {},
    }
    genFloatLitRaw(F, n, expect, neg)
}

// ---- runtime helpers ----

fn rtDecl(mut F: Ctx.FnCtx, name: String, line: String) {
    mut g: Gen.Gen = F.G
    Gen.Declare(g, name, line)
}

fn strVal(F: Ctx.FnCtx, constant: String) -> Ctx.Val { Ctx.Val.New(F.G.Tt.Str, constant) }

// The pointer and the length of a string value, as operands.
fn strParts(mut F: Ctx.FnCtx, s: Ctx.Val) -> (String, String) {
    if (Text.StartsWith(s.V, "{ ptr ") && Text.Contains(s.V, "@")) {
        // a constant: take the pieces apart textually
        let comma: I64 = Text.IndexOf(s.V, ",").Unwrap()
        let p: String = s.V.Slice(6, comma)
        let lenAt: I64 = Text.IndexOf(s.V, "i64 ").Unwrap()
        let n: String = s.V.Slice(lenAt + 4, s.V.Len() - 2)
        return (p, n)
    }
    let p: String = F.Tmp()
    let n: String = F.Tmp()
    F.Emit("${p} = extractvalue { ptr, i64 } ${s.V}, 0")
    F.Emit("${n} = extractvalue { ptr, i64 } ${s.V}, 1")
    (p, n)
}

// Calls a runtime function that returns a String through an out pointer.
fn callStrOut(mut F: Ctx.FnCtx, fnName: String, args: String) -> Ctx.Val {
    let slot: String = F.NewSlot(F.G.Tt.Str)
    F.Emit("call void @${fnName}(ptr ${slot}${if (args != "") { ", " } else { "" }}${args})")
    let t: String = F.Tmp()
    F.Emit("${t} = load { ptr, i64 }, ptr ${slot}")
    Ctx.Val.New(F.G.Tt.Str, t)
}

// x.ToString() for the built-in types.
fn genToString(mut F: Ctx.FnCtx, v: Ctx.Val, pos: Token.Pos) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let t: Types.Type = v.T
    let nullStr: String = "{ ptr null, i64 0 }"
    if (g.IsErr(t)) {
        return strVal(F, nullStr)
    }
    if (t.Id == g.Tt.Str.Id) {
        return v
    }
    if (t.IsInt()) {
        let bits: I32 = t.Bits()
        mut x: String = v.V
        if (bits < 64) {
            x = F.Tmp()
            F.Emit("${x} = ${if (t.IsSigned()) { "sext" } else { "zext" }} i${bits} ${v.V} to i64")
        }
        if (t.IsSigned()) {
            rtDecl(F, "zevic_i64_to_str", "declare void @zevic_i64_to_str(ptr, i64)")
            return callStrOut(F, "zevic_i64_to_str", "i64 ${x}")
        }
        rtDecl(F, "zevic_u64_to_str", "declare void @zevic_u64_to_str(ptr, i64)")
        return callStrOut(F, "zevic_u64_to_str", "i64 ${x}")
    }
    if (t.IsFloat()) {
        mut x: String = v.V
        if (t.Id == g.Tt.F32.Id) {
            x = F.Tmp()
            F.Emit("${x} = fpext float ${v.V} to double")
        }
        rtDecl(F, "zevic_f64_to_str", "declare void @zevic_f64_to_str(ptr, double)")
        return callStrOut(F, "zevic_f64_to_str", "double ${x}")
    }
    if (t.Id == g.Tt.Bool.Id) {
        let x: String = F.Tmp()
        F.Emit("${x} = zext i1 ${v.V} to i32")
        rtDecl(F, "zevic_bool_to_str", "declare void @zevic_bool_to_str(ptr, i32)")
        return callStrOut(F, "zevic_bool_to_str", "i32 ${x}")
    }
    if (t.Id == g.Tt.Char.Id) {
        rtDecl(F, "zevic_char_to_str", "declare void @zevic_char_to_str(ptr, i32)")
        return callStrOut(F, "zevic_char_to_str", "i32 ${v.V}")
    }
    if (t.Id == g.Tt.Unit.Id) {
        return strVal(F, Gen.StrConst(g, "()"))
    }
    if (F.Inst.D.ModName == "Zevic.Test") {
        // the assertions show any value; types without a text form show their name
        return strVal(F, Gen.StrConst(g, "<${t.Name}>"))
    }
    g.Diag.Error(pos, "`ToString` is not available for type `${t.Name}` yet")
    strVal(F, nullStr)
}

// ---- errors, panics and conversions ----

fn isUntypedLit(n: Ast.Node) -> Bool {
    if (n.Kind == Ast.NK.Unary && n.Op == Token.Tk.Minus) {
        return match (n.A) {
            Some(x) => isUntypedLit(x),
            None => false,
        }
    }
    (n.Kind == Ast.NK.Int || n.Kind == Ast.NK.Float) && n.Suffix == ""
}

// A runtime call that panics, in the cold section; returns the label to branch to.
fn coldPanic(mut F: Ctx.FnCtx, msg: String, pos: Token.Pos) -> String {
    mut g: Gen.Gen = F.G
    Gen.Declare(g, "zevic_panic", "declare void @zevic_panic(ptr, i64, ptr, i32) noreturn")
    let label: String = F.NewLabel("panic")
    let file: String = g.Diag.Name(pos.File)
    let m: String = Gen.StrConst(g, msg)
    let fl: String = Gen.StrConst(g, file)
    // the constants are `{ ptr @x, i64 n }`; the runtime takes the pieces
    let mp: String = m.Slice(6, Text.IndexOf(m, ",").Unwrap())
    let fp: String = fl.Slice(6, Text.IndexOf(fl, ",").Unwrap())
    F.Cold.Put("${label}:\n  call void @zevic_panic(ptr ${mp}, i64 ${msg.Len()}, ptr ${fp}, i32 ${pos.Line})\n  unreachable\n")
    label
}

fn unionIndex(u: Types.Type, m: Types.Type) -> I64 {
    mut i: I64 = 0
    while (i < u.Args.Len()) {
        if (u.Args[i].Id == m.Id) {
            return i
        }
        i += 1
    }
    -1
}

// TODO(port): the interface part of gen.c (`to_iface`) is ported with the calls.
fn toIface(mut F: Ctx.FnCtx, pos: Token.Pos, v: Ctx.Val, it: Types.Type, what: String) -> Ctx.Val {
    Panic("not ported yet: conversion to an interface value")
}

// Checks that `v` has type `want`; a value of type Never fits everywhere.
fn coerce(mut F: Ctx.FnCtx, pos: Token.Pos, v: Ctx.Val, want: Types.Type, what: String) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (v.T.Id == want.Id || g.IsErr(v.T) || g.IsErr(want)) {
        return v
    }
    if (v.T.Id == g.Tt.Never.Id) {
        return F.NeverVal(Some(want))
    }
    if (want.Kind == Types.TKind.Iface && Gen.IsUserType(v.T)) {
        return toIface(F, pos, v, want, what)
    }
    if (want.Kind == Types.TKind.Union) {
        return unionCoerce(F, pos, v, want, what)
    }
    // like C, any pointer converts to `*CVoid`
    if (v.T.Kind == Types.TKind.Ptr && want.Kind == Types.TKind.Ptr && want.Args.Len() > 0) {
        match (g.Tt.CByName("CVoid")) {
            Some(cv) => {
                if (want.Args[0].Id == cv.Id) {
                    return Ctx.Val.New(want, v.V)
                }
            },
            None => {},
        }
    }
    F.TypeError(pos, want, v.T, what)
    F.ErrVal()
}

// ---- unions ----

fn tagPtr(mut F: Ctx.FnCtx, et: Types.Type, slot: String) -> String {
    let p: String = F.Tmp()
    F.Emit("${p} = getelementptr inbounds ${F.LlOf(et)}, ptr ${slot}, i32 0, i32 0")
    p
}

fn payloadPtr(mut F: Ctx.FnCtx, et: Types.Type, slot: String) -> String {
    // every payload is empty (like Option<Unit>): the layout has no payload part
    if (et.PayloadWords == 0) {
        return slot
    }
    let p: String = F.Tmp()
    F.Emit("${p} = getelementptr inbounds ${F.LlOf(et)}, ptr ${slot}, i32 0, i32 1")
    p
}

// The same value in another union: every member of `from` that `to` has keeps its payload (members `to` lacks
// never reach here at run time, their tag becomes 0).
fn unionRemap(mut F: Ctx.FnCtx, v: Ctx.Val, from: Types.Type, to: Types.Type) -> Ctx.Val {
    let src: String = F.NewSlot(from)
    F.Emit("store ${F.LlOf(from)} ${v.V}, ptr ${src}")
    let tg: String = F.Tmp()
    F.Emit("${tg} = load i32, ptr ${tagPtr(F, from, src)}")
    let dst: String = F.NewSlot(to)
    mut base: String = tg
    mut i: I64 = 0
    while (i < from.Args.Len()) {
        mut di: I64 = unionIndex(to, from.Args[i])
        if (di < 0) {
            di = 0
        }
        if (di != i) {
            let c: String = F.Tmp()
            F.Emit("${c} = icmp eq i32 ${tg}, ${i}")
            let nx: String = F.Tmp()
            F.Emit("${nx} = select i1 ${c}, i32 ${di}, i32 ${base}")
            base = nx
        }
        i += 1
    }
    F.Emit("store i32 ${base}, ptr ${tagPtr(F, to, dst)}")
    let words: I32 = if (from.PayloadWords < to.PayloadWords) { from.PayloadWords } else { to.PayloadWords }
    if (words > 0) {
        let pv: String = F.Tmp()
        F.Emit("${pv} = load [${words} x i64], ptr ${payloadPtr(F, from, src)}")
        F.Emit("store [${words} x i64] ${pv}, ptr ${payloadPtr(F, to, dst)}")
    }
    let r: String = F.Tmp()
    F.Emit("${r} = load ${F.LlOf(to)}, ptr ${dst}")
    Ctx.Val.New(to, r)
}

// The member `m` of a union value.
fn unionExtract(mut F: Ctx.FnCtx, v: Ctx.Val, m: Types.Type) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (g.Tt.SizeOf(m) == 0) {
        return Ctx.Val.New(m, "zeroinitializer")
    }
    let slot: String = F.NewSlot(v.T)
    F.Emit("store ${F.LlOf(v.T)} ${v.V}, ptr ${slot}")
    let r: String = F.Tmp()
    F.Emit("${r} = load ${F.LlOf(m)}, ptr ${payloadPtr(F, v.T, slot)}")
    Ctx.Val.New(m, r)
}

// A member value becomes a union value, or a union value becomes a wider union (a subset of its members).
fn unionCoerce(mut F: Ctx.FnCtx, pos: Token.Pos, v: Ctx.Val, want: Types.Type, what: String) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (v.T.Kind == Types.TKind.Union) {
        for (m in v.T.Args) {
            if (unionIndex(want, m) < 0) {
                F.TypeError(pos, want, v.T, what)
                g.Diag.Note("`${m.Name}` is not a member of `${want.Name}`")
                return F.ErrVal()
            }
        }
        return unionRemap(F, v, v.T, want)
    }
    let idx: I64 = unionIndex(want, v.T)
    if (idx < 0) {
        F.TypeError(pos, want, v.T, what)
        g.Diag.Note("`${v.T.Name}` is not a member of `${want.Name}`")
        return F.ErrVal()
    }
    let slot: String = F.NewSlot(want)
    F.Emit("store i32 ${idx}, ptr ${tagPtr(F, want, slot)}")
    if (g.Tt.SizeOf(v.T) > 0) {
        F.Emit("store ${F.LlOf(v.T)} ${v.V}, ptr ${payloadPtr(F, want, slot)}")
    }
    let r: String = F.Tmp()
    F.Emit("${r} = load ${F.LlOf(want)}, ptr ${slot}")
    Ctx.Val.New(want, r)
}

// ---- operators ----

fn intIntrinsic(mut F: Ctx.FnCtx, op: String, t: Types.Type) -> String {
    mut g: Gen.Gen = F.G
    let bits: I32 = t.Bits()
    let name: String = "llvm.${op}.with.overflow.i${bits}"
    Gen.Declare(g, name, "declare { i${bits}, i1 } @${name}(i${bits}, i${bits})")
    name
}

fn genIntArith(mut F: Ctx.FnCtx, op: Token.Tk, a: Ctx.Val, b: Ctx.Val, pos: Token.Pos) -> Ctx.Val {
    let t: Types.Type = a.T
    let bits: I32 = t.Bits()
    let sgn: Bool = t.IsSigned()
    let ll: String = F.LlOf(t)
    if (op == Token.Tk.Plus || op == Token.Tk.Minus || op == Token.Tk.Star) {
        let nm: String = match (op) {
            Token.Tk.Plus => if (sgn) { "sadd" } else { "uadd" },
            Token.Tk.Minus => if (sgn) { "ssub" } else { "usub" },
            _ => if (sgn) { "smul" } else { "umul" },
        }
        let fnName: String = intIntrinsic(F, nm, t)
        let r: String = F.Tmp()
        let v: String = F.Tmp()
        let o: String = F.Tmp()
        F.Emit("${r} = call { ${ll}, i1 } @${fnName}(${ll} ${a.V}, ${ll} ${b.V})")
        F.Emit("${v} = extractvalue { ${ll}, i1 } ${r}, 0")
        F.Emit("${o} = extractvalue { ${ll}, i1 } ${r}, 1")
        let ok: String = F.NewLabel("ok")
        let panicL: String = coldPanic(F, "integer overflow", pos)
        F.CondBr(o, panicL, ok)
        F.StartBlock(ok)
        return Ctx.Val.New(t, v)
    }
    if (op == Token.Tk.Slash || op == Token.Tk.Percent) {
        let z: String = F.Tmp()
        F.Emit("${z} = icmp eq ${ll} ${b.V}, 0")
        let ok: String = F.NewLabel("ok")
        let panicL: String = coldPanic(F, if (op == Token.Tk.Slash) { "division by zero" } else { "remainder by zero" }, pos)
        F.CondBr(z, panicL, ok)
        F.StartBlock(ok)
        if (sgn) {
            // MIN / -1 overflows
            let min: String = if (bits == 64) { "-9223372036854775808" } else { "${-(1_I64 << (bits - 1))}" }
            let c1: String = F.Tmp()
            let c2: String = F.Tmp()
            let both: String = F.Tmp()
            F.Emit("${c1} = icmp eq ${ll} ${a.V}, ${min}")
            F.Emit("${c2} = icmp eq ${ll} ${b.V}, -1")
            F.Emit("${both} = and i1 ${c1}, ${c2}")
            let ok2: String = F.NewLabel("ok")
            let panic2: String = coldPanic(F, "integer overflow", pos)
            F.CondBr(both, panic2, ok2)
            F.StartBlock(ok2)
        }
        let r: String = F.Tmp()
        let ins: String = if (op == Token.Tk.Slash) { if (sgn) { "sdiv" } else { "udiv" } } else { if (sgn) { "srem" } else { "urem" } }
        F.Emit("${r} = ${ins} ${ll} ${a.V}, ${b.V}")
        return Ctx.Val.New(t, r)
    }
    let ins: String = match (op) {
        Token.Tk.Amp => "and",
        Token.Tk.Pipe => "or",
        _ => "xor",
    }
    let r: String = F.Tmp()
    F.Emit("${r} = ${ins} ${ll} ${a.V}, ${b.V}")
    Ctx.Val.New(t, r)
}

// a << n and a >> n: the amount is an I32 and must be below the width.
fn genShift(mut F: Ctx.FnCtx, op: Token.Tk, a: Ctx.Val, amt: Ctx.Val, pos: Token.Pos) -> Ctx.Val {
    let t: Types.Type = a.T
    let bits: I32 = t.Bits()
    let ll: String = F.LlOf(t)
    let bad: String = F.Tmp()
    F.Emit("${bad} = icmp uge i32 ${amt.V}, ${bits}")
    let ok: String = F.NewLabel("ok")
    let panicL: String = coldPanic(F, "shift amount is out of range", pos)
    F.CondBr(bad, panicL, ok)
    F.StartBlock(ok)
    mut x: String = amt.V
    if (bits != 32) {
        x = F.Tmp()
        F.Emit("${x} = ${if (bits < 32) { "trunc" } else { "zext" }} i32 ${amt.V} to ${ll}")
    }
    let r: String = F.Tmp()
    let ins: String = if (op == Token.Tk.Shl) { "shl" } else { if (t.IsSigned()) { "ashr" } else { "lshr" } }
    F.Emit("${r} = ${ins} ${ll} ${a.V}, ${x}")
    Ctx.Val.New(t, r)
}

fn genFloatArith(mut F: Ctx.FnCtx, op: Token.Tk, a: Ctx.Val, b: Ctx.Val) -> Ctx.Val {
    let ins: String = match (op) {
        Token.Tk.Plus => "fadd",
        Token.Tk.Minus => "fsub",
        Token.Tk.Star => "fmul",
        Token.Tk.Slash => "fdiv",
        _ => "frem",
    }
    let r: String = F.Tmp()
    F.Emit("${r} = ${ins} ${F.LlOf(a.T)} ${a.V}, ${b.V}")
    Ctx.Val.New(a.T, r)
}

// TODO(port): equality of structs, tuples, enums and classes comes with the equality part of gen.c.
fn genEq(mut F: Ctx.FnCtx, a: Ctx.Val, b: Ctx.Val, pos: Token.Pos) -> Ctx.Val {
    Panic("not ported yet: equality of aggregates")
}

fn icmpPred(op: Token.Tk, sgn: Bool) -> String {
    match (op) {
        Token.Tk.EqEq => "eq",
        Token.Tk.Neq => "ne",
        Token.Tk.Lt => if (sgn) { "slt" } else { "ult" },
        Token.Tk.Le => if (sgn) { "sle" } else { "ule" },
        Token.Tk.Gt => if (sgn) { "sgt" } else { "ugt" },
        _ => if (sgn) { "sge" } else { "uge" },
    }
}

fn fcmpPred(op: Token.Tk) -> String {
    match (op) {
        Token.Tk.EqEq => "oeq",
        Token.Tk.Neq => "une",
        Token.Tk.Lt => "olt",
        Token.Tk.Le => "ole",
        Token.Tk.Gt => "ogt",
        _ => "oge",
    }
}

fn genCompare(mut F: Ctx.FnCtx, op: Token.Tk, a: Ctx.Val, b: Ctx.Val, pos: Token.Pos) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let t: Types.Type = a.T
    let r: String = F.Tmp()
    let res: Ctx.Val = Ctx.Val.New(g.Tt.Bool, r)
    if (t.IsInt() || t.Kind == Types.TKind.Char || t.Kind == Types.TKind.Bool) {
        F.Emit("${r} = icmp ${icmpPred(op, t.IsSigned())} ${F.LlOf(t)} ${a.V}, ${b.V}")
        return res
    }
    if (t.Kind == Types.TKind.CType && t.Name != "CVoid") {
        let isF: Bool = t.Ll == "float" || t.Ll == "double"
        let isP: Bool = t.Ll == "ptr"
        if (isF) {
            F.Emit("${r} = fcmp ${fcmpPred(op)} ${t.Ll} ${a.V}, ${b.V}")
            return res
        }
        if (isP && op != Token.Tk.EqEq && op != Token.Tk.Neq) {
            g.Diag.Error(pos, "`CString` values can only be compared with `==` and `!=`")
            return F.ErrVal()
        }
        F.Emit("${r} = icmp ${icmpPred(op, t.PayloadWords == 1)} ${t.Ll} ${a.V}, ${b.V}")
        return res
    }
    if (t.IsFloat()) {
        F.Emit("${r} = fcmp ${fcmpPred(op)} ${F.LlOf(t)} ${a.V}, ${b.V}")
        return res
    }
    if (t.Kind == Types.TKind.Str) {
        let (ap, an): (String, String) = strParts(F, a)
        let (bp, bn): (String, String) = strParts(F, b)
        let c: String = F.Tmp()
        if (op == Token.Tk.EqEq || op == Token.Tk.Neq) {
            rtDecl(F, "zevic_str_eq", "declare i32 @zevic_str_eq(ptr, i64, ptr, i64)")
            F.Emit("${c} = call i32 @zevic_str_eq(ptr ${ap}, i64 ${an}, ptr ${bp}, i64 ${bn})")
            F.Emit("${r} = icmp ${if (op == Token.Tk.EqEq) { "ne" } else { "eq" }} i32 ${c}, 0")
        } else {
            rtDecl(F, "zevic_str_cmp", "declare i32 @zevic_str_cmp(ptr, i64, ptr, i64)")
            F.Emit("${c} = call i32 @zevic_str_cmp(ptr ${ap}, i64 ${an}, ptr ${bp}, i64 ${bn})")
            let p: String = match (op) {
                Token.Tk.Lt => "slt",
                Token.Tk.Le => "sle",
                Token.Tk.Gt => "sgt",
                _ => "sge",
            }
            F.Emit("${r} = icmp ${p} i32 ${c}, 0")
        }
        return res
    }
    if (t.Kind == Types.TKind.Unit) {
        return Ctx.Val.New(g.Tt.Bool, if (op == Token.Tk.EqEq) { "true" } else { "false" })
    }
    if ((op == Token.Tk.EqEq || op == Token.Tk.Neq) && (t.Kind == Types.TKind.Struct || t.Kind == Types.TKind.Enum || t.Kind == Types.TKind.Tuple || t.Kind == Types.TKind.Class || t.Kind == Types.TKind.Ptr)) {
        let e: Ctx.Val = genEq(F, a, b, pos)
        if (g.IsErr(e.T) || op == Token.Tk.EqEq) {
            return e
        }
        let n: String = F.Tmp()
        F.Emit("${n} = xor i1 ${e.V}, true")
        return Ctx.Val.New(g.Tt.Bool, n)
    }
    if (op == Token.Tk.EqEq || op == Token.Tk.Neq) {
        g.Diag.Error(pos, "values of type `${t.Name}` cannot be compared with `${op.Name()}`")
    } else {
        g.Diag.Error(pos, "values of type `${t.Name}` cannot be ordered with `${op.Name()}`")
    }
    F.ErrVal()
}

// ---- scopes and locals ----

fn nn(o: Option<Ast.Node>) -> Ast.Node {
    match (o) {
        Some(x) => x,
        None => Panic("syntax node is missing"),
    }
}

fn curScope(F: Ctx.FnCtx) -> Ctx.Scope {
    match (F.Scope) {
        Some(s) => s,
        None => Panic("no scope"),
    }
}

fn collectIdents(n: Option<Ast.Node>, mut out: Map<String, Bool>) -> Bool {
    // returns true when `this` appears
    let x: Ast.Node = match (n) {
        Some(v) => v,
        None => return false,
    }
    mut usesThis: Bool = false
    if (x.Kind == Ast.NK.Ident && x.HasName) {
        out.Set(x.Name, true)
    }
    if (x.Kind == Ast.NK.This) {
        usesThis = true
    }
    if (collectIdents(x.A, out)) { usesThis = true }
    if (collectIdents(x.B, out)) { usesThis = true }
    if (collectIdents(x.C, out)) { usesThis = true }
    if (collectIdents(x.D, out)) { usesThis = true }
    for (c in x.List) { if (collectIdents(Some(c), out)) { usesThis = true } }
    for (c in x.List2) { if (collectIdents(Some(c), out)) { usesThis = true } }
    for (c in x.List3) { if (collectIdents(Some(c), out)) { usesThis = true } }
    usesThis
}

// The names a lambda below `n` may capture. A variable with such a name is allocated on the heap when it is declared.
fn collectLambdaNames(n: Option<Ast.Node>, mut heap: Map<String, Bool>) {
    let x: Ast.Node = match (n) {
        Some(v) => v,
        None => return,
    }
    if (x.Kind == Ast.NK.Lambda || x.Kind == Ast.NK.Async) {
        collectIdents(n, heap)
        return
    }
    collectLambdaNames(x.A, heap)
    collectLambdaNames(x.B, heap)
    collectLambdaNames(x.C, heap)
    collectLambdaNames(x.D, heap)
    for (c in x.List) { collectLambdaNames(Some(c), heap) }
    for (c in x.List2) { collectLambdaNames(Some(c), heap) }
    for (c in x.List3) { collectLambdaNames(Some(c), heap) }
}

fn declareLocal(mut F: Ctx.FnCtx, name: String, t: Types.Type, isMut: Bool, pos: Token.Pos) -> Ctx.Local {
    mut g: Gen.Gen = F.G
    let sc: Ctx.Scope = curScope(F)
    for (o in sc.Locals) {
        if (o.Name == name) {
            g.Diag.Error(pos, "`${name}` is already declared in this scope")
            g.Diag.Note("the first declaration is at line ${o.Pos.Line}")
            break
        }
    }
    mut ptr: String = ""
    let size: I64 = g.Tt.SizeOf(t)
    if (F.Heap.Contains(name) && size > 0) {
        // a lambda may capture this variable: give it a cell on the heap that outlives the call
        rtDecl(F, "zevic_alloc", "declare ptr @zevic_alloc(i64)")
        ptr = F.Tmp()
        F.Emit("${ptr} = call ptr @zevic_alloc(i64 ${size})")
    } else {
        ptr = F.NewSlot(t)
    }
    let l: Ctx.Local = Ctx.Local.New(name, t, isMut, ptr, pos)
    mut s2: Ctx.Scope = sc
    s2.Locals.Push(l)
    l
}

// Leave the innermost scope on the normal path.
fn popScope(mut F: Ctx.FnCtx) {
    let s: Ctx.Scope = curScope(F)
    if (!F.Term) {
        runDefersIn(F, s)
    }
    F.Scope = s.Up
}

// ---- `is` and smart casts ----

class Narrow {
    Name: String
    T: Types.Type

    fn Init(name: String, t: Types.Type) {
        this.Name = name
        this.T = t
    }
}

fn narrowable(F: Ctx.FnCtx, x: Ast.Node) -> Option<Ctx.Local> {
    if (x.Kind != Ast.NK.Ident) {
        return None
    }
    match (F.FindLocal(x.Name)) {
        Some(l) => {
            if (l.Mut || l.T.Kind != Types.TKind.Union) { None } else { Some(l) }
        },
        None => None,
    }
}

// The type of a union value once it is known to be (truth) or not to be (!truth) `t`.
fn narrowedType(mut g: Gen.Gen, u: Types.Type, t: Types.Type, truth: Bool) -> Option<Types.Type> {
    if (unionIndex(u, t) < 0) {
        return None
    }
    if (truth) {
        return Some(t)
    }
    mut rest: Array<Types.Type> = []
    for (m in u.Args) {
        if (m.Id != t.Id) {
            rest.Push(m)
        }
    }
    Some(g.Tt.Union(rest))
}

// What the condition `c` tells about variables when it is true (truth) or false (!truth).
fn collectNarrow(mut F: Ctx.FnCtx, c: Ast.Node, truth: Bool, mut out: Array<Narrow>) {
    mut g: Gen.Gen = F.G
    if (c.Kind == Ast.NK.Is) {
        let l: Ctx.Local = match (narrowable(F, nn(c.A))) {
            Some(x) => x,
            None => return,
        }
        let t: Types.Type = Gen.ResolveType(g, F.File, F.Env, nn(c.B))
        if (g.IsErr(t)) {
            return
        }
        match (narrowedType(g, l.T, t, truth != c.Flag)) {
            Some(nt) => out.Push(Narrow.New(l.Name, nt)),
            None => {},
        }
    } else if (c.Kind == Ast.NK.Unary && c.Op == Token.Tk.Bang) {
        collectNarrow(F, nn(c.A), !truth, out)
    } else if (c.Kind == Ast.NK.Binary && ((c.Op == Token.Tk.AndAnd && truth) || (c.Op == Token.Tk.OrOr && !truth))) {
        collectNarrow(F, nn(c.A), truth, out)
        collectNarrow(F, nn(c.B), truth, out)
    }
}

// Open a scope in which the variables are known to have narrower types. Returns how many scopes were opened.
fn pushNarrow(mut F: Ctx.FnCtx, cond: Ast.Node, truth: Bool, errs: I64) -> I64 {
    mut g: Gen.Gen = F.G
    if (g.Diag.Errors != errs) {
        return 0
    }
    mut scopes: I64 = 0
    mut ns: Array<Narrow> = []
    collectNarrow(F, cond, truth, ns)
    for (nr in ns) {
        let l: Ctx.Local = match (F.FindLocal(nr.Name)) {
            Some(x) => x,
            None => continue,
        }
        if (l.T.Kind != Types.TKind.Union) {
            continue
        }
        if (unionIndex(l.T, if (nr.T.Kind == Types.TKind.Union) { nr.T.Args[0] } else { nr.T }) < 0) {
            continue
        }
        F.PushScope() // one scope for each name, so that a name can be narrowed again
        scopes += 1
        let cur: Ctx.Val = F.LoadLocal(l)
        let nv: Ctx.Val = if (nr.T.Kind == Types.TKind.Union) { unionRemap(F, cur, l.T, nr.T) } else { unionExtract(F, cur, nr.T) }
        let nl: Ctx.Local = declareLocal(F, nr.Name, nr.T, false, l.Pos)
        if (g.Tt.SizeOf(nr.T) > 0) {
            F.Emit("store ${F.LlOf(nr.T)} ${nv.V}, ptr ${nl.Ptr}")
        }
    }
    scopes
}

fn genIs(mut F: Ctx.FnCtx, n: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let v: Ctx.Val = genExpr(F, nn(n.A), None)
    if (g.IsErr(v.T) || v.T.Id == g.Tt.Never.Id) {
        return if (g.IsErr(v.T)) { F.ErrVal() } else { F.NeverVal(Some(g.Tt.Bool)) }
    }
    let t: Types.Type = Gen.ResolveType(g, F.File, F.Env, nn(n.B))
    if (g.IsErr(t)) {
        return F.ErrVal()
    }
    if (v.T.Kind != Types.TKind.Union) {
        g.Diag.Error(n.Pos, "`is` needs a union on the left, but this is `${v.T.Name}`")
        return F.ErrVal()
    }
    let idx: I64 = unionIndex(v.T, t)
    if (idx < 0) {
        g.Diag.Error(nn(n.B).Pos, "`${t.Name}` is not a member of `${v.T.Name}`")
        return F.ErrVal()
    }
    let slot: String = F.NewSlot(v.T)
    F.Emit("store ${F.LlOf(v.T)} ${v.V}, ptr ${slot}")
    let tg: String = F.Tmp()
    F.Emit("${tg} = load i32, ptr ${tagPtr(F, v.T, slot)}")
    let r: String = F.Tmp()
    F.Emit("${r} = icmp ${if (n.Flag) { "ne" } else { "eq" }} i32 ${tg}, ${idx}")
    Ctx.Val.New(g.Tt.Bool, r)
}

fn genLogic(mut F: Ctx.FnCtx, n: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let isAnd: Bool = n.Op == Token.Tk.AndAnd
    let errs: I64 = g.Diag.Errors
    mut a: Ctx.Val = genExpr(F, nn(n.A), Some(g.Tt.Bool))
    a = coerce(F, nn(n.A).Pos, a, g.Tt.Bool, "the operand of a logical operator")
    if (a.T.Id == g.Tt.Never.Id) {
        return F.NeverVal(Some(g.Tt.Bool))
    }
    let from: String = F.Cur
    let rhs: String = F.NewLabel(if (isAnd) { "and.rhs" } else { "or.rhs" })
    let end: String = F.NewLabel(if (isAnd) { "and.end" } else { "or.end" })
    if (isAnd) { F.CondBr(a.V, rhs, end) } else { F.CondBr(a.V, end, rhs) }
    F.StartBlock(rhs)
    mut nsc: I64 = pushNarrow(F, nn(n.A), isAnd, errs)
    mut b: Ctx.Val = genExpr(F, nn(n.B), Some(g.Tt.Bool))
    b = coerce(F, nn(n.B).Pos, b, g.Tt.Bool, "the operand of a logical operator")
    while (nsc > 0) {
        popScope(F)
        nsc -= 1
    }
    let from2: String = F.Cur
    let bLive: Bool = !F.Term
    if (bLive) {
        F.Br(end)
    }
    F.StartBlock(end)
    let r: String = F.Tmp()
    let shortV: String = if (isAnd) { "false" } else { "true" }
    if (bLive) {
        F.Emit("${r} = phi i1 [ ${shortV}, %${from} ], [ ${b.V}, %${from2} ]")
    } else {
        F.Emit("${r} = phi i1 [ ${shortV}, %${from} ]")
    }
    Ctx.Val.New(g.Tt.Bool, r)
}

fn genPair(mut F: Ctx.FnCtx, na: Ast.Node, nb: Ast.Node, hint: Option<Types.Type>) -> (Ctx.Val, Ctx.Val) {
    mut g: Gen.Gen = F.G
    if (isUntypedLit(na) && !isUntypedLit(nb)) {
        let vb: Ctx.Val = genExpr(F, nb, hint)
        let va: Ctx.Val = genExpr(F, na, if (g.IsErr(vb.T) || vb.T.Id == g.Tt.Never.Id) { hint } else { Some(vb.T) })
        (va, vb)
    } else {
        let va: Ctx.Val = genExpr(F, na, hint)
        let vb: Ctx.Val = genExpr(F, nb, if (g.IsErr(va.T) || va.T.Id == g.Tt.Never.Id) { hint } else { Some(va.T) })
        (va, vb)
    }
}

fn genBinary(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let op: Token.Tk = n.Op
    if (op == Token.Tk.AndAnd || op == Token.Tk.OrOr) {
        return genLogic(F, n)
    }
    let cmp: Bool = op == Token.Tk.EqEq || op == Token.Tk.Neq || op == Token.Tk.Lt || op == Token.Tk.Gt || op == Token.Tk.Le || op == Token.Tk.Ge
    let shift: Bool = op == Token.Tk.Shl || op == Token.Tk.Shr
    mut a: Ctx.Val = F.ErrVal()
    mut b: Ctx.Val = F.ErrVal()
    if (shift) {
        a = genExpr(F, nn(n.A), expect)
        b = genExpr(F, nn(n.B), Some(g.Tt.I32))
    } else {
        let (pa, pb): (Ctx.Val, Ctx.Val) = genPair(F, nn(n.A), nn(n.B), if (cmp) { None } else { expect })
        a = pa
        b = pb
    }
    if (a.T.Id == g.Tt.Never.Id || b.T.Id == g.Tt.Never.Id) {
        return F.NeverVal(if (cmp) { Some(g.Tt.Bool) } else { expect })
    }
    if (g.IsErr(a.T) || g.IsErr(b.T)) {
        return F.ErrVal()
    }
    if (shift) {
        if (!a.T.IsInt()) {
            g.Diag.Error(n.Pos, "`${op.Name()}` needs an integer on the left, found `${a.T.Name}`")
            return F.ErrVal()
        }
        if (b.T.Id != g.Tt.I32.Id) {
            g.Diag.Error(nn(n.B).Pos, "the shift amount must be `I32`, found `${b.T.Name}`")
            return F.ErrVal()
        }
        return genShift(F, op, a, b, n.Pos)
    }
    if (a.T.Id != b.T.Id) {
        g.Diag.Error(n.Pos, "the operands of `${op.Name()}` have different types: `${a.T.Name}` and `${b.T.Name}` (convert one explicitly, e.g. with `ToI64()`)")
        return F.ErrVal()
    }
    if (cmp) {
        return genCompare(F, op, a, b, n.Pos)
    }
    let t: Types.Type = a.T
    if (t.Id == g.Tt.Str.Id && op == Token.Tk.Plus) {
        let (ap, an): (String, String) = strParts(F, a)
        let (bp, bn): (String, String) = strParts(F, b)
        rtDecl(F, "zevic_str_concat", "declare void @zevic_str_concat(ptr, ptr, i64, ptr, i64)")
        return callStrOut(F, "zevic_str_concat", "ptr ${ap}, i64 ${an}, ptr ${bp}, i64 ${bn}")
    }
    if (t.IsFloat()) {
        if (op == Token.Tk.Plus || op == Token.Tk.Minus || op == Token.Tk.Star || op == Token.Tk.Slash || op == Token.Tk.Percent) {
            return genFloatArith(F, op, a, b)
        }
        g.Diag.Error(n.Pos, "`${op.Name()}` is only for integers, found `${t.Name}`")
        return F.ErrVal()
    }
    if (t.IsInt()) {
        return genIntArith(F, op, a, b, n.Pos)
    }
    g.Diag.Error(n.Pos, "`${op.Name()}` cannot be used with values of type `${t.Name}`")
    F.ErrVal()
}

fn genUnary(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (n.Op == Token.Tk.Minus) {
        let x: Ast.Node = nn(n.A)
        if (x.Kind == Ast.NK.Int) {
            return genIntLit(F, x, expect, true)
        }
        if (x.Kind == Ast.NK.Float) {
            return genFloatLit(F, x, expect, true)
        }
    }
    if (n.Op == Token.Tk.Amp) {
        // &x: the address of a `mut` variable, to hand to a C function
        let x: Ast.Node = nn(n.A)
        if (x.Kind != Ast.NK.Ident && x.Kind != Ast.NK.Member) {
            g.Diag.Error(n.Pos, "`&` can only be applied to a variable or a field")
            return F.ErrVal()
        }
        let p: Ctx.Place = genPlace(F, x)
        if (p.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(expect)
        }
        if (g.IsErr(p.T)) {
            return F.ErrVal()
        }
        if (!p.Mut) {
            g.Diag.Error(n.Pos, "cannot take the address of `${rootName(x)}` because it is not `mut`")
            g.Diag.Note("declare it with `mut ${rootName(x)}: ${p.T.Name} = ...`")
            return F.ErrVal()
        }
        return Ctx.Val.New(g.Tt.Ptr(p.T), p.Ptr)
    }
    let v: Ctx.Val = genExpr(F, nn(n.A), if (n.Op == Token.Tk.Bang) { Some(g.Tt.Bool) } else { expect })
    if (v.T.Id == g.Tt.Never.Id || g.IsErr(v.T)) {
        return v
    }
    let t: Types.Type = v.T
    let r: String = F.Tmp()
    let res: Ctx.Val = Ctx.Val.New(t, r)
    match (n.Op) {
        Token.Tk.Minus => {
            if (t.IsFloat()) {
                F.Emit("${r} = fneg ${F.LlOf(t)} ${v.V}")
                return res
            }
            if (t.IsSigned()) {
                return genIntArith(F, Token.Tk.Minus, Ctx.Val.New(t, "0"), v, n.Pos)
            }
            g.Diag.Error(n.Pos, "cannot negate a value of type `${t.Name}`")
            F.ErrVal()
        },
        Token.Tk.Bang => {
            if (t.Id != g.Tt.Bool.Id) {
                g.Diag.Error(n.Pos, "`!` needs a `Bool`, found `${t.Name}`")
                return F.ErrVal()
            }
            F.Emit("${r} = xor i1 ${v.V}, true")
            res
        },
        Token.Tk.Tilde => {
            if (!t.IsInt()) {
                g.Diag.Error(n.Pos, "`~` needs an integer, found `${t.Name}`")
                return F.ErrVal()
            }
            F.Emit("${r} = xor ${F.LlOf(t)} ${v.V}, -1")
            res
        },
        _ => F.ErrVal(),
    }
}

// ---- names, tuples, if, blocks ----

fn genIdent(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    match (F.FindLocal(n.Name)) {
        Some(l) => return F.LoadLocal(l),
        None => {},
    }
    // a constant
    let (dOpt, used): (Option<Resolve.Decl>, I64) = Gen.FindDecl(g, F.File, [n.Name], n.Pos)
    if (used < 0) {
        return F.ErrVal()
    }
    if (dOpt.IsNone() && n.Name == "Null") {
        match (expect) {
            Some(e) => {
                if (e.Kind == Types.TKind.Ptr || (e.Kind == Types.TKind.CType && e.Ll == "ptr")) {
                    return Ctx.Val.New(e, "null")
                }
            },
            None => {},
        }
        g.Diag.Error(n.Pos, "`Null` is a pointer value; use it where a pointer type (`*T` or `CString`) is expected")
        return F.ErrVal()
    }
    match (dOpt) {
        Some(d) => {
            if (d.Node.Kind == Ast.NK.DConst) {
                let t: Types.Type = Gen.ResolveType(g, d.FileInfo(), Gen.MakeEnv(g, d, None, None), nn(d.Node.A))
                let v: Ctx.Val = genExpr(F, nn(d.Node.B), Some(t))
                return coerce(F, nn(d.Node.B).Pos, v, t, "a constant")
            }
            if (d.Node.Kind == Ast.NK.DFn && used == 1) {
                return fnValueOf(F, d, n.Pos)
            }
        },
        None => {
            match (preludeVariantOwner(F, n.Name)) {
                Some(owner) => return genVariant(F, None, n.Pos, owner, staticType(F, owner, None, expect), n.Name, expect),
                None => {},
            }
        },
    }
    g.Diag.Error(n.Pos, "unknown name `${n.Name}`")
    F.ErrVal()
}

fn genTuple(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    mut vals: Array<Ctx.Val> = []
    mut tys: Array<Types.Type> = []
    mut i: I64 = 0
    while (i < n.List.Len()) {
        mut e: Option<Types.Type> = None
        match (expect) {
            Some(x) => {
                if (x.Kind == Types.TKind.Tuple && i < x.Args.Len()) {
                    e = Some(x.Args[i])
                }
            },
            None => {},
        }
        let v: Ctx.Val = genExpr(F, n.List[i], e)
        if (v.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(expect)
        }
        vals.Push(v)
        tys.Push(v.T)
        i += 1
    }
    for (t in tys) {
        if (g.IsErr(t)) {
            return F.ErrVal()
        }
    }
    let tt: Types.Type = g.Tt.Tuple(tys)
    mut acc: String = "undef"
    mut k: I64 = 0
    while (k < vals.Len()) {
        let v: Ctx.Val = vals[k]
        let r: String = F.Tmp()
        F.Emit("${r} = insertvalue ${F.LlOf(tt)} ${acc}, ${F.LlOf(v.T)} ${v.V}, ${k}")
        acc = r
        k += 1
    }
    Ctx.Val.New(tt, acc)
}

fn isUnionNotType(g: Gen.Gen, want: Option<Types.Type>, v: Ctx.Val) -> Bool {
    match (want) {
        Some(w) => w.Kind == Types.TKind.Union && v.T.Id != w.Id && v.T.Id != g.Tt.Never.Id && !g.IsErr(v.T),
        None => false,
    }
}

fn genIf(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let errs: I64 = g.Diag.Errors
    mut c: Ctx.Val = genExpr(F, nn(n.A), Some(g.Tt.Bool))
    c = coerce(F, nn(n.A).Pos, c, g.Tt.Bool, "an `if` condition")
    if (c.T.Id == g.Tt.Never.Id) {
        return F.NeverVal(expect)
    }
    let thenL: String = F.NewLabel("then")
    let elseL: String = F.NewLabel("else")
    let endL: String = F.NewLabel("endif")
    let hasElse: Bool = n.C.IsSome()
    F.CondBr(c.V, thenL, if (hasElse) { elseL } else { endL })
    F.StartBlock(thenL)
    mut want: Option<Types.Type> = None
    match (expect) {
        Some(e) => {
            if (e.Id != g.Tt.Unit.Id) {
                want = Some(e)
            }
        },
        None => {},
    }
    mut ns1: I64 = pushNarrow(F, nn(n.A), true, errs)
    mut v1: Ctx.Val = genBlock(F, nn(n.B), if (hasElse) { want } else { Some(g.Tt.Unit) })
    if (isUnionNotType(g, want, v1)) {
        v1 = coerce(F, nn(n.B).Pos, v1, want.Unwrap(), "an `if` branch")
    }
    while (ns1 > 0) {
        popScope(F)
        ns1 -= 1
    }
    let pred1: String = F.Cur
    let live1: Bool = !F.Term
    if (live1) {
        F.Br(endL)
    }
    if (!hasElse) {
        F.StartBlock(endL)
        return F.UnitVal()
    }
    let elseN: Ast.Node = nn(n.C)
    F.StartBlock(elseL)
    let t1: Option<Types.Type> = if (v1.T.Id == g.Tt.Never.Id) { want } else { Some(v1.T) }
    mut ns2: I64 = pushNarrow(F, nn(n.A), false, errs)
    mut v2: Ctx.Val = if (elseN.Kind == Ast.NK.If) { genIf(F, elseN, t1) } else { genBlock(F, elseN, t1) }
    if (isUnionNotType(g, t1, v2)) {
        v2 = coerce(F, elseN.Pos, v2, t1.Unwrap(), "an `if` branch")
    }
    while (ns2 > 0) {
        popScope(F)
        ns2 -= 1
    }
    let pred2: String = F.Cur
    let live2: Bool = !F.Term
    if (live2) {
        F.Br(endL)
    }
    F.StartBlock(endL)
    if (!live1 && !live2) {
        F.Emit("unreachable")
        F.Term = true
        return F.NeverVal(want)
    }
    let rt: Types.Type = if (live1) { v1.T } else { v2.T }
    if (live1 && live2 && v1.T.Id != v2.T.Id && !g.IsErr(v1.T) && !g.IsErr(v2.T)) {
        g.Diag.Error(elseN.Pos, "the branches of this `if` have different types: `${v1.T.Name}` and `${v2.T.Name}`")
        return F.ErrVal()
    }
    if (g.IsErr(rt)) {
        return F.ErrVal()
    }
    if (rt.Id == g.Tt.Unit.Id) {
        return F.UnitVal()
    }
    let r: String = F.Tmp()
    if (live1 && live2) {
        F.Emit("${r} = phi ${F.LlOf(rt)} [ ${v1.V}, %${pred1} ], [ ${v2.V}, %${pred2} ]")
    } else if (live1) {
        F.Emit("${r} = phi ${F.LlOf(rt)} [ ${v1.V}, %${pred1} ]")
    } else {
        F.Emit("${r} = phi ${F.LlOf(rt)} [ ${v2.V}, %${pred2} ]")
    }
    Ctx.Val.New(rt, r)
}

// Does this block always leave (return, break, continue)? Decided from the syntax only.
fn blockLeaves(b: Option<Ast.Node>) -> Bool {
    let blk: Ast.Node = match (b) {
        Some(x) => x,
        None => return false,
    }
    if (blk.Kind != Ast.NK.Block) {
        return false
    }
    mut last: Option<Ast.Node> = blk.A
    if (last.IsNone() && !blk.List.IsEmpty()) {
        last = Some(blk.List[blk.List.Len() - 1])
    }
    mut l: Ast.Node = match (last) {
        Some(x) => x,
        None => return false,
    }
    if (l.Kind == Ast.NK.ExprStmt) {
        l = nn(l.A)
    }
    l.Kind == Ast.NK.Return || l.Kind == Ast.NK.Break || l.Kind == Ast.NK.Continue
}

fn genBlock(mut F: Ctx.FnCtx, blk: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    F.PushScope()
    mut extra: I64 = 0
    for (st in blk.List) {
        let errs: I64 = g.Diag.Errors
        genStmt(F, st)
        // `if (x is E) { return ... }`: afterwards x is known not to be an E
        let e: Ast.Node = if (st.Kind == Ast.NK.ExprStmt) { nn(st.A) } else { st }
        if (e.Kind == Ast.NK.If && e.C.IsNone() && blockLeaves(e.B)) {
            extra += pushNarrow(F, nn(e.A), false, errs)
        }
    }
    mut v: Ctx.Val = F.UnitVal()
    let isUnitExpect: Bool = match (expect) {
        Some(e) => e.Id == g.Tt.Unit.Id,
        None => false,
    }
    match (blk.A) {
        Some(tail) => {
            v = genExpr(F, tail, if (isUnitExpect) { None } else { expect })
            if (isUnitExpect && v.T.Id != g.Tt.Never.Id) {
                v = F.UnitVal()
            }
        },
        None => {},
    }
    mut i: I64 = 0
    while (i < extra) {
        popScope(F)
        i += 1
    }
    popScope(F)
    if (F.Term && v.T.Id != g.Tt.Never.Id) {
        return F.NeverVal(Some(match (expect) { Some(e) => e, None => v.T }))
    }
    v
}

fn genExpr(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    match (n.Kind) {
        Ast.NK.Int => genIntLit(F, n, expect, false),
        Ast.NK.Float => genFloatLit(F, n, expect, false),
        Ast.NK.Bool => Ctx.Val.New(g.Tt.Bool, if (n.Ival != 0_U64) { "true" } else { "false" }),
        Ast.NK.Char => Ctx.Val.New(g.Tt.Char, "${n.Ival}"),
        Ast.NK.Byte => Ctx.Val.New(g.Tt.U8, "${n.Ival}"),
        Ast.NK.Str => genStringLit(F, n),
        Ast.NK.Unit => F.UnitVal(),
        Ast.NK.Ident => genIdent(F, n, expect),
        Ast.NK.Tuple => genTuple(F, n, expect),
        Ast.NK.Index => genIndexRead(F, n, expect),
        Ast.NK.Array => genArrayLit(F, n, expect),
        Ast.NK.StructLit => genStructLit(F, n, expect),
        Ast.NK.Unary => genUnary(F, n, expect),
        Ast.NK.Lambda => genLambda(F, n, expect),
        Ast.NK.Async => {
            // async { b }  ->  Zevic.Async.Spawn(() => { b })
            let sp: Option<Resolve.Decl> = match (g.Pg.FindModule("Zevic.Async")) {
                Some(am) => am.Decls.Get("Spawn"),
                None => None,
            }
            match (sp) {
                Some(d) => {
                    mut lam: Ast.Node = Ast.Node.New(Ast.NK.Lambda, n.Pos)
                    lam.B = n.B
                    lam.Flag = true
                    mut call: Ast.Node = Ast.Node.New(Ast.NK.Call, n.Pos)
                    call.A = Some(mkIdent(n.Pos, "Spawn"))
                    call.List.Push(lam)
                    genCallDecl(F, call, d, None, None, expect, None)
                },
                None => {
                    g.Diag.Error(n.Pos, "internal error: `Zevic.Async.Spawn` is missing from the standard library")
                    F.ErrVal()
                },
            }
        },
        Ast.NK.Await => genExpr(F, mkMethodCall(nn(n.A), "Await", n.Pos, None, None), expect),
        Ast.NK.Binary => genBinary(F, n, expect),
        Ast.NK.Is => genIs(F, n),
        Ast.NK.If => genIf(F, n, expect),
        Ast.NK.Block => genBlock(F, n, expect),
        Ast.NK.Call => genCall(F, n, expect),
        Ast.NK.Member => genMember(F, n, expect),
        Ast.NK.Match => genMatch(F, n, expect),
        Ast.NK.Try => genTry(F, n, expect),
        Ast.NK.This => {
            let p: Ctx.Place = genPlace(F, n)
            if (g.IsErr(p.T)) { F.ErrVal() } else { loadPlace(F, p) }
        },
        Ast.NK.Return => genReturn(F, n, expect),
        Ast.NK.Break | Ast.NK.Continue => genBreakContinue(F, n, expect),
        _ => {
            g.Diag.Error(n.Pos, "this kind of expression is not supported yet (${n.Kind.Name()})")
            F.ErrVal()
        },
    }
}

fn runAllDefers(mut F: Ctx.FnCtx, stop: Option<Ctx.Scope>) {
    mut cur: Option<Ctx.Scope> = F.Scope
    loop {
        let s: Ctx.Scope = match (cur) {
            Some(x) => x,
            None => break,
        }
        match (stop) {
            Some(st) => {
                if (s == st) {
                    break
                }
            },
            None => {},
        }
        runDefersIn(F, s)
        cur = s.Up
    }
}

fn genReturn(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    mut v: Ctx.Val = F.UnitVal()
    match (F.Ret) {
        None => {
            // a lambda whose result type is not known yet takes the type of its first `return`
            match (n.A) {
                Some(a) => {
                    v = genExpr(F, a, None)
                    if (v.T.Id == g.Tt.Never.Id || g.IsErr(v.T)) {
                        return v
                    }
                    F.Ret = Some(v.T)
                },
                None => { F.Ret = Some(g.Tt.Unit) },
            }
        },
        Some(rt) => {
            match (n.A) {
                Some(a) => {
                    v = genExpr(F, a, Some(rt))
                    v = coerce(F, a.Pos, v, rt, "a `return` value")
                    if (v.T.Id == g.Tt.Never.Id) {
                        return v
                    }
                },
                None => {
                    if (rt.Id != g.Tt.Unit.Id && !g.IsErr(rt)) {
                        g.Diag.Error(n.Pos, "this function returns `${rt.Name}`, so `return` needs a value")
                    }
                },
            }
        },
    }
    runAllDefers(F, None)
    let rt: Types.Type = F.Ret.Unwrap()
    if (rt.Id == g.Tt.Unit.Id || rt.Id == g.Tt.Never.Id) {
        F.Emit("ret void")
    } else {
        F.Emit("ret ${F.LlOf(rt)} ${v.V}")
    }
    F.Term = true
    F.NeverVal(expect)
}

fn genBreakContinue(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let isBreak: Bool = n.Kind == Ast.NK.Break
    let word: String = if (isBreak) { "break" } else { "continue" }
    if (F.Loops.IsEmpty()) {
        g.Diag.Error(n.Pos, "`${word}` can only be used inside a loop")
        return F.ErrVal()
    }
    mut lp: Option<Ctx.Loop> = F.Loops.Last()
    if (n.HasName) {
        lp = None
        mut i: I64 = F.Loops.Len() - 1
        while (i >= 0) {
            let c: Ctx.Loop = F.Loops[i]
            match (c.Label) {
                Some(lb) => {
                    if (lb == n.Name) {
                        lp = Some(c)
                        break
                    }
                },
                None => {},
            }
            i -= 1
        }
        if (lp.IsNone()) {
            g.Diag.Error(n.Pos, "there is no loop labeled `${n.Name}` around this `${word}` (write `${n.Name}@ for (...) { ... }` on the loop)")
            return F.ErrVal()
        }
    }
    mut target: Ctx.Loop = lp.Unwrap()
    runAllDefers(F, Some(target.Scope))
    if (isBreak) {
        target.BrkUsed = true
    }
    F.Br(if (isBreak) { target.Brk } else { target.Cont })
    F.NeverVal(expect)
}

// ---- statements ----

fn runDefersIn(mut F: Ctx.FnCtx, s: Ctx.Scope) {
    mut i: I64 = s.Defers.Len() - 1
    while (i >= 0) {
        let saved: Option<Ctx.Scope> = F.Scope
        mut t: Ctx.Scope = Ctx.Scope.New()
        t.Up = Some(s)
        F.Scope = Some(t)
        let d: Ast.Node = s.Defers[i]
        if (d.Kind == Ast.NK.Block) {
            let unused: Ctx.Val = genBlock(F, d, Some(F.G.Tt.Unit))
        } else {
            genStmt(F, d)
        }
        F.Scope = saved
        i -= 1
    }
}

// Bind an irrefutable pattern to a value.
fn bindPattern(mut F: Ctx.FnCtx, pat: Ast.Node, v: Ctx.Val, isMut: Bool) {
    mut g: Gen.Gen = F.G
    match (pat.Kind) {
        Ast.NK.PWild => {},
        Ast.NK.PBind => {
            if (g.IsErr(v.T)) {
                declareLocal(F, pat.Name, g.Err, isMut, pat.Pos)
                return
            }
            let l: Ctx.Local = declareLocal(F, pat.Name, v.T, isMut, pat.Pos)
            if (v.T.Id != g.Tt.Unit.Id) {
                F.StoreTo(v.T, v, l.Ptr)
            }
        },
        Ast.NK.PTuple => {
            if (v.T.Kind != Types.TKind.Tuple) {
                if (!g.IsErr(v.T)) {
                    g.Diag.Error(pat.Pos, "cannot destructure a value of type `${v.T.Name}` as a tuple")
                }
                return
            }
            if (v.T.Args.Len() != pat.List.Len()) {
                g.Diag.Error(pat.Pos, "the tuple pattern has ${pat.List.Len()} element(s), but the value has ${v.T.Args.Len()}")
                return
            }
            mut i: I64 = 0
            while (i < pat.List.Len()) {
                let et: Types.Type = v.T.Args[i]
                let r: String = F.Tmp()
                F.Emit("${r} = extractvalue ${F.LlOf(v.T)} ${v.V}, ${i}")
                bindPattern(F, pat.List[i], Ctx.Val.New(et, r), isMut)
                i += 1
            }
        },
        _ => g.Diag.Error(pat.Pos, "this pattern can fail to match; only `_`, names and tuples can be used here"),
    }
}

fn baseOp(k: Token.Tk) -> Token.Tk {
    match (k) {
        Token.Tk.PlusEq => Token.Tk.Plus,
        Token.Tk.MinusEq => Token.Tk.Minus,
        Token.Tk.StarEq => Token.Tk.Star,
        Token.Tk.SlashEq => Token.Tk.Slash,
        Token.Tk.PercentEq => Token.Tk.Percent,
        Token.Tk.AmpEq => Token.Tk.Amp,
        Token.Tk.PipeEq => Token.Tk.Pipe,
        Token.Tk.CaretEq => Token.Tk.Caret,
        Token.Tk.ShlEq => Token.Tk.Shl,
        Token.Tk.ShrEq => Token.Tk.Shr,
        _ => Token.Tk.Assign,
    }
}

// The address of an assignable place and its type; None after an error.
fn genLvalue(mut F: Ctx.FnCtx, n: Ast.Node) -> Option<(String, Types.Type)> {
    mut g: Gen.Gen = F.G
    if (n.Kind == Ast.NK.Ident) {
        let l: Ctx.Local = match (F.FindLocal(n.Name)) {
            Some(x) => x,
            None => {
                g.Diag.Error(n.Pos, "cannot assign to `${n.Name}`: it is not a variable")
                return None
            },
        }
        if (!l.Mut) {
            g.Diag.Error(n.Pos, "cannot assign to `${n.Name}` because it is not `mut`")
            g.Diag.Note("declare it with `mut ${n.Name}: ${l.T.Name} = ...` to allow changes")
            return None
        }
        return Some((l.Ptr, l.T))
    }
    if (n.Kind == Ast.NK.Member && !isStaticPath(F, n)) {
        let p: Ctx.Place = genPlace(F, n)
        if (g.IsErr(p.T) || p.T.Id == g.Tt.Never.Id || p.Ptr == "") {
            return None
        }
        if (!p.Mut) {
            if (nn(n.A).Kind == Ast.NK.This) {
                g.Diag.Error(n.Pos, "cannot assign to field `${n.Name}` here: `this` can only be changed inside a `mut fn` (or `Init`)")
            } else {
                g.Diag.Error(n.Pos, "cannot assign to field `${n.Name}` because `${rootName(n)}` is not `mut`")
            }
            return None
        }
        return Some((p.Ptr, p.T))
    }
    g.Diag.Error(n.Pos, "this expression cannot be assigned to")
    None
}

// After changing a field of a struct element (`xs[i].F = v`), the changed copy goes back into the array.
fn genAssign(mut F: Ctx.FnCtx, n: Ast.Node) {
    mut g: Gen.Gen = F.G
    if (nn(n.A).Kind == Ast.NK.Index) {
        genIndexAssign(F, n)
        return
    }
    let (el, name): (Option<Ast.Node>, String) = genAssignPlace(F, n)
    match (el) {
        Some(e) => {
            if (!isPureExpr(nn(e.A)) || !isPureExpr(nn(e.B))) {
                g.Diag.Error(n.Pos, "changing a field of an array element needs a simple array and index (put them in variables first)")
                return
            }
            mut call: Ast.Node = mkMethodCall(nn(e.A), "SetIndex", n.Pos, e.B, Some(mkIdent(n.Pos, name)))
            call.Flag3 = true
            let unused: Ctx.Val = genExpr(F, call, None)
        },
        None => {},
    }
}

fn genAssignPlace(mut F: Ctx.FnCtx, n: Ast.Node) -> (Option<Ast.Node>, String) {
    mut g: Gen.Gen = F.G
    F.WbElem = None
    let lv: Option<(String, Types.Type)> = genLvalue(F, nn(n.A))
    // the right-hand side may read elements too, so the write-back is noted now
    let wbElem: Option<Ast.Node> = F.WbElem
    let wbName: String = F.WbName
    F.WbElem = None
    let (ptr, t): (String, Types.Type) = match (lv) {
        Some(x) => x,
        None => {
            genExpr(F, nn(n.B), None)
            return (wbElem, wbName)
        },
    }
    if (n.Op == Token.Tk.Assign) {
        mut v: Ctx.Val = genExpr(F, nn(n.B), Some(t))
        v = coerce(F, nn(n.B).Pos, v, t, "an assignment")
        if (v.T.Id == g.Tt.Never.Id || g.IsErr(v.T)) {
            return (wbElem, wbName)
        }
        F.StoreTo(t, v, ptr)
        return (wbElem, wbName)
    }
    let op: Token.Tk = baseOp(n.Op)
    let cur: String = F.Tmp()
    F.Emit("${cur} = load ${F.LlOf(t)}, ptr ${ptr}")
    let a: Ctx.Val = Ctx.Val.New(t, cur)
    let shift: Bool = op == Token.Tk.Shl || op == Token.Tk.Shr
    mut b: Ctx.Val = genExpr(F, nn(n.B), if (shift) { Some(g.Tt.I32) } else { Some(t) })
    if (b.T.Id == g.Tt.Never.Id || g.IsErr(b.T) || g.IsErr(t)) {
        return (wbElem, wbName)
    }
    mut r: Ctx.Val = F.ErrVal()
    if (shift) {
        if (!t.IsInt() || b.T.Id != g.Tt.I32.Id) {
            g.Diag.Error(n.Pos, "`${n.Op.Name()}` needs an integer variable and an `I32` amount")
            return (wbElem, wbName)
        }
        r = genShift(F, op, a, b, n.Pos)
    } else {
        b = coerce(F, nn(n.B).Pos, b, t, "a compound assignment")
        if (g.IsErr(b.T)) {
            return (wbElem, wbName)
        }
        if (t.Id == g.Tt.Str.Id && op == Token.Tk.Plus) {
            let (ap, an): (String, String) = strParts(F, a)
            let (bp, bn): (String, String) = strParts(F, b)
            rtDecl(F, "zevic_str_concat", "declare void @zevic_str_concat(ptr, ptr, i64, ptr, i64)")
            r = callStrOut(F, "zevic_str_concat", "ptr ${ap}, i64 ${an}, ptr ${bp}, i64 ${bn}")
        } else if (t.IsFloat() && op != Token.Tk.Amp && op != Token.Tk.Pipe && op != Token.Tk.Caret) {
            r = genFloatArith(F, op, a, b)
        } else if (t.IsInt()) {
            r = genIntArith(F, op, a, b, n.Pos)
        } else {
            g.Diag.Error(n.Pos, "`${n.Op.Name()}` cannot be used with values of type `${t.Name}`")
            return (wbElem, wbName)
        }
    }
    F.StoreTo(t, r, ptr)
    (wbElem, wbName)
}

fn genWhile(mut F: Ctx.FnCtx, n: Ast.Node) {
    mut g: Gen.Gen = F.G
    let head: String = F.NewLabel("while.cond")
    let body: String = F.NewLabel("while.body")
    let end: String = F.NewLabel("while.end")
    F.GotoBlock(head)
    mut c: Ctx.Val = genExpr(F, nn(n.A), Some(g.Tt.Bool))
    c = coerce(F, nn(n.A).Pos, c, g.Tt.Bool, "a `while` condition")
    if (c.T.Id != g.Tt.Never.Id) {
        F.CondBr(c.V, body, end)
    }
    F.StartBlock(body)
    mut lp: Ctx.Loop = Ctx.Loop.New(end, head, curScope(F))
    if (n.HasName) {
        lp.Label = Some(n.Name)
    }
    F.Loops.Push(lp)
    genBlock(F, nn(n.B), Some(g.Tt.Unit))
    F.Loops.Pop()
    if (!F.Term) {
        F.Br(head)
    }
    F.StartBlock(end)
}

fn genLoop(mut F: Ctx.FnCtx, n: Ast.Node) {
    mut g: Gen.Gen = F.G
    let body: String = F.NewLabel("loop.body")
    let end: String = F.NewLabel("loop.end")
    F.GotoBlock(body)
    mut lp: Ctx.Loop = Ctx.Loop.New(end, body, curScope(F))
    if (n.HasName) {
        lp.Label = Some(n.Name)
    }
    F.Loops.Push(lp)
    genBlock(F, nn(n.B), Some(g.Tt.Unit))
    F.Loops.Pop()
    if (!F.Term) {
        F.Br(body)
    }
    F.StartBlock(end)
    if (!lp.BrkUsed) {
        // a `loop` with no `break` never finishes, so what follows it is unreachable
        F.Emit("unreachable")
        F.Term = true
    }
}

fn genForRange(mut F: Ctx.FnCtx, n: Ast.Node) {
    mut g: Gen.Gen = F.G
    let r: Ast.Node = nn(n.D)
    let (a, b): (Ctx.Val, Ctx.Val) = genPair(F, nn(r.A), nn(r.B), None)
    if (a.T.Id == g.Tt.Never.Id || b.T.Id == g.Tt.Never.Id || g.IsErr(a.T) || g.IsErr(b.T)) {
        return
    }
    if (!a.T.IsInt() || a.T.Id != b.T.Id) {
        g.Diag.Error(r.Pos, "the bounds of a range must be integers of the same type, found `${a.T.Name}` and `${b.T.Name}`")
        return
    }
    let t: Types.Type = a.T
    let ll: String = F.LlOf(t)
    let sgn: Bool = t.IsSigned()
    F.PushScope()
    let ctr: String = F.NewSlot(t)
    F.StoreTo(t, a, ctr)
    let head: String = F.NewLabel("for.cond")
    let body: String = F.NewLabel("for.body")
    let cont: String = F.NewLabel("for.next")
    let end: String = F.NewLabel("for.end")
    F.GotoBlock(head)
    let cur: String = F.Tmp()
    let c: String = F.Tmp()
    F.Emit("${cur} = load ${ll}, ptr ${ctr}")
    let pred: String = if (r.Flag) { if (sgn) { "sle" } else { "ule" } } else { if (sgn) { "slt" } else { "ult" } }
    F.Emit("${c} = icmp ${pred} ${ll} ${cur}, ${b.V}")
    F.CondBr(c, body, end)
    F.StartBlock(body)
    // the loop variable is an immutable alias of the counter
    let pat: Ast.Node = nn(n.A)
    if (pat.Kind == Ast.NK.PBind && F.Heap.Contains(pat.Name)) {
        // a lambda may capture it: every iteration gets its own cell
        let l: Ctx.Local = declareLocal(F, pat.Name, t, false, pat.Pos)
        F.StoreTo(t, Ctx.Val.New(t, cur), l.Ptr)
    } else if (pat.Kind == Ast.NK.PBind) {
        let l: Ctx.Local = Ctx.Local.New(pat.Name, t, false, ctr, pat.Pos)
        mut sc: Ctx.Scope = curScope(F)
        sc.Locals.Push(l)
    } else if (pat.Kind != Ast.NK.PWild) {
        g.Diag.Error(pat.Pos, "a range loop variable must be a name or `_`")
    }
    match (n.C) {
        Some(ix) => g.Diag.Error(ix.Pos, "a range has no index; use a single loop variable"),
        None => {},
    }
    mut lp: Ctx.Loop = Ctx.Loop.New(end, cont, match (curScope(F).Up) { Some(u) => u, None => curScope(F) })
    if (n.HasName) {
        lp.Label = Some(n.Name)
    }
    F.Loops.Push(lp)
    genBlock(F, nn(n.B), Some(g.Tt.Unit))
    F.Loops.Pop()
    if (!F.Term) {
        F.Br(cont)
    }
    F.StartBlock(cont)
    let cur2: String = F.Tmp()
    F.Emit("${cur2} = load ${ll}, ptr ${ctr}")
    if (r.Flag) {
        // inclusive: stop after the upper bound without overflowing
        let last: String = F.Tmp()
        let step: String = F.NewLabel("for.step")
        F.Emit("${last} = icmp eq ${ll} ${cur2}, ${b.V}")
        F.CondBr(last, end, step)
        F.StartBlock(step)
    }
    let nx: String = F.Tmp()
    F.Emit("${nx} = add ${ll} ${cur2}, 1")
    F.StoreTo(t, Ctx.Val.New(t, nx), ctr)
    F.Br(head)
    F.StartBlock(end)
    popScope(F)
}

fn genFor(mut F: Ctx.FnCtx, n: Ast.Node) {
    if (nn(n.D).Kind == Ast.NK.Range) {
        genForRange(F, n)
        return
    }
    genForIter(F, n)
}

fn genLet(mut F: Ctx.FnCtx, n: Ast.Node) {
    mut g: Gen.Gen = F.G
    // `n.B` is empty only for lets the compiler writes itself: the type comes from the value
    let t0: Option<Types.Type> = match (n.B) {
        Some(te) => Some(Gen.ResolveType(g, F.File, F.Env, te)),
        None => None,
    }
    let v0: Ctx.Val = genExpr(F, nn(n.C), t0)
    let t: Types.Type = match (t0) {
        Some(x) => x,
        None => if (v0.T.Id == g.Tt.Never.Id || g.IsErr(v0.T)) { g.Err } else { v0.T },
    }
    mut v: Ctx.Val = coerce(F, nn(n.C).Pos, v0, t, "a variable declaration")
    if (v.T.Id == g.Tt.Never.Id) {
        // the initialiser never completes; still declare the names so later code can be checked
        v = Ctx.Val.New(t, "undef")
    }
    if (g.IsErr(v.T)) {
        v = Ctx.Val.New(t, "undef")
    }
    bindPattern(F, nn(n.A), v, n.Flag)
}

fn checkLoopLabel(mut F: Ctx.FnCtx, s: Ast.Node) {
    if (!s.HasName) {
        return
    }
    mut g: Gen.Gen = F.G
    for (c in F.Loops) {
        match (c.Label) {
            Some(lb) => {
                if (lb == s.Name) {
                    g.Diag.Error(s.Pos, "the label `${s.Name}` is already used by a loop around this one")
                }
            },
            None => {},
        }
    }
}

fn genStmt(mut F: Ctx.FnCtx, s: Ast.Node) {
    if (s.Kind == Ast.NK.While || s.Kind == Ast.NK.Loop || s.Kind == Ast.NK.For) {
        checkLoopLabel(F, s)
    }
    match (s.Kind) {
        Ast.NK.Let => genLet(F, s),
        Ast.NK.Assign => genAssign(F, s),
        Ast.NK.ExprStmt => { genExpr(F, nn(s.A), None) },
        Ast.NK.While => genWhile(F, s),
        Ast.NK.Loop => genLoop(F, s),
        Ast.NK.For => genFor(F, s),
        Ast.NK.Defer => {
            mut sc: Ctx.Scope = curScope(F)
            sc.Defers.Push(nn(s.A))
        },
        _ => { genExpr(F, s, None) },
    }
}

// ---- not ported yet ----
fn genPrintf(mut F: Ctx.FnCtx, n: Ast.Node, toErr: Bool) -> Ctx.Val { Panic("not ported yet: genPrintf") }
fn genIfaceMethod(mut F: Ctx.FnCtx, call: Ast.Node, p: Ctx.Place, recvNode: Ast.Node, name: String, expect: Option<Types.Type>) -> Ctx.Val { Panic("not ported yet: genIfaceMethod") }

fn fnValueOf(mut F: Ctx.FnCtx, d: Resolve.Decl, pos: Token.Pos) -> Ctx.Val { Panic("not ported yet: fnValueOf") }
fn genLambda(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val { Panic("not ported yet: genLambda") }

// ---- places, paths and string literals ----

// The names of a dotted path `A.B.C`, or None when the expression is not one.
fn flattenPath(n: Ast.Node, mut segs: Array<String>, mut nodes: Array<Ast.Node>) -> Bool {
    if (n.Kind == Ast.NK.Ident) {
        segs.Push(n.Name)
        nodes.Push(n)
        return true
    }
    if (n.Kind == Ast.NK.Member) {
        match (n.A) {
            Some(a) => {
                if (flattenPath(a, segs, nodes)) {
                    segs.Push(n.Name)
                    nodes.Push(n)
                    return true
                }
            },
            None => {},
        }
    }
    false
}

// Is this a dotted path whose first name is not a variable (a module or type)?
fn isStaticPath(F: Ctx.FnCtx, n: Ast.Node) -> Bool {
    mut segs: Array<String> = []
    mut nodes: Array<Ast.Node> = []
    if (!flattenPath(n, segs, nodes)) {
        return false
    }
    F.FindLocal(segs[0]).IsNone()
}

// The name of the variable a path starts from (for messages).
fn rootName(n: Ast.Node) -> String {
    mut cur: Ast.Node = n
    while (cur.Kind == Ast.NK.Member || cur.Kind == Ast.NK.Index) {
        match (cur.A) {
            Some(a) => { cur = a },
            None => return "this value",
        }
    }
    if (cur.Kind == Ast.NK.Ident) {
        return cur.Name
    }
    if (cur.Kind == Ast.NK.This) {
        return "this"
    }
    "this value"
}

// An expression that can be evaluated twice without changing the result.
fn isPureExpr(n: Ast.Node) -> Bool {
    match (n.Kind) {
        Ast.NK.Ident | Ast.NK.Int | Ast.NK.This | Ast.NK.Bool | Ast.NK.Char | Ast.NK.Byte => true,
        Ast.NK.Member | Ast.NK.Unary => isPureExpr(nn(n.A)),
        Ast.NK.Binary | Ast.NK.Index => isPureExpr(nn(n.A)) && isPureExpr(nn(n.B)),
        _ => false,
    }
}

fn placeErr(F: Ctx.FnCtx) -> Ctx.Place { Ctx.Place.New("", F.G.Err, false) }

fn loadPlace(mut F: Ctx.FnCtx, p: Ctx.Place) -> Ctx.Val {
    if (F.G.IsErr(p.T)) {
        return F.ErrVal()
    }
    if (p.T.Id == F.G.Tt.Unit.Id) {
        return F.UnitVal()
    }
    let t: String = F.Tmp()
    F.Emit("${t} = load ${F.LlOf(p.T)}, ptr ${p.Ptr}")
    Ctx.Val.New(p.T, t)
}

// A value in a fresh slot, so that it has an address.
fn spill(mut F: Ctx.FnCtx, v: Ctx.Val) -> Ctx.Place {
    let g: Gen.Gen = F.G
    if (g.IsErr(v.T) || v.T.Id == g.Tt.Never.Id) {
        return Ctx.Place.New("", v.T, false)
    }
    let ptr: String = F.NewSlot(v.T)
    if (v.T.Id != g.Tt.Unit.Id) {
        F.StoreTo(v.T, v, ptr)
    }
    Ctx.Place.New(ptr, v.T, false)
}

// A class object is laid out like a tuple of its fields.
fn objTuple(mut g: Gen.Gen, cls: Types.Type) -> Types.Type {
    mut ts: Array<Types.Type> = []
    for (f in cls.Fields) {
        ts.Push(f.T)
    }
    g.Tt.Tuple(ts)
}

fn checkVis(mut F: Ctx.FnCtx, t: Types.Type, name: String, pos: Token.Pos, what: String) -> Bool {
    mut g: Gen.Gen = F.G
    if (Gen.NameIsPub(name)) {
        return true
    }
    match (Gen.DeclOfType(g, t)) {
        Some(d) => {
            if (d.ModName == fileModName(F)) {
                return true
            }
            g.Diag.Error(pos, "${what} `${name}` of `${t.Name}` is private (names starting with a lowercase letter are only visible inside module `${d.ModName}`)")
            false
        },
        None => true,
    }
}

fn findFieldIdx(t: Types.Type, name: String) -> I64 {
    mut i: I64 = 0
    while (i < t.Fields.Len()) {
        if (t.Fields[i].Name == name) {
            return i
        }
        i += 1
    }
    -1
}



fn genPlace(mut F: Ctx.FnCtx, n: Ast.Node) -> Ctx.Place {
    mut g: Gen.Gen = F.G
    match (n.Kind) {
        Ast.NK.Ident => {
            match (F.FindLocal(n.Name)) {
                Some(l) => return Ctx.Place.New(l.Ptr, l.T, l.Mut),
                None => {},
            }
        },
        Ast.NK.This => {
            if (!F.HasThis) {
                g.Diag.Error(n.Pos, "`this` can only be used inside a method")
                return placeErr(F)
            }
            return Ctx.Place.New(F.ThisSlot, thisType(F), F.ThisMut)
        },
        Ast.NK.Index => {
            // an element of an array: a class element is a reference, so its fields can be changed in place; a struct
            // element is copied into a local and stored back after the assignment (see genAssign). Either way the
            // array itself must be `mut`.
            mut amut: Bool = false
            let a: Ast.Node = nn(n.A)
            if (a.Kind == Ast.NK.Ident || a.Kind == Ast.NK.Member || a.Kind == Ast.NK.This || a.Kind == Ast.NK.Index) {
                let ap: Ctx.Place = genPlace(F, a)
                if (g.IsErr(ap.T) || ap.T.Id == g.Tt.Never.Id) {
                    return placeErr(F)
                }
                amut = ap.Mut
            }
            let v: Ctx.Val = genExpr(F, n, None)
            if (v.T.Id == g.Tt.Never.Id || g.IsErr(v.T)) {
                return placeErr(F)
            }
            if (v.T.Kind == Types.TKind.Struct) {
                let name: String = "$el${F.NSlot}"
                let l: Ctx.Local = declareLocal(F, name, v.T, true, n.Pos)
                F.StoreTo(v.T, v, l.Ptr)
                F.WbElem = Some(n)
                F.WbName = name
                return Ctx.Place.New(l.Ptr, v.T, amut)
            }
            let p: Ctx.Place = spill(F, v)
            return Ctx.Place.New(p.Ptr, p.T, amut)
        },
        Ast.NK.Member => {
            if (!isStaticPath(F, n)) {
                let b: Ctx.Place = genPlace(F, nn(n.A))
                if (g.IsErr(b.T)) {
                    return placeErr(F)
                }
                if (b.T.Id == g.Tt.Never.Id) {
                    return b
                }
                mut bt: Types.Type = b.T
                if (bt.Kind != Types.TKind.Struct && bt.Kind != Types.TKind.Class) {
                    g.Diag.Error(n.Pos, "type `${bt.Name}` has no field `${n.Name}`")
                    return placeErr(F)
                }
                Gen.EnsureMembers(g, bt)
                let idx: I64 = findFieldIdx(bt, n.Name)
                if (idx < 0) {
                    match (Gen.FindMember(g, bt, n.Name)) {
                        Some(m) => g.Diag.Error(n.Pos, "`${n.Name}` is a method of `${bt.Name}`; call it with `()`"),
                        None => g.Diag.Error(n.Pos, "type `${bt.Name}` has no field `${n.Name}`"),
                    }
                    return placeErr(F)
                }
                if (!checkVis(F, bt, n.Name, n.Pos, "field")) {
                    return placeErr(F)
                }
                mut base: String = b.Ptr
                mut sll: String = ""
                if (bt.Kind == Types.TKind.Class) {
                    base = F.Tmp()
                    F.Emit("${base} = load ptr, ptr ${b.Ptr}")
                    sll = F.LlOf(objTuple(g, bt))
                } else {
                    sll = F.LlOf(bt)
                }
                let gep: String = F.Tmp()
                F.Emit("${gep} = getelementptr inbounds ${sll}, ptr ${base}, i32 0, i32 ${idx}")
                return Ctx.Place.New(gep, bt.Fields[idx].T, b.Mut)
            }
        },
        _ => {},
    }
    spill(F, genExpr(F, n, None))
}

fn genStringLit(mut F: Ctx.FnCtx, n: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (n.List.Len() == 0) {
        return strVal(F, Gen.StrConst(g, ""))
    }
    if (n.List.Len() == 1 && n.List[0].Kind == Ast.NK.StrLit) {
        return strVal(F, Gen.StrConst(g, n.List[0].Name))
    }
    // interpolation: build the result in a runtime string builder
    rtDecl(F, "zevic_sb_new", "declare ptr @zevic_sb_new()")
    rtDecl(F, "zevic_sb_add", "declare void @zevic_sb_add(ptr, ptr, i64)")
    rtDecl(F, "zevic_sb_finish", "declare void @zevic_sb_finish(ptr, ptr)")
    let sb: String = F.Tmp()
    F.Emit("${sb} = call ptr @zevic_sb_new()")
    for (part in n.List) {
        mut s: Ctx.Val = F.ErrVal()
        if (part.Kind == Ast.NK.StrLit) {
            s = strVal(F, Gen.StrConst(g, part.Name))
        } else {
            let v: Ctx.Val = genExpr(F, part, None)
            if (v.T.Id == g.Tt.Never.Id) {
                return F.NeverVal(Some(g.Tt.Str))
            }
            s = genToString(F, v, part.Pos)
        }
        let (p, len): (String, String) = strParts(F, s)
        F.Emit("call void @zevic_sb_add(ptr ${sb}, ptr ${p}, i64 ${len})")
    }
    callStrOut(F, "zevic_sb_finish", "ptr ${sb}")
}

fn thisType(F: Ctx.FnCtx) -> Types.Type {
    match (F.ThisT) {
        Some(t) => t,
        None => Panic("`this` type is missing"),
    }
}

fn fileModName(F: Ctx.FnCtx) -> String {
    match (F.File.Mod) {
        Some(m) => m.Name,
        None => "",
    }
}

// ---- enum variants ----

// `Some` and `None` belong to Option, `Ok` and `Err` to Result (both live in Zevic.Core).
fn preludeVariantOwner(F: Ctx.FnCtx, name: String) -> Option<Resolve.Decl> {
    if (name == "Some" || name == "None") {
        return Gen.LookupInPrelude(F.G, "Option")
    }
    if (name == "Ok" || name == "Err") {
        return Gen.LookupInPrelude(F.G, "Result")
    }
    None
}

fn findVariantNode(enumDecl: Ast.Node, name: String) -> Option<Ast.Node> {
    for (m in enumDecl.List) {
        if (m.Kind == Ast.NK.Variant && m.Name == name) {
            return Some(m)
        }
    }
    None
}

fn findVariant(t: Types.Type, name: String) -> Option<Types.Variant> {
    for (v in t.Variants) {
        if (v.Name == name) {
            return Some(v)
        }
    }
    None
}

fn sameDecl(g: Gen.Gen, t: Types.Type, d: Resolve.Decl) -> Bool {
    match (Gen.DeclOfType(g, t)) {
        Some(x) => x.Key() == d.Key(),
        None => false,
    }
}

// The type of a generic type's instance when it is known without looking at the arguments.
fn staticType(mut F: Ctx.FnCtx, d: Resolve.Decl, tnode: Option<Ast.Node>, expect: Option<Types.Type>) -> Option<Types.Type> {
    mut g: Gen.Gen = F.G
    let td: Ast.Node = d.Node
    if (td.List2.Len() == 0) {
        return Some(Gen.Instantiate(g, d, [], td.Pos))
    }
    match (tnode) {
        Some(tn) => {
            if (tn.List2.Len() > 0) {
                mut targs: Array<Types.Type> = []
                for (a in tn.List2) {
                    targs.Push(Gen.ResolveType(g, F.File, F.Env, a))
                }
                return Some(Gen.Instantiate(g, d, targs, tn.Pos))
            }
        },
        None => {},
    }
    match (expect) {
        Some(e) => {
            if (sameDecl(g, e, d)) {
                return Some(e)
            }
        },
        None => {},
    }
    None
}

fn isFnTParam(fnNode: Ast.Node, name: String) -> Bool {
    for (tp in fnNode.List2) {
        if (tp.Name == name) {
            return true
        }
    }
    false
}

// Does this type syntax mention a type parameter of `fn` that is not bound yet?
fn syntaxUsesUnbound(te: Ast.Node, fnNode: Ast.Node, env: Gen.Env) -> Bool {
    match (te.Kind) {
        Ast.NK.TypeName => {
            if (te.Path.Len() == 1 && isFnTParam(fnNode, te.Path[0]) && env.Get(te.Path[0]).IsNone()) {
                return true
            }
            for (a in te.List) {
                if (syntaxUsesUnbound(a, fnNode, env)) {
                    return true
                }
            }
            false
        },
        Ast.NK.TypeTuple | Ast.NK.TypeUnion => {
            for (a in te.List) {
                if (syntaxUsesUnbound(a, fnNode, env)) {
                    return true
                }
            }
            false
        },
        Ast.NK.TypeFn => {
            for (a in te.List) {
                if (syntaxUsesUnbound(a, fnNode, env)) {
                    return true
                }
            }
            syntaxUsesUnbound(nn(te.A), fnNode, env)
        },
        Ast.NK.TypePtr => syntaxUsesUnbound(nn(te.A), fnNode, env),
        _ => false,
    }
}

// Bind the type parameters in `te` by matching it against `actual`.
fn unify(g: Gen.Gen, te: Ast.Node, actual: Types.Type, fnNode: Ast.Node, mut env: Gen.Env) {
    if (g.IsErr(actual) || actual.Id == g.Tt.Never.Id) {
        return
    }
    match (te.Kind) {
        Ast.NK.TypeName => {
            if (te.Path.Len() == 1 && isFnTParam(fnNode, te.Path[0])) {
                if (env.Get(te.Path[0]).IsNone()) {
                    env.Add(te.Path[0], actual)
                }
                return
            }
            if (Gen.DeclOfType(g, actual).IsSome() && te.List.Len() == actual.Args.Len()) {
                mut i: I64 = 0
                while (i < te.List.Len()) {
                    unify(g, te.List[i], actual.Args[i], fnNode, env)
                    i += 1
                }
            }
        },
        Ast.NK.TypeTuple => {
            if (actual.Kind == Types.TKind.Tuple && actual.Args.Len() == te.List.Len()) {
                mut i: I64 = 0
                while (i < te.List.Len()) {
                    unify(g, te.List[i], actual.Args[i], fnNode, env)
                    i += 1
                }
            }
        },
        Ast.NK.TypeFn => {
            if (actual.Kind == Types.TKind.Fn && actual.Args.Len() == te.List.Len()) {
                mut i: I64 = 0
                while (i < te.List.Len()) {
                    unify(g, te.List[i], actual.Args[i], fnNode, env)
                    i += 1
                }
                match (actual.Ret) {
                    Some(r) => unify(g, nn(te.A), r, fnNode, env),
                    None => {},
                }
            }
        },
        Ast.NK.TypePtr => {
            if (actual.Kind == Types.TKind.Ptr) {
                unify(g, nn(te.A), actual.Args[0], fnNode, env)
            }
        },
        _ => {},
    }
}

// Build an aggregate value from already generated parts.
fn makeAggregate(mut F: Ctx.FnCtx, tt: Types.Type, vals: Array<Ctx.Val>) -> Ctx.Val {
    if (vals.Len() == 0) {
        return Ctx.Val.New(tt, "zeroinitializer")
    }
    mut acc: String = "undef"
    mut i: I64 = 0
    while (i < vals.Len()) {
        let v: Ctx.Val = vals[i]
        let r: String = F.Tmp()
        F.Emit("${r} = insertvalue ${F.LlOf(tt)} ${acc}, ${F.LlOf(v.T)} ${v.V}, ${i}")
        acc = r
        i += 1
    }
    Ctx.Val.New(tt, acc)
}

fn buildVariant(mut F: Ctx.FnCtx, et: Types.Type, v: Types.Variant, vals: Array<Ctx.Val>) -> Ctx.Val {
    let slot: String = F.NewSlot(et)
    F.Emit("store i32 ${v.Tag}, ptr ${tagPtr(F, et, slot)}")
    match (v.Payload) {
        Some(pl) => {
            if (vals.Len() > 0) {
                let pv: Ctx.Val = makeAggregate(F, pl, vals)
                F.Emit("store ${F.LlOf(pl)} ${pv.V}, ptr ${payloadPtr(F, et, slot)}")
            }
        },
        None => {},
    }
    let t: String = F.Tmp()
    F.Emit("${t} = load ${F.LlOf(et)}, ptr ${slot}")
    Ctx.Val.New(et, t)
}

// Shape.Circle(1.0), Some(x), None ... `call` is None for a variant without data.
fn genVariant(mut F: Ctx.FnCtx, call: Option<Ast.Node>, pos: Token.Pos, d: Resolve.Decl, etIn: Option<Types.Type>, vname: String, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let vn: Ast.Node = match (findVariantNode(d.Node, vname)) {
        Some(x) => x,
        None => {
            g.Diag.Error(pos, "enum `${d.Name}` has no variant `${vname}`")
            return F.ErrVal()
        },
    }
    let nf: I64 = if (vn.Flag) { vn.List2.Len() } else { vn.List.Len() }
    mut args: Array<Ast.Node> = []
    mut named: Bool = false
    match (call) {
        Some(c) => {
            args = c.List
            named = c.Flag2
        },
        None => {},
    }
    let nargs: I64 = args.Len()
    if (nf != nargs) {
        if (nf == 0) {
            g.Diag.Error(pos, "variant `${d.Name}.${vname}` has no data, so it is written without `(...)`")
        } else if (call.IsNone()) {
            g.Diag.Error(pos, "variant `${d.Name}.${vname}` needs ${nf} value(s): write `${d.Name}.${vname}(...)`")
        } else {
            g.Diag.Error(pos, "variant `${d.Name}.${vname}` takes ${nf} value(s), but ${nargs} were given")
        }
        return F.ErrVal()
    }
    if (vn.Flag && !(call.IsSome() && named)) {
        let first: String = if (vn.List2.Len() > 0) { vn.List2[0].Name } else { "Field" }
        g.Diag.Error(pos, "variant `${d.Name}.${vname}` has named fields: write `${d.Name}.${vname} { ${first}: ... }`")
        return F.ErrVal()
    }
    mut vals: Array<Ctx.Val> = []
    mut et: Types.Type = g.Err
    match (etIn) {
        None => {
            mut env: Gen.Env = Gen.Env.New()
            mut i: I64 = 0
            while (i < nargs) {
                let fte: Ast.Node = if (vn.Flag) { nn(vn.List2[i].A) } else { vn.List[i] }
                let pexp: Option<Types.Type> = if (syntaxUsesUnbound(fte, d.Node, env)) { None } else { Some(Gen.ResolveType(g, d.FileInfo(), env, fte)) }
                let v: Ctx.Val = genExpr(F, args[i], pexp)
                if (v.T.Id == g.Tt.Never.Id) {
                    return F.NeverVal(expect)
                }
                if (pexp.IsNone()) {
                    unify(g, fte, v.T, d.Node, env)
                }
                vals.Push(v)
                i += 1
            }
            mut targs: Array<Types.Type> = []
            mut k: I64 = 0
            while (k < d.Node.List2.Len()) {
                let tp: Ast.Node = d.Node.List2[k]
                mut t: Option<Types.Type> = env.Get(tp.Name)
                if (t.IsNone()) {
                    match (expect) {
                        Some(e) => {
                            if (sameDecl(g, e, d)) {
                                t = Some(e.Args[k])
                            }
                        },
                        None => {},
                    }
                }
                match (t) {
                    Some(x) => targs.Push(x),
                    None => {
                        g.Diag.Error(pos, "cannot infer the type parameter `${tp.Name}` of `${d.Name}` (add a type annotation)")
                        return F.ErrVal()
                    },
                }
                k += 1
            }
            et = Gen.Instantiate(g, d, targs, pos)
        },
        Some(e) => {
            et = e
            match (findVariant(e, vname)) {
                Some(v0) => {
                    mut i: I64 = 0
                    while (i < nargs) {
                        let v: Ctx.Val = genExpr(F, args[i], Some(v0.Fields[i].T))
                        if (v.T.Id == g.Tt.Never.Id) {
                            return F.NeverVal(expect)
                        }
                        vals.Push(v)
                        i += 1
                    }
                },
                None => {},
            }
        },
    }
    let var: Types.Variant = match (findVariant(et, vname)) {
        Some(x) => x,
        None => return F.ErrVal(),
    }
    mut i: I64 = 0
    while (i < nargs) {
        let f: Types.Field = var.Fields[i]
        let what: String = if (named) { "field `${f.Name}` of `${d.Name}.${vname}`" } else { "argument ${i + 1} of `${d.Name}.${vname}`" }
        let cv: Ctx.Val = coerce(F, args[i].Pos, vals[i], f.T, what)
        if (g.IsErr(cv.T)) {
            return F.ErrVal()
        }
        vals[i] = cv
        i += 1
    }
    buildVariant(F, et, var, vals)
}

// ---- arrays and struct literals ----

fn isArrayType(F: Ctx.FnCtx, t: Types.Type) -> Bool {
    if (t.Kind != Types.TKind.Class) {
        return false
    }
    match (Gen.LookupInPrelude(F.G, "Array")) {
        Some(d) => sameDecl(F.G, t, d),
        None => false,
    }
}

fn mkInt(pos: Token.Pos, v: U64) -> Ast.Node {
    mut n: Ast.Node = Ast.Node.New(Ast.NK.Int, pos)
    n.Ival = v
    n
}

// Call function `fname` of standard library module `module` with values that are already computed.
// They are parked in hidden variables so that the ordinary call code can be reused.
fn callStd(mut F: Ctx.FnCtx, modName: String, fname: String, pos: Token.Pos, args: Array<Ctx.Val>, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let d: Option<Resolve.Decl> = match (g.Pg.FindModule(modName)) {
        Some(m) => m.Decls.Get(fname),
        None => None,
    }
    match (d) {
        Some(dd) => {
            mut call: Ast.Node = Ast.Node.New(Ast.NK.Call, pos)
            call.A = Some(mkIdent(pos, fname))
            for (a in args) {
                let name: String = "$c${F.NTmp}"
                F.NTmp += 1
                let l: Ctx.Local = declareLocal(F, name, a.T, false, pos)
                if (a.T.Id != g.Tt.Unit.Id) {
                    F.StoreTo(a.T, a, l.Ptr)
                }
                call.List.Push(mkIdent(pos, name))
            }
            genCallDecl(F, call, dd, None, None, expect, None)
        },
        None => {
            g.Diag.Error(pos, "internal error: `${modName}.${fname}` is missing from the standard library")
            F.ErrVal()
        },
    }
}

// a[i]  ->  a.Index(i)
fn genIndexRead(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut call: Ast.Node = mkMethodCall(nn(n.A), "Index", n.Pos, n.B, None)
    call.Flag3 = true
    genExpr(F, call, expect)
}

// a[i] = v  ->  a.SetIndex(i, v);   a[i] += v  ->  a.SetIndex(i, a[i] + v)
fn genIndexAssign(mut F: Ctx.FnCtx, n: Ast.Node) {
    let target: Ast.Node = nn(n.A)
    mut value: Ast.Node = nn(n.B)
    if (n.Op != Token.Tk.Assign) {
        if (!isPureExpr(nn(target.A)) || !isPureExpr(nn(target.B))) {
            F.G.Diag.Error(n.Pos, "`${n.Op.Name()}` on an element needs a simple array and index (put them in variables first)")
            return
        }
        mut bin: Ast.Node = Ast.Node.New(Ast.NK.Binary, n.Pos)
        bin.Op = baseOp(n.Op)
        bin.A = Some(target)
        bin.B = n.B
        value = bin
    }
    mut call: Ast.Node = mkMethodCall(nn(target.A), "SetIndex", n.Pos, target.B, Some(value))
    call.Flag3 = true
    let unused: Ctx.Val = genExpr(F, call, None)
}

fn elemSize(mut F: Ctx.FnCtx, et: Types.Type) -> String {
    let g1: String = F.Tmp()
    let sz: String = F.Tmp()
    F.Emit("${g1} = getelementptr ${F.LlOf(et)}, ptr null, i32 1")
    F.Emit("${sz} = ptrtoint ptr ${g1} to i64")
    sz
}

fn elemPtr(mut F: Ctx.FnCtx, et: Types.Type, base: String, idx: String) -> String {
    let p: String = F.Tmp()
    F.Emit("${p} = getelementptr inbounds ${F.LlOf(et)}, ptr ${base}, i64 ${idx}")
    p
}

// [a, b, c]: fill a new buffer and wrap it in an Array object.
fn genArrayLit(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let cnt: I64 = n.List.Len()
    mut at: Types.Type = g.Err
    mut et: Types.Type = g.Err
    mut first: Option<Ctx.Val> = None
    mut fromExpect: Bool = false
    match (expect) {
        Some(e) => {
            if (isArrayType(F, e)) {
                at = e
                et = e.Args[0]
                fromExpect = true
            }
        },
        None => {},
    }
    if (!fromExpect) {
        if (cnt == 0) {
            g.Diag.Error(n.Pos, "an empty array `[]` needs a type from its context (write `let a: Array<I32> = []`)")
            return F.ErrVal()
        }
        let f0: Ctx.Val = genExpr(F, n.List[0], None)
        if (f0.T.Id == g.Tt.Never.Id) {
            return f0
        }
        if (g.IsErr(f0.T)) {
            mut i: I64 = 1
            while (i < cnt) {
                let unused: Ctx.Val = genExpr(F, n.List[i], None)
                i += 1
            }
            return F.ErrVal()
        }
        first = Some(f0)
        et = f0.T
        at = Gen.ArrayType(g, et)
        if (g.IsErr(at)) {
            return F.ErrVal()
        }
    }
    rtDecl(F, "zevic_alloc", "declare ptr @zevic_alloc(i64)")
    let bytes: String = F.Tmp()
    let buf: String = F.Tmp()
    F.Emit("${bytes} = mul i64 ${cnt}, ${elemSize(F, et)}")
    F.Emit("${buf} = call ptr @zevic_alloc(i64 ${bytes})")
    mut failed: Bool = false
    mut i: I64 = 0
    while (i < cnt) {
        let en: Ast.Node = n.List[i]
        mut v: Ctx.Val = F.ErrVal()
        match (first) {
            Some(f0) => {
                if (i == 0) {
                    v = f0
                } else {
                    v = genExpr(F, en, Some(et))
                }
            },
            None => { v = genExpr(F, en, Some(et)) },
        }
        v = coerce(F, en.Pos, v, et, "an array element")
        if (v.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(Some(at))
        }
        if (g.IsErr(v.T)) {
            failed = true
        } else if (et.Id != g.Tt.Unit.Id) {
            F.StoreTo(et, v, elemPtr(F, et, buf, "${i}"))
        }
        i += 1
    }
    if (failed) {
        return F.ErrVal()
    }
    Gen.EnsureMembers(g, at)
    let vt: Types.Type = objTuple(g, at)
    let obj: String = F.Tmp()
    F.Emit("${obj} = call ptr @zevic_alloc(i64 ${g.Tt.SizeOf(vt)})")
    let bi: I64 = findFieldIdx(at, "buf")
    let li: I64 = findFieldIdx(at, "len")
    let ci: I64 = findFieldIdx(at, "cap")
    if (bi < 0 || li < 0 || ci < 0) {
        g.Diag.Error(n.Pos, "internal error: Array in Core.zev must have the fields `buf`, `len` and `cap`")
        return F.ErrVal()
    }
    let gb: String = F.Tmp()
    let gl: String = F.Tmp()
    let gc: String = F.Tmp()
    F.Emit("${gb} = getelementptr inbounds ${F.LlOf(vt)}, ptr ${obj}, i32 0, i32 ${bi}")
    F.Emit("store ptr ${buf}, ptr ${gb}")
    F.Emit("${gl} = getelementptr inbounds ${F.LlOf(vt)}, ptr ${obj}, i32 0, i32 ${li}")
    F.Emit("store i64 ${cnt}, ptr ${gl}")
    F.Emit("${gc} = getelementptr inbounds ${F.LlOf(vt)}, ptr ${obj}, i32 0, i32 ${ci}")
    F.Emit("store i64 ${cnt}, ptr ${gc}")
    Ctx.Val.New(at, obj)
}

// Shape.Named { Field: value }
fn genStructLit(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    mut segs: Array<String> = []
    mut nodes: Array<Ast.Node> = []
    if (!flattenPath(nn(n.A), segs, nodes) || segs.Len() < 2) {
        g.Diag.Error(n.Pos, "`{ name: value }` can only follow an enum variant like `Shape.Named`")
        return F.ErrVal()
    }
    let (dOpt, used): (Option<Resolve.Decl>, I64) = Gen.FindDecl(g, F.File, segs, nn(n.A).Pos)
    if (used < 0) {
        return F.ErrVal()
    }
    mut vnOpt: Option<Ast.Node> = None
    match (dOpt) {
        Some(d) => {
            if (d.Node.Kind == Ast.NK.DEnum && used == segs.Len() - 1) {
                vnOpt = findVariantNode(d.Node, segs[used])
            }
        },
        None => {},
    }
    let vn: Ast.Node = match (vnOpt) {
        Some(x) => x,
        None => {
            g.Diag.Error(n.Pos, "`${Ast.PathJoin(segs, ".")}` is not an enum variant, so it cannot be built with `{ name: value }`")
            return F.ErrVal()
        },
    }
    let d: Resolve.Decl = match (dOpt) {
        Some(x) => x,
        None => return F.ErrVal(),
    }
    let vname: String = vn.Name
    if (!vn.Flag) {
        g.Diag.Error(n.Pos, "variant `${d.Name}.${vname}` has no named fields; write `${d.Name}.${vname}(...)`")
        return F.ErrVal()
    }
    mut call: Ast.Node = Ast.Node.New(Ast.NK.Call, n.Pos)
    call.Flag2 = true
    call.A = n.A
    mut ok: Bool = true
    for (declF in vn.List2) {
        mut given: Option<Ast.Node> = None
        for (gv in n.List) {
            if (gv.Name == declF.Name) {
                if (given.IsSome()) {
                    g.Diag.Error(gv.Pos, "field `${gv.Name}` is given twice")
                    ok = false
                } else {
                    given = Some(gv)
                }
            }
        }
        match (given) {
            Some(gv) => call.List.Push(nn(gv.B)),
            None => {
                g.Diag.Error(n.Pos, "variant `${d.Name}.${vname}` needs the field `${declF.Name}`")
                ok = false
            },
        }
    }
    for (gv in n.List) {
        mut known: Bool = false
        for (declF in vn.List2) {
            if (declF.Name == gv.Name) {
                known = true
            }
        }
        if (!known) {
            g.Diag.Error(gv.Pos, "variant `${d.Name}.${vname}` has no field `${gv.Name}`")
            ok = false
        }
    }
    if (!ok) {
        return F.ErrVal()
    }
    let t: Option<Types.Type> = staticType(F, d, Some(nodes[used - 1]), expect)
    genVariant(F, Some(call), n.Pos, d, t, vname, expect)
}

// ---- members: `Type.Variant`, `Type.StaticField`, `Module.CONST`, `x.Field` ----

fn findStaticField(g: Gen.Gen, t: Types.Type, name: String) -> Option<Ast.Node> {
    match (Gen.DeclNode(g, t)) {
        Some(td) => {
            for (m in td.List) {
                if (m.Kind == Ast.NK.Field && m.Flag && m.Name == name) {
                    return Some(m)
                }
            }
            None
        },
        None => None,
    }
}

fn genStaticMember(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    mut segs: Array<String> = []
    mut nodes: Array<Ast.Node> = []
    let unusedFlat: Bool = flattenPath(n, segs, nodes)
    mut used: I64 = 0
    mut dOpt: Option<Resolve.Decl> = None
    let selfDecl: Option<Resolve.Decl> = match (F.Env.SelfT) {
        Some(st) => Gen.DeclOfType(g, st),
        None => None,
    }
    if (segs[0] == "Self" && selfDecl.IsSome()) {
        dOpt = selfDecl
        used = 1
    } else {
        let (x, u): (Option<Resolve.Decl>, I64) = Gen.FindDecl(g, F.File, segs, n.Pos)
        dOpt = x
        used = u
    }
    if (used < 0) {
        return F.ErrVal()
    }
    let d: Resolve.Decl = match (dOpt) {
        Some(x) => x,
        None => {
            g.Diag.Error(n.Pos, "unknown name `${Ast.PathJoin(segs, ".")}`")
            return F.ErrVal()
        },
    }
    let dn: Ast.Node = d.Node
    if (dn.Kind == Ast.NK.DConst && used == segs.Len()) {
        let t: Types.Type = Gen.ResolveType(g, d.FileInfo(), Gen.MakeEnv(g, d, None, None), nn(dn.A))
        let v: Ctx.Val = genExpr(F, nn(dn.B), Some(t))
        return coerce(F, nn(dn.B).Pos, v, t, "a constant")
    }
    if ((dn.Kind == Ast.NK.DEnum || dn.Kind == Ast.NK.DStruct || dn.Kind == Ast.NK.DClass) && used == segs.Len() - 1) {
        let member: String = segs[used]
        let tnode: Ast.Node = nodes[used - 1]
        let t: Option<Types.Type> = if (segs[0] == "Self" && F.Env.SelfT.IsSome()) { F.Env.SelfT } else { staticType(F, d, Some(tnode), expect) }
        if (dn.Kind == Ast.NK.DEnum && findVariantNode(dn, member).IsSome()) {
            return genVariant(F, None, n.Pos, d, t, member, expect)
        }
        match (t) {
            Some(tt) => {
                match (findStaticField(g, tt, member)) {
                    Some(sf) => {
                        mut tenv: Gen.Env = Gen.Env.New()
                        tenv.SelfT = Some(tt)
                        mut i: I64 = 0
                        while (i < dn.List2.Len()) {
                            tenv.Add(dn.List2[i].Name, tt.Args[i])
                            i += 1
                        }
                        let ft: Types.Type = Gen.ResolveType(g, d.FileInfo(), tenv, nn(sf.A))
                        let osf: Resolve.FileInfo = F.File
                        let oe: Gen.Env = F.Env
                        let os: Option<Ctx.Scope> = F.Scope
                        F.File = d.FileInfo()
                        F.Env = tenv
                        F.Scope = Some(Ctx.Scope.New())
                        mut v: Ctx.Val = F.ErrVal()
                        match (sf.B) {
                            Some(init) => { v = genExpr(F, init, Some(ft)) },
                            None => {},
                        }
                        v = coerce(F, n.Pos, v, ft, "a static field")
                        F.File = osf
                        F.Env = oe
                        F.Scope = os
                        return v
                    },
                    None => {},
                }
                if (Gen.FindMember(g, tt, member).IsSome()) {
                    g.Diag.Error(n.Pos, "`${d.Name}.${member}` is a function; call it with `()`")
                    return F.ErrVal()
                }
            },
            None => {},
        }
        g.Diag.Error(n.Pos, "type `${d.Name}` has no member `${member}`")
        return F.ErrVal()
    }
    if (dn.Kind == Ast.NK.DFn && used == segs.Len()) {
        return fnValueOf(F, d, n.Pos)
    }
    g.Diag.Error(n.Pos, "`${Ast.PathJoin(segs, ".")}` cannot be used as a value here")
    F.ErrVal()
}

fn genMember(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    if (isStaticPath(F, n)) {
        return genStaticMember(F, n, expect)
    }
    let p: Ctx.Place = genPlace(F, n)
    if (p.T.Id == F.G.Tt.Never.Id) {
        return F.NeverVal(expect)
    }
    loadPlace(F, p)
}

// ---- calls of declared functions ----

// The pointer part of a string constant `{ ptr @x, i64 n }`.
fn constPtr(c: String) -> String { c.Slice(6, Text.IndexOf(c, ",").Unwrap()) }

// Attribute that makes a narrow C integer cross the call boundary the way a C compiler would.
fn cExtAttr(t: Types.Type) -> String {
    if (t.Kind != Types.TKind.CType || !Text.StartsWith(t.Ll, "i")) {
        return ""
    }
    if (t.Size >= 4) {
        return ""
    }
    if (t.Name == "CBool") {
        return " zeroext"
    }
    if (t.PayloadWords == 1) { " signext" } else { " zeroext" }
}

// A Zevic function value as a C function pointer: a wrapper with the plain C signature that calls the function
// with a null environment. Only a named function or a lambda that captures nothing can be passed.
fn cCallback(mut F: Ctx.FnCtx, v: Ctx.Val) -> Option<String> {
    mut g: Gen.Gen = F.G
    mut target: Option<String> = None
    let pre: String = "{ ptr @\"thunk."
    let post: String = "\", ptr null }"
    if (Text.StartsWith(v.V, pre) && Text.IndexOf(v.V, post).IsSome()) {
        target = Some(v.V.Slice(8, Text.IndexOf(v.V, post).Unwrap()))
    } else {
        target = g.Noenv.Get("${F.Inst.Name}:${v.V}")
    }
    let tg: String = match (target) {
        Some(x) => x,
        None => {
            g.Diag.Error(g.CallPos, "only a named function, or a lambda that captures nothing, can be passed to C as a callback")
            g.Diag.Note("wrap the data a callback needs in a `Handle` and pass its number instead")
            return None
        },
    }
    let wrapper: String = "cb.${tg}"
    if (g.Thunks.Get(wrapper).IsNone()) {
        g.Thunks.Set(wrapper, tg)
        let ft: Types.Type = v.T
        mut ps: String = ""
        mut cargs: String = ""
        mut i: I64 = 0
        while (i < ft.Args.Len()) {
            let pt: Types.Type = ft.Args[i]
            ps = "${ps}${if (i > 0) { ", " } else { "" }}${pt.Ll}${cExtAttr(pt)} %p${i}"
            cargs = "${cargs}, ${pt.Ll} %p${i}"
            i += 1
        }
        let r: Types.Type = match (ft.Ret) {
            Some(x) => x,
            None => g.Tt.Unit,
        }
        let isVoid: Bool = r.Id == g.Tt.Unit.Id || r.Id == g.Tt.Never.Id || (r.Kind == Types.TKind.CType && r.Name == "CVoid")
        let rl: String = if (isVoid) { "void" } else { r.Ll }
        let ra: String = if (isVoid) { "" } else { cExtAttr(r) }
        if (isVoid) {
            g.Funcs.Put("define void @\"${wrapper}\"(${ps}) {\nentry:\n  call void @\"${tg}\"(ptr null${cargs})\n  ret void\n}\n\n")
        } else {
            g.Funcs.Put("define${ra} ${rl} @\"${wrapper}\"(${ps}) {\nentry:\n  %r = call ${rl} @\"${tg}\"(ptr null${cargs})\n  ret ${rl} %r\n}\n\n")
        }
    }
    Some("@\"${wrapper}\"")
}

// A call to an `extern "C"` function.
fn emitCCall(mut F: Ctx.FnCtx, inst: Gen.Inst, args: Array<Ctx.Val>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    mut a: String = ""
    mut ptypes: String = ""
    let ret: Types.Type = inst.Ret
    mut variadic: Bool = false
    for (p in inst.D.Node.List) {
        if (p.Flag3) {
            variadic = true
        }
    }
    mut i: I64 = 0
    while (i < args.Len()) {
        let v: Ctx.Val = args[i]
        if (i > 0) {
            a = "${a}, "
        }
        let attr: String = cExtAttr(v.T)
        mut ll: String = F.LlOf(v.T)
        mut vv: String = v.V
        if (v.T.Kind == Types.TKind.Fn) {
            match (cCallback(F, v)) {
                Some(cb) => {
                    vv = cb
                    ll = "ptr"
                },
                None => return F.ErrVal(),
            }
        }
        a = "${a}${ll}${attr} ${vv}"
        if (i < inst.Ptypes.Len()) {
            if (i > 0) {
                ptypes = "${ptypes}, "
            }
            ptypes = "${ptypes}${ll}${attr}"
        }
        i += 1
    }
    if (variadic) {
        ptypes = if (ptypes.Len() > 0) { "${ptypes}, ..." } else { "..." }
    }
    let isVoid: Bool = ret.Id == g.Tt.Unit.Id || ret.Id == g.Tt.Never.Id
    let rl: String = if (isVoid) { "void" } else { F.LlOf(ret) }
    let rattr: String = if (isVoid) { "" } else { cExtAttr(ret) }
    Gen.Declare(g, inst.Name, "declare${rattr} ${rl} @${inst.Name}(${ptypes})")
    // a variadic callee is called through its full function type
    let fty: String = if (variadic) { " ${rl} (${ptypes})" } else { " ${rl}" }
    if (isVoid) {
        F.Emit("call${fty} @${inst.Name}(${a})")
        return F.UnitVal()
    }
    let t: String = F.Tmp()
    F.Emit("${t} = call${rattr}${fty} @${inst.Name}(${a})")
    Ctx.Val.New(ret, t)
}

// Emit a direct call to a function instance.
fn emitCall(mut F: Ctx.FnCtx, inst: Gen.Inst, args: Array<Ctx.Val>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let ret: Types.Type = inst.Ret
    let abi: String = inst.D.Abi
    let zevicAbi: Bool = inst.IsExtern && abi == "zevic"
    let cAbi: Bool = inst.IsExtern && abi == "C"
    if (cAbi) {
        return emitCCall(F, inst, args)
    }
    if (!inst.IsExtern && inst.D.ModName == "Zevic.Test" && F.Inst.D.ModName != "Zevic.Test") {
        // an assertion reports the line of the call, not a line inside the library
        rtDecl(F, "zevic_test_at", "declare void @zevic_test_at(ptr, i32)")
        let fc: String = Gen.StrConst(g, g.Diag.Name(g.CallPos.File))
        F.Emit("call void @zevic_test_at(ptr ${constPtr(fc)}, i32 ${g.CallPos.Line})")
    }
    if (inst.IsExtern && !zevicAbi) {
        g.Diag.Error(inst.D.Node.Pos, "`extern \"${abi}\"` functions are not supported yet")
        return F.ErrVal()
    }
    let isStr: Bool = ret.Id == g.Tt.Str.Id
    let noValue: Bool = isStr || ret.Id == g.Tt.Unit.Id || ret.Id == g.Tt.Never.Id
    mut a: String = ""
    if (zevicAbi) {
        mut ptypes: String = ""
        mut slot: String = ""
        if (isStr) {
            slot = F.NewSlot(g.Tt.Str)
            a = "ptr ${slot}"
            ptypes = "ptr"
        }
        for (v in args) {
            if (v.T.Id == g.Tt.Unit.Id) {
                continue
            }
            if (a.Len() > 0) {
                a = "${a}, "
            }
            if (ptypes.Len() > 0) {
                ptypes = "${ptypes}, "
            }
            if (v.T.Id == g.Tt.Str.Id) {
                let (p, n): (String, String) = strParts(F, v)
                a = "${a}ptr ${p}, i64 ${n}"
                ptypes = "${ptypes}ptr, i64"
            } else {
                a = "${a}${F.LlOf(v.T)} ${v.V}"
                ptypes = "${ptypes}${F.LlOf(v.T)}"
            }
        }
        let rl: String = if (noValue) { "void" } else { F.LlOf(ret) }
        Gen.Declare(g, inst.Name, "declare ${rl} @${inst.Name}(${ptypes})")
        if (noValue) {
            F.Emit("call void @${inst.Name}(${a})")
            if (ret.Id == g.Tt.Never.Id) {
                F.Emit("unreachable")
                F.Term = true
                return F.NeverVal(None)
            }
            if (ret.Id == g.Tt.Unit.Id) {
                return F.UnitVal()
            }
            let t: String = F.Tmp()
            F.Emit("${t} = load { ptr, i64 }, ptr ${slot}")
            return Ctx.Val.New(g.Tt.Str, t)
        }
        let t: String = F.Tmp()
        F.Emit("${t} = call ${F.LlOf(ret)} @${inst.Name}(${a})")
        return Ctx.Val.New(ret, t)
    }
    mut i: I64 = 0
    while (i < args.Len()) {
        if (i > 0) {
            a = "${a}, "
        }
        a = "${a}${F.LlOf(args[i].T)} ${args[i].V}"
        i += 1
    }
    if (ret.Id == g.Tt.Unit.Id || ret.Id == g.Tt.Never.Id) {
        F.Emit("call void @\"${inst.Name}\"(${a})")
        if (ret.Id == g.Tt.Never.Id) {
            F.Emit("unreachable")
            F.Term = true
            return F.NeverVal(None)
        }
        return F.UnitVal()
    }
    let t: String = F.Tmp()
    F.Emit("${t} = call ${F.LlOf(ret)} @\"${inst.Name}\"(${a})")
    Ctx.Val.New(ret, t)
}

// Call function `d` with the arguments of `call`, inferring generic arguments.
fn genCallDecl(mut F: Ctx.FnCtx, callIn: Ast.Node, d: Resolve.Decl, self: Option<Types.Type>, explicit: Option<Array<Ast.Node>>, expect: Option<Types.Type>, recv: Option<Ctx.Val>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let fnNode: Ast.Node = d.Node
    mut call: Ast.Node = callIn
    let ntp: I64 = fnNode.List2.Len()
    mut env: Gen.Env = Gen.MakeEnv(g, d, self, None)
    match (explicit) {
        Some(ex) => {
            if (ex.Len() > 0) {
                if (ex.Len() != ntp) {
                    g.Diag.Error(call.Pos, "`${fnNode.Name}` takes ${ntp} type argument(s), found ${ex.Len()}")
                    return F.ErrVal()
                }
                mut i: I64 = 0
                while (i < ntp) {
                    env.Add(fnNode.List2[i].Name, Gen.ResolveType(g, F.File, F.Env, ex[i]))
                    i += 1
                }
            }
        },
        None => {},
    }
    // `params xs: Array<T>`: the values at the end of the call are collected into an array
    mut pi: I64 = 0
    while (pi < fnNode.List.Len()) {
        let pm: Ast.Node = fnNode.List[pi]
        if (pm.Flag2 && pi != fnNode.List.Len() - 1) {
            g.Diag.Error(pm.Pos, "only the last parameter can be `params`")
            return F.ErrVal()
        }
        pi += 1
    }
    if (fnNode.List.Len() > 0 && fnNode.List[fnNode.List.Len() - 1].Flag2) {
        let fixed: I64 = fnNode.List.Len() - 1
        if (call.List.Len() < fixed) {
            g.Diag.Error(call.Pos, "`${fnNode.Name}` takes at least ${fixed} argument(s), but ${call.List.Len()} were given")
            return F.ErrVal()
        }
        mut packed: Ast.Node = call.Copy()
        packed.List = []
        mut arr: Ast.Node = Ast.Node.New(Ast.NK.Array, call.Pos)
        mut i: I64 = 0
        while (i < call.List.Len()) {
            if (i < fixed) {
                packed.List.Push(call.List[i])
            } else {
                arr.List.Push(call.List[i])
            }
            i += 1
        }
        packed.List.Push(arr)
        call = packed
    }
    mut nparams: I64 = 0
    for (pm in fnNode.List) {
        if (!pm.Flag3) {
            nparams += 1
        }
    }
    let variadic: Bool = nparams < fnNode.List.Len()
    if (if (variadic) { call.List.Len() < nparams } else { call.List.Len() != nparams }) {
        g.Diag.Error(call.Pos, "`${fnNode.Name}` takes ${if (variadic) { "at least " } else { "" }}${nparams} argument(s), but ${call.List.Len()} were given")
        return F.ErrVal()
    }
    mut vals: Array<Ctx.Val> = []
    mut postponed: Array<Bool> = []
    mut k: I64 = 0
    while (k < nparams) {
        vals.Push(F.ErrVal())
        postponed.Push(false)
        k += 1
    }
    mut never: Bool = false
    // a bare number literal for a parameter whose type is still unknown (`Reduce(0, f)`) waits until the other
    // arguments have fixed the type parameters; it has no side effects, so the order does not matter
    mut pass: I64 = 0
    while (pass < 2) {
        mut i: I64 = 0
        while (i < nparams) {
            let pn: Ast.Node = fnNode.List[i]
            let an: Ast.Node = call.List[i]
            let unbound: Bool = syntaxUsesUnbound(nn(pn.A), fnNode, env)
            if (pass == 0 && unbound && isUntypedLit(an)) {
                postponed[i] = true
            } else if (pass == 1 && !postponed[i]) {
            } else {
                let pexp: Option<Types.Type> = if (unbound) { None } else { Some(Gen.ResolveType(g, d.FileInfo(), env, nn(pn.A))) }
                let v: Ctx.Val = genExpr(F, an, pexp)
                vals[i] = v
                if (v.T.Id == g.Tt.Never.Id) {
                    never = true
                } else if (pexp.IsNone()) {
                    unify(g, nn(pn.A), v.T, fnNode, env)
                }
            }
            i += 1
        }
        pass += 1
    }
    if (never) {
        return F.NeverVal(expect)
    }
    mut targs: Array<Types.Type> = []
    mut ti: I64 = 0
    while (ti < ntp) {
        let tp: Ast.Node = fnNode.List2[ti]
        mut t: Option<Types.Type> = env.Get(tp.Name)
        if (t.IsNone()) {
            match (expect) {
                Some(e) => {
                    match (fnNode.A) {
                        Some(ra) => {
                            unify(g, ra, e, fnNode, env)
                            t = env.Get(tp.Name)
                        },
                        None => {},
                    }
                },
                None => {},
            }
        }
        match (t) {
            Some(x) => targs.Push(x),
            None => {
                g.Diag.Error(call.Pos, "cannot infer the type parameter `${tp.Name}` of `${fnNode.Name}` (write it explicitly, like `${fnNode.Name}<I32>(...)`)")
                return F.ErrVal()
            },
        }
        ti += 1
    }
    if (ntp > 0) {
        Gen.CheckBounds(g, d.FileInfo(), fnNode, targs, Some(env), fnNode.Name, call.Pos)
    }
    let inst: Gen.Inst = Gen.GetInst(g, d, self, Some(targs))
    mut i: I64 = 0
    while (i < nparams) {
        mut what: String = "argument ${i + 1} of `${fnNode.Name}`"
        if (call.Flag3) {
            // written as `a[i]` or `a[i] = v`
            what = if (fnNode.Name == "SetIndex" && i == 1) { "an assignment" } else { "an index" }
        }
        let cv: Ctx.Val = coerce(F, call.List[i].Pos, vals[i], inst.Ptypes[i], what)
        vals[i] = cv
        if (g.IsErr(cv.T)) {
            return F.ErrVal()
        }
        i += 1
    }
    let mut_i0: I64 = nparams
    mut j: I64 = mut_i0
    while (j < call.List.Len()) {
        // the `...` part: C types and pointers, promoted the way C does
        let an: Ast.Node = call.List[j]
        mut v: Ctx.Val = genExpr(F, an, None)
        if (v.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(expect)
        }
        if (g.IsErr(v.T)) {
            return F.ErrVal()
        }
        if (!Gen.IsCValueType(v.T)) {
            g.Diag.Error(an.Pos, "argument ${j + 1} of `${fnNode.Name}` has type `${v.T.Name}`; the `...` part of a C function takes only C types and pointers")
            if (v.T.IsNumeric()) {
                g.Diag.Note("convert it with a method such as `.ToCInt()` or `.ToCDouble()`")
            } else if (v.T.Id == g.Tt.Str.Id) {
                g.Diag.Note("convert a String with `.ToC()`")
            }
            return F.ErrVal()
        }
        if (v.T.Kind == Types.TKind.CType && v.T.Ll == "float") {
            let r: String = F.Tmp()
            F.Emit("${r} = fpext float ${v.V} to double")
            v = Ctx.Val.New(nnT(g.Tt.CByName("CDouble")), r)
        } else if (v.T.Kind == Types.TKind.CType && Text.StartsWith(v.T.Ll, "i") && v.T.Size < 4) {
            let r: String = F.Tmp()
            let sgn: Bool = v.T.PayloadWords == 1 && v.T.Name != "CBool"
            F.Emit("${r} = ${if (sgn) { "sext" } else { "zext" }} ${v.T.Ll} ${v.V} to i32")
            v = Ctx.Val.New(nnT(g.Tt.CByName(if (sgn) { "CInt" } else { "CUInt" })), r)
        }
        vals.Push(v)
        j += 1
    }
    g.CallPos = call.Pos
    match (recv) {
        Some(r) => {
            // the receiver goes first
            mut all: Array<Ctx.Val> = [r]
            for (v in vals) {
                all.Push(v)
            }
            emitCall(F, inst, all)
        },
        None => emitCall(F, inst, vals),
    }
}

fn nnT(t: Option<Types.Type>) -> Types.Type {
    match (t) {
        Some(x) => x,
        None => Panic("type is missing"),
    }
}

// ---- built-in functions: Panic, Assert, NewString, Free, ObjPtr, String.FromC ----

fn emitPanicCall(mut F: Ctx.FnCtx, msg: Ctx.Val, pos: Token.Pos) {
    mut g: Gen.Gen = F.G
    Gen.Declare(g, "zevic_panic", "declare void @zevic_panic(ptr, i64, ptr, i32) noreturn")
    let (p, n): (String, String) = strParts(F, msg)
    let fc: String = Gen.StrConst(g, g.Diag.Name(pos.File))
    F.Emit("call void @zevic_panic(ptr ${p}, i64 ${n}, ptr ${constPtr(fc)}, i32 ${pos.Line})")
    F.Emit("unreachable")
    F.Term = true
}

fn genPanicBuiltin(mut F: Ctx.FnCtx, n: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (n.List.Len() != 1) {
        g.Diag.Error(n.Pos, "`Panic` takes one argument, the message")
        return F.ErrVal()
    }
    mut m: Ctx.Val = genExpr(F, n.List[0], Some(g.Tt.Str))
    m = coerce(F, n.List[0].Pos, m, g.Tt.Str, "the message of `Panic`")
    if (m.T.Id == g.Tt.Never.Id) {
        return m
    }
    if (g.IsErr(m.T)) {
        return F.ErrVal()
    }
    emitPanicCall(F, m, n.Pos)
    F.NeverVal(None)
}

fn genAssertBuiltin(mut F: Ctx.FnCtx, n: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (n.List.Len() != 2) {
        g.Diag.Error(n.Pos, "`Assert` takes two arguments: the condition and the message")
        return F.ErrVal()
    }
    mut c: Ctx.Val = genExpr(F, n.List[0], Some(g.Tt.Bool))
    c = coerce(F, n.List[0].Pos, c, g.Tt.Bool, "the condition of `Assert`")
    if (c.T.Id == g.Tt.Never.Id) {
        return c
    }
    if (g.IsErr(c.T)) {
        return F.ErrVal()
    }
    let fail: String = F.NewLabel("assert.fail")
    let ok: String = F.NewLabel("assert.ok")
    F.CondBr(c.V, ok, fail)
    F.StartBlock(fail)
    mut m: Ctx.Val = genExpr(F, n.List[1], Some(g.Tt.Str))
    m = coerce(F, n.List[1].Pos, m, g.Tt.Str, "the message of `Assert`")
    if (m.T.Id != g.Tt.Never.Id && !g.IsErr(m.T)) {
        emitPanicCall(F, m, n.Pos)
    } else if (!F.Term) {
        F.Emit("unreachable")
        F.Term = true
    }
    F.StartBlock(ok)
    F.UnitVal()
}

fn genStringFromC(mut F: Ctx.FnCtx, call: Ast.Node, lossy: Bool) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let fname: String = if (lossy) { "FromCLossy" } else { "FromC" }
    if (call.List.Len() != 1) {
        g.Diag.Error(call.Pos, "`String.${fname}` takes one argument (a `CString`)")
        return F.ErrVal()
    }
    let cs: Types.Type = nnT(g.Tt.CByName("CString"))
    mut c: Ctx.Val = genExpr(F, call.List[0], Some(cs))
    if (c.T.Id == g.Tt.Never.Id) {
        return c
    }
    if (g.IsErr(c.T)) {
        return F.ErrVal()
    }
    c = coerce(F, call.List[0].Pos, c, cs, "the argument")
    if (g.IsErr(c.T)) {
        return F.ErrVal()
    }
    Gen.Declare(g, "zevic_str_from_c", "declare i32 @zevic_str_from_c(ptr, ptr, i32)")
    let slot: String = F.NewSlot(g.Tt.Str)
    let ok: String = F.Tmp()
    F.Emit("${ok} = call i32 @zevic_str_from_c(ptr ${slot}, ptr ${c.V}, i32 ${if (lossy) { 1 } else { 0 }})")
    if (!lossy) {
        let bad: String = F.Tmp()
        let lb: String = F.NewLabel("fromc.bad")
        let lg: String = F.NewLabel("fromc.ok")
        F.Emit("${bad} = icmp eq i32 ${ok}, 0")
        F.Emit("br i1 ${bad}, label %${lb}, label %${lg}")
        F.StartBlock(lb)
        let msg: Ctx.Val = strVal(F, Gen.StrConst(g, "String.FromC: the C string is not valid UTF-8 (use String.FromCLossy)"))
        emitPanicCall(F, msg, call.Pos)
        F.StartBlock(lg)
    }
    let r: String = F.Tmp()
    F.Emit("${r} = load { ptr, i64 }, ptr ${slot}")
    Ctx.Val.New(g.Tt.Str, r)
}

// NewString(s): a copy of `s` in malloc'd memory that C may keep (and must free).
fn genNewString(mut F: Ctx.FnCtx, call: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (call.List.Len() != 1) {
        g.Diag.Error(call.Pos, "`NewString` takes one argument (a `String`)")
        return F.ErrVal()
    }
    mut s: Ctx.Val = genExpr(F, call.List[0], Some(g.Tt.Str))
    s = coerce(F, call.List[0].Pos, s, g.Tt.Str, "the argument of `NewString`")
    if (s.T.Id == g.Tt.Never.Id) {
        return s
    }
    if (g.IsErr(s.T)) {
        return F.ErrVal()
    }
    Gen.Declare(g, "zevic_new_cstring", "declare ptr @zevic_new_cstring(ptr, i64)")
    let (p, n): (String, String) = strParts(F, s)
    let r: String = F.Tmp()
    F.Emit("${r} = call ptr @zevic_new_cstring(ptr ${p}, i64 ${n})")
    Ctx.Val.New(nnT(g.Tt.CByName("CString")), r)
}

// Free(p): C's free, for memory from C or from NewString.
fn genFree(mut F: Ctx.FnCtx, call: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (call.List.Len() != 1) {
        g.Diag.Error(call.Pos, "`Free` takes one argument (a pointer or a `CString`)")
        return F.ErrVal()
    }
    let p: Ctx.Val = genExpr(F, call.List[0], None)
    if (p.T.Id == g.Tt.Never.Id) {
        return p
    }
    if (g.IsErr(p.T)) {
        return F.ErrVal()
    }
    if (p.T.Kind != Types.TKind.Ptr && p.T.Id != nnT(g.Tt.CByName("CString")).Id) {
        g.Diag.Error(call.List[0].Pos, "`Free` needs a pointer or a `CString`, found `${p.T.Name}`")
        return F.ErrVal()
    }
    Gen.Declare(g, "free", "declare void @free(ptr)")
    F.Emit("call void @free(ptr ${p.V})")
    F.UnitVal()
}

// ObjPtr(x) turns a class object into a C `void*`; PtrObj<T>(p) turns it back.
fn genObjPtr(mut F: Ctx.FnCtx, call: Ast.Node, d: Resolve.Decl, last: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let toPtr: Bool = d.Name == "ObjPtr"
    if (call.List.Len() != 1) {
        g.Diag.Error(call.Pos, "`${d.Name}` takes one argument")
        return F.ErrVal()
    }
    let voidp: Types.Type = g.Tt.Ptr(nnT(g.Tt.CByName("CVoid")))
    if (toPtr) {
        let x: Ctx.Val = genExpr(F, call.List[0], None)
        if (x.T.Id == g.Tt.Never.Id) {
            return x
        }
        if (g.IsErr(x.T)) {
            return F.ErrVal()
        }
        if (x.T.Kind != Types.TKind.Class) {
            g.Diag.Error(call.Pos, "`ObjPtr` needs a class value, found `${x.T.Name}`")
            return F.ErrVal()
        }
        return Ctx.Val.New(voidp, x.V)
    }
    mut p: Ctx.Val = genExpr(F, call.List[0], Some(voidp))
    p = coerce(F, call.List[0].Pos, p, voidp, "the argument of `PtrObj`")
    if (p.T.Id == g.Tt.Never.Id) {
        return p
    }
    if (g.IsErr(p.T)) {
        return F.ErrVal()
    }
    if (last.List2.Len() != 1) {
        g.Diag.Error(call.Pos, "`PtrObj` needs its type: `PtrObj<T>(p)`")
        return F.ErrVal()
    }
    let t: Types.Type = Gen.ResolveType(g, F.File, F.Env, last.List2[0])
    if (g.IsErr(t)) {
        return F.ErrVal()
    }
    if (t.Kind != Types.TKind.Class) {
        g.Diag.Error(call.Pos, "`PtrObj` can only produce a class, not `${t.Name}`")
        return F.ErrVal()
    }
    Ctx.Val.New(t, p.V)
}

// ---- calling function values, methods and `Type.Function(...)` ----

fn genCallValue(mut F: Ctx.FnCtx, call: Ast.Node, f: Ctx.Val, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let ft: Types.Type = f.T
    if (call.List.Len() != ft.Args.Len()) {
        g.Diag.Error(call.Pos, "this function value takes ${ft.Args.Len()} argument(s), but ${call.List.Len()} were given")
        for (a in call.List) {
            let unused: Ctx.Val = genExpr(F, a, None)
        }
        return F.ErrVal()
    }
    mut args: String = ""
    mut never: Bool = false
    mut i: I64 = 0
    while (i < ft.Args.Len()) {
        let pt: Types.Type = ft.Args[i]
        mut v: Ctx.Val = genExpr(F, call.List[i], Some(pt))
        if (v.T.Id == g.Tt.Never.Id) {
            never = true
        } else {
            v = coerce(F, call.List[i].Pos, v, pt, "argument ${i + 1} of a function value")
            if (g.IsErr(v.T)) {
                return F.ErrVal()
            }
            args = "${args}, ${F.LlOf(pt)} ${v.V}"
        }
        i += 1
    }
    if (never) {
        return F.NeverVal(expect)
    }
    let fp: String = F.Tmp()
    let env: String = F.Tmp()
    F.Emit("${fp} = extractvalue { ptr, ptr } ${f.V}, 0")
    F.Emit("${env} = extractvalue { ptr, ptr } ${f.V}, 1")
    let ret: Types.Type = match (ft.Ret) {
        Some(r) => r,
        None => g.Tt.Unit,
    }
    if (ret.Id == g.Tt.Unit.Id || ret.Id == g.Tt.Never.Id) {
        F.Emit("call void ${fp}(ptr ${env}${args})")
        if (ret.Id == g.Tt.Never.Id) {
            F.Emit("unreachable")
            F.Term = true
            return F.NeverVal(expect)
        }
        return F.UnitVal()
    }
    let r: String = F.Tmp()
    F.Emit("${r} = call ${F.LlOf(ret)} ${fp}(ptr ${env}${args})")
    Ctx.Val.New(ret, r)
}

fn genArgsForErrors(mut F: Ctx.FnCtx, call: Ast.Node) {
    for (a in call.List) {
        let unused: Ctx.Val = genExpr(F, a, None)
    }
}

// `42.ToCInt()`: an unsuffixed literal receiver takes the C type's own width, so the conversion cannot fail.
fn literalCTarget(mut g: Gen.Gen, recv: Ast.Node, name: String) -> Option<Types.Type> {
    mut lit: Ast.Node = recv
    if (lit.Kind == Ast.NK.Unary) {
        match (lit.A) {
            Some(x) => {
                if (x.Kind == Ast.NK.Int) {
                    lit = x
                }
            },
            None => {},
        }
    }
    if (lit.Kind != Ast.NK.Int && lit.Kind != Ast.NK.Float) {
        return None
    }
    if (lit.Suffix != "") {
        return None
    }
    if (!Text.StartsWith(name, "To")) {
        return None
    }
    let c: Option<Types.Type> = g.Tt.CByName(name.Slice(2, name.Len()))
    match (c) {
        Some(ct) => cNative(g, ct),
        None => None,
    }
}

fn genUserMethod(mut F: Ctx.FnCtx, call: Ast.Node, p: Ctx.Place, recvNode: Ast.Node, name: String, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let t: Types.Type = p.T
    mut fnOpt: Option<Ast.Node> = Gen.FindMember(g, t, name)
    mut dflt: Option<Resolve.Decl> = None
    if (fnOpt.IsNone()) {
        let (dm, conflict): (Option<Gen.IMethod>, Bool) = Gen.FindDefault(g, t, name)
        match (dm) {
            Some(m) => {
                fnOpt = Some(m.Fn)
                dflt = Some(Gen.DefaultDecl(g, t, m))
            },
            None => {},
        }
    }
    if (fnOpt.IsNone() && call.Flag3) {
        g.Diag.Error(call.Pos, "a value of type `${t.Name}` cannot be indexed with `[]`")
        genArgsForErrors(F, call)
        return F.ErrVal()
    }
    let fnNode: Ast.Node = match (fnOpt) {
        Some(x) => x,
        None => {
            Gen.EnsureMembers(g, t)
            let idx: I64 = if (t.Kind == Types.TKind.Struct || t.Kind == Types.TKind.Class) { findFieldIdx(t, name) } else { -1 }
            if (idx >= 0 && t.Fields[idx].T.Kind == Types.TKind.Fn) {
                mut fm: Ast.Node = Ast.Node.New(Ast.NK.Member, call.Pos)
                fm.A = Some(recvNode)
                fm.SetName(name)
                let fv: Ctx.Val = genExpr(F, fm, None)
                if (fv.T.Id == g.Tt.Never.Id) {
                    return fv
                }
                if (g.IsErr(fv.T)) {
                    return F.ErrVal()
                }
                return genCallValue(F, call, fv, expect)
            }
            if (idx >= 0) {
                g.Diag.Error(call.Pos, "`${name}` is a field of `${t.Name}`, not a method")
            } else {
                g.Diag.Error(call.Pos, "type `${t.Name}` has no method `${name}`")
            }
            genArgsForErrors(F, call)
            return F.ErrVal()
        },
    }
    let tname: String = match (Gen.DeclOfType(g, t)) {
        Some(dd) => dd.Name,
        None => t.Name,
    }
    if (name == "Init") {
        g.Diag.Error(call.Pos, "`Init` cannot be called directly; create values with `${tname}.New(...)`")
        return F.ErrVal()
    }
    if (!checkVis(F, t, name, call.Pos, "method")) {
        return F.ErrVal()
    }
    if (fnNode.IsStatic) {
        g.Diag.Error(call.Pos, "`${name}` is a static function; call it as `${tname}.${name}(...)`")
        return F.ErrVal()
    }
    if (fnNode.IsMutFn && !p.Mut && call.Flag3) {
        g.Diag.Error(call.Pos, "cannot assign to an element of `${rootName(recvNode)}` because it is not `mut`")
        g.Diag.Note("declare it with `mut ${rootName(recvNode)}: ${t.Name} = ...` to allow changes")
        return F.ErrVal()
    }
    if (fnNode.IsMutFn && !p.Mut) {
        if (recvNode.Kind == Ast.NK.This) {
            g.Diag.Error(call.Pos, "`mut fn ${name}` cannot be called here: `this` can only be changed inside a `mut fn` (or `Init`)")
        } else {
            g.Diag.Error(call.Pos, "cannot call `mut fn ${name}` because `${rootName(recvNode)}` is not `mut`")
        }
        return F.ErrVal()
    }
    mut recvV: String = p.Ptr
    if (t.Kind == Types.TKind.Class) {
        let o: String = F.Tmp()
        F.Emit("${o} = load ptr, ptr ${p.Ptr}")
        recvV = o
    }
    let recv: Ctx.Val = Ctx.Val.New(g.Tt.Ptr(g.Tt.U8), recvV)
    let md: Resolve.Decl = match (dflt) {
        Some(x) => x,
        None => Gen.MethodDecl(g, t, fnNode),
    }
    let explicit: Array<Ast.Node> = match (call.A) {
        Some(c) => c.List2,
        None => [],
    }
    genCallDecl(F, call, md, Some(t), Some(explicit), expect, Some(recv))
}

fn genMethodCall(mut F: Ctx.FnCtx, call: Ast.Node, recvNode: Ast.Node, name: String, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    match (literalCTarget(g, recvNode, name)) {
        Some(litT) => {
            let v: Ctx.Val = genExpr(F, recvNode, Some(litT))
            if (v.T.Id == g.Tt.Never.Id || g.IsErr(v.T)) {
                return v
            }
            return genPrimMethod(F, call, v, name, expect)
        },
        None => {},
    }
    let p: Ctx.Place = genPlace(F, recvNode)
    if (p.T.Id == g.Tt.Never.Id) {
        return F.NeverVal(expect)
    }
    if (g.IsErr(p.T)) {
        genArgsForErrors(F, call)
        return F.ErrVal()
    }
    if (p.T.Kind == Types.TKind.Iface) {
        return genIfaceMethod(F, call, p, recvNode, name, expect)
    }
    if (Gen.IsUserType(p.T)) {
        return genUserMethod(F, call, p, recvNode, name, expect)
    }
    let recv: Ctx.Val = loadPlace(F, p)
    if (recv.T.Kind == Types.TKind.Buf) {
        return genBufMethod(F, call, recv, name)
    }
    if (call.Flag3) {
        g.Diag.Error(call.Pos, "a value of type `${recv.T.Name}` cannot be indexed with `[]`")
        genArgsForErrors(F, call)
        return F.ErrVal()
    }
    genPrimMethod(F, call, recv, name, expect)
}

// Foo(...), Module.Foo(...), Type.Static(...), Type.New(...), Shape.Circle(...), and calls on values.
fn genCall(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let callee: Ast.Node = nn(n.A)
    if (callee.Kind == Ast.NK.Ident) {
        match (F.FindLocal(callee.Name)) {
            Some(fl) => {
                if (fl.T.Kind == Types.TKind.Fn) {
                    return genCallValue(F, n, F.LoadLocal(fl), expect)
                }
            },
            None => {},
        }
    }
    mut segs: Array<String> = []
    mut nodes: Array<Ast.Node> = []
    if (flattenPath(callee, segs, nodes)) {
        let head: String = segs[0]
        let valueHead: Bool = F.FindLocal(head).IsSome()
        if (!valueHead) {
            mut used: I64 = 0
            mut dOpt: Option<Resolve.Decl> = None
            let selfDecl: Option<Resolve.Decl> = match (F.Env.SelfT) {
                Some(st) => Gen.DeclOfType(g, st),
                None => None,
            }
            if (head == "Self" && selfDecl.IsSome()) {
                dOpt = selfDecl
                used = 1
            } else {
                let (x, u): (Option<Resolve.Decl>, I64) = Gen.FindDecl(g, F.File, segs, callee.Pos)
                dOpt = x
                used = u
            }
            if (used < 0) {
                return F.ErrVal()
            }
            match (dOpt) {
                Some(d) => {
                    let k: Ast.NK = d.Node.Kind
                    if ((k == Ast.NK.DStruct || k == Ast.NK.DClass || k == Ast.NK.DEnum) && used == segs.Len() - 1) {
                        let member: String = segs[used]
                        let tnode: Ast.Node = nodes[used - 1]
                        let lastn: Ast.Node = nodes[nodes.Len() - 1]
                        mut t: Option<Types.Type> = if (head == "Self") { F.Env.SelfT } else { staticType(F, d, Some(tnode), expect) }
                        if (t.IsNone() && d.Name == "Handle" && d.ModIsStd && member == "Get" && lastn.List2.Len() == 1) {
                            // Handle.Get<T>(id): the type argument written after `Get` is the class's
                            let ht: Types.Type = Gen.Instantiate(g, d, [Gen.ResolveType(g, F.File, F.Env, lastn.List2[0])], n.Pos)
                            match (Gen.FindMember(g, ht, "Get")) {
                                Some(gfn) => {
                                    if (g.IsErr(ht)) {
                                        return F.ErrVal()
                                    }
                                    return genCallDecl(F, n, Gen.MethodDecl(g, ht, gfn), Some(ht), None, expect, None)
                                },
                                None => return F.ErrVal(),
                            }
                        }
                        if (k == Ast.NK.DEnum && findVariantNode(d.Node, member).IsSome()) {
                            return genVariant(F, Some(n), n.Pos, d, t, member, expect)
                        }
                        if (member == "New") {
                            match (t) {
                                Some(tt) => return genConstruct(F, n, d, tt, expect),
                                None => {
                                    g.Diag.Error(n.Pos, "cannot infer the type arguments of `${d.Name}` (write `${d.Name}<...>.New(...)` or give the variable a type)")
                                    return F.ErrVal()
                                },
                            }
                        }
                        let fnOpt: Option<Ast.Node> = match (t) {
                            Some(tt) => Gen.FindMember(g, tt, member),
                            None => None,
                        }
                        match (fnOpt) {
                            Some(fnNode) => {
                                let tt: Types.Type = nnT(t)
                                if (fnNode.IsStatic) {
                                    if (!checkVis(F, tt, member, n.Pos, "function")) {
                                        return F.ErrVal()
                                    }
                                    return genCallDecl(F, n, Gen.MethodDecl(g, tt, fnNode), Some(tt), Some(lastn.List2), expect, None)
                                }
                                g.Diag.Error(n.Pos, "`${member}` is a method; call it on a value, like `value.${member}(...)`")
                                return F.ErrVal()
                            },
                            None => {},
                        }
                        if (t.IsNone()) {
                            g.Diag.Error(n.Pos, "cannot infer the type arguments of `${d.Name}`; write them like `${d.Name}<I32>.${member}(...)`")
                            return F.ErrVal()
                        }
                        g.Diag.Error(n.Pos, "type `${d.Name}` has no function `${member}`")
                        return F.ErrVal()
                    }
                    if (k == Ast.NK.DFn && used == segs.Len()) {
                        let last: Ast.Node = nodes[nodes.Len() - 1]
                        if (d.Abi == "intrinsic") {
                            if (d.Name == "Printf") {
                                return genPrintf(F, n, false)
                            }
                            if (d.Name == "Eprintf") {
                                return genPrintf(F, n, true)
                            }
                            if (d.Name == "ObjPtr" || d.Name == "PtrObj") {
                                return genObjPtr(F, n, d, last)
                            }
                            g.Diag.Error(n.Pos, "unknown intrinsic `${d.Name}`")
                            return F.ErrVal()
                        }
                        return genCallDecl(F, n, d, None, Some(last.List2), expect, None)
                    }
                    if (k == Ast.NK.DFn) {
                        g.Diag.Error(callee.Pos, "function `${d.Name}` has no member `${segs[used]}`")
                        return F.ErrVal()
                    }
                    if (k == Ast.NK.DInterface || k == Ast.NK.DExtern) {
                        g.Diag.Error(callee.Pos, "calling `${Ast.PathJoin(segs, ".")}` this way is not supported yet")
                        return F.ErrVal()
                    }
                },
                None => {
                    if (segs.Len() == 2 && head == "String" && (segs[1] == "FromC" || segs[1] == "FromCLossy")) {
                        return genStringFromC(F, n, segs[1] == "FromCLossy")
                    }
                    if (segs.Len() == 1) {
                        match (preludeVariantOwner(F, head)) {
                            Some(owner) => return genVariant(F, Some(n), n.Pos, owner, staticType(F, owner, None, expect), head, expect),
                            None => {},
                        }
                        if (head == "NewString") {
                            return genNewString(F, n)
                        }
                        if (head == "Free") {
                            return genFree(F, n)
                        }
                        if (head == "Panic") {
                            return genPanicBuiltin(F, n)
                        }
                        if (head == "Assert") {
                            return genAssertBuiltin(F, n)
                        }
                    }
                    // a type or constant followed by more names is a method call on a value; a lone name is unknown
                    if (callee.Kind == Ast.NK.Ident) {
                        g.Diag.Error(callee.Pos, "unknown function `${head}`")
                        return F.ErrVal()
                    }
                },
            }
        }
    }
    if (callee.Kind == Ast.NK.Member) {
        return genMethodCall(F, n, nn(callee.A), callee.Name, expect)
    }
    if (callee.Kind == Ast.NK.Call || callee.Kind == Ast.NK.Index || callee.Kind == Ast.NK.Lambda) {
        let f: Ctx.Val = genExpr(F, callee, None)
        if (f.T.Id == g.Tt.Never.Id) {
            return f
        }
        if (g.IsErr(f.T)) {
            return F.ErrVal()
        }
        if (f.T.Kind == Types.TKind.Fn) {
            return genCallValue(F, n, f, expect)
        }
        g.Diag.Error(callee.Pos, "a value of type `${f.T.Name}` cannot be called")
        return F.ErrVal()
    }
    g.Diag.Error(callee.Pos, "this expression cannot be called")
    F.ErrVal()
}

// ---- Buf, extern structs and `Type.New(...)` ----

fn genI64Arg(mut F: Ctx.FnCtx, a: Ast.Node, what: String) -> Ctx.Val {
    let v: Ctx.Val = genExpr(F, a, Some(F.G.Tt.I64))
    coerce(F, a.Pos, v, F.G.Tt.I64, what)
}

fn isExternStruct(g: Gen.Gen, t: Types.Type) -> Bool {
    if (t.Kind != Types.TKind.Struct) {
        return false
    }
    match (Gen.DeclOfType(g, t)) {
        Some(d) => d.Abi != "",
        None => false,
    }
}

// Buf<T>.New(capacity)
fn genBufNew(mut F: Ctx.FnCtx, call: Ast.Node, t: Types.Type) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (call.List.Len() != 1) {
        g.Diag.Error(call.Pos, "`Buf.New` takes the capacity")
        return F.ErrVal()
    }
    let cap: Ctx.Val = genI64Arg(F, call.List[0], "the capacity of `Buf.New`")
    if (cap.T.Id == g.Tt.Never.Id) {
        return F.NeverVal(Some(t))
    }
    if (g.IsErr(cap.T)) {
        return F.ErrVal()
    }
    let et: Types.Type = t.Args[0]
    let bytes: String = F.Tmp()
    let p: String = F.Tmp()
    F.Emit("${bytes} = mul i64 ${cap.V}, ${elemSize(F, et)}")
    rtDecl(F, "zevic_alloc", "declare ptr @zevic_alloc(i64)")
    F.Emit("${p} = call ptr @zevic_alloc(i64 ${bytes})")
    Ctx.Val.New(t, p)
}

fn genBufMethod(mut F: Ctx.FnCtx, call: Ast.Node, recv: Ctx.Val, name: String) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let et: Types.Type = recv.T.Args[0]
    let nargs: I64 = call.List.Len()
    let unit: Bool = et.Id == g.Tt.Unit.Id
    if (name == "Get" && nargs == 1) {
        let i: Ctx.Val = genI64Arg(F, call.List[0], "the index of `Buf.Get`")
        if (i.T.Id == g.Tt.Never.Id) {
            return i
        }
        if (g.IsErr(i.T)) {
            return F.ErrVal()
        }
        if (unit) {
            return F.UnitVal()
        }
        let gp: String = elemPtr(F, et, recv.V, i.V)
        let r: String = F.Tmp()
        F.Emit("${r} = load ${F.LlOf(et)}, ptr ${gp}")
        return Ctx.Val.New(et, r)
    }
    if (name == "Set" && nargs == 2) {
        let i: Ctx.Val = genI64Arg(F, call.List[0], "the index of `Buf.Set`")
        mut v: Ctx.Val = genExpr(F, call.List[1], Some(et))
        v = coerce(F, call.List[1].Pos, v, et, "the value of `Buf.Set`")
        if (i.T.Id == g.Tt.Never.Id || v.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(None)
        }
        if (g.IsErr(i.T) || g.IsErr(v.T)) {
            return F.ErrVal()
        }
        if (!unit) {
            F.StoreTo(et, v, elemPtr(F, et, recv.V, i.V))
        }
        return F.UnitVal()
    }
    if (name == "Copy" && nargs == 4) {
        mut src: Ctx.Val = genExpr(F, call.List[0], Some(recv.T))
        src = coerce(F, call.List[0].Pos, src, recv.T, "the source of `Buf.Copy`")
        let from: Ctx.Val = genI64Arg(F, call.List[1], "an argument of `Buf.Copy`")
        let to: Ctx.Val = genI64Arg(F, call.List[2], "an argument of `Buf.Copy`")
        let n: Ctx.Val = genI64Arg(F, call.List[3], "an argument of `Buf.Copy`")
        let nv: I32 = g.Tt.Never.Id
        if (src.T.Id == nv || from.T.Id == nv || to.T.Id == nv || n.T.Id == nv) {
            return F.NeverVal(None)
        }
        if (g.IsErr(src.T) || g.IsErr(from.T) || g.IsErr(to.T) || g.IsErr(n.T)) {
            return F.ErrVal()
        }
        let sp: String = elemPtr(F, et, src.V, from.V)
        let dp: String = elemPtr(F, et, recv.V, to.V)
        let bytes: String = F.Tmp()
        F.Emit("${bytes} = mul i64 ${n.V}, ${elemSize(F, et)}")
        Gen.Declare(g, "llvm.memmove.p0.p0.i64", "declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1 immarg)")
        F.Emit("call void @llvm.memmove.p0.p0.i64(ptr ${dp}, ptr ${sp}, i64 ${bytes}, i1 false)")
        return F.UnitVal()
    }
    if (name == "Ptr" && nargs == 0) {
        return Ctx.Val.New(g.Tt.Ptr(et), recv.V)
    }
    g.Diag.Error(call.Pos, "`Buf` has no method `${name}` that takes ${nargs} argument(s)")
    F.ErrVal()
}

// Point.New(x, y) for an `extern struct`: every field, in order.
fn genExternStructNew(mut F: Ctx.FnCtx, call: Ast.Node, d: Resolve.Decl, t: Types.Type) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    Gen.EnsureMembers(g, t)
    mut ok: Bool = true
    for (f in t.Fields) {
        if (g.IsErr(f.T) || Gen.IsCValueType(f.T) || isExternStruct(g, f.T)) {
            continue
        }
        g.Diag.Error(d.Node.Pos, "field `${f.Name}` of the extern struct `${d.Name}` has type `${f.T.Name}`; its fields must be C types, pointers or other extern structs")
        ok = false
    }
    if (!ok) {
        return F.ErrVal()
    }
    if (call.List.Len() != t.Fields.Len()) {
        g.Diag.Error(call.Pos, "`${d.Name}.New` takes ${t.Fields.Len()} argument(s) (one per field), but ${call.List.Len()} were given")
        return F.ErrVal()
    }
    let slot: String = F.NewSlot(t)
    F.Emit("store ${F.LlOf(t)} zeroinitializer, ptr ${slot}")
    mut i: I64 = 0
    while (i < t.Fields.Len()) {
        let f: Types.Field = t.Fields[i]
        mut v: Ctx.Val = genExpr(F, call.List[i], Some(f.T))
        v = coerce(F, call.List[i].Pos, v, f.T, "field `${f.Name}` of `${d.Name}`")
        if (v.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(None)
        }
        if (g.IsErr(v.T)) {
            return F.ErrVal()
        }
        let gep: String = F.Tmp()
        F.Emit("${gep} = getelementptr inbounds ${F.LlOf(t)}, ptr ${slot}, i32 0, i32 ${i}")
        F.StoreTo(f.T, v, gep)
        i += 1
    }
    let r: String = F.Tmp()
    F.Emit("${r} = load ${F.LlOf(t)}, ptr ${slot}")
    Ctx.Val.New(t, r)
}

// Type.New(args)
fn genConstruct(mut F: Ctx.FnCtx, call: Ast.Node, d: Resolve.Decl, t: Types.Type, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let td: Ast.Node = d.Node
    if (t.Kind == Types.TKind.Buf) {
        return genBufNew(F, call, t)
    }
    if (td.Kind == Ast.NK.DEnum) {
        let first: String = if (td.List.Len() > 0) { td.List[0].Name } else { "Variant" }
        g.Diag.Error(call.Pos, "an enum value is built with one of its variants, like `${d.Name}.${first}(...)`")
        return F.ErrVal()
    }
    if (d.Abi != "" && t.Kind == Types.TKind.Struct) {
        return genExternStructNew(F, call, d, t)
    }
    Gen.EnsureMembers(g, t)
    let isClass: Bool = t.Kind == Types.TKind.Class
    mut obj: String = ""
    let vt: Types.Type = if (isClass) { objTuple(g, t) } else { t }
    if (isClass) {
        rtDecl(F, "zevic_alloc", "declare ptr @zevic_alloc(i64)")
        obj = F.Tmp()
        F.Emit("${obj} = call ptr @zevic_alloc(i64 ${g.Tt.SizeOf(vt)})")
    } else {
        obj = F.NewSlot(t)
        F.Emit("store ${F.LlOf(t)} zeroinitializer, ptr ${obj}")
    }
    // field initial values, evaluated as the type's own code would
    mut tenv: Gen.Env = Gen.Env.New()
    tenv.SelfT = Some(t)
    mut ti: I64 = 0
    while (ti < td.List2.Len()) {
        tenv.Add(td.List2[ti].Name, t.Args[ti])
        ti += 1
    }
    let init: Option<Ast.Node> = Gen.FindMember(g, t, "Init")
    mut i: I64 = 0
    while (i < t.Fields.Len()) {
        let f: Types.Field = t.Fields[i]
        mut fdecl: Option<Ast.Node> = None
        for (m in td.List) {
            if (m.Kind == Ast.NK.Field && !m.Flag && m.Name == f.Name) {
                fdecl = Some(m)
            }
        }
        let initExpr: Option<Ast.Node> = match (fdecl) {
            Some(fd) => fd.B,
            None => None,
        }
        match (initExpr) {
            None => {
                if (init.IsNone()) {
                    g.Diag.Error(call.Pos, "`${t.Name}` has no `Init`, so every field needs an initial value (`${f.Name}` has none)")
                    return F.ErrVal()
                }
            },
            Some(ie) => {
                let sf: Resolve.FileInfo = F.File
                let se: Gen.Env = F.Env
                let ss: Option<Ctx.Scope> = F.Scope
                F.File = d.FileInfo()
                F.Env = tenv
                F.Scope = Some(Ctx.Scope.New())
                mut v: Ctx.Val = genExpr(F, ie, Some(f.T))
                v = coerce(F, ie.Pos, v, f.T, "a field initial value")
                F.File = sf
                F.Env = se
                F.Scope = ss
                if (!g.IsErr(v.T) && v.T.Id != g.Tt.Never.Id) {
                    let gep: String = F.Tmp()
                    F.Emit("${gep} = getelementptr inbounds ${F.LlOf(vt)}, ptr ${obj}, i32 0, i32 ${i}")
                    F.StoreTo(f.T, v, gep)
                }
            },
        }
        i += 1
    }
    match (init) {
        Some(initFn) => {
            let recv: Ctx.Val = Ctx.Val.New(g.Tt.Ptr(g.Tt.U8), obj)
            let md: Resolve.Decl = Gen.MethodDecl(g, t, initFn)
            if (initFn.IsStatic) {
                g.Diag.Error(initFn.Pos, "`Init` cannot be static")
                return F.ErrVal()
            }
            let r: Ctx.Val = genCallDecl(F, call, md, Some(t), None, None, Some(recv))
            if (g.IsErr(r.T) || r.T.Id == g.Tt.Never.Id) {
                return r
            }
        },
        None => {
            if (call.List.Len() > 0) {
                g.Diag.Error(call.Pos, "`${t.Name}` has no `Init`, so `New` takes no arguments")
                return F.ErrVal()
            }
        },
    }
    if (isClass) {
        return Ctx.Val.New(t, obj)
    }
    let v: String = F.Tmp()
    F.Emit("${v} = load ${F.LlOf(t)}, ptr ${obj}")
    Ctx.Val.New(t, v)
}

// ---- methods of the built-in types ----

fn intFits(from: Types.Type, to: Types.Type) -> Bool {
    let fb: I32 = from.Bits()
    let tb: I32 = to.Bits()
    if (from.IsSigned() == to.IsSigned()) {
        return tb >= fb
    }
    if (!from.IsSigned() && to.IsSigned()) {
        return tb > fb
    }
    false
}

fn castInt(mut F: Ctx.FnCtx, v: Ctx.Val, to: Types.Type) -> Ctx.Val {
    let fb: I32 = v.T.Bits()
    let tb: I32 = to.Bits()
    if (fb == tb) {
        return Ctx.Val.New(to, v.V)
    }
    let r: String = F.Tmp()
    if (tb < fb) {
        F.Emit("${r} = trunc ${F.LlOf(v.T)} ${v.V} to ${F.LlOf(to)}")
    } else {
        F.Emit("${r} = ${if (v.T.IsSigned()) { "sext" } else { "zext" }} ${F.LlOf(v.T)} ${v.V} to ${F.LlOf(to)}")
    }
    Ctx.Val.New(to, r)
}

fn pow2(n: I32) -> F64 {
    mut r: F64 = 1.0
    mut i: I32 = 0
    while (i < n) {
        r = r * 2.0
        i += 1
    }
    r
}

fn castFloatToInt(mut F: Ctx.FnCtx, v: Ctx.Val, to: Types.Type, pos: Token.Pos) -> Ctx.Val {
    let bits: I32 = to.Bits()
    let sgn: Bool = to.IsSigned()
    mut x: String = v.V
    if (v.T.Kind == Types.TKind.F32) {
        x = F.Tmp()
        F.Emit("${x} = fpext float ${v.V} to double")
    }
    let lo: F64 = if (sgn) { 0.0 - pow2(bits - 1) } else { 0.0 }
    let hi: F64 = pow2(if (sgn) { bits - 1 } else { bits })
    let c1: String = F.Tmp()
    let c2: String = F.Tmp()
    let both: String = F.Tmp()
    F.Emit("${c1} = fcmp oge double ${x}, ${doubleHex(lo)}")
    F.Emit("${c2} = fcmp olt double ${x}, ${doubleHex(hi)}")
    F.Emit("${both} = and i1 ${c1}, ${c2}")
    let ok: String = F.NewLabel("ok")
    let bad: String = coldPanic(F, "conversion from a decimal number is out of range (or NaN)", pos)
    F.CondBr(both, ok, bad)
    F.StartBlock(ok)
    let r: String = F.Tmp()
    F.Emit("${r} = ${if (sgn) { "fptosi" } else { "fptoui" }} double ${x} to ${F.LlOf(to)}")
    Ctx.Val.New(to, r)
}

fn castToFloat(mut F: Ctx.FnCtx, v: Ctx.Val, to: Types.Type) -> Ctx.Val {
    if (!v.T.IsInt() && v.T.Id == to.Id) {
        return v
    }
    let r: String = F.Tmp()
    if (v.T.IsInt()) {
        F.Emit("${r} = ${if (v.T.IsSigned()) { "sitofp" } else { "uitofp" }} ${F.LlOf(v.T)} ${v.V} to ${F.LlOf(to)}")
    } else {
        F.Emit("${r} = ${if (to.Kind == Types.TKind.F64) { "fpext" } else { "fptrunc" }} ${F.LlOf(v.T)} ${v.V} to ${F.LlOf(to)}")
    }
    Ctx.Val.New(to, r)
}

fn isCoreType(t: Types.Type, kind: Types.TKind, name: String) -> Bool {
    if (t.Kind != kind) {
        return false
    }
    t.DeclName == name
}

fn isResultType(t: Types.Type) -> Bool { isCoreType(t, Types.TKind.Enum, "Result") }

fn isOptionType(t: Types.Type) -> Bool { isCoreType(t, Types.TKind.Enum, "Option") }

fn isErrorType(t: Types.Type) -> Bool { isCoreType(t, Types.TKind.Class, "Error") }

// Result<A, E> with the same payload shape, relabelled as Result<B, E>.
fn retagResult(mut g: Gen.Gen, res: Types.Type, ok: Types.Type) -> Types.Type {
    match (Gen.DeclOfType(g, res)) {
        Some(d) => Gen.Instantiate(g, d, [ok, res.Args[1]], Token.Pos.New(0, 0, 0)),
        None => res,
    }
}

// the one argument of a call, evaluated as `t`
fn genArg1(mut F: Ctx.FnCtx, call: Ast.Node, t: Types.Type, what: String) -> Ctx.Val {
    let v: Ctx.Val = genExpr(F, call.List[0], Some(t))
    coerce(F, call.List[0].Pos, v, t, what)
}

fn isNeverOrErr(g: Gen.Gen, v: Ctx.Val) -> Bool { v.T.Id == g.Tt.Never.Id || g.IsErr(v.T) }

fn passUp(mut F: Ctx.FnCtx, v: Ctx.Val) -> Ctx.Val {
    if (v.T.Id == F.G.Tt.Never.Id) { v } else { F.ErrVal() }
}

// x.ToCInt(), c.ToI32(), c.ToCLong() ...: conversions between Zevic numbers and C numbers.
// Both sides are mapped to their Zevic equivalents, converted there, and the result relabelled.
fn genCConversion(mut F: Ctx.FnCtx, call: Ast.Node, recv: Ctx.Val, name: String, expect: Option<Types.Type>) -> Option<Ctx.Val> {
    mut g: Gen.Gen = F.G
    if (!Text.StartsWith(name, "To")) {
        return None
    }
    let src: Option<Types.Type> = cNative(g, recv.T)
    if (src.IsNone() && !recv.T.IsNumeric()) {
        return None
    }
    mut base: String = name.Slice(2, name.Len())
    mut wrap: Bool = false
    if (base.Len() > 4 && Text.EndsWith(base, "Wrap")) {
        wrap = true
        base = base.Slice(0, base.Len() - 4)
    }
    let toC: Option<Types.Type> = g.Tt.CByName(base)
    let toNative: Option<Types.Type> = match (toC) {
        Some(c) => cNative(g, c),
        None => None,
    }
    if (src.IsNone() && toNative.IsNone()) {
        return None
    }
    if (toC.IsSome() && toNative.IsNone()) {
        return None
    }
    let to: Types.Type = match (toNative) {
        Some(x) => x,
        None => match (g.Tt.PrimByName(base)) {
            Some(p) => p,
            None => return None,
        },
    }
    if (!to.IsNumeric()) {
        return None
    }
    let r: Ctx.Val = match (src) {
        Some(s) => Ctx.Val.New(s, recv.V),
        None => recv,
    }
    mut res: Ctx.Val = genPrimMethod(F, call, r, "To${to.Name}${if (wrap) { "Wrap" } else { "" }}", expect)
    if (g.IsErr(res.T) || res.T.Id == g.Tt.Never.Id) {
        return Some(res)
    }
    match (toC) {
        Some(c) => {
            if (isResultType(res.T)) {
                res = Ctx.Val.New(retagResult(g, res.T, c), res.V)
            } else {
                res = Ctx.Val.New(c, res.V)
            }
        },
        None => {},
    }
    Some(res)
}

// x.Equals(y), x.Compare(y), x.Hash() on the built-in types.
fn genBuiltinIfaceMethod(mut F: Ctx.FnCtx, call: Ast.Node, recv: Ctx.Val, name: String) -> Option<Ctx.Val> {
    mut g: Gen.Gen = F.G
    let t: Types.Type = recv.T
    let nargs: I64 = call.List.Len()
    if (name == "Hash") {
        if (nargs > 0 || !Gen.BuiltinSatisfies(t, "Hashable")) {
            return None
        }
        mut x: String = ""
        if (t.Kind == Types.TKind.Str) {
            let (p, n): (String, String) = strParts(F, recv)
            Gen.Declare(g, "zevic_str_hash", "declare i64 @zevic_str_hash(ptr, i64)")
            x = F.Tmp()
            F.Emit("${x} = call i64 @zevic_str_hash(ptr ${p}, i64 ${n})")
        } else {
            if (t.Kind == Types.TKind.Bool) {
                x = F.Tmp()
                F.Emit("${x} = zext i1 ${recv.V} to i64")
            } else if (t.Kind == Types.TKind.Char) {
                x = F.Tmp()
                F.Emit("${x} = zext i32 ${recv.V} to i64")
            } else if (t.Bits() == 64) {
                x = recv.V
            } else {
                x = F.Tmp()
                F.Emit("${x} = ${if (t.IsSigned()) { "sext" } else { "zext" }} ${F.LlOf(t)} ${recv.V} to i64")
            }
            Gen.Declare(g, "zevic_hash_u64", "declare i64 @zevic_hash_u64(i64)")
            let h: String = F.Tmp()
            F.Emit("${h} = call i64 @zevic_hash_u64(i64 ${x})")
            x = h
        }
        return Some(Ctx.Val.New(g.Tt.U64, x))
    }
    if (nargs != 1) {
        return None
    }
    let o: Ctx.Val = genArg1(F, call, t, "the argument")
    if (isNeverOrErr(g, o)) {
        return Some(passUp(F, o))
    }
    if (name == "Equals") {
        return Some(genCompare(F, Token.Tk.EqEq, recv, o, call.Pos))
    }
    if (!Gen.BuiltinSatisfies(t, "Comparable")) {
        return None
    }
    let lt: Ctx.Val = genCompare(F, Token.Tk.Lt, recv, o, call.Pos)
    let gt: Ctx.Val = genCompare(F, Token.Tk.Gt, recv, o, call.Pos)
    let a: String = F.Tmp()
    let b: String = F.Tmp()
    F.Emit("${a} = select i1 ${gt.V}, i32 1, i32 0")
    F.Emit("${b} = select i1 ${lt.V}, i32 -1, i32 ${a}")
    Some(Ctx.Val.New(g.Tt.I32, b))
}

fn genPrimMethod(mut F: Ctx.FnCtx, call: Ast.Node, recv: Ctx.Val, name: String, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let t: Types.Type = recv.T
    let nargs: I64 = call.List.Len()
    let isStr: Bool = t.Kind == Types.TKind.Str
    match (genCConversion(F, call, recv, name, expect)) {
        Some(v) => return v,
        None => {},
    }
    if (Gen.IsBuiltinValue(t) && (name == "Equals" || name == "Compare" || name == "Hash")) {
        match (genBuiltinIfaceMethod(F, call, recv, name)) {
            Some(v) => return v,
            None => {},
        }
    }
    if (isStr && name == "ToC") {
        if (nargs > 0) {
            g.Diag.Error(call.Pos, "`ToC` takes no arguments")
            return F.ErrVal()
        }
        // a String is always NUL-terminated, so its data pointer is a valid C string
        let (p, n): (String, String) = strParts(F, recv)
        return Ctx.Val.New(nnT(g.Tt.CByName("CString")), p)
    }
    if (name == "ToString") {
        if (nargs > 0) {
            g.Diag.Error(call.Pos, "`ToString` takes no arguments")
            return F.ErrVal()
        }
        return genToString(F, recv, call.Pos)
    }
    // Char <-> U32
    if (t.Kind == Types.TKind.Char && name == "ToU32" && nargs == 0) {
        return Ctx.Val.New(g.Tt.U32, recv.V)
    }
    if (t.Kind == Types.TKind.U32 && name == "ToCharUnchecked" && nargs == 0) {
        return Ctx.Val.New(g.Tt.Char, recv.V)
    }
    if (t.Kind == Types.TKind.U32 && name == "ToChar" && nargs == 0) {
        return callStd(F, "Zevic.Convert", "U32ToChar", call.Pos, [recv], expect)
    }
    // numeric conversions: ToI32, ToU8Wrap, ToF64, ...
    if (Text.StartsWith(name, "To") && t.IsNumeric()) {
        mut base: String = name.Slice(2, name.Len())
        mut wrap: Bool = false
        if (base.Len() > 4 && Text.EndsWith(base, "Wrap")) {
            wrap = true
            base = base.Slice(0, base.Len() - 4)
        }
        match (g.Tt.PrimByName(base)) {
            Some(to) => {
                if (to.IsNumeric()) {
                    if (nargs > 0) {
                        g.Diag.Error(call.Pos, "`${name}` takes no arguments")
                        return F.ErrVal()
                    }
                    if (to.IsFloat()) {
                        if (wrap) {
                            g.Diag.Error(call.Pos, "`${name}` does not exist (only integer conversions have a `Wrap` form)")
                            return F.ErrVal()
                        }
                        return castToFloat(F, recv, to)
                    }
                    if (t.IsInt()) {
                        if (wrap || intFits(t, to)) {
                            return castInt(F, recv, to)
                        }
                        // may not fit: the answer is a Result, computed by Zevic.Convert
                        return callStd(F, "Zevic.Convert", "${t.Name}To${to.Name}", call.Pos, [recv], expect)
                    }
                    if (wrap) {
                        g.Diag.Error(call.Pos, "`${name}` does not exist for `${t.Name}`")
                        return F.ErrVal()
                    }
                    return castFloatToInt(F, recv, to, call.Pos)
                }
            },
            None => {},
        }
    }
    // WrapAdd / WrapSub / WrapMul: arithmetic that wraps around instead of panicking
    if (t.IsInt() && (name == "WrapAdd" || name == "WrapSub" || name == "WrapMul")) {
        if (nargs != 1) {
            g.Diag.Error(call.Pos, "`${name}` takes one argument")
            return F.ErrVal()
        }
        let o: Ctx.Val = genArg1(F, call, t, "the argument")
        if (isNeverOrErr(g, o)) {
            return passUp(F, o)
        }
        let op: String = if (name == "WrapAdd") { "add" } else if (name == "WrapSub") { "sub" } else { "mul" }
        let r: String = F.Tmp()
        F.Emit("${r} = ${op} ${F.LlOf(t)} ${recv.V}, ${o.V}")
        return Ctx.Val.New(t, r)
    }
    if (t.IsInt() && (name == "Min" || name == "Max")) {
        if (nargs != 1) {
            g.Diag.Error(call.Pos, "`${name}` takes one argument")
            return F.ErrVal()
        }
        let o: Ctx.Val = genArg1(F, call, t, "the argument")
        if (isNeverOrErr(g, o)) {
            return passUp(F, o)
        }
        let c: String = F.Tmp()
        let r: String = F.Tmp()
        let sgn: Bool = t.IsSigned()
        let pred: String = if (name == "Min") { if (sgn) { "slt" } else { "ult" } } else { if (sgn) { "sgt" } else { "ugt" } }
        F.Emit("${c} = icmp ${pred} ${F.LlOf(t)} ${recv.V}, ${o.V}")
        F.Emit("${r} = select i1 ${c}, ${F.LlOf(t)} ${recv.V}, ${F.LlOf(t)} ${o.V}")
        return Ctx.Val.New(t, r)
    }
    // Min / Max / Clamp on decimal numbers (integers are handled above)
    if (t.IsFloat() && (name == "Min" || name == "Max") && nargs == 1) {
        let o: Ctx.Val = genArg1(F, call, t, "the argument")
        if (isNeverOrErr(g, o)) {
            return passUp(F, o)
        }
        let c: String = F.Tmp()
        let r: String = F.Tmp()
        F.Emit("${c} = fcmp ${if (name == "Min") { "olt" } else { "ogt" }} ${F.LlOf(t)} ${recv.V}, ${o.V}")
        F.Emit("${r} = select i1 ${c}, ${F.LlOf(t)} ${recv.V}, ${F.LlOf(t)} ${o.V}")
        return Ctx.Val.New(t, r)
    }
    if (t.IsNumeric() && name == "Clamp") {
        if (nargs != 2) {
            g.Diag.Error(call.Pos, "`Clamp` takes two arguments: the lowest and the highest value")
            return F.ErrVal()
        }
        mut lo: Ctx.Val = genExpr(F, call.List[0], Some(t))
        lo = coerce(F, call.List[0].Pos, lo, t, "the lowest value of `Clamp`")
        mut hi: Ctx.Val = genExpr(F, call.List[1], Some(t))
        hi = coerce(F, call.List[1].Pos, hi, t, "the highest value of `Clamp`")
        if (lo.T.Id == g.Tt.Never.Id || hi.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(Some(t))
        }
        if (g.IsErr(lo.T) || g.IsErr(hi.T)) {
            return F.ErrVal()
        }
        let fl: Bool = t.IsFloat()
        let sgn: Bool = t.IsSigned()
        let lt: String = if (fl) { "fcmp olt" } else if (sgn) { "icmp slt" } else { "icmp ult" }
        let gt: String = if (fl) { "fcmp ogt" } else if (sgn) { "icmp sgt" } else { "icmp ugt" }
        let ll: String = F.LlOf(t)
        let bad: String = F.Tmp()
        F.Emit("${bad} = ${gt} ${ll} ${lo.V}, ${hi.V}")
        let ok: String = F.NewLabel("ok")
        F.CondBr(bad, coldPanic(F, "Clamp: the lowest value is greater than the highest", call.Pos), ok)
        F.StartBlock(ok)
        let c1: String = F.Tmp()
        let m1: String = F.Tmp()
        let c2: String = F.Tmp()
        let m2: String = F.Tmp()
        F.Emit("${c1} = ${lt} ${ll} ${recv.V}, ${lo.V}")
        F.Emit("${m1} = select i1 ${c1}, ${ll} ${lo.V}, ${ll} ${recv.V}")
        F.Emit("${c2} = ${gt} ${ll} ${m1}, ${hi.V}")
        F.Emit("${m2} = select i1 ${c2}, ${ll} ${hi.V}, ${ll} ${m1}")
        return Ctx.Val.New(t, m2)
    }
    if (t.IsInt() && name == "Abs" && nargs == 0) {
        if (!t.IsSigned()) {
            return recv
        }
        let n: Ctx.Val = genIntArith(F, Token.Tk.Minus, Ctx.Val.New(t, "0"), recv, call.Pos)
        let r: String = F.Tmp()
        F.Emit("${r} = icmp slt ${F.LlOf(t)} ${recv.V}, 0")
        let sel: String = F.Tmp()
        F.Emit("${sel} = select i1 ${r}, ${F.LlOf(t)} ${n.V}, ${F.LlOf(t)} ${recv.V}")
        return Ctx.Val.New(t, sel)
    }
    if (t.IsFloat() && name == "Abs" && nargs == 0) {
        let intr: String = if (t.Kind == Types.TKind.F64) { "llvm.fabs.f64" } else { "llvm.fabs.f32" }
        Gen.Declare(g, intr, "declare ${F.LlOf(t)} @${intr}(${F.LlOf(t)})")
        let r: String = F.Tmp()
        F.Emit("${r} = call ${F.LlOf(t)} @${intr}(${F.LlOf(t)} ${recv.V})")
        return Ctx.Val.New(t, r)
    }
    if (t.IsFloat() && (name == "IsNaN" || name == "IsInf") && nargs == 0) {
        let r: String = F.Tmp()
        if (name == "IsNaN") {
            F.Emit("${r} = fcmp uno ${F.LlOf(t)} ${recv.V}, ${recv.V}")
        } else {
            let intr: String = if (t.Kind == Types.TKind.F64) { "llvm.fabs.f64" } else { "llvm.fabs.f32" }
            Gen.Declare(g, intr, "declare ${F.LlOf(t)} @${intr}(${F.LlOf(t)})")
            let a: String = F.Tmp()
            F.Emit("${a} = call ${F.LlOf(t)} @${intr}(${F.LlOf(t)} ${recv.V})")
            F.Emit("${r} = fcmp oeq ${F.LlOf(t)} ${a}, 0x7FF0000000000000")
        }
        return Ctx.Val.New(g.Tt.Bool, r)
    }
    if (isStr) {
        if (Text.StartsWith(name, "To") && nargs == 0) {
            match (g.Tt.PrimByName(name.Slice(2, name.Len()))) {
                Some(to) => {
                    if (to.IsNumeric()) {
                        return callStd(F, "Zevic.Convert", "StringTo${to.Name}", call.Pos, [recv], expect)
                    }
                },
                None => {},
            }
        }
        if (name == "Len" && nargs == 0) {
            let (p, n): (String, String) = strParts(F, recv)
            return Ctx.Val.New(g.Tt.I64, n)
        }
        if (name == "IsEmpty" && nargs == 0) {
            let (p, n): (String, String) = strParts(F, recv)
            let r: String = F.Tmp()
            F.Emit("${r} = icmp eq i64 ${n}, 0")
            return Ctx.Val.New(g.Tt.Bool, r)
        }
        if (name == "CharCount" && nargs == 0) {
            let (p, n): (String, String) = strParts(F, recv)
            rtDecl(F, "zevic_str_char_count", "declare i64 @zevic_str_char_count(ptr, i64)")
            let r: String = F.Tmp()
            F.Emit("${r} = call i64 @zevic_str_char_count(ptr ${p}, i64 ${n})")
            return Ctx.Val.New(g.Tt.I64, r)
        }
        if (name == "Slice" && nargs == 2) {
            // s.Slice(from, to): a copy of the bytes [from, to); both ends must be on character boundaries
            mut a: Ctx.Val = genExpr(F, call.List[0], Some(g.Tt.I64))
            a = coerce(F, call.List[0].Pos, a, g.Tt.I64, "the start of `Slice`")
            mut b: Ctx.Val = genExpr(F, call.List[1], Some(g.Tt.I64))
            b = coerce(F, call.List[1].Pos, b, g.Tt.I64, "the end of `Slice`")
            if (a.T.Id == g.Tt.Never.Id || b.T.Id == g.Tt.Never.Id) {
                return F.NeverVal(None)
            }
            if (g.IsErr(a.T) || g.IsErr(b.T)) {
                return F.ErrVal()
            }
            let (p, n): (String, String) = strParts(F, recv)
            rtDecl(F, "zevic_str_slice_ok", "declare i32 @zevic_str_slice_ok(ptr, i64, i64, i64)")
            rtDecl(F, "zevic_str_slice", "declare void @zevic_str_slice(ptr, ptr, i64, i64, i64)")
            let ok: String = F.Tmp()
            let bad: String = F.Tmp()
            F.Emit("${ok} = call i32 @zevic_str_slice_ok(ptr ${p}, i64 ${n}, i64 ${a.V}, i64 ${b.V})")
            F.Emit("${bad} = icmp eq i32 ${ok}, 0")
            let go: String = F.NewLabel("ok")
            F.CondBr(bad, coldPanic(F, "string slice out of range or not on character boundaries", call.Pos), go)
            F.StartBlock(go)
            let slot: String = F.NewSlot(g.Tt.Str)
            F.Emit("call void @zevic_str_slice(ptr ${slot}, ptr ${p}, i64 ${n}, i64 ${a.V}, i64 ${b.V})")
            let r: String = F.Tmp()
            F.Emit("${r} = load { ptr, i64 }, ptr ${slot}")
            return Ctx.Val.New(g.Tt.Str, r)
        }
        if (name == "ByteAt" && nargs == 1) {
            let i: Ctx.Val = genArg1(F, call, g.Tt.I64, "the argument of `ByteAt`")
            if (isNeverOrErr(g, i)) {
                return passUp(F, i)
            }
            let (p, n): (String, String) = strParts(F, recv)
            let bad: String = F.Tmp()
            F.Emit("${bad} = icmp uge i64 ${i.V}, ${n}")
            let ok: String = F.NewLabel("ok")
            F.CondBr(bad, coldPanic(F, "string index out of range", call.Pos), ok)
            F.StartBlock(ok)
            let gp: String = F.Tmp()
            let r: String = F.Tmp()
            F.Emit("${gp} = getelementptr inbounds i8, ptr ${p}, i64 ${i.V}")
            F.Emit("${r} = load i8, ptr ${gp}")
            return Ctx.Val.New(g.Tt.U8, r)
        }
    }
    g.Diag.Error(call.Pos, "type `${t.Name}` has no method `${name}` (or it takes different arguments)")
    F.ErrVal()
}

// ---- match ----

fn wildNode() -> Ast.Node { Ast.Node.New(Ast.NK.PWild, Token.Pos.New(0, 0, 0)) }

fn fieldPlace(mut F: Ctx.FnCtx, base: String, agg: Types.Type, idx: I64, ft: Types.Type, isMut: Bool) -> Ctx.Place {
    let gep: String = F.Tmp()
    F.Emit("${gep} = getelementptr inbounds ${F.LlOf(agg)}, ptr ${base}, i32 0, i32 ${idx}")
    Ctx.Place.New(gep, ft, isMut)
}

fn variantPatName(pat: Ast.Node) -> String { pat.Path[pat.Path.Len() - 1] }

fn isPreludeVariant(n: String) -> Bool { n == "Some" || n == "None" || n == "Ok" || n == "Err" }

// Resolve the variant a pattern names, checking its shape. None after an error.
fn patVariant(mut g: Gen.Gen, et: Types.Type, pat: Ast.Node) -> Option<Types.Variant> {
    if (et.Kind != Types.TKind.Enum) {
        g.Diag.Error(pat.Pos, "cannot match a value of type `${et.Name}` against the variant pattern `${Ast.PathJoin(pat.Path, ".")}`")
        return None
    }
    let vname: String = variantPatName(pat)
    let declName: String = match (Gen.DeclOfType(g, et)) {
        Some(d) => d.Name,
        None => et.Name,
    }
    if (pat.Path.Len() >= 2) {
        let tn: String = pat.Path[pat.Path.Len() - 2]
        if (tn != declName) {
            g.Diag.Error(pat.Pos, "the pattern `${Ast.PathJoin(pat.Path, ".")}` belongs to a different type than the matched value (`${et.Name}`)")
            return None
        }
    } else if (!isPreludeVariant(vname)) {
        if (findVariant(et, vname).IsSome()) {
            g.Diag.Error(pat.Pos, "write the variant with its type name, like `${declName}.${vname}` (only `Some`, `None`, `Ok` and `Err` can be written alone)")
        } else {
            g.Diag.Error(pat.Pos, "unknown variant `${vname}` of `${et.Name}`")
        }
        return None
    }
    let v: Types.Variant = match (findVariant(et, vname)) {
        Some(x) => x,
        None => {
            g.Diag.Error(pat.Pos, "type `${et.Name}` has no variant `${vname}`")
            return None
        },
    }
    let nf: I64 = v.Fields.Len()
    if (pat.Flag2) {
        if (!v.Named) {
            g.Diag.Error(pat.Pos, "variant `${v.Name}` has no named fields; write `${v.Name}(...)`")
            return None
        }
    } else if (v.Named) {
        g.Diag.Error(pat.Pos, "variant `${v.Name}` has named fields; match it with `${v.Name} { Name: pattern, .. }`")
        return None
    } else if (pat.List.Len() != nf) {
        if (nf == 0) {
            g.Diag.Error(pat.Pos, "variant `${v.Name}` has no data, so the pattern is written without `(...)`")
        } else {
            g.Diag.Error(pat.Pos, "variant `${v.Name}` has ${nf} value(s), but the pattern has ${pat.List.Len()}")
        }
        return None
    }
    Some(v)
}

fn variantPayload(v: Types.Variant) -> Types.Type {
    match (v.Payload) {
        Some(p) => p,
        None => Panic("variant without data"),
    }
}

fn patTest(mut F: Ctx.FnCtx, mut pat: Ast.Node, pl: Ctx.Place, fail: String) {
    mut g: Gen.Gen = F.G
    if (g.IsErr(pl.T)) {
        return
    }
    match (pat.Kind) {
        Ast.NK.PWild | Ast.NK.PBind => {},
        Ast.NK.PType => {
            if (pl.T.Kind != Types.TKind.Union) {
                g.Diag.Error(pat.Pos, "a type pattern needs a union to match on, but this is `${pl.T.Name}`")
                return
            }
            let mt: Types.Type = match (pat.Aux) {
                Some(x) => x,
                None => Gen.ResolveType(g, F.File, F.Env, nn(pat.A)),
            }
            if (g.IsErr(mt)) {
                return
            }
            let idx: I64 = unionIndex(pl.T, mt)
            if (idx < 0) {
                g.Diag.Error(nn(pat.A).Pos, "`${mt.Name}` is not a member of `${pl.T.Name}`")
                pat.Aux = Some(g.Err)
                return
            }
            pat.Aux = Some(mt)
            let tg: String = F.Tmp()
            let eq: String = F.Tmp()
            F.Emit("${tg} = load i32, ptr ${tagPtr(F, pl.T, pl.Ptr)}")
            F.Emit("${eq} = icmp eq i32 ${tg}, ${idx}")
            let ok: String = F.NewLabel("pat.type")
            F.CondBr(eq, ok, fail)
            F.StartBlock(ok)
        },
        Ast.NK.PLit => {
            let v: Ctx.Val = genExpr(F, nn(pat.A), Some(pl.T))
            if (g.IsErr(v.T) || v.T.Id == g.Tt.Never.Id) {
                return
            }
            if (v.T.Id != pl.T.Id) {
                F.TypeError(pat.Pos, pl.T, v.T, "a pattern")
                return
            }
            let cur: Ctx.Val = loadPlace(F, pl)
            let eq: Ctx.Val = genCompare(F, Token.Tk.EqEq, cur, v, pat.Pos)
            if (g.IsErr(eq.T)) {
                return
            }
            let ok: String = F.NewLabel("pat.ok")
            F.CondBr(eq.V, ok, fail)
            F.StartBlock(ok)
        },
        Ast.NK.PRange => {
            let lo: Ctx.Val = genExpr(F, nn(pat.A), Some(pl.T))
            let hi: Ctx.Val = genExpr(F, nn(pat.B), Some(pl.T))
            if (g.IsErr(lo.T) || g.IsErr(hi.T) || lo.T.Id == g.Tt.Never.Id || hi.T.Id == g.Tt.Never.Id) {
                return
            }
            if (lo.T.Id != pl.T.Id || hi.T.Id != pl.T.Id || !(pl.T.IsInt() || pl.T.Kind == Types.TKind.Char)) {
                g.Diag.Error(pat.Pos, "a range pattern needs integers or characters of the matched type (`${pl.T.Name}`)")
                return
            }
            let cur: Ctx.Val = loadPlace(F, pl)
            let c1: Ctx.Val = genCompare(F, Token.Tk.Ge, cur, lo, pat.Pos)
            let ok1: String = F.NewLabel("pat.lo")
            F.CondBr(c1.V, ok1, fail)
            F.StartBlock(ok1)
            let c2: Ctx.Val = genCompare(F, if (pat.Flag) { Token.Tk.Le } else { Token.Tk.Lt }, cur, hi, pat.Pos)
            let ok2: String = F.NewLabel("pat.hi")
            F.CondBr(c2.V, ok2, fail)
            F.StartBlock(ok2)
        },
        Ast.NK.PTuple => {
            if (pl.T.Kind != Types.TKind.Tuple) {
                g.Diag.Error(pat.Pos, "cannot match a value of type `${pl.T.Name}` against a tuple pattern")
                return
            }
            if (pl.T.Args.Len() != pat.List.Len()) {
                g.Diag.Error(pat.Pos, "the tuple pattern has ${pat.List.Len()} element(s), but the value has ${pl.T.Args.Len()}")
                return
            }
            mut i: I64 = 0
            while (i < pat.List.Len()) {
                patTest(F, pat.List[i], fieldPlace(F, pl.Ptr, pl.T, i, pl.T.Args[i], pl.Mut), fail)
                i += 1
            }
        },
        Ast.NK.POr => {
            let done: String = F.NewLabel("pat.or")
            mut i: I64 = 0
            while (i < pat.List.Len()) {
                let last: Bool = i == pat.List.Len() - 1
                let next: String = if (last) { fail } else { F.NewLabel("pat.alt") }
                patTest(F, pat.List[i], pl, next)
                if (!last) {
                    F.Br(done)
                    F.StartBlock(next)
                }
                i += 1
            }
            F.GotoBlock(done)
        },
        Ast.NK.PVariant => {
            let v: Types.Variant = match (patVariant(g, pl.T, pat)) {
                Some(x) => x,
                None => return,
            }
            let tg: String = F.Tmp()
            let eq: String = F.Tmp()
            F.Emit("${tg} = load i32, ptr ${tagPtr(F, pl.T, pl.Ptr)}")
            F.Emit("${eq} = icmp eq i32 ${tg}, ${v.Tag}")
            let ok: String = F.NewLabel("pat.tag")
            F.CondBr(eq, ok, fail)
            F.StartBlock(ok)
            if (v.Fields.Len() == 0) {
                return
            }
            let pp: String = payloadPtr(F, pl.T, pl.Ptr)
            let payload: Types.Type = variantPayload(v)
            if (pat.Flag2) {
                for (fp in pat.List2) {
                    mut idx: I64 = -1
                    mut k: I64 = 0
                    while (k < v.Fields.Len()) {
                        if (v.Fields[k].Name == fp.Name) {
                            idx = k
                        }
                        k += 1
                    }
                    if (idx < 0) {
                        g.Diag.Error(fp.Pos, "variant `${v.Name}` has no field `${fp.Name}`")
                    } else {
                        patTest(F, nn(fp.A), fieldPlace(F, pp, payload, idx, v.Fields[idx].T, pl.Mut), fail)
                    }
                }
                if (!pat.Flag3 && pat.List2.Len() < v.Fields.Len()) {
                    g.Diag.Error(pat.Pos, "the pattern does not mention every field of `${v.Name}`; add `..` to ignore the rest")
                }
            } else {
                mut i: I64 = 0
                while (i < pat.List.Len()) {
                    patTest(F, pat.List[i], fieldPlace(F, pp, payload, i, v.Fields[i].T, pl.Mut), fail)
                    i += 1
                }
            }
        },
        _ => g.Diag.Error(pat.Pos, "this pattern is not supported here"),
    }
}

fn patHasBinding(pat: Ast.Node) -> Bool {
    match (pat.Kind) {
        Ast.NK.PBind => true,
        Ast.NK.PType => pat.Name != "_",
        Ast.NK.PTuple | Ast.NK.POr | Ast.NK.PVariant => {
            for (p in pat.List) {
                if (patHasBinding(p)) {
                    return true
                }
            }
            for (fp in pat.List2) {
                if (patHasBinding(nn(fp.A))) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn patBind(mut F: Ctx.FnCtx, pat: Ast.Node, pl: Ctx.Place, isMut: Bool) {
    mut g: Gen.Gen = F.G
    if (g.IsErr(pl.T)) {
        return
    }
    match (pat.Kind) {
        Ast.NK.PBind => {
            let l: Ctx.Local = declareLocal(F, pat.Name, pl.T, isMut, pat.Pos)
            if (pl.T.Id != g.Tt.Unit.Id) {
                let v: Ctx.Val = loadPlace(F, pl)
                F.StoreTo(pl.T, v, l.Ptr)
            }
        },
        Ast.NK.PType => {
            match (pat.Aux) {
                Some(mt) => {
                    if (pl.T.Kind != Types.TKind.Union || pat.Name == "_") {
                        return
                    }
                    let l: Ctx.Local = declareLocal(F, pat.Name, mt, isMut, pat.Pos)
                    if (g.Tt.SizeOf(mt) > 0) {
                        let mp: Ctx.Place = Ctx.Place.New(payloadPtr(F, pl.T, pl.Ptr), mt, pl.Mut)
                        let v: Ctx.Val = loadPlace(F, mp)
                        F.StoreTo(mt, v, l.Ptr)
                    }
                },
                None => {},
            }
        },
        Ast.NK.PTuple => {
            if (pl.T.Kind != Types.TKind.Tuple || pl.T.Args.Len() != pat.List.Len()) {
                return
            }
            mut i: I64 = 0
            while (i < pat.List.Len()) {
                patBind(F, pat.List[i], fieldPlace(F, pl.Ptr, pl.T, i, pl.T.Args[i], pl.Mut), isMut)
                i += 1
            }
        },
        Ast.NK.POr => {
            for (p in pat.List) {
                if (patHasBinding(p)) {
                    g.Diag.Error(pat.Pos, "an `|` pattern cannot bind names (each alternative would bind different values)")
                    return
                }
            }
        },
        Ast.NK.PVariant => {
            if (pl.T.Kind != Types.TKind.Enum) {
                return
            }
            let v: Types.Variant = match (findVariant(pl.T, variantPatName(pat))) {
                Some(x) => x,
                None => return,
            }
            if (v.Fields.Len() == 0) {
                return
            }
            let pp: String = payloadPtr(F, pl.T, pl.Ptr)
            let payload: Types.Type = variantPayload(v)
            if (pat.Flag2) {
                for (fp in pat.List2) {
                    mut k: I64 = 0
                    while (k < v.Fields.Len()) {
                        if (v.Fields[k].Name == fp.Name) {
                            patBind(F, nn(fp.A), fieldPlace(F, pp, payload, k, v.Fields[k].T, pl.Mut), isMut)
                        }
                        k += 1
                    }
                }
            } else {
                mut i: I64 = 0
                while (i < pat.List.Len() && i < v.Fields.Len()) {
                    patBind(F, pat.List[i], fieldPlace(F, pp, payload, i, v.Fields[i].T, pl.Mut), isMut)
                    i += 1
                }
            }
        },
        _ => {},
    }
}

// ---- exhaustiveness: does this set of pattern rows cover every value? ----

fn patIsWild(p: Ast.Node) -> Bool { p.Kind == Ast.NK.PWild || p.Kind == Ast.NK.PBind }

fn rowWith(first: Array<Ast.Node>, rest: Array<Ast.Node>, skip: I64) -> Array<Ast.Node> {
    mut r: Array<Ast.Node> = []
    for (x in first) {
        r.Push(x)
    }
    mut i: I64 = skip
    while (i < rest.Len()) {
        r.Push(rest[i])
        i += 1
    }
    r
}

fn rowsCover(rowsIn: Array<Array<Ast.Node>>, tys: Array<Types.Type>) -> Bool {
    if (rowsIn.Len() == 0) {
        return false
    }
    if (tys.Len() == 0) {
        return true
    }
    let t: Types.Type = tys[0]
    // expand `a | b` in the first column into separate rows
    mut rows: Array<Array<Ast.Node>> = []
    for (r in rowsIn) {
        let p: Ast.Node = r[0]
        if (p.Kind == Ast.NK.POr) {
            for (alt in p.List) {
                rows.Push(rowWith([alt], r, 1))
            }
        } else {
            rows.Push(r)
        }
    }
    mut restTys: Array<Types.Type> = []
    mut ri: I64 = 1
    while (ri < tys.Len()) {
        restTys.Push(tys[ri])
        ri += 1
    }
    if (t.Kind == Types.TKind.Enum) {
        for (v in t.Variants) {
            mut nrows: Array<Array<Ast.Node>> = []
            for (r in rows) {
                let p: Ast.Node = r[0]
                mut sub: Array<Ast.Node> = []
                if (patIsWild(p)) {
                    for (f in v.Fields) {
                        sub.Push(wildNode())
                    }
                } else if (p.Kind == Ast.NK.PVariant && variantPatName(p) == v.Name) {
                    if (p.Flag2) {
                        for (f in v.Fields) {
                            mut sp: Ast.Node = wildNode()
                            for (fp in p.List2) {
                                if (f.Name == fp.Name) {
                                    sp = nn(fp.A)
                                }
                            }
                            sub.Push(sp)
                        }
                    } else {
                        mut k: I64 = 0
                        while (k < v.Fields.Len()) {
                            sub.Push(if (k < p.List.Len()) { p.List[k] } else { wildNode() })
                            k += 1
                        }
                    }
                } else {
                    continue
                }
                nrows.Push(rowWith(sub, r, 1))
            }
            mut ntys: Array<Types.Type> = []
            for (f in v.Fields) {
                ntys.Push(f.T)
            }
            for (x in restTys) {
                ntys.Push(x)
            }
            if (!rowsCover(nrows, ntys)) {
                return false
            }
        }
        return true
    }
    if (t.Kind == Types.TKind.Union) {
        for (m in t.Args) {
            mut nrows: Array<Array<Ast.Node>> = []
            for (r in rows) {
                let p: Ast.Node = r[0]
                let isThis: Bool = match (p.Aux) {
                    Some(a) => p.Kind == Ast.NK.PType && a.Id == m.Id,
                    None => false,
                }
                if (patIsWild(p) || isThis) {
                    nrows.Push(rowWith([], r, 1))
                }
            }
            if (!rowsCover(nrows, restTys)) {
                return false
            }
        }
        return true
    }
    if (t.Kind == Types.TKind.Tuple) {
        mut nrows: Array<Array<Ast.Node>> = []
        for (r in rows) {
            let p: Ast.Node = r[0]
            mut sub: Array<Ast.Node> = []
            if (patIsWild(p)) {
                for (a in t.Args) {
                    sub.Push(wildNode())
                }
            } else if (p.Kind == Ast.NK.PTuple) {
                mut k: I64 = 0
                while (k < t.Args.Len()) {
                    sub.Push(if (k < p.List.Len()) { p.List[k] } else { wildNode() })
                    k += 1
                }
            } else {
                continue
            }
            nrows.Push(rowWith(sub, r, 1))
        }
        mut ntys: Array<Types.Type> = []
        for (a in t.Args) {
            ntys.Push(a)
        }
        for (x in restTys) {
            ntys.Push(x)
        }
        return rowsCover(nrows, ntys)
    }
    if (t.Kind == Types.TKind.Bool) {
        mut b: I64 = 0
        while (b < 2) {
            mut nrows: Array<Array<Ast.Node>> = []
            for (r in rows) {
                let p: Ast.Node = r[0]
                mut take: Bool = patIsWild(p)
                if (p.Kind == Ast.NK.PLit && nn(p.A).Kind == Ast.NK.Bool && nn(p.A).Ival.ToI64Wrap() == b) {
                    take = true
                }
                if (take) {
                    nrows.Push(rowWith([], r, 1))
                }
            }
            if (!rowsCover(nrows, restTys)) {
                return false
            }
            b += 1
        }
        return true
    }
    // numbers, characters, strings: only a catch-all row covers everything
    mut nrows: Array<Array<Ast.Node>> = []
    for (r in rows) {
        if (patIsWild(r[0])) {
            nrows.Push(rowWith([], r, 1))
        }
    }
    rowsCover(nrows, restTys)
}

fn missingHint(mut g: Gen.Gen, t: Types.Type, rows: Array<Array<Ast.Node>>) -> Option<String> {
    if (t.Kind == Types.TKind.Union) {
        for (m in t.Args) {
            mut seen: Bool = false
            for (r in rows) {
                let p: Ast.Node = r[0]
                if (patIsWild(p) || (p.Kind == Ast.NK.PType && sameAux(p, m))) {
                    seen = true
                } else if (p.Kind == Ast.NK.POr) {
                    for (q in p.List) {
                        if (q.Kind == Ast.NK.PType && sameAux(q, m)) {
                            seen = true
                        }
                    }
                }
            }
            if (!seen) {
                return Some("`${m.Name}` is not handled")
            }
        }
    }
    // name one enum variant that no arm mentions, to make the message concrete
    if (t.Kind == Types.TKind.Enum) {
        let tn: String = match (Gen.DeclOfType(g, t)) {
            Some(d) => d.Name,
            None => t.Name,
        }
        for (v in t.Variants) {
            mut count: I64 = 0
            for (r in rows) {
                let p: Ast.Node = r[0]
                if (patIsWild(p) || (p.Kind == Ast.NK.PVariant && variantPatName(p) == v.Name)) {
                    count += 1
                } else if (p.Kind == Ast.NK.POr) {
                    for (q in p.List) {
                        if (q.Kind == Ast.NK.PVariant && variantPatName(q) == v.Name) {
                            count += 1
                        }
                    }
                }
            }
            if (count == 0) {
                return Some("`${tn}.${v.Name}` is not handled")
            }
        }
    }
    None
}

fn sameAux(p: Ast.Node, m: Types.Type) -> Bool {
    match (p.Aux) {
        Some(a) => a.Id == m.Id,
        None => false,
    }
}

// Resolve the types of the type patterns first: the exhaustiveness check looks at them before the arms are generated.
fn resolveTypePats(mut F: Ctx.FnCtx, pat: Option<Ast.Node>) {
    match (pat) {
        Some(p0) => {
            mut p: Ast.Node = p0
            if (p.Kind == Ast.NK.PType) {
                p.Aux = Some(Gen.ResolveType(F.G, F.File, F.Env, nn(p.A)))
            }
            for (x in p.List) {
                resolveTypePats(F, Some(x))
            }
            for (fp in p.List2) {
                resolveTypePats(F, fp.A)
            }
        },
        None => {},
    }
}

fn genMatch(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let sp: Ctx.Place = genPlace(F, nn(n.A))
    if (sp.T.Id == g.Tt.Never.Id) {
        return F.NeverVal(expect)
    }
    let bad: Bool = g.IsErr(sp.T)
    for (arm in n.List) {
        resolveTypePats(F, arm.A)
    }
    if (!bad) {
        mut rows: Array<Array<Ast.Node>> = []
        for (arm in n.List) {
            // a guarded arm may fail, so it does not count
            if (arm.B.IsNone()) {
                rows.Push([nn(arm.A)])
            }
        }
        if (!rowsCover(rows, [sp.T])) {
            let hint: Option<String> = missingHint(g, sp.T, rows)
            match (hint) {
                Some(h) => {
                    g.Diag.Error(n.Pos, "this `match` does not cover every case: ${h}")
                    g.Diag.Note("add an arm for it or a `_ =>` arm")
                },
                None => g.Diag.Error(n.Pos, "this `match` does not cover every case (add a `_ =>` arm)"),
            }
        }
    }
    let endL: String = F.NewLabel("match.end")
    mut rvals: Array<Ctx.Val> = []
    mut rlabels: Array<String> = []
    let want: Option<Types.Type> = match (expect) {
        Some(e) => if (e.Id != g.Tt.Unit.Id) { Some(e) } else { None },
        None => None,
    }
    mut rt: Option<Types.Type> = None
    for (arm in n.List) {
        let next: String = F.NewLabel("arm.next")
        F.PushScope()
        if (!bad) {
            patTest(F, nn(arm.A), sp, next)
            patBind(F, nn(arm.A), sp, false)
        }
        match (arm.B) {
            Some(guard) => {
                mut gv: Ctx.Val = genExpr(F, guard, Some(g.Tt.Bool))
                gv = coerce(F, guard.Pos, gv, g.Tt.Bool, "a match guard")
                if (gv.T.Id != g.Tt.Never.Id && !g.IsErr(gv.T)) {
                    let ok: String = F.NewLabel("guard.ok")
                    F.CondBr(gv.V, ok, next)
                    F.StartBlock(ok)
                }
            },
            None => {},
        }
        let body: Ast.Node = nn(arm.C)
        let armWant: Option<Types.Type> = if (rt.IsSome()) { rt } else { want }
        mut v: Ctx.Val = if (body.Kind == Ast.NK.Block) { genBlock(F, body, armWant) } else { genExpr(F, body, armWant) }
        let live: Bool = !F.Term
        match (want) {
            Some(w) => {
                if (live && w.Kind == Types.TKind.Union && v.T.Id != w.Id && !g.IsErr(v.T) && v.T.Id != g.Tt.Never.Id) {
                    v = coerce(F, body.Pos, v, w, "a `match` arm")
                }
            },
            None => {},
        }
        if (live) {
            if (g.IsErr(v.T)) {
                // keep going: the error is already reported
            } else {
                match (rt) {
                    None => { rt = Some(v.T) },
                    Some(r0) => {
                        if (v.T.Id != r0.Id && !g.IsErr(r0)) {
                            g.Diag.Error(body.Pos, "the arms of this `match` have different types: `${r0.Name}` and `${v.T.Name}`")
                            v = F.ErrVal()
                        }
                    },
                }
            }
        }
        popScope(F)
        if (live && !F.Term) {
            rvals.Push(v)
            rlabels.Push(F.Cur)
            F.Br(endL)
        }
        F.StartBlock(next)
    }
    F.Emit("unreachable")
    F.Term = true
    F.StartBlock(endL)
    if (rvals.Len() == 0) {
        F.Emit("unreachable")
        F.Term = true
        return F.NeverVal(expect)
    }
    for (v in rvals) {
        if (g.IsErr(v.T)) {
            return F.ErrVal()
        }
    }
    let rtype: Types.Type = match (rt) {
        Some(x) => x,
        None => return F.UnitVal(),
    }
    if (rtype.Id == g.Tt.Unit.Id) {
        return F.UnitVal()
    }
    let r: String = F.Tmp()
    mut parts: String = ""
    mut i: I64 = 0
    while (i < rvals.Len()) {
        parts = "${parts}${if (i > 0) { ", " } else { "" }}[ ${rvals[i].V}, %${rlabels[i]} ]"
        i += 1
    }
    F.Emit("${r} = phi ${F.LlOf(rtype)} ${parts}")
    Ctx.Val.New(rtype, r)
}

// ---- the `?` operator ----

fn genTry(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let v: Ctx.Val = genExpr(F, nn(n.A), None)
    if (v.T.Id == g.Tt.Never.Id) {
        return F.NeverVal(expect)
    }
    if (g.IsErr(v.T)) {
        return F.ErrVal()
    }
    if (!isResultType(v.T)) {
        if (isOptionType(v.T)) {
            g.Diag.Error(n.Pos, "`?` works on a `Result`, not an `Option` (turn it into a `Result` with `OkOr(error)` first)")
        } else {
            g.Diag.Error(n.Pos, "`?` can only be used on a `Result`, found `${v.T.Name}`")
        }
        return F.ErrVal()
    }
    if (!isErrorType(v.T.Args[1])) {
        g.Diag.Error(n.Pos, "`?` needs the error type to be `Error`, found `Result<${v.T.Args[0].Name}, ${v.T.Args[1].Name}>`")
        return F.ErrVal()
    }
    let ret: Types.Type = match (F.Ret) {
        Some(r) => r,
        None => {
            g.Diag.Error(n.Pos, "`?` needs to know the result type of the function; write the lambda's expected type (`let f: fn(...) -> Result<...> = ...`)")
            return F.ErrVal()
        },
    }
    if (!isResultType(ret) || ret.Args[1].Id != v.T.Args[1].Id) {
        g.Diag.Error(n.Pos, "`?` can only be used in a function that returns `Result<_, Error>` (this one returns `${ret.Name}`)")
        return F.ErrVal()
    }
    let okT: Types.Type = v.T.Args[0]
    let ok: Types.Variant = nnV(findVariant(v.T, "Ok"))
    let er: Types.Variant = nnV(findVariant(v.T, "Err"))
    let sp: Ctx.Place = spill(F, v)
    let tg: String = F.Tmp()
    let isok: String = F.Tmp()
    F.Emit("${tg} = load i32, ptr ${tagPtr(F, v.T, sp.Ptr)}")
    F.Emit("${isok} = icmp eq i32 ${tg}, ${ok.Tag}")
    let okL: String = F.NewLabel("try.ok")
    let errL: String = F.NewLabel("try.err")
    F.CondBr(isok, okL, errL)
    // Err: return it from this function (running the defers of every open scope)
    F.StartBlock(errL)
    let ep: Ctx.Place = fieldPlace(F, payloadPtr(F, v.T, sp.Ptr), variantPayload(er), 0, v.T.Args[1], false)
    let ev: Ctx.Val = loadPlace(F, ep)
    let rv: Ctx.Val = buildVariant(F, ret, nnV(findVariant(ret, "Err")), [ev])
    runAllDefers(F, None)
    F.Emit("ret ${F.LlOf(ret)} ${rv.V}")
    F.Term = true
    F.StartBlock(okL)
    if (okT.Id == g.Tt.Unit.Id) {
        return F.UnitVal()
    }
    let op: Ctx.Place = fieldPlace(F, payloadPtr(F, v.T, sp.Ptr), variantPayload(ok), 0, okT, false)
    loadPlace(F, op)
}

fn nnV(v: Option<Types.Variant>) -> Types.Variant {
    match (v) {
        Some(x) => x,
        None => Panic("variant is missing"),
    }
}

// ---- for (x in ...) over arrays and iterables ----

// Does the type have an `Iter()` method (its own, a default one, or one of an interface value)?
fn hasIterMethod(mut g: Gen.Gen, t: Types.Type) -> Bool {
    if (t.Kind == Types.TKind.Iface) {
        mut all: Array<Gen.IMethod> = []
        Gen.CollectIfaceMethods(g, t, all, 0)
        for (m in all) {
            if (m.Fn.Name == "Iter") {
                return true
            }
        }
        return false
    }
    if (!Gen.IsUserType(t)) {
        return false
    }
    if (Gen.FindMember(g, t, "Iter").IsSome()) {
        return true
    }
    let (dm, conflict): (Option<Gen.IMethod>, Bool) = Gen.FindDefault(g, t, "Iter")
    dm.IsSome()
}

fn mkLet(pos: Token.Pos, pat: Ast.Node, init: Ast.Node) -> Ast.Node {
    mut l: Ast.Node = Ast.Node.New(Ast.NK.Let, pos)
    l.A = Some(pat)
    l.C = Some(init)
    l
}

fn mkPlusOne(pos: Token.Pos, name: String) -> Ast.Node {
    mut inc: Ast.Node = Ast.Node.New(Ast.NK.Assign, pos)
    inc.Op = Token.Tk.PlusEq
    inc.A = Some(mkIdent(pos, name))
    inc.B = Some(mkInt(pos, 1_U64))
    inc
}

fn pushLoop(mut F: Ctx.FnCtx, n: Ast.Node, brk: String, cont: String) {
    mut lp: Ctx.Loop = Ctx.Loop.New(brk, cont, curScope(F))
    if (n.HasName) {
        lp.Label = Some(n.Name)
    }
    F.Loops.Push(lp)
}

// for (x in v) over anything with Iter(): it = v.Iter(); loop { o = it.Next(); if None, stop; x = o.Unwrap(); body }
fn genForIterable(mut F: Ctx.FnCtx, n: Ast.Node, src: Ctx.Val) {
    mut g: Gen.Gen = F.G
    let pos: Token.Pos = n.Pos
    let sl: Ctx.Local = declareLocal(F, "$src", src.T, false, pos)
    F.StoreTo(src.T, src, sl.Ptr)
    let iter: Ctx.Val = genExpr(F, mkMethodCall(mkIdent(pos, "$src"), "Iter", pos, None, None), None)
    if (iter.T.Id == g.Tt.Never.Id || g.IsErr(iter.T)) {
        popScope(F)
        return
    }
    // `Next` is a `mut fn`
    let itl: Ctx.Local = declareLocal(F, "$iter", iter.T, true, pos)
    F.StoreTo(iter.T, iter, itl.Ptr)
    // Map is the one exception: `for (k, v in m)` destructures the (key, value) element
    let isMap: Bool = match (Gen.DeclOfType(g, src.T)) {
        Some(d) => src.T.Kind == Types.TKind.Class && d.Name == "Map" && d.ModIsStd,
        None => false,
    }
    let mapPairs: Bool = n.C.IsSome() && isMap
    if (n.C.IsSome() && !mapPairs) {
        let il: Ctx.Local = declareLocal(F, "$i", g.Tt.I64, true, pos)
        F.StoreTo(g.Tt.I64, Ctx.Val.New(g.Tt.I64, "0"), il.Ptr)
    }
    let head: String = F.NewLabel("for.cond")
    let body: String = F.NewLabel("for.body")
    let end: String = F.NewLabel("for.end")
    F.GotoBlock(head)
    let o: Ctx.Val = genExpr(F, mkMethodCall(mkIdent(pos, "$iter"), "Next", pos, None, None), None)
    if (o.T.Id == g.Tt.Never.Id || g.IsErr(o.T) || !isOptionType(o.T)) {
        if (!g.IsErr(o.T) && o.T.Id != g.Tt.Never.Id) {
            g.Diag.Error(pos, "`Next()` must return an `Option`, found `${o.T.Name}`")
        }
        popScope(F)
        return
    }
    let ol: Ctx.Local = declareLocal(F, "$o", o.T, false, pos)
    F.StoreTo(o.T, o, ol.Ptr)
    let some: Ctx.Val = genExpr(F, mkMethodCall(mkIdent(pos, "$o"), "IsSome", pos, None, None), Some(g.Tt.Bool))
    F.CondBr(some.V, body, end)
    F.StartBlock(body)
    F.PushScope()
    mut pat: Ast.Node = nn(n.A)
    if (mapPairs) {
        mut tp: Ast.Node = Ast.Node.New(Ast.NK.PTuple, pos)
        tp.List.Push(nn(n.C))
        tp.List.Push(nn(n.A))
        pat = tp
    }
    genLet(F, mkLet(pos, pat, mkMethodCall(mkIdent(pos, "$o"), "Unwrap", pos, None, None)))
    if (n.C.IsSome() && !mapPairs) {
        genLet(F, mkLet(pos, nn(n.C), mkIdent(pos, "$i")))
        genAssign(F, mkPlusOne(pos, "$i"))
    }
    pushLoop(F, n, end, head)
    let unused: Ctx.Val = genBlock(F, nn(n.B), Some(g.Tt.Unit))
    F.Loops.Pop()
    popScope(F)
    if (!F.Term) {
        F.Br(head)
    }
    F.StartBlock(end)
    popScope(F)
}

// for (x in arr) / for (i, x in arr):
//   let $it = arr;  mut $i = 0
//   while ($i < $it.Len()) { let x = $it.Index($i); let i = $i; $i += 1; body }
// The counter moves before the body, so `continue` needs no special care.
fn genForIter(mut F: Ctx.FnCtx, n: Ast.Node) {
    mut g: Gen.Gen = F.G
    let pos: Token.Pos = n.Pos
    F.PushScope()
    let it: Ctx.Val = genExpr(F, nn(n.D), None)
    if (it.T.Id == g.Tt.Never.Id || g.IsErr(it.T)) {
        popScope(F)
        return
    }
    if (!isArrayType(F, it.T)) {
        if (hasIterMethod(g, it.T)) {
            genForIterable(F, n, it)
            return
        }
        g.Diag.Error(nn(n.D).Pos, "cannot loop over a value of type `${it.T.Name}` (`for` works on ranges like `0..10`, on arrays and on anything that is `Iterable`)")
        popScope(F)
        return
    }
    let itl: Ctx.Local = declareLocal(F, "$it", it.T, false, pos)
    F.StoreTo(it.T, it, itl.Ptr)
    let il: Ctx.Local = declareLocal(F, "$i", g.Tt.I64, true, pos)
    F.StoreTo(g.Tt.I64, Ctx.Val.New(g.Tt.I64, "0"), il.Ptr)

    mut cond: Ast.Node = Ast.Node.New(Ast.NK.Binary, pos)
    cond.Op = Token.Tk.Lt
    cond.A = Some(mkIdent(pos, "$i"))
    cond.B = Some(mkMethodCall(mkIdent(pos, "$it"), "Len", pos, None, None))

    let get: Ast.Node = mkMethodCall(mkIdent(pos, "$it"), "Index", pos, Some(mkIdent(pos, "$i")), None)
    let letElem: Ast.Node = mkLet(pos, nn(n.A), get)

    let head: String = F.NewLabel("for.cond")
    let body: String = F.NewLabel("for.body")
    let end: String = F.NewLabel("for.end")
    F.GotoBlock(head)
    let c: Ctx.Val = genExpr(F, cond, Some(g.Tt.Bool))
    if (c.T.Id != g.Tt.Never.Id && !g.IsErr(c.T)) {
        F.CondBr(c.V, body, end)
    }
    F.StartBlock(body)
    F.PushScope()
    genLet(F, letElem)
    match (n.C) {
        Some(idxPat) => genLet(F, mkLet(pos, idxPat, mkIdent(pos, "$i"))),
        None => {},
    }
    genAssign(F, mkPlusOne(pos, "$i"))
    pushLoop(F, n, end, head)
    let unused: Ctx.Val = genBlock(F, nn(n.B), Some(g.Tt.Unit))
    F.Loops.Pop()
    popScope(F)
    if (!F.Term) {
        F.Br(head)
    }
    F.StartBlock(end)
    popScope(F)
}

fn mkIdent(pos: Token.Pos, name: String) -> Ast.Node {
    mut n: Ast.Node = Ast.Node.New(Ast.NK.Ident, pos)
    n.SetName(name)
    n
}

fn mkMethodCall(recv: Ast.Node, method: String, pos: Token.Pos, a1: Option<Ast.Node>, a2: Option<Ast.Node>) -> Ast.Node {
    mut m: Ast.Node = Ast.Node.New(Ast.NK.Member, pos)
    m.A = Some(recv)
    m.SetName(method)
    mut c: Ast.Node = Ast.Node.New(Ast.NK.Call, pos)
    c.A = Some(m)
    match (a1) {
        Some(x) => c.List.Push(x),
        None => {},
    }
    match (a2) {
        Some(x) => c.List.Push(x),
        None => {},
    }
    c
}
