// ---- places, paths and string literals ----

// The names of a dotted path `A.B.C`, or None when the expression is not one.
fn flattenPath(n: Ast.Node, mut segs: Array<String>, mut nodes: Array<Ast.Node>) -> Bool {
    if (n.Kind == Ast.NK.Ident) {
        segs.Push(n.Name)
        nodes.Push(n)
        return true
    }
    if (n.Kind == Ast.NK.Member) {
        match (n.A) {
            Some(a) => {
                if (flattenPath(a, segs, nodes)) {
                    segs.Push(n.Name)
                    nodes.Push(n)
                    return true
                }
            },
            None => {},
        }
    }
    false
}

// Is this a dotted path whose first name is not a variable (a module or type)?
fn isStaticPath(F: Ctx.FnCtx, n: Ast.Node) -> Bool {
    mut segs: Array<String> = []
    mut nodes: Array<Ast.Node> = []
    if (!flattenPath(n, segs, nodes)) {
        return false
    }
    F.FindLocal(segs[0]).IsNone()
}

// The name of the variable a path starts from (for messages).
fn rootName(n: Ast.Node) -> String {
    mut cur: Ast.Node = n
    while (cur.Kind == Ast.NK.Member || cur.Kind == Ast.NK.Index) {
        match (cur.A) {
            Some(a) => { cur = a },
            None => return "this value",
        }
    }
    if (cur.Kind == Ast.NK.Ident) {
        return cur.Name
    }
    if (cur.Kind == Ast.NK.This) {
        return "this"
    }
    "this value"
}

// An expression that can be evaluated twice without changing the result.
fn isPureExpr(n: Ast.Node) -> Bool {
    match (n.Kind) {
        Ast.NK.Ident | Ast.NK.Int | Ast.NK.This | Ast.NK.Bool | Ast.NK.Char | Ast.NK.Byte => true,
        Ast.NK.Member | Ast.NK.Unary => isPureExpr(nn(n.A)),
        Ast.NK.Binary | Ast.NK.Index => isPureExpr(nn(n.A)) && isPureExpr(nn(n.B)),
        _ => false,
    }
}

fn placeErr(F: Ctx.FnCtx) -> Ctx.Place { Ctx.Place.New("", F.G.Err, false) }

fn loadPlace(mut F: Ctx.FnCtx, p: Ctx.Place) -> Ctx.Val {
    if (F.G.IsErr(p.T)) {
        return F.ErrVal()
    }
    if (p.T.Id == F.G.Tt.Unit.Id) {
        return F.UnitVal()
    }
    let t: String = F.Tmp()
    F.Emit("${t} = load ${F.LlOf(p.T)}, ptr ${p.Ptr}")
    Ctx.Val.New(p.T, t)
}

// A value in a fresh slot, so that it has an address.
fn spill(mut F: Ctx.FnCtx, v: Ctx.Val) -> Ctx.Place {
    let g: Gen.Gen = F.G
    if (g.IsErr(v.T) || v.T.Id == g.Tt.Never.Id) {
        return Ctx.Place.New("", v.T, false)
    }
    let ptr: String = F.NewSlot(v.T)
    if (v.T.Id != g.Tt.Unit.Id) {
        F.StoreTo(v.T, v, ptr)
    }
    Ctx.Place.New(ptr, v.T, false)
}

// A class object is laid out like a tuple of its fields.
fn objTuple(mut g: Gen.Gen, cls: Types.Type) -> Types.Type {
    mut ts: Array<Types.Type> = []
    for (f in cls.Fields) {
        ts.Push(f.T)
    }
    g.Tt.Tuple(ts)
}

fn checkVis(mut F: Ctx.FnCtx, t: Types.Type, name: String, pos: Token.Pos, what: String) -> Bool {
    mut g: Gen.Gen = F.G
    if (Gen.NameIsPub(name)) {
        return true
    }
    match (Gen.DeclOfType(g, t)) {
        Some(d) => {
            if (d.ModName == fileModName(F)) {
                return true
            }
            g.Diag.Error(pos, "${what} `${name}` of `${t.Name}` is private (names starting with a lowercase letter are only visible inside module `${d.ModName}`)")
            false
        },
        None => true,
    }
}

fn findFieldIdx(t: Types.Type, name: String) -> I64 {
    mut i: I64 = 0
    while (i < t.Fields.Len()) {
        if (t.Fields[i].Name == name) {
            return i
        }
        i += 1
    }
    -1
}



fn genPlace(mut F: Ctx.FnCtx, n: Ast.Node) -> Ctx.Place {
    mut g: Gen.Gen = F.G
    match (n.Kind) {
        Ast.NK.Ident => {
            match (F.FindLocal(n.Name)) {
                Some(l) => return Ctx.Place.New(l.Ptr, l.T, l.Mut),
                None => {},
            }
        },
        Ast.NK.This => {
            if (!F.HasThis) {
                g.Diag.Error(n.Pos, "`this` can only be used inside a method")
                return placeErr(F)
            }
            return Ctx.Place.New(F.ThisSlot, thisType(F), F.ThisMut)
        },
        Ast.NK.Index => {
            // an element of an array: a class element is a reference, so its fields can be changed in place; a struct
            // element is copied into a local and stored back after the assignment (see genAssign). Either way the
            // array itself must be `mut`.
            mut amut: Bool = false
            let a: Ast.Node = nn(n.A)
            if (a.Kind == Ast.NK.Ident || a.Kind == Ast.NK.Member || a.Kind == Ast.NK.This || a.Kind == Ast.NK.Index) {
                let ap: Ctx.Place = genPlace(F, a)
                if (g.IsErr(ap.T) || ap.T.Id == g.Tt.Never.Id) {
                    return placeErr(F)
                }
                amut = ap.Mut
            }
            let v: Ctx.Val = genExpr(F, n, None)
            if (v.T.Id == g.Tt.Never.Id || g.IsErr(v.T)) {
                return placeErr(F)
            }
            if (v.T.Kind == Types.TKind.Struct) {
                let name: String = "$el${F.NSlot}"
                let l: Ctx.Local = declareLocal(F, name, v.T, true, n.Pos)
                F.StoreTo(v.T, v, l.Ptr)
                F.WbElem = Some(n)
                F.WbName = name
                return Ctx.Place.New(l.Ptr, v.T, amut)
            }
            let p: Ctx.Place = spill(F, v)
            return Ctx.Place.New(p.Ptr, p.T, amut)
        },
        Ast.NK.Member => {
            if (!isStaticPath(F, n)) {
                let b: Ctx.Place = genPlace(F, nn(n.A))
                if (g.IsErr(b.T)) {
                    return placeErr(F)
                }
                if (b.T.Id == g.Tt.Never.Id) {
                    return b
                }
                mut bt: Types.Type = b.T
                if (bt.Kind != Types.TKind.Struct && bt.Kind != Types.TKind.Class) {
                    g.Diag.Error(n.Pos, "type `${bt.Name}` has no field `${n.Name}`")
                    return placeErr(F)
                }
                Gen.EnsureMembers(g, bt)
                let idx: I64 = findFieldIdx(bt, n.Name)
                if (idx < 0) {
                    match (Gen.FindMember(g, bt, n.Name)) {
                        Some(m) => g.Diag.Error(n.Pos, "`${n.Name}` is a method of `${bt.Name}`; call it with `()`"),
                        None => g.Diag.Error(n.Pos, "type `${bt.Name}` has no field `${n.Name}`"),
                    }
                    return placeErr(F)
                }
                if (!checkVis(F, bt, n.Name, n.Pos, "field")) {
                    return placeErr(F)
                }
                mut base: String = b.Ptr
                mut sll: String = ""
                if (bt.Kind == Types.TKind.Class) {
                    base = F.Tmp()
                    F.Emit("${base} = load ptr, ptr ${b.Ptr}")
                    sll = F.LlOf(objTuple(g, bt))
                } else {
                    sll = F.LlOf(bt)
                }
                let gep: String = F.Tmp()
                F.Emit("${gep} = getelementptr inbounds ${sll}, ptr ${base}, i32 0, i32 ${idx}")
                return Ctx.Place.New(gep, bt.Fields[idx].T, b.Mut)
            }
        },
        _ => {},
    }
    spill(F, genExpr(F, n, None))
}

fn genStringLit(mut F: Ctx.FnCtx, n: Ast.Node) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    if (n.List.Len() == 0) {
        return strVal(F, Gen.StrConst(g, ""))
    }
    if (n.List.Len() == 1 && n.List[0].Kind == Ast.NK.StrLit) {
        return strVal(F, Gen.StrConst(g, n.List[0].Name))
    }
    // interpolation: build the result in a runtime string builder
    rtDecl(F, "zevic_sb_new", "declare ptr @zevic_sb_new()")
    rtDecl(F, "zevic_sb_add", "declare void @zevic_sb_add(ptr, ptr, i64)")
    rtDecl(F, "zevic_sb_finish", "declare void @zevic_sb_finish(ptr, ptr)")
    let sb: String = F.Tmp()
    F.Emit("${sb} = call ptr @zevic_sb_new()")
    for (part in n.List) {
        mut s: Ctx.Val = F.ErrVal()
        if (part.Kind == Ast.NK.StrLit) {
            s = strVal(F, Gen.StrConst(g, part.Name))
        } else {
            let v: Ctx.Val = genExpr(F, part, None)
            if (v.T.Id == g.Tt.Never.Id) {
                return F.NeverVal(Some(g.Tt.Str))
            }
            s = genToString(F, v, part.Pos)
        }
        let (p, len): (String, String) = strParts(F, s)
        F.Emit("call void @zevic_sb_add(ptr ${sb}, ptr ${p}, i64 ${len})")
    }
    callStrOut(F, "zevic_sb_finish", "ptr ${sb}")
}

fn thisType(F: Ctx.FnCtx) -> Types.Type {
    match (F.ThisT) {
        Some(t) => t,
        None => Panic("`this` type is missing"),
    }
}

fn fileModName(F: Ctx.FnCtx) -> String {
    match (F.File.Mod) {
        Some(m) => m.Name,
        None => "",
    }
}

// ---- enum variants ----

// `Some` and `None` belong to Option, `Ok` and `Err` to Result (both live in Zevic.Core).
fn preludeVariantOwner(F: Ctx.FnCtx, name: String) -> Option<Resolve.Decl> {
    if (name == "Some" || name == "None") {
        return Gen.LookupInPrelude(F.G, "Option")
    }
    if (name == "Ok" || name == "Err") {
        return Gen.LookupInPrelude(F.G, "Result")
    }
    None
}

fn findVariantNode(enumDecl: Ast.Node, name: String) -> Option<Ast.Node> {
    for (m in enumDecl.List) {
        if (m.Kind == Ast.NK.Variant && m.Name == name) {
            return Some(m)
        }
    }
    None
}

fn findVariant(t: Types.Type, name: String) -> Option<Types.Variant> {
    for (v in t.Variants) {
        if (v.Name == name) {
            return Some(v)
        }
    }
    None
}

fn sameDecl(g: Gen.Gen, t: Types.Type, d: Resolve.Decl) -> Bool {
    match (Gen.DeclOfType(g, t)) {
        Some(x) => x.Key() == d.Key(),
        None => false,
    }
}

// The type of a generic type's instance when it is known without looking at the arguments.
fn staticType(mut F: Ctx.FnCtx, d: Resolve.Decl, tnode: Option<Ast.Node>, expect: Option<Types.Type>) -> Option<Types.Type> {
    mut g: Gen.Gen = F.G
    let td: Ast.Node = d.Node
    if (td.List2.Len() == 0) {
        return Some(Gen.Instantiate(g, d, [], td.Pos))
    }
    match (tnode) {
        Some(tn) => {
            if (tn.List2.Len() > 0) {
                mut targs: Array<Types.Type> = []
                for (a in tn.List2) {
                    targs.Push(Gen.ResolveType(g, F.File, F.Env, a))
                }
                return Some(Gen.Instantiate(g, d, targs, tn.Pos))
            }
        },
        None => {},
    }
    match (expect) {
        Some(e) => {
            if (sameDecl(g, e, d)) {
                return Some(e)
            }
        },
        None => {},
    }
    None
}

fn isFnTParam(fnNode: Ast.Node, name: String) -> Bool {
    for (tp in fnNode.List2) {
        if (tp.Name == name) {
            return true
        }
    }
    false
}

// Does this type syntax mention a type parameter of `fn` that is not bound yet?
fn syntaxUsesUnbound(te: Ast.Node, fnNode: Ast.Node, env: Gen.Env) -> Bool {
    match (te.Kind) {
        Ast.NK.TypeName => {
            if (te.Path.Len() == 1 && isFnTParam(fnNode, te.Path[0]) && env.Get(te.Path[0]).IsNone()) {
                return true
            }
            for (a in te.List) {
                if (syntaxUsesUnbound(a, fnNode, env)) {
                    return true
                }
            }
            false
        },
        Ast.NK.TypeTuple | Ast.NK.TypeUnion => {
            for (a in te.List) {
                if (syntaxUsesUnbound(a, fnNode, env)) {
                    return true
                }
            }
            false
        },
        Ast.NK.TypeFn => {
            for (a in te.List) {
                if (syntaxUsesUnbound(a, fnNode, env)) {
                    return true
                }
            }
            syntaxUsesUnbound(nn(te.A), fnNode, env)
        },
        Ast.NK.TypePtr => syntaxUsesUnbound(nn(te.A), fnNode, env),
        _ => false,
    }
}

// Bind the type parameters in `te` by matching it against `actual`.
fn unify(g: Gen.Gen, te: Ast.Node, actual: Types.Type, fnNode: Ast.Node, mut env: Gen.Env) {
    if (g.IsErr(actual) || actual.Id == g.Tt.Never.Id) {
        return
    }
    match (te.Kind) {
        Ast.NK.TypeName => {
            if (te.Path.Len() == 1 && isFnTParam(fnNode, te.Path[0])) {
                if (env.Get(te.Path[0]).IsNone()) {
                    env.Add(te.Path[0], actual)
                }
                return
            }
            if (Gen.DeclOfType(g, actual).IsSome() && te.List.Len() == actual.Args.Len()) {
                mut i: I64 = 0
                while (i < te.List.Len()) {
                    unify(g, te.List[i], actual.Args[i], fnNode, env)
                    i += 1
                }
            }
        },
        Ast.NK.TypeTuple => {
            if (actual.Kind == Types.TKind.Tuple && actual.Args.Len() == te.List.Len()) {
                mut i: I64 = 0
                while (i < te.List.Len()) {
                    unify(g, te.List[i], actual.Args[i], fnNode, env)
                    i += 1
                }
            }
        },
        Ast.NK.TypeFn => {
            if (actual.Kind == Types.TKind.Fn && actual.Args.Len() == te.List.Len()) {
                mut i: I64 = 0
                while (i < te.List.Len()) {
                    unify(g, te.List[i], actual.Args[i], fnNode, env)
                    i += 1
                }
                match (actual.Ret) {
                    Some(r) => unify(g, nn(te.A), r, fnNode, env),
                    None => {},
                }
            }
        },
        Ast.NK.TypePtr => {
            if (actual.Kind == Types.TKind.Ptr) {
                unify(g, nn(te.A), actual.Args[0], fnNode, env)
            }
        },
        _ => {},
    }
}

// Build an aggregate value from already generated parts.
fn makeAggregate(mut F: Ctx.FnCtx, tt: Types.Type, vals: Array<Ctx.Val>) -> Ctx.Val {
    if (vals.Len() == 0) {
        return Ctx.Val.New(tt, "zeroinitializer")
    }
    mut acc: String = "undef"
    mut i: I64 = 0
    while (i < vals.Len()) {
        let v: Ctx.Val = vals[i]
        let r: String = F.Tmp()
        F.Emit("${r} = insertvalue ${F.LlOf(tt)} ${acc}, ${F.LlOf(v.T)} ${v.V}, ${i}")
        acc = r
        i += 1
    }
    Ctx.Val.New(tt, acc)
}

fn buildVariant(mut F: Ctx.FnCtx, et: Types.Type, v: Types.Variant, vals: Array<Ctx.Val>) -> Ctx.Val {
    let slot: String = F.NewSlot(et)
    F.Emit("store i32 ${v.Tag}, ptr ${tagPtr(F, et, slot)}")
    match (v.Payload) {
        Some(pl) => {
            if (vals.Len() > 0) {
                let pv: Ctx.Val = makeAggregate(F, pl, vals)
                F.Emit("store ${F.LlOf(pl)} ${pv.V}, ptr ${payloadPtr(F, et, slot)}")
            }
        },
        None => {},
    }
    let t: String = F.Tmp()
    F.Emit("${t} = load ${F.LlOf(et)}, ptr ${slot}")
    Ctx.Val.New(et, t)
}

// Shape.Circle(1.0), Some(x), None ... `call` is None for a variant without data.
fn genVariant(mut F: Ctx.FnCtx, call: Option<Ast.Node>, pos: Token.Pos, d: Resolve.Decl, etIn: Option<Types.Type>, vname: String, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let vn: Ast.Node = match (findVariantNode(d.Node, vname)) {
        Some(x) => x,
        None => {
            g.Diag.Error(pos, "enum `${d.Name}` has no variant `${vname}`")
            return F.ErrVal()
        },
    }
    let nf: I64 = if (vn.Flag) { vn.List2.Len() } else { vn.List.Len() }
    mut args: Array<Ast.Node> = []
    mut named: Bool = false
    match (call) {
        Some(c) => {
            args = c.List
            named = c.Flag2
        },
        None => {},
    }
    let nargs: I64 = args.Len()
    if (nf != nargs) {
        if (nf == 0) {
            g.Diag.Error(pos, "variant `${d.Name}.${vname}` has no data, so it is written without `(...)`")
        } else if (call.IsNone()) {
            g.Diag.Error(pos, "variant `${d.Name}.${vname}` needs ${nf} value(s): write `${d.Name}.${vname}(...)`")
        } else {
            g.Diag.Error(pos, "variant `${d.Name}.${vname}` takes ${nf} value(s), but ${nargs} were given")
        }
        return F.ErrVal()
    }
    if (vn.Flag && !(call.IsSome() && named)) {
        let first: String = if (vn.List2.Len() > 0) { vn.List2[0].Name } else { "Field" }
        g.Diag.Error(pos, "variant `${d.Name}.${vname}` has named fields: write `${d.Name}.${vname} { ${first}: ... }`")
        return F.ErrVal()
    }
    mut vals: Array<Ctx.Val> = []
    mut et: Types.Type = g.Err
    match (etIn) {
        None => {
            mut env: Gen.Env = Gen.Env.New()
            mut i: I64 = 0
            while (i < nargs) {
                let fte: Ast.Node = if (vn.Flag) { nn(vn.List2[i].A) } else { vn.List[i] }
                let pexp: Option<Types.Type> = if (syntaxUsesUnbound(fte, d.Node, env)) { None } else { Some(Gen.ResolveType(g, d.FileInfo(), env, fte)) }
                let v: Ctx.Val = genExpr(F, args[i], pexp)
                if (v.T.Id == g.Tt.Never.Id) {
                    return F.NeverVal(expect)
                }
                if (pexp.IsNone()) {
                    unify(g, fte, v.T, d.Node, env)
                }
                vals.Push(v)
                i += 1
            }
            mut targs: Array<Types.Type> = []
            mut k: I64 = 0
            while (k < d.Node.List2.Len()) {
                let tp: Ast.Node = d.Node.List2[k]
                mut t: Option<Types.Type> = env.Get(tp.Name)
                if (t.IsNone()) {
                    match (expect) {
                        Some(e) => {
                            if (sameDecl(g, e, d)) {
                                t = Some(e.Args[k])
                            }
                        },
                        None => {},
                    }
                }
                match (t) {
                    Some(x) => targs.Push(x),
                    None => {
                        g.Diag.Error(pos, "cannot infer the type parameter `${tp.Name}` of `${d.Name}` (add a type annotation)")
                        return F.ErrVal()
                    },
                }
                k += 1
            }
            et = Gen.Instantiate(g, d, targs, pos)
        },
        Some(e) => {
            et = e
            match (findVariant(e, vname)) {
                Some(v0) => {
                    mut i: I64 = 0
                    while (i < nargs) {
                        let v: Ctx.Val = genExpr(F, args[i], Some(v0.Fields[i].T))
                        if (v.T.Id == g.Tt.Never.Id) {
                            return F.NeverVal(expect)
                        }
                        vals.Push(v)
                        i += 1
                    }
                },
                None => {},
            }
        },
    }
    let var: Types.Variant = match (findVariant(et, vname)) {
        Some(x) => x,
        None => return F.ErrVal(),
    }
    mut i: I64 = 0
    while (i < nargs) {
        let f: Types.Field = var.Fields[i]
        let what: String = if (named) { "field `${f.Name}` of `${d.Name}.${vname}`" } else { "argument ${i + 1} of `${d.Name}.${vname}`" }
        let cv: Ctx.Val = coerce(F, args[i].Pos, vals[i], f.T, what)
        if (g.IsErr(cv.T)) {
            return F.ErrVal()
        }
        vals[i] = cv
        i += 1
    }
    buildVariant(F, et, var, vals)
}

// ---- arrays and struct literals ----

fn isArrayType(F: Ctx.FnCtx, t: Types.Type) -> Bool {
    if (t.Kind != Types.TKind.Class) {
        return false
    }
    match (Gen.LookupInPrelude(F.G, "Array")) {
        Some(d) => sameDecl(F.G, t, d),
        None => false,
    }
}

fn mkInt(pos: Token.Pos, v: U64) -> Ast.Node {
    mut n: Ast.Node = Ast.Node.New(Ast.NK.Int, pos)
    n.Ival = v
    n
}

// Call function `fname` of standard library module `module` with values that are already computed.
// They are parked in hidden variables so that the ordinary call code can be reused.
fn callStd(mut F: Ctx.FnCtx, modName: String, fname: String, pos: Token.Pos, args: Array<Ctx.Val>, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let d: Option<Resolve.Decl> = match (g.Pg.FindModule(modName)) {
        Some(m) => m.Decls.Get(fname),
        None => None,
    }
    match (d) {
        Some(dd) => {
            mut call: Ast.Node = Ast.Node.New(Ast.NK.Call, pos)
            call.A = Some(mkIdent(pos, fname))
            for (a in args) {
                let name: String = "$c${F.NTmp}"
                F.NTmp += 1
                let l: Ctx.Local = declareLocal(F, name, a.T, false, pos)
                if (a.T.Id != g.Tt.Unit.Id) {
                    F.StoreTo(a.T, a, l.Ptr)
                }
                call.List.Push(mkIdent(pos, name))
            }
            genCallDecl(F, call, dd, None, None, expect, None)
        },
        None => {
            g.Diag.Error(pos, "internal error: `${modName}.${fname}` is missing from the standard library")
            F.ErrVal()
        },
    }
}

// a[i]  ->  a.Index(i)
fn genIndexRead(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut call: Ast.Node = mkMethodCall(nn(n.A), "Index", n.Pos, n.B, None)
    call.Flag3 = true
    genExpr(F, call, expect)
}

// a[i] = v  ->  a.SetIndex(i, v);   a[i] += v  ->  a.SetIndex(i, a[i] + v)
fn genIndexAssign(mut F: Ctx.FnCtx, n: Ast.Node) {
    let target: Ast.Node = nn(n.A)
    mut value: Ast.Node = nn(n.B)
    if (n.Op != Token.Tk.Assign) {
        if (!isPureExpr(nn(target.A)) || !isPureExpr(nn(target.B))) {
            F.G.Diag.Error(n.Pos, "`${n.Op.Name()}` on an element needs a simple array and index (put them in variables first)")
            return
        }
        mut bin: Ast.Node = Ast.Node.New(Ast.NK.Binary, n.Pos)
        bin.Op = baseOp(n.Op)
        bin.A = Some(target)
        bin.B = n.B
        value = bin
    }
    mut call: Ast.Node = mkMethodCall(nn(target.A), "SetIndex", n.Pos, target.B, Some(value))
    call.Flag3 = true
    let unused: Ctx.Val = genExpr(F, call, None)
}

fn elemSize(mut F: Ctx.FnCtx, et: Types.Type) -> String {
    let g1: String = F.Tmp()
    let sz: String = F.Tmp()
    F.Emit("${g1} = getelementptr ${F.LlOf(et)}, ptr null, i32 1")
    F.Emit("${sz} = ptrtoint ptr ${g1} to i64")
    sz
}

fn elemPtr(mut F: Ctx.FnCtx, et: Types.Type, base: String, idx: String) -> String {
    let p: String = F.Tmp()
    F.Emit("${p} = getelementptr inbounds ${F.LlOf(et)}, ptr ${base}, i64 ${idx}")
    p
}

// [a, b, c]: fill a new buffer and wrap it in an Array object.
fn genArrayLit(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let cnt: I64 = n.List.Len()
    mut at: Types.Type = g.Err
    mut et: Types.Type = g.Err
    mut first: Option<Ctx.Val> = None
    mut fromExpect: Bool = false
    match (expect) {
        Some(e) => {
            if (isArrayType(F, e)) {
                at = e
                et = e.Args[0]
                fromExpect = true
            }
        },
        None => {},
    }
    if (!fromExpect) {
        if (cnt == 0) {
            g.Diag.Error(n.Pos, "an empty array `[]` needs a type from its context (write `let a: Array<I32> = []`)")
            return F.ErrVal()
        }
        let f0: Ctx.Val = genExpr(F, n.List[0], None)
        if (f0.T.Id == g.Tt.Never.Id) {
            return f0
        }
        if (g.IsErr(f0.T)) {
            mut i: I64 = 1
            while (i < cnt) {
                let unused: Ctx.Val = genExpr(F, n.List[i], None)
                i += 1
            }
            return F.ErrVal()
        }
        first = Some(f0)
        et = f0.T
        at = Gen.ArrayType(g, et)
        if (g.IsErr(at)) {
            return F.ErrVal()
        }
    }
    rtDecl(F, "zevic_alloc", "declare ptr @zevic_alloc(i64)")
    let bytes: String = F.Tmp()
    let buf: String = F.Tmp()
    F.Emit("${bytes} = mul i64 ${cnt}, ${elemSize(F, et)}")
    F.Emit("${buf} = call ptr @zevic_alloc(i64 ${bytes})")
    mut failed: Bool = false
    mut i: I64 = 0
    while (i < cnt) {
        let en: Ast.Node = n.List[i]
        mut v: Ctx.Val = F.ErrVal()
        match (first) {
            Some(f0) => {
                if (i == 0) {
                    v = f0
                } else {
                    v = genExpr(F, en, Some(et))
                }
            },
            None => { v = genExpr(F, en, Some(et)) },
        }
        v = coerce(F, en.Pos, v, et, "an array element")
        if (v.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(Some(at))
        }
        if (g.IsErr(v.T)) {
            failed = true
        } else if (et.Id != g.Tt.Unit.Id) {
            F.StoreTo(et, v, elemPtr(F, et, buf, "${i}"))
        }
        i += 1
    }
    if (failed) {
        return F.ErrVal()
    }
    Gen.EnsureMembers(g, at)
    let vt: Types.Type = objTuple(g, at)
    let obj: String = F.Tmp()
    F.Emit("${obj} = call ptr @zevic_alloc(i64 ${g.Tt.SizeOf(vt)})")
    let bi: I64 = findFieldIdx(at, "buf")
    let li: I64 = findFieldIdx(at, "len")
    let ci: I64 = findFieldIdx(at, "cap")
    if (bi < 0 || li < 0 || ci < 0) {
        g.Diag.Error(n.Pos, "internal error: Array in Core.zev must have the fields `buf`, `len` and `cap`")
        return F.ErrVal()
    }
    let gb: String = F.Tmp()
    let gl: String = F.Tmp()
    let gc: String = F.Tmp()
    F.Emit("${gb} = getelementptr inbounds ${F.LlOf(vt)}, ptr ${obj}, i32 0, i32 ${bi}")
    F.Emit("store ptr ${buf}, ptr ${gb}")
    F.Emit("${gl} = getelementptr inbounds ${F.LlOf(vt)}, ptr ${obj}, i32 0, i32 ${li}")
    F.Emit("store i64 ${cnt}, ptr ${gl}")
    F.Emit("${gc} = getelementptr inbounds ${F.LlOf(vt)}, ptr ${obj}, i32 0, i32 ${ci}")
    F.Emit("store i64 ${cnt}, ptr ${gc}")
    Ctx.Val.New(at, obj)
}

// Shape.Named { Field: value }
fn genStructLit(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    mut segs: Array<String> = []
    mut nodes: Array<Ast.Node> = []
    if (!flattenPath(nn(n.A), segs, nodes) || segs.Len() < 2) {
        g.Diag.Error(n.Pos, "`{ name: value }` can only follow an enum variant like `Shape.Named`")
        return F.ErrVal()
    }
    let (dOpt, used): (Option<Resolve.Decl>, I64) = Gen.FindDecl(g, F.File, segs, nn(n.A).Pos)
    if (used < 0) {
        return F.ErrVal()
    }
    mut vnOpt: Option<Ast.Node> = None
    match (dOpt) {
        Some(d) => {
            if (d.Node.Kind == Ast.NK.DEnum && used == segs.Len() - 1) {
                vnOpt = findVariantNode(d.Node, segs[used])
            }
        },
        None => {},
    }
    let vn: Ast.Node = match (vnOpt) {
        Some(x) => x,
        None => {
            g.Diag.Error(n.Pos, "`${Ast.PathJoin(segs, ".")}` is not an enum variant, so it cannot be built with `{ name: value }`")
            return F.ErrVal()
        },
    }
    let d: Resolve.Decl = match (dOpt) {
        Some(x) => x,
        None => return F.ErrVal(),
    }
    let vname: String = vn.Name
    if (!vn.Flag) {
        g.Diag.Error(n.Pos, "variant `${d.Name}.${vname}` has no named fields; write `${d.Name}.${vname}(...)`")
        return F.ErrVal()
    }
    mut call: Ast.Node = Ast.Node.New(Ast.NK.Call, n.Pos)
    call.Flag2 = true
    call.A = n.A
    mut ok: Bool = true
    for (declF in vn.List2) {
        mut given: Option<Ast.Node> = None
        for (gv in n.List) {
            if (gv.Name == declF.Name) {
                if (given.IsSome()) {
                    g.Diag.Error(gv.Pos, "field `${gv.Name}` is given twice")
                    ok = false
                } else {
                    given = Some(gv)
                }
            }
        }
        match (given) {
            Some(gv) => call.List.Push(nn(gv.B)),
            None => {
                g.Diag.Error(n.Pos, "variant `${d.Name}.${vname}` needs the field `${declF.Name}`")
                ok = false
            },
        }
    }
    for (gv in n.List) {
        mut known: Bool = false
        for (declF in vn.List2) {
            if (declF.Name == gv.Name) {
                known = true
            }
        }
        if (!known) {
            g.Diag.Error(gv.Pos, "variant `${d.Name}.${vname}` has no field `${gv.Name}`")
            ok = false
        }
    }
    if (!ok) {
        return F.ErrVal()
    }
    let t: Option<Types.Type> = staticType(F, d, Some(nodes[used - 1]), expect)
    genVariant(F, Some(call), n.Pos, d, t, vname, expect)
}

// ---- members: `Type.Variant`, `Type.StaticField`, `Module.CONST`, `x.Field` ----

fn findStaticField(g: Gen.Gen, t: Types.Type, name: String) -> Option<Ast.Node> {
    match (Gen.DeclNode(g, t)) {
        Some(td) => {
            for (m in td.List) {
                if (m.Kind == Ast.NK.Field && m.Flag && m.Name == name) {
                    return Some(m)
                }
            }
            None
        },
        None => None,
    }
}

fn genStaticMember(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    mut segs: Array<String> = []
    mut nodes: Array<Ast.Node> = []
    let unusedFlat: Bool = flattenPath(n, segs, nodes)
    mut used: I64 = 0
    mut dOpt: Option<Resolve.Decl> = None
    let selfDecl: Option<Resolve.Decl> = match (F.Env.SelfT) {
        Some(st) => Gen.DeclOfType(g, st),
        None => None,
    }
    if (segs[0] == "Self" && selfDecl.IsSome()) {
        dOpt = selfDecl
        used = 1
    } else {
        let (x, u): (Option<Resolve.Decl>, I64) = Gen.FindDecl(g, F.File, segs, n.Pos)
        dOpt = x
        used = u
    }
    if (used < 0) {
        return F.ErrVal()
    }
    let d: Resolve.Decl = match (dOpt) {
        Some(x) => x,
        None => {
            g.Diag.Error(n.Pos, "unknown name `${Ast.PathJoin(segs, ".")}`")
            return F.ErrVal()
        },
    }
    let dn: Ast.Node = d.Node
    if (dn.Kind == Ast.NK.DConst && used == segs.Len()) {
        let t: Types.Type = Gen.ResolveType(g, d.FileInfo(), Gen.MakeEnv(g, d, None, None), nn(dn.A))
        let v: Ctx.Val = genExpr(F, nn(dn.B), Some(t))
        return coerce(F, nn(dn.B).Pos, v, t, "a constant")
    }
    if ((dn.Kind == Ast.NK.DEnum || dn.Kind == Ast.NK.DStruct || dn.Kind == Ast.NK.DClass) && used == segs.Len() - 1) {
        let member: String = segs[used]
        let tnode: Ast.Node = nodes[used - 1]
        let t: Option<Types.Type> = if (segs[0] == "Self" && F.Env.SelfT.IsSome()) { F.Env.SelfT } else { staticType(F, d, Some(tnode), expect) }
        if (dn.Kind == Ast.NK.DEnum && findVariantNode(dn, member).IsSome()) {
            return genVariant(F, None, n.Pos, d, t, member, expect)
        }
        match (t) {
            Some(tt) => {
                match (findStaticField(g, tt, member)) {
                    Some(sf) => {
                        mut tenv: Gen.Env = Gen.Env.New()
                        tenv.SelfT = Some(tt)
                        mut i: I64 = 0
                        while (i < dn.List2.Len()) {
                            tenv.Add(dn.List2[i].Name, tt.Args[i])
                            i += 1
                        }
                        let ft: Types.Type = Gen.ResolveType(g, d.FileInfo(), tenv, nn(sf.A))
                        let osf: Resolve.FileInfo = F.File
                        let oe: Gen.Env = F.Env
                        let os: Option<Ctx.Scope> = F.Scope
                        F.File = d.FileInfo()
                        F.Env = tenv
                        F.Scope = Some(Ctx.Scope.New())
                        mut v: Ctx.Val = F.ErrVal()
                        match (sf.B) {
                            Some(init) => { v = genExpr(F, init, Some(ft)) },
                            None => {},
                        }
                        v = coerce(F, n.Pos, v, ft, "a static field")
                        F.File = osf
                        F.Env = oe
                        F.Scope = os
                        return v
                    },
                    None => {},
                }
                if (Gen.FindMember(g, tt, member).IsSome()) {
                    g.Diag.Error(n.Pos, "`${d.Name}.${member}` is a function; call it with `()`")
                    return F.ErrVal()
                }
            },
            None => {},
        }
        g.Diag.Error(n.Pos, "type `${d.Name}` has no member `${member}`")
        return F.ErrVal()
    }
    if (dn.Kind == Ast.NK.DFn && used == segs.Len()) {
        return fnValueOf(F, d, n.Pos)
    }
    g.Diag.Error(n.Pos, "`${Ast.PathJoin(segs, ".")}` cannot be used as a value here")
    F.ErrVal()
}

fn genMember(mut F: Ctx.FnCtx, n: Ast.Node, expect: Option<Types.Type>) -> Ctx.Val {
    if (isStaticPath(F, n)) {
        return genStaticMember(F, n, expect)
    }
    let p: Ctx.Place = genPlace(F, n)
    if (p.T.Id == F.G.Tt.Never.Id) {
        return F.NeverVal(expect)
    }
    loadPlace(F, p)
}

// ---- calls of declared functions ----

// The pointer part of a string constant `{ ptr @x, i64 n }`.
fn constPtr(c: String) -> String { c.Slice(6, Text.IndexOf(c, ",").Unwrap()) }

// Attribute that makes a narrow C integer cross the call boundary the way a C compiler would.
fn cExtAttr(t: Types.Type) -> String {
    if (t.Kind != Types.TKind.CType || !Text.StartsWith(t.Ll, "i")) {
        return ""
    }
    if (t.Size >= 4) {
        return ""
    }
    if (t.Name == "CBool") {
        return " zeroext"
    }
    if (t.PayloadWords == 1) { " signext" } else { " zeroext" }
}

// A Zevic function value as a C function pointer: a wrapper with the plain C signature that calls the function
// with a null environment. Only a named function or a lambda that captures nothing can be passed.
fn cCallback(mut F: Ctx.FnCtx, v: Ctx.Val) -> Option<String> {
    mut g: Gen.Gen = F.G
    mut target: Option<String> = None
    let pre: String = "{ ptr @\"thunk."
    let post: String = "\", ptr null }"
    if (Text.StartsWith(v.V, pre) && Text.IndexOf(v.V, post).IsSome()) {
        target = Some(v.V.Slice(8, Text.IndexOf(v.V, post).Unwrap()))
    } else {
        target = g.Noenv.Get("${F.Inst.Name}:${v.V}")
    }
    let tg: String = match (target) {
        Some(x) => x,
        None => {
            g.Diag.Error(g.CallPos, "only a named function, or a lambda that captures nothing, can be passed to C as a callback")
            g.Diag.Note("wrap the data a callback needs in a `Handle` and pass its number instead")
            return None
        },
    }
    let wrapper: String = "cb.${tg}"
    if (g.Thunks.Get(wrapper).IsNone()) {
        g.Thunks.Set(wrapper, tg)
        let ft: Types.Type = v.T
        mut ps: String = ""
        mut cargs: String = ""
        mut i: I64 = 0
        while (i < ft.Args.Len()) {
            let pt: Types.Type = ft.Args[i]
            ps = "${ps}${if (i > 0) { ", " } else { "" }}${pt.Ll}${cExtAttr(pt)} %p${i}"
            cargs = "${cargs}, ${pt.Ll} %p${i}"
            i += 1
        }
        let r: Types.Type = match (ft.Ret) {
            Some(x) => x,
            None => g.Tt.Unit,
        }
        let isVoid: Bool = r.Id == g.Tt.Unit.Id || r.Id == g.Tt.Never.Id || (r.Kind == Types.TKind.CType && r.Name == "CVoid")
        let rl: String = if (isVoid) { "void" } else { r.Ll }
        let ra: String = if (isVoid) { "" } else { cExtAttr(r) }
        if (isVoid) {
            g.Funcs.Put("define void @\"${wrapper}\"(${ps}) {\nentry:\n  call void @\"${tg}\"(ptr null${cargs})\n  ret void\n}\n\n")
        } else {
            g.Funcs.Put("define${ra} ${rl} @\"${wrapper}\"(${ps}) {\nentry:\n  %r = call ${rl} @\"${tg}\"(ptr null${cargs})\n  ret ${rl} %r\n}\n\n")
        }
    }
    Some("@\"${wrapper}\"")
}

// A call to an `extern "C"` function.
fn emitCCall(mut F: Ctx.FnCtx, inst: Gen.Inst, args: Array<Ctx.Val>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    mut a: String = ""
    mut ptypes: String = ""
    let ret: Types.Type = inst.Ret
    mut variadic: Bool = false
    for (p in inst.D.Node.List) {
        if (p.Flag3) {
            variadic = true
        }
    }
    mut i: I64 = 0
    while (i < args.Len()) {
        let v: Ctx.Val = args[i]
        if (i > 0) {
            a = "${a}, "
        }
        let attr: String = cExtAttr(v.T)
        mut ll: String = F.LlOf(v.T)
        mut vv: String = v.V
        if (v.T.Kind == Types.TKind.Fn) {
            match (cCallback(F, v)) {
                Some(cb) => {
                    vv = cb
                    ll = "ptr"
                },
                None => return F.ErrVal(),
            }
        }
        a = "${a}${ll}${attr} ${vv}"
        if (i < inst.Ptypes.Len()) {
            if (i > 0) {
                ptypes = "${ptypes}, "
            }
            ptypes = "${ptypes}${ll}${attr}"
        }
        i += 1
    }
    if (variadic) {
        ptypes = if (ptypes.Len() > 0) { "${ptypes}, ..." } else { "..." }
    }
    let isVoid: Bool = ret.Id == g.Tt.Unit.Id || ret.Id == g.Tt.Never.Id
    let rl: String = if (isVoid) { "void" } else { F.LlOf(ret) }
    let rattr: String = if (isVoid) { "" } else { cExtAttr(ret) }
    Gen.Declare(g, inst.Name, "declare${rattr} ${rl} @${inst.Name}(${ptypes})")
    // a variadic callee is called through its full function type
    let fty: String = if (variadic) { " ${rl} (${ptypes})" } else { " ${rl}" }
    if (isVoid) {
        F.Emit("call${fty} @${inst.Name}(${a})")
        return F.UnitVal()
    }
    let t: String = F.Tmp()
    F.Emit("${t} = call${rattr}${fty} @${inst.Name}(${a})")
    Ctx.Val.New(ret, t)
}

// Emit a direct call to a function instance.
fn emitCall(mut F: Ctx.FnCtx, inst: Gen.Inst, args: Array<Ctx.Val>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let ret: Types.Type = inst.Ret
    let abi: String = inst.D.Abi
    let zevicAbi: Bool = inst.IsExtern && abi == "zevic"
    let cAbi: Bool = inst.IsExtern && abi == "C"
    if (cAbi) {
        return emitCCall(F, inst, args)
    }
    if (!inst.IsExtern && inst.D.ModName == "Zevic.Test" && F.Inst.D.ModName != "Zevic.Test") {
        // an assertion reports the line of the call, not a line inside the library
        rtDecl(F, "zevic_test_at", "declare void @zevic_test_at(ptr, i32)")
        let fc: String = Gen.StrConst(g, g.Diag.Name(g.CallPos.File))
        F.Emit("call void @zevic_test_at(ptr ${constPtr(fc)}, i32 ${g.CallPos.Line})")
    }
    if (inst.IsExtern && !zevicAbi) {
        g.Diag.Error(inst.D.Node.Pos, "`extern \"${abi}\"` functions are not supported yet")
        return F.ErrVal()
    }
    let isStr: Bool = ret.Id == g.Tt.Str.Id
    let noValue: Bool = isStr || ret.Id == g.Tt.Unit.Id || ret.Id == g.Tt.Never.Id
    mut a: String = ""
    if (zevicAbi) {
        mut ptypes: String = ""
        mut slot: String = ""
        if (isStr) {
            slot = F.NewSlot(g.Tt.Str)
            a = "ptr ${slot}"
            ptypes = "ptr"
        }
        for (v in args) {
            if (v.T.Id == g.Tt.Unit.Id) {
                continue
            }
            if (a.Len() > 0) {
                a = "${a}, "
            }
            if (ptypes.Len() > 0) {
                ptypes = "${ptypes}, "
            }
            if (v.T.Id == g.Tt.Str.Id) {
                let (p, n): (String, String) = strParts(F, v)
                a = "${a}ptr ${p}, i64 ${n}"
                ptypes = "${ptypes}ptr, i64"
            } else {
                a = "${a}${F.LlOf(v.T)} ${v.V}"
                ptypes = "${ptypes}${F.LlOf(v.T)}"
            }
        }
        let rl: String = if (noValue) { "void" } else { F.LlOf(ret) }
        Gen.Declare(g, inst.Name, "declare ${rl} @${inst.Name}(${ptypes})")
        if (noValue) {
            F.Emit("call void @${inst.Name}(${a})")
            if (ret.Id == g.Tt.Never.Id) {
                F.Emit("unreachable")
                F.Term = true
                return F.NeverVal(None)
            }
            if (ret.Id == g.Tt.Unit.Id) {
                return F.UnitVal()
            }
            let t: String = F.Tmp()
            F.Emit("${t} = load { ptr, i64 }, ptr ${slot}")
            return Ctx.Val.New(g.Tt.Str, t)
        }
        let t: String = F.Tmp()
        F.Emit("${t} = call ${F.LlOf(ret)} @${inst.Name}(${a})")
        return Ctx.Val.New(ret, t)
    }
    mut i: I64 = 0
    while (i < args.Len()) {
        if (i > 0) {
            a = "${a}, "
        }
        a = "${a}${F.LlOf(args[i].T)} ${args[i].V}"
        i += 1
    }
    if (ret.Id == g.Tt.Unit.Id || ret.Id == g.Tt.Never.Id) {
        F.Emit("call void @\"${inst.Name}\"(${a})")
        if (ret.Id == g.Tt.Never.Id) {
            F.Emit("unreachable")
            F.Term = true
            return F.NeverVal(None)
        }
        return F.UnitVal()
    }
    let t: String = F.Tmp()
    F.Emit("${t} = call ${F.LlOf(ret)} @\"${inst.Name}\"(${a})")
    Ctx.Val.New(ret, t)
}

// Call function `d` with the arguments of `call`, inferring generic arguments.
fn genCallDecl(mut F: Ctx.FnCtx, callIn: Ast.Node, d: Resolve.Decl, self: Option<Types.Type>, explicit: Option<Array<Ast.Node>>, expect: Option<Types.Type>, recv: Option<Ctx.Val>) -> Ctx.Val {
    mut g: Gen.Gen = F.G
    let fnNode: Ast.Node = d.Node
    mut call: Ast.Node = callIn
    let ntp: I64 = fnNode.List2.Len()
    mut env: Gen.Env = Gen.MakeEnv(g, d, self, None)
    match (explicit) {
        Some(ex) => {
            if (ex.Len() > 0) {
                if (ex.Len() != ntp) {
                    g.Diag.Error(call.Pos, "`${fnNode.Name}` takes ${ntp} type argument(s), found ${ex.Len()}")
                    return F.ErrVal()
                }
                mut i: I64 = 0
                while (i < ntp) {
                    env.Add(fnNode.List2[i].Name, Gen.ResolveType(g, F.File, F.Env, ex[i]))
                    i += 1
                }
            }
        },
        None => {},
    }
    // `params xs: Array<T>`: the values at the end of the call are collected into an array
    mut pi: I64 = 0
    while (pi < fnNode.List.Len()) {
        let pm: Ast.Node = fnNode.List[pi]
        if (pm.Flag2 && pi != fnNode.List.Len() - 1) {
            g.Diag.Error(pm.Pos, "only the last parameter can be `params`")
            return F.ErrVal()
        }
        pi += 1
    }
    if (fnNode.List.Len() > 0 && fnNode.List[fnNode.List.Len() - 1].Flag2) {
        let fixed: I64 = fnNode.List.Len() - 1
        if (call.List.Len() < fixed) {
            g.Diag.Error(call.Pos, "`${fnNode.Name}` takes at least ${fixed} argument(s), but ${call.List.Len()} were given")
            return F.ErrVal()
        }
        mut packed: Ast.Node = call.Copy()
        packed.List = []
        mut arr: Ast.Node = Ast.Node.New(Ast.NK.Array, call.Pos)
        mut i: I64 = 0
        while (i < call.List.Len()) {
            if (i < fixed) {
                packed.List.Push(call.List[i])
            } else {
                arr.List.Push(call.List[i])
            }
            i += 1
        }
        packed.List.Push(arr)
        call = packed
    }
    mut nparams: I64 = 0
    for (pm in fnNode.List) {
        if (!pm.Flag3) {
            nparams += 1
        }
    }
    let variadic: Bool = nparams < fnNode.List.Len()
    if (if (variadic) { call.List.Len() < nparams } else { call.List.Len() != nparams }) {
        g.Diag.Error(call.Pos, "`${fnNode.Name}` takes ${if (variadic) { "at least " } else { "" }}${nparams} argument(s), but ${call.List.Len()} were given")
        return F.ErrVal()
    }
    mut vals: Array<Ctx.Val> = []
    mut postponed: Array<Bool> = []
    mut k: I64 = 0
    while (k < nparams) {
        vals.Push(F.ErrVal())
        postponed.Push(false)
        k += 1
    }
    mut never: Bool = false
    // a bare number literal for a parameter whose type is still unknown (`Reduce(0, f)`) waits until the other
    // arguments have fixed the type parameters; it has no side effects, so the order does not matter
    mut pass: I64 = 0
    while (pass < 2) {
        mut i: I64 = 0
        while (i < nparams) {
            let pn: Ast.Node = fnNode.List[i]
            let an: Ast.Node = call.List[i]
            let unbound: Bool = syntaxUsesUnbound(nn(pn.A), fnNode, env)
            if (pass == 0 && unbound && isUntypedLit(an)) {
                postponed[i] = true
            } else if (pass == 1 && !postponed[i]) {
            } else {
                let pexp: Option<Types.Type> = if (unbound) { None } else { Some(Gen.ResolveType(g, d.FileInfo(), env, nn(pn.A))) }
                let v: Ctx.Val = genExpr(F, an, pexp)
                vals[i] = v
                if (v.T.Id == g.Tt.Never.Id) {
                    never = true
                } else if (pexp.IsNone()) {
                    unify(g, nn(pn.A), v.T, fnNode, env)
                }
            }
            i += 1
        }
        pass += 1
    }
    if (never) {
        return F.NeverVal(expect)
    }
    mut targs: Array<Types.Type> = []
    mut ti: I64 = 0
    while (ti < ntp) {
        let tp: Ast.Node = fnNode.List2[ti]
        mut t: Option<Types.Type> = env.Get(tp.Name)
        if (t.IsNone()) {
            match (expect) {
                Some(e) => {
                    match (fnNode.A) {
                        Some(ra) => {
                            unify(g, ra, e, fnNode, env)
                            t = env.Get(tp.Name)
                        },
                        None => {},
                    }
                },
                None => {},
            }
        }
        match (t) {
            Some(x) => targs.Push(x),
            None => {
                g.Diag.Error(call.Pos, "cannot infer the type parameter `${tp.Name}` of `${fnNode.Name}` (write it explicitly, like `${fnNode.Name}<I32>(...)`)")
                return F.ErrVal()
            },
        }
        ti += 1
    }
    if (ntp > 0) {
        Gen.CheckBounds(g, d.FileInfo(), fnNode, targs, Some(env), fnNode.Name, call.Pos)
    }
    let inst: Gen.Inst = Gen.GetInst(g, d, self, Some(targs))
    mut i: I64 = 0
    while (i < nparams) {
        mut what: String = "argument ${i + 1} of `${fnNode.Name}`"
        if (call.Flag3) {
            // written as `a[i]` or `a[i] = v`
            what = if (fnNode.Name == "SetIndex" && i == 1) { "an assignment" } else { "an index" }
        }
        let cv: Ctx.Val = coerce(F, call.List[i].Pos, vals[i], inst.Ptypes[i], what)
        vals[i] = cv
        if (g.IsErr(cv.T)) {
            return F.ErrVal()
        }
        i += 1
    }
    let mut_i0: I64 = nparams
    mut j: I64 = mut_i0
    while (j < call.List.Len()) {
        // the `...` part: C types and pointers, promoted the way C does
        let an: Ast.Node = call.List[j]
        mut v: Ctx.Val = genExpr(F, an, None)
        if (v.T.Id == g.Tt.Never.Id) {
            return F.NeverVal(expect)
        }
        if (g.IsErr(v.T)) {
            return F.ErrVal()
        }
        if (!Gen.IsCValueType(v.T)) {
            g.Diag.Error(an.Pos, "argument ${j + 1} of `${fnNode.Name}` has type `${v.T.Name}`; the `...` part of a C function takes only C types and pointers")
            if (v.T.IsNumeric()) {
                g.Diag.Note("convert it with a method such as `.ToCInt()` or `.ToCDouble()`")
            } else if (v.T.Id == g.Tt.Str.Id) {
                g.Diag.Note("convert a String with `.ToC()`")
            }
            return F.ErrVal()
        }
        if (v.T.Kind == Types.TKind.CType && v.T.Ll == "float") {
            let r: String = F.Tmp()
            F.Emit("${r} = fpext float ${v.V} to double")
            v = Ctx.Val.New(nnT(g.Tt.CByName("CDouble")), r)
        } else if (v.T.Kind == Types.TKind.CType && Text.StartsWith(v.T.Ll, "i") && v.T.Size < 4) {
            let r: String = F.Tmp()
            let sgn: Bool = v.T.PayloadWords == 1 && v.T.Name != "CBool"
            F.Emit("${r} = ${if (sgn) { "sext" } else { "zext" }} ${v.T.Ll} ${v.V} to i32")
            v = Ctx.Val.New(nnT(g.Tt.CByName(if (sgn) { "CInt" } else { "CUInt" })), r)
        }
        vals.Push(v)
        j += 1
    }
    g.CallPos = call.Pos
    match (recv) {
        Some(r) => {
            // the receiver goes first
            mut all: Array<Ctx.Val> = [r]
            for (v in vals) {
                all.Push(v)
            }
            emitCall(F, inst, all)
        },
        None => emitCall(F, inst, vals),
    }
}

fn nnT(t: Option<Types.Type>) -> Types.Type {
    match (t) {
        Some(x) => x,
        None => Panic("type is missing"),
    }
}

fn mkIdent(pos: Token.Pos, name: String) -> Ast.Node {
    mut n: Ast.Node = Ast.Node.New(Ast.NK.Ident, pos)
    n.SetName(name)
    n
}

fn mkMethodCall(recv: Ast.Node, method: String, pos: Token.Pos, a1: Option<Ast.Node>, a2: Option<Ast.Node>) -> Ast.Node {
    mut m: Ast.Node = Ast.Node.New(Ast.NK.Member, pos)
    m.A = Some(recv)
    m.SetName(method)
    mut c: Ast.Node = Ast.Node.New(Ast.NK.Call, pos)
    c.A = Some(m)
    match (a1) {
        Some(x) => c.List.Push(x),
        None => {},
    }
    match (a2) {
        Some(x) => c.List.Push(x),
        None => {},
    }
    c
}
