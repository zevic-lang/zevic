module Zevic1.Home

// Where the standard library and the runtime live (zevic0/driver.c: driver_find_home).

import Zevic.Env
import Zevic.Fs

// The directory part of a path, "." when it has none.
fn DirOf(path: String) -> String {
    mut last: I64 = -1
    mut i: I64 = 0
    while (i < path.Len()) {
        let c: I32 = path.ByteAt(i).ToI32Wrap()
        if (c == 47 || c == 92) { last = i }
        i += 1
    }
    if (last < 0) { "." } else { path.Slice(0, last) }
}

fn isHome(dir: String) -> Bool {
    Fs.IsFile("${dir}/runtime/zevic_rt.c") && Fs.IsDir("${dir}/stdlib")
}

fn Find() -> Option<String> {
    match (Env.Get("ZEVIC_HOME")) {
        Some(h) => {
            if (h != "" && isHome(h)) { return Some(h) }
        },
        None => {},
    }
    let dir: String = DirOf(Env.ExePath())
    let cands: Array<String> = ["${dir}/../share/zevic", "${dir}/..", dir, "."]
    for (c in cands) {
        if (isHome(c)) { return Some(c) }
    }
    None
}
