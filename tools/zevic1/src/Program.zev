module Zevic1.Program

// Whole-program emission: a port of the end of zevic0/gen.c (emit_function, find_main, gen_program, gen_header).

import Zevic.Text
import Zevic1.Ast as Ast
import Zevic1.Ctx as Ctx
import Zevic1.Expr as Expr
import Zevic1.Gen as Gen
import Zevic1.Resolve as Resolve
import Zevic1.Token as Token
import Zevic1.Types as Types

fn noPos() -> Token.Pos { Token.Pos.New(0, 0, 0) }

fn emitFunction(mut g: Gen.Gen, mut inst: Gen.Inst) {
    if (inst.Emitted) {
        return
    }
    inst.Emitted = true
    let fnNode: Ast.Node = inst.D.Node
    mut fc: Ctx.FnCtx = Ctx.FnCtx.New(g, inst, inst.D.FileInfo(), Some(inst.Ret))
    fc.Cur = "entry"
    Expr.CollectLambdaNames(fnNode.B, fc.Heap)
    fc.PushScope()
    mut params: String = ""
    if (inst.HasThis) {
        params = "ptr %this"
        fc.HasThis = true
        fc.ThisT = inst.SelfT
        fc.ThisMut = fnNode.IsMutFn || fnNode.Name == "Init"
        let st: Types.Type = Expr.ThisType(fc)
        if (st.Kind == Types.TKind.Class) {
            // a class `this` is an object pointer; keep it in a slot so it can be used like a variable
            fc.ThisSlot = fc.NewSlot(st)
            fc.Emit("store ptr %this, ptr ${fc.ThisSlot}")
        } else {
            fc.ThisSlot = "%this"
        }
    }
    mut i: I64 = 0
    while (i < inst.Ptypes.Len()) {
        let pn: Ast.Node = fnNode.List[i]
        let pt: Types.Type = inst.Ptypes[i]
        if (params.Len() > 0) {
            params = "${params}, "
        }
        params = "${params}${fc.LlOf(pt)}${if (inst.IsExport) { Expr.CExtAttr(pt) } else { "" }} %p${i}"
        let l: Ctx.Local = Expr.DeclareLocal(fc, pn.Name, pt, pn.Flag, pn.Pos)
        if (pt.Id != g.Tt.Unit.Id) {
            fc.StoreTo(pt, Ctx.Val.New(pt, "%p${i}"), l.Ptr)
        }
        i += 1
    }
    let body: Ast.Node = match (fnNode.B) {
        Some(b) => b,
        None => {
            g.Diag.Error(fnNode.Pos, "function `${fnNode.Name}` has no body")
            return
        },
    }
    mut v: Ctx.Val = Expr.GenBlock(fc, body, Some(inst.Ret))
    if (!fc.Term) {
        if (inst.Ret.Id == g.Tt.Unit.Id) {
            fc.Emit("ret void")
        } else if (inst.Ret.Id == g.Tt.Never.Id) {
            fc.Emit("unreachable")
        } else {
            v = Expr.Coerce(fc, body.Pos, v, inst.Ret, "the function result (the body must end with a value or `return`)")
            if (g.IsErr(v.T)) {
                fc.Emit("unreachable")
            } else {
                fc.Emit("ret ${fc.LlOf(inst.Ret)} ${v.V}")
            }
        }
        fc.Term = true
    }
    mut rl: String = if (inst.Ret.Id == g.Tt.Unit.Id || inst.Ret.Id == g.Tt.Never.Id) { "void" } else { fc.LlOf(inst.Ret) }
    if (inst.IsExport && !Text.StartsWith(rl, "void")) {
        let ra: String = Expr.CExtAttr(inst.Ret)
        if (ra.Len() > 0) {
            rl = "${ra.Slice(1, ra.Len())} ${rl}"
        }
    }
    g.Funcs.Put("define ${rl} @\"${inst.Name}\"(${params}) {\nentry:\n${fc.Allocas.String()}${fc.Code.String()}${fc.Cold.String()}}\n\n")
}

fn findMain(mut g: Gen.Gen) -> Option<Resolve.Decl> {
    match (g.Pg.FindModule("Main")) {
        Some(m) => {
            match (m.Decls.Get("Main")) {
                Some(d) => {
                    if (d.Node.Kind == Ast.NK.DFn) {
                        return Some(d)
                    }
                },
                None => {},
            }
        },
        None => {},
    }
    g.Diag.Error(noPos(), "no entry point: a program needs `module Main` with a public `fn Main()`")
    None
}

// The text of the LLVM IR, or None when there were errors.
fn GenProgram(mut g: Gen.Gen) -> Option<String> {
    let mdOpt: Option<Resolve.Decl> = if (g.TestMode || g.LibMode) { None } else { findMain(g) }
    mut mainIn: Option<Gen.Inst> = None
    mut argsIn: Option<Gen.Inst> = None
    match (mdOpt) {
        Some(md) => {
            let fnNode: Ast.Node = md.Node
            if (fnNode.List2.Len() > 0) {
                g.Diag.Error(fnNode.Pos, "`Main` cannot have type parameters")
            } else if (fnNode.List.Len() > 1) {
                g.Diag.Error(fnNode.Pos, "`Main` takes no parameters or one `args: Array<String>`")
            } else {
                let mi: Gen.Inst = Gen.GetInst(g, md, None, None)
                mainIn = Some(mi)
                if (fnNode.List.Len() == 1) {
                    let ra: Option<Resolve.Decl> = match (g.Pg.FindModule("Zevic.Env")) {
                        Some(em) => em.Decls.Get("RawArgs"),
                        None => None,
                    }
                    match (ra) {
                        Some(rd) => {
                            let ai: Gen.Inst = Gen.GetInst(g, rd, None, None)
                            argsIn = Some(ai)
                            if (mi.Ptypes[0].Name != ai.Ret.Name) {
                                g.Diag.Error(fnNode.Pos, "the parameter of `Main` must be `args: Array<String>`")
                            }
                        },
                        None => g.Diag.Error(fnNode.Pos, "cannot find `Zevic.Env.RawArgs` for the arguments of `Main`"),
                    }
                }
                if (mi.Ret.Id != g.Tt.Unit.Id && !g.IsErr(mi.Ret)) {
                    g.Diag.Error(fnNode.Pos, "`Main` must not return a value (use `Env.Exit(code)` to set the exit code)")
                }
            }
        },
        None => {},
    }
    // check every non-generic function of the user's modules, even if unused
    for (m in g.Pg.Modules) {
        if (m.IsStd) {
            continue
        }
        for (d in m.Decls.Values()) {
            let dk: Ast.NK = d.Node.Kind
            if (dk == Ast.NK.DFn && d.Abi == "" && d.Node.List2.Len() == 0) {
                let unused: Gen.Inst = Gen.GetInst(g, d, None, None)
            }
            if ((dk == Ast.NK.DStruct || dk == Ast.NK.DClass || dk == Ast.NK.DEnum) && d.Node.List2.Len() == 0) {
                // check every method of a non-generic type, even one that is never called
                let t: Types.Type = Gen.Instantiate(g, d, [], d.Node.Pos)
                for (mn in d.Node.List) {
                    if (mn.Kind == Ast.NK.DFn && mn.List2.Len() == 0) {
                        let unused: Gen.Inst = Gen.GetInst(g, Gen.MethodDecl(g, t, mn), Some(t), None)
                    }
                }
            }
        }
    }
    mut tests: Array<Gen.Inst> = []
    mut tnames: Array<String> = []
    if (g.TestMode) {
        for (m in g.Pg.Modules) {
            if (m.IsStd) {
                continue
            }
            for (td in m.Tests) {
                tests.Push(Gen.GetInst(g, td, None, None))
                tnames.Push(Expr.ConstPtr(Gen.StrConst(g, td.TestName)))
            }
        }
    }
    // emitting a function can add more to the worklist
    mut wi: I64 = 0
    while (wi < g.Worklist.Len()) {
        emitFunction(g, g.Worklist[wi])
        wi += 1
    }
    if (g.Diag.Errors > 0) {
        return None
    }
    mut out: String = "; generated by zevic0\nsource_filename = \"zevic\"\n\n"
    out = "${out}${g.Globals.String()}\n${g.Decls.String()}declare void @zevic_init(i32, ptr)\n\n${g.Funcs.String()}"
    if (g.TestMode) {
        out = "${out}declare void @zevic_test_add(ptr, i64, ptr)\ndeclare i32 @zevic_test_main()\n\n"
        out = "${out}define i32 @main(i32 %argc, ptr %argv) {\n  call void @zevic_init(i32 %argc, ptr %argv)\n"
        mut i: I64 = 0
        while (i < tests.Len()) {
            let inst: Gen.Inst = tests[i]
            out = "${out}  call void @zevic_test_add(ptr ${tnames[i]}, i64 ${inst.D.TestName.Len()}, ptr @\"${inst.Name}\")\n"
            i += 1
        }
        return Some("${out}  %rc = call i32 @zevic_test_main()\n  ret i32 %rc\n}\n")
    }
    if (g.LibMode) {
        return Some(out)
    }
    out = "${out}define i32 @main(i32 %argc, ptr %argv) {\n  call void @zevic_init(i32 %argc, ptr %argv)\n"
    let mi: Gen.Inst = match (mainIn) {
        Some(x) => x,
        None => return None,
    }
    match (argsIn) {
        Some(ai) => {
            let al: String = ctxLl(g, ai.Ret)
            out = "${out}  %args = call ${al} @\"${ai.Name}\"()\n  call void @\"${mi.Name}\"(${al} %args)\n"
        },
        None => { out = "${out}  call void @\"${mi.Name}\"()\n" },
    }
    Some("${out}  ret i32 0\n}\n")
}

// ---- the C header ----

fn cSpelling(t: Types.Type, g: Gen.Gen) -> String {
    if (t.Id == g.Tt.Unit.Id) {
        return "void"
    }
    if (t.Kind == Types.TKind.Ptr) {
        let inner: String = cSpelling(t.Args[0], g)
        return "${inner}${if (Text.EndsWith(inner, "*")) { "" } else { " " }}*"
    }
    if (t.Kind == Types.TKind.Struct) {
        return "struct ${shortName(t)}"
    }
    let tab: Array<(String, String)> = [
        ("CChar", "char"), ("CSChar", "signed char"), ("CUChar", "unsigned char"), ("CShort", "short"),
        ("CUShort", "unsigned short"), ("CInt", "int"), ("CUInt", "unsigned int"), ("CLong", "long"),
        ("CULong", "unsigned long"), ("CLongLong", "long long"), ("CULongLong", "unsigned long long"),
        ("CSizeT", "size_t"), ("CSSizeT", "intptr_t"), ("CPtrDiff", "ptrdiff_t"), ("CIntPtr", "intptr_t"),
        ("CUIntPtr", "uintptr_t"), ("CFloat", "float"), ("CDouble", "double"), ("CBool", "_Bool"),
        ("CString", "const char *"), ("CVoid", "void"),
    ]
    for (e in tab) {
        let (k, v): (String, String) = e
        if (k == t.Name) {
            return v
        }
    }
    "int"
}

fn headerStruct(mut g: Gen.Gen, t: Types.Type, mut seen: Map<String, Bool>, mut out: Array<String>) {
    if (t.Kind == Types.TKind.Ptr) {
        headerStruct(g, t.Args[0], seen, out)
        return
    }
    if (t.Kind != Types.TKind.Struct || seen.Contains(t.Name)) {
        return
    }
    seen.Set(t.Name, true)
    Gen.EnsureMembers(g, t)
    for (f in t.Fields) {
        headerStruct(g, f.T, seen, out)
    }
    out.Push("struct ${shortName(t)} {\n")
    for (f in t.Fields) {
        out.Push("    ${cSpelling(f.T, g)} ${f.Name};\n")
    }
    out.Push("};\n\n")
}

fn GenHeader(mut g: Gen.Gen, guard: String) -> String {
    mut out: Array<String> = []
    out.Push("/* generated by zevic0: the `export \"C\"` functions of this program */\n#ifndef ${guard}\n#define ${guard}\n\n")
    out.Push("#include <stddef.h>\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
    if (g.LibMode) {
        out.Push("/* Call this once before any other function of the library. */\nvoid zevic_init(int argc, char **argv);\n\n")
    }
    mut seen: Map<String, Bool> = Map.New()
    for (inst in g.Exports) {
        for (pt in inst.Ptypes) {
            headerStruct(g, pt, seen, out)
        }
        headerStruct(g, inst.Ret, seen, out)
    }
    for (inst in g.Exports) {
        out.Push("${cSpelling(inst.Ret, g)} ${inst.Name}(")
        if (inst.Ptypes.Len() == 0) {
            out.Push("void")
        }
        mut k: I64 = 0
        while (k < inst.Ptypes.Len()) {
            out.Push("${if (k > 0) { ", " } else { "" }}${cSpelling(inst.Ptypes[k], g)} ${inst.D.Node.List[k].Name}")
            k += 1
        }
        out.Push(");\n")
    }
    out.Push("\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n")
    out.Join("")
}

fn ctxLl(mut g: Gen.Gen, t: Types.Type) -> String {
    mut tt: Types.TypeTable = g.Tt
    tt.LlOf(t)
}

// "Main::Point" -> "Point"
fn shortName(t: Types.Type) -> String {
    match (Text.IndexOf(t.DeclName, "::")) {
        Some(i) => t.DeclName.Slice(i + 2, t.DeclName.Len()),
        None => t.DeclName,
    }
}
