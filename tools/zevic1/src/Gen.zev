module Zevic1.Gen

// Type checking and LLVM IR generation: a port of zevic0/gen.c, in the order of that file.
// So far: the state, names, declaration lookup and types from syntax.

import Zevic.Console
import Zevic.Text
import Zevic1.Ast as Ast
import Zevic1.Diag as Diag
import Zevic1.Resolve as Resolve
import Zevic1.Token as Token
import Zevic1.Types as Types

// A mapping from type parameter names to types, plus `Self`.
class Env {
    Names: Array<String> = []
    Types: Array<Types.Type> = []
    SelfT: Option<Types.Type> = None

    mut fn Add(name: String, t: Types.Type) {
        this.Names.Push(name)
        this.Types.Push(t)
    }

    fn Get(name: String) -> Option<Types.Type> {
        mut i: I64 = this.Names.Len() - 1
        while (i >= 0) {
            if (this.Names[i] == name) {
                return Some(this.Types[i])
            }
            i -= 1
        }
        None
    }
}

// Pieces of text that are joined at the end (cheaper than growing one string).
class Sb {
    Parts: Array<String> = []

    mut fn Put(s: String) {
        this.Parts.Push(s)
    }

    fn String() -> String { this.Parts.Join("") }
}

class Gen {
    Pg: Resolve.Program
    Diag: Diag.Diag
    Tt: Types.TypeTable
    // The type of an expression that already produced an error: it matches everything.
    Err: Types.Type
    // set while resolving the interfaces a type implements or extends, and constraints
    AllowSelfyIface: Bool = false
    // every declaration of the program by its key
    DeclByKey: Map<String, Resolve.Decl> = Map.New()
    // declarations made for methods and for the default methods of interfaces (once each)
    MethodDecls: Map<String, Resolve.Decl> = Map.New()
    Defaults: Map<String, Resolve.Decl> = Map.New()
    // the function instances (one LLVM function each) by their symbol, and the ones still to be generated
    Insts: Map<String, Inst> = Map.New()
    Worklist: Array<Inst> = []
    // the `export "C"` functions
    Exports: Array<Inst> = []
    // string constants, `declare` lines and function definitions of the module
    Globals: Sb = Sb.New()
    Decls: Sb = Sb.New()
    Funcs: Sb = Sb.New()
    Declared: Map<String, Bool> = Map.New()
    NStr: I64 = 0
    StrConst: Map<String, String> = Map.New()
    TestMode: Bool = false
    LibMode: Bool = false
    NLambda: I64 = 0
    // wrapper functions already written (thunks and C callbacks), by name
    Thunks: Map<String, String> = Map.New()
    // "<function symbol>:%tN" -> symbol of a lambda that captures nothing (so it can go to C as a callback)
    Noenv: Map<String, String> = Map.New()
    // the call being generated, for errors found while emitting it
    CallPos: Token.Pos = Token.Pos.New(0, 0, 0)
    // method tables of interface values by "type|interface", and how many there are
    Vtables: Map<String, String> = Map.New()
    NVt: I64 = 0

    fn Init(pg: Resolve.Program, diag: Diag.Diag, longBytes: I64) {
        this.Pg = pg
        this.Diag = diag
        this.Tt = Types.TypeTable.New(longBytes)
        this.Err = this.Tt.Param("error")
        for (m in pg.Modules) {
            for (d in m.Decls.Values()) {
                this.DeclByKey.Set(d.Key(), d)
            }
        }
    }

    fn IsErr(t: Types.Type) -> Bool { t.Id == this.Err.Id }
}

// ---- names ----

fn QualifiedName(d: Resolve.Decl) -> String {
    if (d.ModName == "Zevic.Core") {
        return d.Name
    }
    "${d.ModName}.${d.Name}"
}

// ---- declaration lookup ----

fn LookupInPrelude(g: Gen, name: String) -> Option<Resolve.Decl> {
    match (g.Pg.FindModule("Zevic.Core")) {
        Some(core) => {
            match (core.Decls.Get(name)) {
                Some(d) => if (d.IsPub) { Some(d) } else { None },
                None => None,
            }
        },
        None => None,
    }
}

// Finds the declaration a dotted path starts with. `used` is the number of segments consumed (the module prefix plus
// the declaration name), or -1 after an error was reported.
fn FindDecl(mut g: Gen, f: Resolve.FileInfo, segs: Array<String>, pos: Token.Pos) -> (Option<Resolve.Decl>, I64) {
    let mod: Resolve.Module = match (f.Mod) {
        Some(m) => m,
        None => return (None, 0),
    }
    mut k: I64 = segs.Len() - 1
    while (k >= 1) {
        let prefix: String = segs.Slice(0, k).Join(".")
        match (f.ImportMap.Get(prefix)) {
            Some(m) => {
                match (m.Decls.Get(segs[k])) {
                    Some(d) => {
                        if (!d.IsPub && d.ModName != mod.Name) {
                            g.Diag.Error(pos, "`${segs[k]}` is private to module `${m.Name}` (names starting with a lowercase letter are not exported)")
                            return (None, -1)
                        }
                        return (Some(d), k + 1)
                    },
                    None => {
                        g.Diag.Error(pos, "module `${m.Name}` has no member `${segs[k]}`")
                        return (None, -1)
                    },
                }
            },
            None => {},
        }
        k -= 1
    }
    match (mod.Decls.Get(segs[0])) {
        Some(d) => return (Some(d), 1),
        None => {},
    }
    match (LookupInPrelude(g, segs[0])) {
        Some(d) => return (Some(d), 1),
        None => {},
    }
    (None, 0)
}

// ---- types from syntax ----

fn SyntaxMentionsSelf(te: Option<Ast.Node>) -> Bool {
    let n: Ast.Node = match (te) {
        Some(x) => x,
        None => return false,
    }
    match (n.Kind) {
        Ast.NK.TypeName => {
            if (n.Path.Len() == 1 && n.Path[0] == "Self") {
                return true
            }
            for (x in n.List) {
                if (SyntaxMentionsSelf(Some(x))) {
                    return true
                }
            }
            false
        },
        Ast.NK.TypeTuple | Ast.NK.TypeFn | Ast.NK.TypeUnion => {
            for (x in n.List) {
                if (SyntaxMentionsSelf(Some(x))) {
                    return true
                }
            }
            SyntaxMentionsSelf(n.A)
        },
        Ast.NK.TypePtr => SyntaxMentionsSelf(n.A),
        _ => false,
    }
}

// Does an interface mention `Self` in a method signature? Such an interface only works as a constraint.
fn ifaceUsesSelf(decl: Ast.Node) -> Bool {
    for (m in decl.List) {
        if (m.Kind != Ast.NK.DFn) {
            continue
        }
        for (p in m.List) {
            if (SyntaxMentionsSelf(p.A)) {
                return true
            }
        }
        if (SyntaxMentionsSelf(m.A)) {
            return true
        }
    }
    false
}

fn Instantiate(mut g: Gen, d: Resolve.Decl, targs: Array<Types.Type>, pos: Token.Pos) -> Types.Type {
    let n: Ast.Node = d.Node
    if (n.List2.Len() != targs.Len()) {
        if (n.List2.Len() == 0) {
            g.Diag.Error(pos, "type `${d.Name}` takes no type arguments")
        } else {
            g.Diag.Error(pos, "type `${d.Name}` needs ${n.List2.Len()} type argument(s), found ${targs.Len()}")
        }
        return g.Err
    }
    if (targs.Len() > 0) {
        CheckBounds(g, d.FileInfo(), n, targs, None, d.Name, pos)
    }
    mut k: Types.TKind = match (n.Kind) {
        Ast.NK.DStruct => Types.TKind.Struct,
        Ast.NK.DClass => Types.TKind.Class,
        Ast.NK.DInterface => Types.TKind.Iface,
        _ => Types.TKind.Enum,
    }
    if (d.ModIsStd && d.ModName == "Zevic.Intrinsics" && d.Name == "Buf") {
        k = Types.TKind.Buf
    }
    let t: Types.Type = g.Tt.Named(k, d.Key(), QualifiedName(d), targs)
    EnsureMembers(g, t)
    t
}

// Array<elem>: the class from Zevic.Core.
fn ArrayType(mut g: Gen, elem: Types.Type) -> Types.Type {
    match (LookupInPrelude(g, "Array")) {
        Some(d) => Instantiate(g, d, [elem], d.Node.Pos),
        None => {
            g.Diag.Error(Token.Pos.New(0, 0, 0), "the standard library file Core.zev is missing (cannot find `Array`)")
            g.Err
        },
    }
}

// Resolves the fields (struct, class) or variants (enum) of a type.
fn EnsureMembers(mut g: Gen, mut t: Types.Type) {
    if (t.MembersDone) {
        return
    }
    t.MembersDone = true
    let d: Resolve.Decl = match (g.DeclByKey.Get(t.DeclName)) {
        Some(x) => x,
        None => return,
    }
    let n: Ast.Node = d.Node
    mut env: Env = Env.New()
    env.SelfT = Some(t)
    mut i: I64 = 0
    while (i < n.List2.Len()) {
        env.Add(n.List2[i].Name, t.Args[i])
        i += 1
    }
    let f: Resolve.FileInfo = d.FileInfo()
    if (n.Kind == Ast.NK.DStruct || n.Kind == Ast.NK.DClass) {
        for (m in n.List) {
            if (m.Kind != Ast.NK.Field || m.Flag) {
                continue
            }
            t.Fields.Push(Types.Field.New(m.Name, ResolveType(g, f, env, UnwrapNode(m.A))))
        }
    } else if (n.Kind == Ast.NK.DEnum) {
        mut tag: I32 = 0
        for (m in n.List) {
            if (m.Kind != Ast.NK.Variant) {
                continue
            }
            mut v: Types.Variant = Types.Variant.New(m.Name, tag)
            tag += 1
            v.Named = m.Flag
            mut ptypes: Array<Types.Type> = []
            if (m.Flag) {
                for (fd in m.List2) {
                    let ft: Types.Type = ResolveType(g, f, env, UnwrapNode(fd.A))
                    v.Fields.Push(Types.Field.New(fd.Name, ft))
                    ptypes.Push(ft)
                }
            } else {
                mut k: I64 = 0
                for (x in m.List) {
                    let ft: Types.Type = ResolveType(g, f, env, x)
                    v.Fields.Push(Types.Field.New("${k}", ft))
                    ptypes.Push(ft)
                    k += 1
                }
            }
            if (ptypes.Len() > 0) {
                v.Payload = Some(g.Tt.Tuple(ptypes))
            }
            t.Variants.Push(v)
        }
    }
    if (n.List3.Len() > 0 && n.Kind != Ast.NK.DInterface) {
        CheckConformance(g, t)
    }
}

fn UnwrapNode(n: Option<Ast.Node>) -> Ast.Node {
    match (n) {
        Some(x) => x,
        None => Panic("a syntax node is missing"),
    }
}

fn ResolveType(mut g: Gen, f: Resolve.FileInfo, env: Env, te: Ast.Node) -> Types.Type {
    match (te.Kind) {
        Ast.NK.TypeTuple => {
            mut elems: Array<Types.Type> = []
            for (x in te.List) {
                elems.Push(ResolveType(g, f, env, x))
            }
            g.Tt.Tuple(elems)
        },
        Ast.NK.TypeFn => {
            mut ps: Array<Types.Type> = []
            for (x in te.List) {
                ps.Push(ResolveType(g, f, env, x))
            }
            let ret: Types.Type = ResolveType(g, f, env, UnwrapNode(te.A))
            g.Tt.Fn(ps, ret)
        },
        Ast.NK.TypePtr => {
            let inner: Types.Type = ResolveType(g, f, env, UnwrapNode(te.A))
            g.Tt.Ptr(inner)
        },
        Ast.NK.TypeUnion => {
            mut ms: Array<Types.Type> = []
            mut bad: Bool = false
            for (x in te.List) {
                let m: Types.Type = ResolveType(g, f, env, x)
                if (g.IsErr(m)) {
                    bad = true
                } else if (m.Id == g.Tt.Never.Id) {
                    g.Diag.Error(x.Pos, "`Never` cannot be a member of a union")
                    bad = true
                } else {
                    ms.Push(m)
                }
            }
            if (bad) {
                return g.Err
            }
            let u: Types.Type = g.Tt.Union(ms)
            if (u.Kind != Types.TKind.Union) {
                g.Diag.Error(te.Pos, "a union needs at least two different types (found only `${u.Name}`)")
            }
            u
        },
        Ast.NK.TypeName => ResolveTypeName(g, f, env, te),
        _ => {
            g.Diag.Error(te.Pos, "expected a type")
            g.Err
        },
    }
}

fn ResolveTypeName(mut g: Gen, f: Resolve.FileInfo, env: Env, te: Ast.Node) -> Types.Type {
    let segs: Array<String> = te.Path
    let n: I64 = segs.Len()
    if (n == 1) {
        let name: String = segs[0]
        match (env.Get(name)) {
            Some(bound) => return bound,
            None => {},
        }
        if (name == "Self") {
            match (env.SelfT) {
                Some(s) => return s,
                None => {
                    g.Diag.Error(te.Pos, "`Self` can only be used inside a type or interface")
                    return g.Err
                },
            }
        }
        match (g.Tt.PrimByName(name)) {
            Some(p) => {
                if (te.List.Len() > 0) {
                    g.Diag.Error(te.Pos, "type `${name}` takes no type arguments")
                }
                return p
            },
            None => {},
        }
        if (name == "Never") {
            return g.Tt.Never
        }
        match (g.Tt.CByName(name)) {
            Some(ct) => return ct,
            None => {},
        }
    }
    let (found, used): (Option<Resolve.Decl>, I64) = FindDecl(g, f, segs, te.Pos)
    if (used < 0) {
        return g.Err
    }
    let d: Resolve.Decl = match (found) {
        Some(x) => if (used == n) { x } else {
            g.Diag.Error(te.Pos, "unknown type `${Ast.PathJoin(te.Path, ".")}`")
            return g.Err
        },
        None => {
            g.Diag.Error(te.Pos, "unknown type `${Ast.PathJoin(te.Path, ".")}`")
            return g.Err
        },
    }
    let k: Ast.NK = d.Node.Kind
    if (k != Ast.NK.DStruct && k != Ast.NK.DClass && k != Ast.NK.DEnum && k != Ast.NK.DInterface) {
        g.Diag.Error(te.Pos, "`${d.Name}` is not a type")
        return g.Err
    }
    if (k == Ast.NK.DInterface && !g.AllowSelfyIface && ifaceUsesSelf(d.Node)) {
        g.Diag.Error(te.Pos, "`${d.Name}` uses `Self`, so it can only be used as a constraint (`<T: ${d.Name}>`), not as the type of a value")
        return g.Err
    }
    mut targs: Array<Types.Type> = []
    for (x in te.List) {
        targs.Push(ResolveType(g, f, env, x))
    }
    Instantiate(g, d, targs, te.Pos)
}

// ---- --dump-types (compared with zevic0) ----

fn dumpType(mut g: Gen, t: Types.Type) {
    if (g.IsErr(t)) {
        Console.Println("<error>")
        return
    }
    g.Tt.Layout(t)
    Console.Println("${t.Name} | kind=${Types.KindNo(t.Kind)} size=${t.Size} align=${t.Align} ll=${t.Ll} words=${t.PayloadWords}")
    for (f in t.Fields) {
        Console.Println("  field ${f.Name}: ${f.T.Name}")
    }
    for (v in t.Variants) {
        let pn: String = match (v.Payload) { Some(p) => p.Name, None => "-" }
        Console.Println("  variant ${v.Name} tag=${v.Tag} named=${if (v.Named) { 1 } else { 0 }} payload=${pn}")
        for (f in v.Fields) {
            Console.Println("    ${f.Name}: ${f.T.Name}")
        }
    }
}

fn DumpTypes(mut g: Gen) {
    let none: Token.Pos = Token.Pos.New(0, 0, 0)
    for (m in g.Pg.Modules) {
        for (info in m.Files) {
            for (n in info.Sf.Decls) {
                if (n.Kind != Ast.NK.DStruct && n.Kind != Ast.NK.DClass && n.Kind != Ast.NK.DEnum) {
                    continue
                }
                if (n.List2.Len() > 0) {
                    continue
                }
                match (m.Decls.Get(n.Name)) {
                    Some(d) => dumpType(g, Instantiate(g, d, [], none)),
                    None => {},
                }
            }
        }
    }
    let errT: Types.Type = match (LookupInPrelude(g, "Error")) {
        Some(d) => Instantiate(g, d, [], none),
        None => g.Tt.I32,
    }
    match (LookupInPrelude(g, "Option")) {
        Some(d) => dumpType(g, Instantiate(g, d, [g.Tt.Str], none)),
        None => {},
    }
    match (LookupInPrelude(g, "Result")) {
        Some(d) => dumpType(g, Instantiate(g, d, [g.Tt.I32, errT], none)),
        None => {},
    }
    match (LookupInPrelude(g, "Map")) {
        Some(d) => dumpType(g, Instantiate(g, d, [g.Tt.Str, g.Tt.I64], none)),
        None => {},
    }
    dumpType(g, ArrayType(g, g.Tt.I32))
    dumpType(g, ArrayType(g, ArrayType(g, g.Tt.Str)))
}

// ---- function environments and members ----

fn MakeEnv(g: Gen, d: Resolve.Decl, self: Option<Types.Type>, fnTargs: Option<Array<Types.Type>>) -> Env {
    mut e: Env = Env.New()
    match (self) {
        Some(st) => {
            e.SelfT = Some(st)
            match (DeclNode(g, st)) {
                Some(td) => {
                    mut i: I64 = 0
                    while (i < td.List2.Len() && i < st.Args.Len()) {
                        e.Add(td.List2[i].Name, st.Args[i])
                        i += 1
                    }
                },
                None => {},
            }
        },
        None => {},
    }
    match (d.Iface) {
        Some(it) => {
            // a default method of an interface: the interface's type parameters are in scope
            match (DeclNode(g, it)) {
                Some(itd) => {
                    mut i: I64 = 0
                    while (i < itd.List2.Len() && i < it.Args.Len()) {
                        e.Add(itd.List2[i].Name, it.Args[i])
                        i += 1
                    }
                },
                None => {},
            }
        },
        None => {},
    }
    match (fnTargs) {
        Some(ts) => {
            mut i: I64 = 0
            while (i < d.Node.List2.Len() && i < ts.Len()) {
                e.Add(d.Node.List2[i].Name, ts[i])
                i += 1
            }
        },
        None => {},
    }
    e
}

// ---- interfaces ----

class IMethod {
    // the method as declared in the interface
    Fn: Ast.Node
    // the interface type (with type arguments) that declares it
    Owner: Types.Type

    fn Init(fnNode: Ast.Node, owner: Types.Type) {
        this.Fn = fnNode
        this.Owner = owner
    }
}

// the syntax node a struct, class, enum or interface type was declared with
fn DeclNode(g: Gen, t: Types.Type) -> Option<Ast.Node> {
    match (g.DeclByKey.Get(t.DeclName)) {
        Some(d) => Some(d.Node),
        None => None,
    }
}

fn DeclOfType(g: Gen, t: Types.Type) -> Option<Resolve.Decl> { g.DeclByKey.Get(t.DeclName) }

fn IsUserType(t: Types.Type) -> Bool {
    t.Kind == Types.TKind.Struct || t.Kind == Types.TKind.Class || t.Kind == Types.TKind.Enum
}

fn NameIsPub(n: String) -> Bool {
    let c: I32 = n.ByteAt(0).ToI32Wrap()
    c >= 65 && c <= 90
}

// The declaration of a method of `t`, made once per method.
fn MethodDecl(mut g: Gen, t: Types.Type, fnNode: Ast.Node) -> Resolve.Decl {
    let key: String = "${t.DeclName}.${fnNode.Name}"
    match (g.MethodDecls.Get(key)) {
        Some(d) => return d,
        None => {},
    }
    let owner: Resolve.Decl = match (DeclOfType(g, t)) {
        Some(x) => x,
        None => Panic("method of a type without a declaration"),
    }
    mut d: Resolve.Decl = Resolve.Decl.New(fnNode, fnNode.Name)
    d.ModName = owner.ModName
    d.ModIsStd = owner.ModIsStd
    d.File = owner.File
    d.IsPub = NameIsPub(fnNode.Name)
    g.MethodDecls.Set(key, d)
    d
}

fn FindMember(g: Gen, t: Types.Type, name: String) -> Option<Ast.Node> {
    match (DeclNode(g, t)) {
        Some(td) => {
            for (m in td.List) {
                if (m.Kind == Ast.NK.DFn && m.Name == name) {
                    return Some(m)
                }
            }
            None
        },
        None => None,
    }
}

fn IfaceEnv(g: Gen, it: Types.Type, self: Types.Type) -> Env {
    mut env: Env = Env.New()
    env.SelfT = Some(self)
    match (DeclNode(g, it)) {
        Some(n) => {
            mut i: I64 = 0
            while (i < n.List2.Len() && i < it.Args.Len()) {
                env.Add(n.List2[i].Name, it.Args[i])
                i += 1
            }
        },
        None => {},
    }
    env
}

// The interfaces a type implements (for an interface: the ones it extends).
fn TypeSupers(mut g: Gen, mut t: Types.Type) -> Array<Types.Type> {
    if (t.SupersDone) {
        return t.Supers
    }
    t.SupersDone = true
    let d: Resolve.Decl = match (DeclOfType(g, t)) {
        Some(x) => x,
        None => return t.Supers,
    }
    let n: Ast.Node = d.Node
    mut env: Env = Env.New()
    env.SelfT = Some(t)
    mut i: I64 = 0
    while (i < n.List2.Len() && i < t.Args.Len()) {
        env.Add(n.List2[i].Name, t.Args[i])
        i += 1
    }
    let saved: Bool = g.AllowSelfyIface
    g.AllowSelfyIface = true
    for (te in n.List3) {
        let s: Types.Type = ResolveType(g, d.FileInfo(), env, te)
        if (g.IsErr(s)) {
            continue
        }
        if (s.Kind != Types.TKind.Iface) {
            g.Diag.Error(te.Pos, "`${s.Name}` is not an interface, so `${t.Name}` cannot implement it")
            continue
        }
        t.Supers.Push(s)
    }
    g.AllowSelfyIface = saved
    t.Supers
}

fn typeImplementsD(mut g: Gen, t: Types.Type, it: Types.Type, depth: I32) -> Bool {
    if (t.Id == it.Id) {
        return true
    }
    if (t.DeclName == "" || depth > 20) {
        return false
    }
    for (s in TypeSupers(g, t)) {
        if (typeImplementsD(g, s, it, depth + 1)) {
            return true
        }
    }
    false
}

fn TypeImplements(mut g: Gen, t: Types.Type, it: Types.Type) -> Bool { typeImplementsD(g, t, it, 0) }

// Every instance method of an interface and the ones it extends, parents first.
fn CollectIfaceMethods(mut g: Gen, it: Types.Type, mut out: Array<IMethod>, depth: I32) {
    if (depth > 20 || it.DeclName == "") {
        return
    }
    for (s in TypeSupers(g, it)) {
        CollectIfaceMethods(g, s, out, depth + 1)
    }
    let n: Ast.Node = match (DeclNode(g, it)) {
        Some(x) => x,
        None => return,
    }
    for (m in n.List) {
        if (m.Kind != Ast.NK.DFn || m.IsStatic) {
            continue
        }
        mut dup: Bool = false
        for (o in out) {
            if (o.Fn.Name == m.Name) {
                dup = true
            }
        }
        if (dup) {
            continue
        }
        out.Push(IMethod.New(m, it))
    }
}

// The default method (one with a body) of that name that `t` gets from its interfaces, and whether two interfaces
// both supply a default with this name.
fn FindDefault(mut g: Gen, t: Types.Type, name: String) -> (Option<IMethod>, Bool) {
    if (t.DeclName == "") {
        return (None, false)
    }
    mut all: Array<IMethod> = []
    for (s in TypeSupers(g, t)) {
        CollectIfaceMethods(g, s, all, 0)
    }
    mut found: Option<IMethod> = None
    mut conflict: Bool = false
    for (m in all) {
        if (m.Fn.Name != name || m.Fn.B.IsNone()) {
            continue
        }
        match (found) {
            Some(f) => {
                if (!sameFn(f, m)) {
                    conflict = true
                }
                continue
            },
            None => {},
        }
        found = Some(m)
    }
    (found, conflict)
}

// two interface methods are the same declaration
fn sameFn(a: IMethod, b: IMethod) -> Bool {
    a.Owner.DeclName == b.Owner.DeclName && a.Fn.Name == b.Fn.Name
}

fn DefaultDecl(mut g: Gen, t: Types.Type, m: IMethod) -> Resolve.Decl {
    let key: String = "${t.Name}|${m.Fn.Name}|${m.Owner.DeclName}"
    match (g.Defaults.Get(key)) {
        Some(d) => return d,
        None => {},
    }
    let od: Resolve.Decl = match (DeclOfType(g, m.Owner)) {
        Some(x) => x,
        None => Panic("interface without a declaration"),
    }
    mut d: Resolve.Decl = Resolve.Decl.New(m.Fn, m.Fn.Name)
    d.ModName = od.ModName
    d.ModIsStd = od.ModIsStd
    d.File = od.File
    d.IsPub = NameIsPub(m.Fn.Name)
    d.Iface = Some(m.Owner)
    g.Defaults.Set(key, d)
    d
}

fn SigString(ptypes: Array<Types.Type>, ret: Types.Type) -> String {
    mut names: Array<String> = []
    for (p in ptypes) {
        names.Push(p.Name)
    }
    "(${names.Join(", ")}) -> ${ret.Name}"
}

fn FnSig(mut g: Gen, f: Resolve.FileInfo, env: Env, fnNode: Ast.Node) -> (Array<Types.Type>, Types.Type) {
    mut ptypes: Array<Types.Type> = []
    for (p in fnNode.List) {
        if (p.Flag3) {
            continue
        }
        ptypes.Push(ResolveType(g, f, env, UnwrapNode(p.A)))
    }
    let ret: Types.Type = match (fnNode.A) {
        Some(r) => ResolveType(g, f, env, r),
        None => g.Tt.Unit,
    }
    (ptypes, ret)
}

// Does `t` provide everything its interfaces ask for?
fn CheckConformance(mut g: Gen, t: Types.Type) {
    let td: Resolve.Decl = match (DeclOfType(g, t)) {
        Some(x) => x,
        None => return,
    }
    let tn: Ast.Node = td.Node
    mut seenDefaults: Array<IMethod> = []
    for (s in TypeSupers(g, t)) {
        mut all: Array<IMethod> = []
        CollectIfaceMethods(g, s, all, 0)
        for (m in all) {
            let memberFn: Ast.Node = match (FindMember(g, t, m.Fn.Name)) {
                Some(x) => x,
                None => {
                    if (m.Fn.B.IsSome()) {
                        mut dup: Bool = false
                        for (o in seenDefaults) {
                            if (o.Fn.Name == m.Fn.Name && !sameFn(o, m)) {
                                g.Diag.Error(tn.Pos, "`${t.Name}` gets a default `${m.Fn.Name}` from both `${o.Owner.Name}` and `${m.Owner.Name}`; write its own `${m.Fn.Name}` to choose")
                            }
                            if (sameFn(o, m)) {
                                dup = true
                            }
                        }
                        if (!dup) {
                            seenDefaults.Push(m)
                        }
                    } else {
                        g.Diag.Error(tn.Pos, "`${t.Name}` does not implement `${m.Fn.Name}`, which `${s.Name}` requires")
                    }
                    continue
                },
            }
            // generic methods are not compared
            if (memberFn.List2.Len() > 0 || m.Fn.List2.Len() > 0) {
                continue
            }
            let md: Resolve.Decl = MethodDecl(g, t, memberFn)
            let (ip, iret): (Array<Types.Type>, Types.Type) = FnSig(g, md.FileInfo(), MakeEnv(g, md, Some(t), None), memberFn)
            let od: Resolve.Decl = match (DeclOfType(g, m.Owner)) {
                Some(x) => x,
                None => continue,
            }
            let (mp, mret): (Array<Types.Type>, Types.Type) = FnSig(g, od.FileInfo(), IfaceEnv(g, m.Owner, t), m.Fn)
            mut ok: Bool = ip.Len() == mp.Len() && iret.Id == mret.Id && memberFn.IsMutFn == m.Fn.IsMutFn && memberFn.IsStatic == m.Fn.IsStatic
            mut k: I64 = 0
            while (ok && k < ip.Len()) {
                if (ip[k].Id != mp[k].Id && !g.IsErr(ip[k]) && !g.IsErr(mp[k])) {
                    ok = false
                }
                k += 1
            }
            if (!ok && !g.IsErr(iret) && !g.IsErr(mret)) {
                g.Diag.Error(memberFn.Pos, "`${t.Name}.${memberFn.Name}` does not match the declaration in `${m.Owner.Name}`: it should be `${if (m.Fn.IsMutFn) { "mut " } else { "" }}fn ${m.Fn.Name}${SigString(mp, mret)}`")
            }
        }
    }
}

// The built-in types satisfy Equatable, Comparable and Hashable without declaring them.
fn BuiltinSatisfies(t: Types.Type, iface: String) -> Bool {
    let num: Bool = t.IsInt() || t.Kind == Types.TKind.Char || t.Kind == Types.TKind.Bool
    if (iface == "Equatable") {
        return num || t.IsFloat() || t.Kind == Types.TKind.Str
    }
    if (iface == "Comparable") {
        return t.IsInt() || t.Kind == Types.TKind.Char || t.IsFloat() || t.Kind == Types.TKind.Str
    }
    if (iface == "Hashable") {
        return num || t.Kind == Types.TKind.Str
    }
    false
}

fn IsBuiltinValue(t: Types.Type) -> Bool {
    t.IsNumeric() || t.Kind == Types.TKind.Char || t.Kind == Types.TKind.Bool || t.Kind == Types.TKind.Str
}

fn Satisfies(mut g: Gen, t: Types.Type, bound: Types.Type) -> Bool {
    if (g.IsErr(t) || t.Kind == Types.TKind.Param || g.IsErr(bound)) {
        return true
    }
    if (IsBuiltinValue(t)) {
        match (DeclOfType(g, bound)) {
            Some(bd) => {
                if (bd.ModIsStd) {
                    return BuiltinSatisfies(t, bd.Name)
                }
            },
            None => {},
        }
    }
    TypeImplements(g, t, bound)
}

// Checks the `<T: Bound + Bound>` constraints of a generic declaration against the type arguments.
fn CheckBounds(mut g: Gen, f: Resolve.FileInfo, owner: Ast.Node, targs: Array<Types.Type>, base: Option<Env>, what: String, pos: Token.Pos) {
    mut i: I64 = 0
    while (i < owner.List2.Len() && i < targs.Len()) {
        let tp: Ast.Node = owner.List2[i]
        let arg: Types.Type = targs[i]
        i += 1
        if (tp.List.Len() == 0) {
            continue
        }
        if (g.IsErr(arg) || arg.Kind == Types.TKind.Param) {
            continue
        }
        mut env: Env = Env.New()
        match (base) {
            Some(b) => {
                env.SelfT = b.SelfT
                mut k: I64 = 0
                while (k < b.Names.Len()) {
                    env.Add(b.Names[k], b.Types[k])
                    k += 1
                }
            },
            None => {},
        }
        mut k2: I64 = 0
        while (k2 < owner.List2.Len() && k2 < targs.Len()) {
            env.Add(owner.List2[k2].Name, targs[k2])
            k2 += 1
        }
        // `Self` in a bound is the constrained type
        env.SelfT = Some(arg)
        let saved: Bool = g.AllowSelfyIface
        g.AllowSelfyIface = true
        for (be in tp.List) {
            let bound: Types.Type = ResolveType(g, f, env, be)
            if (g.IsErr(bound)) {
                continue
            }
            if (bound.Kind != Types.TKind.Iface) {
                g.Diag.Error(be.Pos, "`${bound.Name}` is not an interface, so it cannot be a constraint")
                continue
            }
            if (!Satisfies(g, arg, bound)) {
                g.Diag.Error(pos, "`${arg.Name}` does not satisfy the constraint `${tp.Name}: ${bound.Name}` of `${what}`")
                g.Diag.Note("`${arg.Name}` would have to implement `${bound.Name}`")
            }
        }
        g.AllowSelfyIface = saved
    }
}

// ---- function instances ----

// A function (or method) with its type arguments fixed: one LLVM function.
class Inst {
    D: Resolve.Decl
    // owning type for methods
    SelfT: Option<Types.Type> = None
    Env: Env = Env.New()
    // the LLVM symbol without the @
    Name: String = ""
    Ptypes: Array<Types.Type> = []
    Ret: Types.Type
    Emitted: Bool = false
    IsExtern: Bool = false
    // `export "C"`: the symbol is the plain name and the signature is C's
    IsExport: Bool = false
    // a method: the first parameter is `ptr %this`
    HasThis: Bool = false

    fn Init(d: Resolve.Decl, ret: Types.Type) {
        this.D = d
        this.Ret = ret
    }
}

fn MangleName(s: String) -> String { Text.Replace(s, ".", "_") }

// Arguments and results of `extern "C"` functions are C types or pointers.
fn IsCValueType(t: Types.Type) -> Bool {
    if (t.Kind == Types.TKind.Fn) {
        // a callback: C types and pointers only
        for (a in t.Args) {
            if (!IsCValueType(a)) {
                return false
            }
        }
        let r: Types.Type = match (t.Ret) {
            Some(x) => x,
            None => return false,
        }
        return r.Kind == Types.TKind.Unit || (r.Kind == Types.TKind.CType && r.Name == "CVoid") || IsCValueType(r)
    }
    t.Kind == Types.TKind.Ptr || (t.Kind == Types.TKind.CType && t.Name != "CVoid")
}

fn checkCSignature(mut g: Gen, mut inst: Inst, fnNode: Ast.Node) {
    mut pi: I64 = 0
    for (p in fnNode.List) {
        if (p.Flag3) {
            continue
        }
        let pt: Types.Type = inst.Ptypes[pi]
        pi += 1
        if (g.IsErr(pt)) {
            continue
        }
        if (!IsCValueType(pt)) {
            g.Diag.Error(p.Pos, "parameter `${p.Name}` of the C function `${fnNode.Name}` has type `${pt.Name}`; C functions take only C types and pointers")
            if (pt.Kind == Types.TKind.Struct) {
                match (DeclOfType(g, pt)) {
                    Some(sd) => {
                        if (sd.HasAbi) {
                            g.Diag.Note("structs are passed by pointer: write `*${pt.Name}` and pass `&value`")
                        }
                    },
                    None => {},
                }
            } else if (pt.Id == g.Tt.Str.Id) {
                g.Diag.Note("convert a String with `.ToC()`")
            } else if (pt.IsNumeric()) {
                g.Diag.Note("convert it with a method such as `.ToCInt()`")
            }
        }
    }
    if (g.IsErr(inst.Ret)) {
        return
    }
    if (inst.Ret.Kind == Types.TKind.CType && inst.Ret.Name == "CVoid") {
        inst.Ret = g.Tt.Unit
    } else if (inst.Ret.Id != g.Tt.Unit.Id && !IsCValueType(inst.Ret)) {
        g.Diag.Error(fnNode.Pos, "the C function `${fnNode.Name}` returns `${inst.Ret.Name}`; C functions return only C types, pointers and `CVoid`")
    }
}

fn GetInst(mut g: Gen, d: Resolve.Decl, self: Option<Types.Type>, targs: Option<Array<Types.Type>>) -> Inst {
    let fnNode: Ast.Node = d.Node
    let isExtern: Bool = d.HasAbi
    let isExport: Bool = fnNode.IsExport && self.IsNone()
    mut key: String = ""
    if (isExport) {
        key = fnNode.Name
    } else if (isExtern) {
        key = if (fnNode.Name2 != "") { fnNode.Name2 } else { fnNode.Name }
    } else {
        key = match (self) {
            Some(st) => "zevic_${MangleName(st.Name)}_${fnNode.Name}",
            None => "zevic_${MangleName(d.ModName)}_${fnNode.Name}",
        }
    }
    match (targs) {
        Some(ts) => {
            if (ts.Len() > 0 && !isExtern) {
                mut names: Array<String> = []
                for (t in ts) {
                    names.Push(t.Name)
                }
                key += "<${names.Join(", ")}>"
            }
        },
        None => {},
    }
    match (g.Insts.Get(key)) {
        Some(old) => {
            if (isExport && old.D.Key() != d.Key()) {
                g.Diag.Error(fnNode.Pos, "the C name `${fnNode.Name}` is exported twice")
                g.Diag.Note("the other one is in module `${old.D.ModName}`")
            }
            return old
        },
        None => {},
    }
    mut env: Env = MakeEnv(g, d, self, targs)
    mut ptypes: Array<Types.Type> = []
    for (p in fnNode.List) {
        if (p.Flag3) {
            continue
        }
        ptypes.Push(ResolveType(g, d.FileInfo(), env, UnwrapNode(p.A)))
    }
    let ret: Types.Type = match (fnNode.A) {
        Some(r) => ResolveType(g, d.FileInfo(), env, r),
        None => g.Tt.Unit,
    }
    mut inst: Inst = Inst.New(d, ret)
    inst.IsExport = isExport
    inst.SelfT = self
    inst.Name = key
    inst.IsExtern = isExtern
    inst.HasThis = self.IsSome() && !fnNode.IsStatic && !isExtern
    inst.Env = env
    inst.Ptypes = ptypes
    if (isExport) {
        g.Exports.Push(inst)
    }
    if ((isExtern && d.Abi == "C") || isExport) {
        checkCSignature(g, inst, fnNode)
    }
    if (isExport && fnNode.List2.Len() > 0) {
        g.Diag.Error(fnNode.Pos, "an exported function cannot have type parameters")
    }
    if (isExport && fnNode.Name == "Main" && d.ModName == "Main") {
        g.Diag.Error(fnNode.Pos, "`Main` cannot be exported")
    }
    g.Insts.Set(key, inst)
    if (!isExtern) {
        g.Worklist.Push(inst)
    }
    inst
}

// ---- strings ----

fn hexDigit(n: I64) -> String {
    let digits: String = "0123456789ABCDEF"
    digits.Slice(n, n + 1)
}

fn HexN(v: U64, width: I64) -> String {
    mut out: String = ""
    mut i: I64 = width - 1
    while (i >= 0) {
        let nib: I64 = ((v >> (i * 4).ToI32Wrap()) & 15_U64).ToI64Wrap()
        out += hexDigit(nib)
        i -= 1
    }
    out
}

// A string as the contents of an LLVM constant: printable ASCII as it is, the rest as \XX.
fn llEscape(s: String) -> String {
    mut out: String = ""
    mut run: I64 = 0
    mut i: I64 = 0
    while (i < s.Len()) {
        let c: I32 = s.ByteAt(i).ToI32Wrap()
        if (c >= 32 && c < 127 && c != 34 && c != 92) {
            i += 1
            continue
        }
        if (i > run) { out += s.Slice(run, i) }
        out += "\\${HexN(c.ToU64Wrap(), 2)}"
        i += 1
        run = i
    }
    out += s.Slice(run, s.Len())
    out
}

// The LLVM constant for a string literal: `{ ptr @.str.N, i64 len }`.
fn StrConst(mut g: Gen, s: String) -> String {
    let n: I64 = s.Len()
    // keys cannot contain NULs; make them unique through the length prefix
    let key: String = "${n}:${s}"
    let name: String = match (g.StrConst.Get(key)) {
        Some(x) => x,
        None => {
            let nm: String = "@.str.${g.NStr}"
            g.NStr += 1
            g.StrConst.Set(key, nm)
            g.Globals.Put("${nm} = private unnamed_addr constant [${n + 1} x i8] c\"${llEscape(s)}\\00\"\n")
            nm
        },
    }
    "{ ptr ${name}, i64 ${n} }"
}

fn Declare(mut g: Gen, name: String, line: String) {
    if (g.Declared.Contains(name)) {
        return
    }
    g.Declared.Set(name, true)
    g.Decls.Put("${line}\n")
}
