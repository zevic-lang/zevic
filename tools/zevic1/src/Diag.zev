module Zevic1.Diag

// The loaded source files and the error messages, in the format of zevic0 (util.c):
//
//     file:line:col: error: message
//       the source line
//           ^

import Zevic.Console
import Zevic.Text
import Zevic1.Token as Token

class Diag {
    names: Array<String> = []
    texts: Array<String> = []
    // How many errors were reported.
    Errors: I64 = 0

    // Remembers a file and returns its number.
    mut fn AddSource(name: String, text: String) -> I32 {
        this.names.Push(name)
        this.texts.Push(text)
        (this.names.Len() - 1).ToI32Wrap()
    }

    fn Name(file: I32) -> String {
        if (file >= 0 && file.ToI64() < this.names.Len()) { this.names[file.ToI64()] } else { "<unknown>" }
    }

    fn Text(file: I32) -> String {
        if (file >= 0 && file.ToI64() < this.texts.Len()) { this.texts[file.ToI64()] } else { "" }
    }

    // The source line of a position with a `^` under the column.
    fn sourceLine(pos: Token.Pos) -> String {
        let text: String = this.Text(pos.File)
        if (pos.Line < 1) {
            return ""
        }
        mut p: I64 = 0
        mut line: I32 = 1
        while (line < pos.Line && p < text.Len()) {
            if (text.ByteAt(p).ToI32Wrap() == 10) {
                line += 1
            }
            p += 1
        }
        mut e: I64 = p
        while (e < text.Len() && text.ByteAt(e).ToI32Wrap() != 10 && text.ByteAt(e).ToI32Wrap() != 13) {
            e += 1
        }
        mut out: String = "  ${text.Slice(p, e)}\n  "
        mut i: I32 = 1
        while (i < pos.Col) {
            let k: I64 = (i - 1).ToI64()
            let c: I32 = if (k < e - p) { text.ByteAt(p + k).ToI32Wrap() } else { 32 }
            out += if (c == 9) { "\t" } else { " " }
            i += 1
        }
        out + "^\n"
    }

    mut fn Error(pos: Token.Pos, msg: String) {
        Console.Eprint("${this.Name(pos.File)}:${pos.Line}:${pos.Col}: error: ${msg}\n${this.sourceLine(pos)}")
        this.Errors += 1
    }

    fn Note(msg: String) {
        Console.Eprint("  note: ${msg}\n")
    }
}
