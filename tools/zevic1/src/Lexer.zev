module Zevic1.Lexer

// The lexer: a port of zevic0/lexer.c. It produces the same tokens (see `--dump-tokens`) and the same messages.

import Zevic.Text
import Zevic1.Diag as Diag
import Zevic1.Token as Token

// ---- small helpers ----

fn isIdentStart(c: I32) -> Bool { (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 }

fn isDigit(c: I32) -> Bool { c >= 48 && c <= 57 }

fn isIdentChar(c: I32) -> Bool { isIdentStart(c) || isDigit(c) }

fn digitValue(c: I32) -> I32 {
    if (c >= 48 && c <= 57) { return c - 48 }
    if (c >= 97 && c <= 102) { return c - 97 + 10 }
    if (c >= 65 && c <= 70) { return c - 65 + 10 }
    99
}

fn byteAt(s: String, i: I64) -> I32 {
    if (i >= 0 && i < s.Len()) { s.ByteAt(i).ToI32Wrap() } else { -1 }
}

fn keyword(s: String) -> Option<Token.Tk> {
    match (s) {
        "module" => Some(Token.Tk.Module),
        "import" => Some(Token.Tk.Import),
        "as" => Some(Token.Tk.As),
        "fn" => Some(Token.Tk.Fn),
        "let" => Some(Token.Tk.Let),
        "mut" => Some(Token.Tk.Mut),
        "class" => Some(Token.Tk.Class),
        "struct" => Some(Token.Tk.Struct),
        "enum" => Some(Token.Tk.Enum),
        "interface" => Some(Token.Tk.Interface),
        "static" => Some(Token.Tk.Static),
        "Self" => Some(Token.Tk.SelfT),
        "extern" => Some(Token.Tk.Extern),
        "export" => Some(Token.Tk.Export),
        "if" => Some(Token.Tk.If),
        "else" => Some(Token.Tk.Else),
        "while" => Some(Token.Tk.While),
        "loop" => Some(Token.Tk.Loop),
        "for" => Some(Token.Tk.For),
        "in" => Some(Token.Tk.In),
        "match" => Some(Token.Tk.Match),
        "return" => Some(Token.Tk.Return),
        "break" => Some(Token.Tk.Break),
        "continue" => Some(Token.Tk.Continue),
        "defer" => Some(Token.Tk.Defer),
        "async" => Some(Token.Tk.Async),
        "await" => Some(Token.Tk.Await),
        "true" => Some(Token.Tk.True),
        "false" => Some(Token.Tk.False),
        "this" => Some(Token.Tk.This),
        _ => None,
    }
}

// Words reserved for the future (the specification lists them).
fn isFuture(s: String) -> Bool {
    s == "macro" || s == "unsafe" || s == "type" || s == "where" || s == "const" || s == "yield" || s == "impl" || s == "null"
}

let Suffixes: Array<String> = ["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64"]

// Does a token of this kind at the end of a line mean that the statement goes on?
fn continuesAfter(k: Token.Tk) -> Bool {
    match (k) {
        Token.Tk.Plus | Token.Tk.Minus | Token.Tk.Star | Token.Tk.Slash | Token.Tk.Percent => true,
        Token.Tk.Amp | Token.Tk.Pipe | Token.Tk.Caret | Token.Tk.Shl | Token.Tk.Shr => true,
        Token.Tk.AndAnd | Token.Tk.OrOr | Token.Tk.EqEq | Token.Tk.Neq => true,
        Token.Tk.Lt | Token.Tk.Gt | Token.Tk.Le | Token.Tk.Ge => true,
        Token.Tk.Comma | Token.Tk.LParen | Token.Tk.LBrack | Token.Tk.LBrace => true,
        Token.Tk.Assign | Token.Tk.FatArrow | Token.Tk.Arrow | Token.Tk.Dot => true,
        Token.Tk.PlusEq | Token.Tk.MinusEq | Token.Tk.StarEq | Token.Tk.SlashEq | Token.Tk.PercentEq => true,
        Token.Tk.AmpEq | Token.Tk.PipeEq | Token.Tk.CaretEq | Token.Tk.ShlEq | Token.Tk.ShrEq => true,
        Token.Tk.Colon => true,
        _ => false,
    }
}

// ---- UTF-8 ----

// The length of the UTF-8 sequence at `i` (0 when it is not valid). `n` is the end of the text.
fn Utf8Len(s: String, i: I64, n: I64) -> I64 {
    let c: I32 = s.ByteAt(i).ToI32Wrap()
    if (c < 128) { return 1 }
    let len: I64 = if (c / 32 == 6) { 2 } else if (c / 16 == 14) { 3 } else if (c / 8 == 30) { 4 } else { 0 }
    if (len == 0 || i + len > n) { return 0 }
    mut v: I64 = if (len == 2) { (c % 32).ToI64() } else if (len == 3) { (c % 16).ToI64() } else { (c % 8).ToI64() }
    mut k: I64 = 1
    while (k < len) {
        let d: I32 = s.ByteAt(i + k).ToI32Wrap()
        if (d / 64 != 2) { return 0 }
        v = v * 64 + (d % 64).ToI64()
        k += 1
    }
    if ((len == 2 && v < 128) || (len == 3 && v < 2048) || (len == 4 && v < 65536) || v > 1114111 || (v >= 55296 && v <= 57343)) {
        return 0
    }
    len
}

// The code point of a valid sequence of `len` bytes at `i`.
fn utf8Cp(s: String, i: I64, len: I64) -> U32 {
    let c: I32 = s.ByteAt(i).ToI32Wrap()
    if (len == 1) { return c.ToU32Wrap() }
    mut v: I64 = if (len == 2) { (c % 32).ToI64() } else if (len == 3) { (c % 16).ToI64() } else { (c % 8).ToI64() }
    mut k: I64 = 1
    while (k < len) {
        v = v * 64 + (s.ByteAt(i + k).ToI32Wrap() % 64).ToI64()
        k += 1
    }
    v.ToU32Wrap()
}

// A code point as a string.
fn cpString(cp: U32) -> String {
    match (cp.ToChar()) {
        Ok(ch) => "${ch}",
        Err(_) => "?",
    }
}

// The result of reading an escape sequence.
class Esc {
    Err: String = ""
    Cp: U32 = 0_U32
    I: I64 = 0
}

// Reads the escape whose backslash was just consumed; s[i] is the letter. `maxX` is the largest `\xNN` that is allowed.
fn readEscape(s: String, n: I64, start: I64, maxX: U32) -> Esc {
    mut r: Esc = Esc.New()
    mut i: I64 = start
    r.I = i
    if (i >= n) {
        r.Err = "unfinished escape sequence"
        return r
    }
    let c: I32 = s.ByteAt(i).ToI32Wrap()
    i += 1
    r.I = i
    if (c == 110) { r.Cp = 10_U32 }
    else if (c == 114) { r.Cp = 13_U32 }
    else if (c == 116) { r.Cp = 9_U32 }
    else if (c == 92) { r.Cp = 92_U32 }
    else if (c == 34) { r.Cp = 34_U32 }
    else if (c == 39) { r.Cp = 39_U32 }
    else if (c == 48) { r.Cp = 0_U32 }
    else if (c == 36) { r.Cp = 36_U32 }
    else if (c == 120) {
        if (i + 2 > n || digitValue(byteAt(s, i)) > 15 || digitValue(byteAt(s, i + 1)) > 15) {
            r.Err = "`\\x` must be followed by two hex digits"
            return r
        }
        r.Cp = (digitValue(byteAt(s, i)) * 16 + digitValue(byteAt(s, i + 1))).ToU32Wrap()
        i += 2
        r.I = i
        if (r.Cp > maxX) {
            r.Err = if (maxX == 127_U32) { "`\\xNN` in a string must be 00 to 7F (use `\\u{...}` for other characters)" } else { "`\\xNN` is out of range" }
        }
    } else if (c == 117) {
        if (i >= n || byteAt(s, i) != 123) {
            r.Err = "`\\u` must be followed by `{hex digits}`"
            return r
        }
        i += 1
        mut v: I64 = 0
        mut nd: I64 = 0
        while (i < n && byteAt(s, i) != 125) {
            let d: I32 = digitValue(byteAt(s, i))
            if (d > 15 || nd >= 6) {
                r.Err = "invalid `\\u{...}` escape"
                r.I = i
                return r
            }
            v = v * 16 + d.ToI64()
            nd += 1
            i += 1
        }
        if (i >= n || nd == 0) {
            r.Err = "invalid `\\u{...}` escape"
            r.I = i
            return r
        }
        i += 1
        r.I = i
        if (v > 1114111 || (v >= 55296 && v <= 57343)) {
            r.Err = "`\\u{...}` is not a valid Unicode scalar value"
            return r
        }
        r.Cp = v.ToU32Wrap()
    } else {
        r.Err = "unknown escape sequence"
    }
    r
}

// Skips `${ ... }`: `i` is just after the `${`. Returns the index of the matching `}`.
fn skipInterp(s: String, n: I64, start: I64) -> I64 {
    mut i: I64 = start
    mut depth: I64 = 1
    while (i < n) {
        let c: I32 = s.ByteAt(i).ToI32Wrap()
        if (c == 123) {
            depth += 1
        } else if (c == 125) {
            depth -= 1
            if (depth == 0) {
                return i
            }
        } else if (c == 34) {
            i = skipNestedString(s, n, i + 1)
            continue
        } else if (c == 39) {
            i += 1
            if (i < n && byteAt(s, i) == 92) {
                i += 1
            }
            while (i < n && byteAt(s, i) != 39 && byteAt(s, i) != 10) {
                i += 1
            }
        }
        i += 1
    }
    n
}

// Skips a string body: `i` is just after the opening quote. Returns the index just after the closing quote.
fn skipNestedString(s: String, n: I64, start: I64) -> I64 {
    mut i: I64 = start
    while (i < n) {
        let c: I32 = s.ByteAt(i).ToI32Wrap()
        if (c == 92) {
            i += 2
        } else if (c == 34) {
            return i + 1
        } else if (c == 36 && i + 1 < n && byteAt(s, i + 1) == 123) {
            i = skipInterp(s, n, i + 2) + 1
        } else {
            i += 1
        }
    }
    n
}

// A growing piece of text that remembers its length.
class Buf {
    parts: Array<String> = []
    Len: I64 = 0

    mut fn Put(s: String) {
        this.parts.Push(s)
        this.Len += s.Len()
    }

    mut fn Clear() {
        this.parts = []
        this.Len = 0
    }

    fn String() -> String { Text.Join(this.parts, "") }
}

// ---- the lexer ----

class Lexer {
    file: I32
    s: String
    n: I64
    i: I64 = 0
    line: I32 = 1
    col: I32 = 1
    toks: Array<Token.Token> = []
    stack: Array<I32> = [] // open brackets: ( [ {
    angle: I64 = 0 // open `<` of type arguments, such as Array<I32>
    diag: Diag.Diag

    fn Init(diag: Diag.Diag, file: I32, text: String, line: I32, col: I32) {
        this.diag = diag
        this.file = file
        this.s = text
        this.n = text.Len()
        this.line = line
        this.col = col
    }

    fn here() -> Token.Pos { Token.Pos.New(this.file, this.line, this.col) }

    fn peekc(off: I64) -> I32 { byteAt(this.s, this.i + off) }

    mut fn advance() -> I32 {
        if (this.i >= this.n) {
            return -1
        }
        let c: I32 = this.s.ByteAt(this.i).ToI32Wrap()
        this.i += 1
        if (c == 10) {
            this.line += 1
            this.col = 1
        } else if (c / 64 != 2) {
            this.col += 1
        }
        c
    }

    mut fn skip() {
        this.advance()
    }

    mut fn push(k: Token.Tk, pos: Token.Pos) -> Token.Token {
        mut t: Token.Token = Token.Token.New(k, pos)
        this.toks.Push(t)
        t
    }

    // After a newline: does the next line start with `.`, `&&` or `||` (skipping blanks and comments)?
    fn nextLineContinues() -> Bool {
        let s: String = this.s
        let n: I64 = this.n
        mut i: I64 = this.i
        while (i < n) {
            let c: I32 = byteAt(s, i)
            if (c == 32 || c == 9 || c == 13 || c == 10) {
                i += 1
            } else if (c == 47 && i + 1 < n && byteAt(s, i + 1) == 47) {
                while (i < n && byteAt(s, i) != 10) {
                    i += 1
                }
            } else if (c == 47 && i + 1 < n && byteAt(s, i + 1) == 42) {
                mut depth: I64 = 1
                i += 2
                while (i < n && depth > 0) {
                    if (byteAt(s, i) == 47 && i + 1 < n && byteAt(s, i + 1) == 42) {
                        depth += 1
                        i += 2
                    } else if (byteAt(s, i) == 42 && i + 1 < n && byteAt(s, i + 1) == 47) {
                        depth -= 1
                        i += 2
                    } else {
                        i += 1
                    }
                }
            } else {
                break
            }
        }
        if (i >= n) {
            return false
        }
        let c: I32 = byteAt(s, i)
        if (c == 46 && !(i + 1 < n && byteAt(s, i + 1) == 46)) { return true }
        if (c == 38 && i + 1 < n && byteAt(s, i + 1) == 38) { return true }
        if (c == 124 && i + 1 < n && byteAt(s, i + 1) == 124) { return true }
        false
    }

    mut fn newline(pos: Token.Pos) {
        if (this.stack.Len() > 0 && this.stack[this.stack.Len() - 1] != 123) {
            return // inside ( ) or [ ]
        }
        if (this.toks.IsEmpty()) {
            return
        }
        let lastTok: Token.Token = this.toks[this.toks.Len() - 1]
        mut last: Token.Tk = lastTok.Kind
        if (lastTok.GenericClose) {
            last = Token.Tk.Ident // `Array<I32>` ends a type, not an expression
        }
        if (last == Token.Tk.Nl || continuesAfter(last)) {
            return
        }
        if (this.nextLineContinues()) {
            return
        }
        this.angle = 0
        this.push(Token.Tk.Nl, pos)
    }

    mut fn skipBlockComment() {
        let start: Token.Pos = this.here()
        this.advance()
        this.advance() // the opening slash-star
        mut depth: I64 = 1
        while (depth > 0) {
            if (this.i >= this.n) {
                this.diag.Error(start, "unterminated block comment")
                return
            }
            if (this.peekc(0) == 47 && this.peekc(1) == 42) {
                this.advance()
                this.advance()
                depth += 1
            } else if (this.peekc(0) == 42 && this.peekc(1) == 47) {
                this.advance()
                this.advance()
                depth -= 1
            } else {
                let c: I32 = this.advance()
                if (c == 10) {
                    this.newline(start)
                }
            }
        }
    }

    mut fn lexIdent() {
        let pos: Token.Pos = this.here()
        let start: I64 = this.i
        while (isIdentChar(this.peekc(0))) {
            this.advance()
        }
        let word: String = this.s.Slice(start, this.i)
        // r"..." and b'...' prefixes
        if (word == "r" && this.peekc(0) == 34) {
            this.lexString(true)
            return
        }
        if (word == "b" && this.peekc(0) == 39) {
            this.lexChar(true)
            return
        }
        match (keyword(word)) {
            Some(k) => {
                this.push(k, pos)
                return
            },
            None => {},
        }
        if (isFuture(word)) {
            this.diag.Error(pos, "`${word}` is reserved for the future and cannot be used as a name (use `${word}` in backticks)")
        }
        mut t: Token.Token = this.push(Token.Tk.Ident, pos)
        t.Text = word
    }

    mut fn lexBacktick() {
        let pos: Token.Pos = this.here()
        this.advance()
        let start: I64 = this.i
        while (isIdentChar(this.peekc(0))) {
            this.advance()
        }
        let len: I64 = this.i - start
        if (this.peekc(0) != 96 || len == 0) {
            this.diag.Error(pos, "malformed `identifier`: expected a name followed by a closing backtick")
            return
        }
        mut t: Token.Token = this.push(Token.Tk.Ident, pos)
        t.Text = this.s.Slice(start, this.i)
        t.Quoted = true
        this.advance()
    }

    mut fn lexOp() {
        let pos: Token.Pos = this.here()
        let c: I32 = this.peekc(0)
        let d: I32 = this.peekc(1)
        let e: I32 = this.peekc(2)
        mut k: Token.Tk = Token.Tk.Eof
        mut len: I64 = 1
        if (c == 43) {
            if (d == 61) { k = Token.Tk.PlusEq
                len = 2 } else { k = Token.Tk.Plus }
        } else if (c == 45) {
            if (d == 61) { k = Token.Tk.MinusEq
                len = 2 } else if (d == 62) { k = Token.Tk.Arrow
                    len = 2 } else { k = Token.Tk.Minus }
        } else if (c == 42) {
            if (d == 61) { k = Token.Tk.StarEq
                len = 2 } else { k = Token.Tk.Star }
        } else if (c == 47) {
            if (d == 61) { k = Token.Tk.SlashEq
                len = 2 } else { k = Token.Tk.Slash }
        } else if (c == 37) {
            if (d == 61) { k = Token.Tk.PercentEq
                len = 2 } else { k = Token.Tk.Percent }
        } else if (c == 38) {
            if (d == 38) { k = Token.Tk.AndAnd
                len = 2 } else if (d == 61) { k = Token.Tk.AmpEq
                    len = 2 } else { k = Token.Tk.Amp }
        } else if (c == 124) {
            if (d == 124) { k = Token.Tk.OrOr
                len = 2 } else if (d == 61) { k = Token.Tk.PipeEq
                    len = 2 } else { k = Token.Tk.Pipe }
        } else if (c == 94) {
            if (d == 61) { k = Token.Tk.CaretEq
                len = 2 } else { k = Token.Tk.Caret }
        } else if (c == 126) {
            k = Token.Tk.Tilde
        } else if (c == 33) {
            if (d == 61) { k = Token.Tk.Neq
                len = 2 } else { k = Token.Tk.Bang }
        } else if (c == 61) {
            if (d == 61) { k = Token.Tk.EqEq
                len = 2 } else if (d == 62) { k = Token.Tk.FatArrow
                    len = 2 } else { k = Token.Tk.Assign }
        } else if (c == 60) {
            if (d == 60) {
                if (e == 61) { k = Token.Tk.ShlEq
                    len = 3 } else { k = Token.Tk.Shl
                        len = 2 }
            } else if (d == 61) {
                k = Token.Tk.Le
                len = 2
            } else {
                k = Token.Tk.Lt
                // `Name<...`: glued to a name and not followed by a space, so it opens type arguments
                if (this.i > 0 && isIdentChar(byteAt(this.s, this.i - 1)) && d != 32 && d != 9 && d != 10 && d != -1) {
                    this.angle += 1
                }
            }
        } else if (c == 62) {
            // `>>` is only a shift token when it cannot close two generic lists; the parser splits it when needed
            if (d == 62) {
                if (e == 61) { k = Token.Tk.ShrEq
                    len = 3 } else { k = Token.Tk.Shr
                        len = 2 }
            } else if (d == 61) {
                k = Token.Tk.Ge
                len = 2
            } else {
                k = Token.Tk.Gt
            }
        } else if (c == 46) {
            if (d == 46 && e == 46) { k = Token.Tk.Ellipsis
                len = 3 } else if (d == 46 && e == 61) { k = Token.Tk.DotDotEq
                    len = 3 } else if (d == 46) { k = Token.Tk.DotDot
                        len = 2 } else { k = Token.Tk.Dot }
        } else if (c == 44) {
            k = Token.Tk.Comma
        } else if (c == 58) {
            k = Token.Tk.Colon
        } else if (c == 63) {
            k = Token.Tk.Question
        } else if (c == 64) {
            k = Token.Tk.At
        } else if (c == 40) {
            k = Token.Tk.LParen
            if (this.stack.Len() < 255) { this.stack.Push(40) }
        } else if (c == 91) {
            k = Token.Tk.LBrack
            if (this.stack.Len() < 255) { this.stack.Push(91) }
        } else if (c == 123) {
            k = Token.Tk.LBrace
            if (this.stack.Len() < 255) { this.stack.Push(123) }
        } else if (c == 41) {
            k = Token.Tk.RParen
            this.popBracket()
        } else if (c == 93) {
            k = Token.Tk.RBrack
            this.popBracket()
        } else if (c == 125) {
            k = Token.Tk.RBrace
            this.popBracket()
        }
        if (k == Token.Tk.Eof) {
            if (c >= 128) {
                this.diag.Error(pos, "unexpected non-ASCII character outside a string or comment")
            } else if (c == 35) {
                this.diag.Error(pos, "`#` is not used in Zevic")
            } else {
                this.diag.Error(pos, "unexpected character `${this.s.Slice(this.i, this.i + 1)}`")
            }
            this.advance()
            return
        }
        mut j: I64 = 0
        while (j < len) {
            this.advance()
            j += 1
        }
        mut t: Token.Token = this.push(k, pos)
        if (k == Token.Tk.Gt && this.angle > 0) {
            this.angle -= 1
            t.GenericClose = true
        } else if (k == Token.Tk.Shr && this.angle >= 2) {
            this.angle -= 2
            t.GenericClose = true
        }
    }

    mut fn popBracket() {
        if (this.stack.Len() > 0) {
            this.stack.Pop()
        }
    }

    // ---- numbers ----

    // If the text at offset `off` is `_` followed by a type suffix, returns it ("" otherwise).
    fn suffixAt(off: I64) -> String {
        if (this.peekc(off) != 95) {
            return ""
        }
        for (suffix in Suffixes) {
            let m: I64 = suffix.Len()
            if (this.i + off + 1 + m <= this.n && this.s.Slice(this.i + off + 1, this.i + off + 1 + m) == suffix && !isIdentChar(this.peekc(off + 1 + m))) {
                return suffix
            }
        }
        ""
    }

    // Reads digits of `base` with single underscores between digits.
    mut fn readDigits(base: I32, out: Buf, pos: Token.Pos) {
        mut o: Buf = out
        loop {
            let c: I32 = this.peekc(0)
            if (c == 95) {
                if (this.suffixAt(0) != "") {
                    return
                }
                let d: I32 = this.peekc(1)
                if (o.Len == 0 || digitValue(d) >= base) {
                    this.diag.Error(pos, "`_` in a number must sit between two digits")
                    this.advance()
                    continue
                }
                this.advance()
            } else if (c >= 0 && digitValue(c) < base && !(base <= 10 && !isDigit(c))) {
                o.Put(this.s.Slice(this.i, this.i + 1))
                this.advance()
            } else {
                return
            }
        }
    }

    mut fn lexNumber() {
        let pos: Token.Pos = this.here()
        mut digits: Buf = Buf.New()
        mut base: I32 = 10
        mut isFloat: Bool = false
        if (this.peekc(0) == 48 && (this.peekc(1) == 120 || this.peekc(1) == 98 || this.peekc(1) == 111)) {
            base = if (this.peekc(1) == 120) { 16 } else if (this.peekc(1) == 98) { 2 } else { 8 }
            this.advance()
            this.advance()
            this.readDigits(base, digits, pos)
            if (digits.Len == 0) {
                this.diag.Error(pos, "expected digits after the number prefix")
            }
        } else {
            this.readDigits(10, digits, pos)
            // a fraction: `.` must be followed by a digit (so `1..10` and `1.ToString()` work)
            if (this.peekc(0) == 46 && isDigit(this.peekc(1))) {
                isFloat = true
                digits.Put(".")
                this.advance()
                mut frac: Buf = Buf.New()
                this.readDigits(10, frac, pos)
                digits.Put(frac.String())
            } else if (this.peekc(0) == 46 && !isIdentStart(this.peekc(1)) && this.peekc(1) != 46) {
                this.diag.Error(pos, "a number needs digits on both sides of `.` (write `1.0`, not `1.`)")
            }
            let c: I32 = this.peekc(0)
            if (c == 101 || c == 69) {
                let d: I32 = this.peekc(1)
                let sign: I64 = if (d == 43 || d == 45) { 1 } else { 0 }
                if (isDigit(this.peekc(1 + sign))) {
                    isFloat = true
                    digits.Put("e")
                    this.advance()
                    if (sign == 1) {
                        digits.Put(this.s.Slice(this.i, this.i + 1))
                        this.advance()
                    }
                    while (isDigit(this.peekc(0))) {
                        digits.Put(this.s.Slice(this.i, this.i + 1))
                        this.advance()
                    }
                }
            }
        }
        let suffix: String = this.suffixAt(0)
        if (suffix != "") {
            mut k: I64 = 0
            while (k < suffix.Len() + 1) {
                this.advance()
                k += 1
            }
        }
        if (isIdentChar(this.peekc(0))) {
            this.diag.Error(pos, "unexpected `${this.s.Slice(this.i, this.i + 1)}` after a number (a type is written like `255_U8`)")
            while (isIdentChar(this.peekc(0))) {
                this.advance()
            }
        }
        let txt: String = digits.String()
        if (suffix != "" && suffix.Slice(0, 1) == "F") {
            isFloat = true
        }
        if (isFloat) {
            mut t: Token.Token = this.push(Token.Tk.Float, pos)
            t.Fval = txt.ToF64().UnwrapOr(0.0)
            t.Suffix = suffix
            if (suffix != "" && suffix.Slice(0, 1) != "F") {
                this.diag.Error(pos, "a decimal number cannot have the integer type `${suffix}`")
            }
            return
        }
        if (base == 10 && txt.Len() > 1 && txt.ByteAt(0).ToI32Wrap() == 48) {
            this.diag.Error(pos, "a number cannot start with 0 (octal is written `0o17`)")
        }
        mut v: U64 = 0_U64
        mut overflow: Bool = false
        let umax: U64 = 0xFFFFFFFFFFFFFFFF_U64
        let b: U64 = base.ToU64Wrap()
        mut k: I64 = 0
        while (k < txt.Len()) {
            let d: U64 = digitValue(txt.ByteAt(k).ToI32Wrap()).ToU64Wrap()
            if (v > (umax - d) / b) {
                overflow = true
            }
            v = v.WrapMul(b).WrapAdd(d)
            k += 1
        }
        if (overflow) {
            this.diag.Error(pos, "integer literal is too large (the maximum is 18446744073709551615)")
        }
        mut t: Token.Token = this.push(Token.Tk.Int, pos)
        t.Ival = v
        t.Suffix = suffix
    }

    // ---- characters and strings ----

    // The cursor is on the opening quote (a preceding `b` was already consumed).
    mut fn lexChar(isByte: Bool) {
        mut pos: Token.Pos = this.here()
        if (isByte) {
            pos = Token.Pos.New(pos.File, pos.Line, pos.Col - 1) // point at the `b`
        }
        this.advance()
        let s: String = this.s
        let n: I64 = this.n
        mut i: I64 = this.i
        if (i >= n || byteAt(s, i) == 10) {
            this.diag.Error(pos, "unterminated character literal")
            return
        }
        if (byteAt(s, i) == 39) {
            this.diag.Error(pos, "empty character literal")
            this.advance()
            return
        }
        mut cp: U32 = 0_U32
        if (byteAt(s, i) == 92) {
            i += 1
            let r: Esc = readEscape(s, n, i, if (isByte) { 255_U32 } else { 1114111_U32 })
            if (r.Err != "") {
                this.diag.Error(pos, r.Err)
                return
            }
            cp = r.Cp
            i = r.I
        } else {
            let len: I64 = Utf8Len(s, i, n)
            if (len == 0) {
                this.diag.Error(pos, "invalid UTF-8 in character literal")
                return
            }
            cp = utf8Cp(s, i, len)
            i += len
            if (isByte && cp >= 128_U32) {
                this.diag.Error(pos, "a byte literal must be ASCII (use `b'\\xNN'` for other values)")
            }
        }
        if (i >= n || byteAt(s, i) != 39) {
            this.diag.Error(pos, "a character literal holds exactly one character (use a string for more)")
            // resync: skip to the closing quote on this line
            while (this.i < this.n && this.peekc(0) != 39 && this.peekc(0) != 10) {
                this.advance()
            }
            if (this.peekc(0) == 39) {
                this.advance()
            }
            return
        }
        i += 1
        while (this.i < i) {
            this.advance()
        }
        mut t: Token.Token = this.push(if (isByte) { Token.Tk.Byte } else { Token.Tk.Char }, pos)
        t.Ival = cp.ToU64()
    }

    // Turns the body of a string literal into literal and `${}` parts.
    mut fn splitBody(body: String, raw: Bool, pos: Token.Pos, parts: Array<Token.StrPart>) {
        mut ps: Array<Token.StrPart> = parts
        let n: I64 = body.Len()
        mut cur: Buf = Buf.New()
        mut i: I64 = 0
        mut line: I32 = pos.Line
        mut col: I32 = pos.Col
        mut curLine: I32 = pos.Line
        mut curCol: I32 = pos.Col
        while (i < n) {
            let c: I32 = body.ByteAt(i).ToI32Wrap()
            if (!raw && c == 92) {
                mut j: I64 = i + 1
                let r: Esc = readEscape(body, n, j, 127_U32)
                if (r.Err != "") {
                    this.diag.Error(Token.Pos.New(pos.File, line, col), r.Err)
                    j = if (i + 2 > n) { n } else { i + 2 }
                } else {
                    cur.Put(cpString(r.Cp))
                    j = r.I
                }
                col += (j - i).ToI32Wrap()
                i = j
            } else if (!raw && c == 36 && i + 1 < n && byteAt(body, i + 1) == 123) {
                let end: I64 = skipInterp(body, n, i + 2)
                if (end >= n) {
                    this.diag.Error(Token.Pos.New(pos.File, line, col), "unterminated `\${` in a string")
                    return
                }
                if (cur.Len > 0) {
                    ps.Push(Token.StrPart.New(false, cur.String(), Token.Pos.New(pos.File, curLine, curCol)))
                    cur.Clear()
                }
                ps.Push(Token.StrPart.New(true, body.Slice(i + 2, end), Token.Pos.New(pos.File, line, col + 2)))
                mut k: I64 = i
                while (k <= end) {
                    let ch: I32 = body.ByteAt(k).ToI32Wrap()
                    if (ch == 10) {
                        line += 1
                        col = 1
                    } else if (ch / 64 != 2) {
                        col += 1
                    }
                    k += 1
                }
                i = end + 1
                curLine = line
                curCol = col
            } else {
                if (cur.Len == 0) {
                    curLine = line
                    curCol = col
                }
                // whole characters (a byte of a multi-byte character is not a string on its own)
                let len: I64 = Utf8Len(body, i, n)
                let step: I64 = if (len == 0) { 1 } else { len }
                if (len > 0) {
                    cur.Put(body.Slice(i, i + len))
                }
                if (c == 10) {
                    line += 1
                    col = 1
                } else if (c / 64 != 2) {
                    col += 1
                }
                i += step
            }
        }
        if (cur.Len > 0) {
            ps.Push(Token.StrPart.New(false, cur.String(), Token.Pos.New(pos.File, curLine, curCol)))
        }
    }

    mut fn checkUtf8(text: String, pos: Token.Pos) {
        let n: I64 = text.Len()
        mut i: I64 = 0
        while (i < n) {
            let len: I64 = Utf8Len(text, i, n)
            if (len == 0) {
                this.diag.Error(pos, "invalid UTF-8 in a string literal")
                return
            }
            i += len
        }
    }

    // The cursor is on the opening quote.
    mut fn lexString(raw: Bool) {
        mut pos: Token.Pos = this.here()
        if (raw) {
            pos = Token.Pos.New(pos.File, pos.Line, pos.Col - 1) // the `r`
        }
        let s: String = this.s
        let n: I64 = this.n
        mut i: I64 = this.i
        let triple: Bool = i + 2 < n && byteAt(s, i + 1) == 34 && byteAt(s, i + 2) == 34
        mut ps: Array<Token.StrPart> = []
        if (triple) {
            i += 3
            // the opening quotes must be followed by a newline
            mut j: I64 = i
            while (j < n && (byteAt(s, j) == 32 || byteAt(s, j) == 9 || byteAt(s, j) == 13)) {
                j += 1
            }
            if (j >= n || byteAt(s, j) != 10) {
                this.diag.Error(pos, "a `\"\"\"` string must start on a new line (put the text after the line break)")
            } else {
                i = j + 1
            }
            let bodyStart: I64 = i
            mut k: I64 = i
            loop {
                if (k >= n) {
                    this.diag.Error(pos, "unterminated multi-line string")
                    while (this.i < n) {
                        this.advance()
                    }
                    return
                }
                if (!raw && byteAt(s, k) == 92) {
                    k += 2
                    continue
                }
                if (!raw && byteAt(s, k) == 36 && k + 1 < n && byteAt(s, k + 1) == 123) {
                    k = skipInterp(s, n, k + 2) + 1
                    continue
                }
                if (byteAt(s, k) == 34 && k + 2 < n && byteAt(s, k + 1) == 34 && byteAt(s, k + 2) == 34) {
                    break
                }
                k += 1
            }
            let bodyEnd: I64 = k
            let total: I64 = k + 3
            // dedent: the indentation of the closing line is removed from every line
            mut ls: I64 = bodyEnd
            while (ls > bodyStart && byteAt(s, ls - 1) != 10) {
                ls -= 1
            }
            let indent: I64 = bodyEnd - ls
            mut blank: Bool = true
            mut q: I64 = ls
            while (q < bodyEnd) {
                if (byteAt(s, q) != 32 && byteAt(s, q) != 9) {
                    blank = false
                }
                q += 1
            }
            mut text: Buf = Buf.New()
            if (!blank) {
                this.diag.Error(pos, "the closing `\"\"\"` must be on its own line")
                text.Put(s.Slice(bodyStart, bodyEnd))
            } else {
                mut p: I64 = bodyStart
                let contentEnd: I64 = if (ls == bodyStart) { bodyStart } else { ls - 1 } // drop the last newline
                mut first: Bool = true
                while (p <= contentEnd && ls > bodyStart) {
                    mut e: I64 = p
                    while (e < contentEnd && byteAt(s, e) != 10) {
                        e += 1
                    }
                    let lstart: I64 = p
                    mut skip: I64 = 0
                    while (skip < indent && lstart + skip < e && (byteAt(s, lstart + skip) == 32 || byteAt(s, lstart + skip) == 9)) {
                        skip += 1
                    }
                    if (skip < indent && e > lstart + skip) {
                        this.diag.Error(Token.Pos.New(pos.File, pos.Line, pos.Col), "a line in a multi-line string is indented less than the closing `\"\"\"`")
                    }
                    if (!first) {
                        text.Put("\n")
                    }
                    first = false
                    mut cut: I64 = e
                    if (cut > lstart && byteAt(s, cut - 1) == 13) {
                        cut -= 1
                    }
                    text.Put(s.Slice(lstart + skip, cut))
                    if (e >= contentEnd) {
                        break
                    }
                    p = e + 1
                }
            }
            let bp: Token.Pos = Token.Pos.New(pos.File, pos.Line + 1, 1)
            let body: String = text.String()
            this.checkUtf8(body, pos)
            this.splitBody(body, raw, bp, ps)
            while (this.i < total) {
                this.advance()
            }
        } else {
            i += 1
            let bodyStart: I64 = i
            mut k: I64 = i
            loop {
                if (k >= n || byteAt(s, k) == 10) {
                    this.diag.Error(pos, "unterminated string (a string cannot span lines; use `\"\"\"` for that)")
                    while (this.i < k && this.i < this.n) {
                        this.advance()
                    }
                    return
                }
                if (!raw && byteAt(s, k) == 92) {
                    k += 2
                    continue
                }
                if (!raw && byteAt(s, k) == 36 && k + 1 < n && byteAt(s, k + 1) == 123) {
                    k = skipInterp(s, n, k + 2) + 1
                    continue
                }
                if (byteAt(s, k) == 34) {
                    break
                }
                k += 1
            }
            let bodyEnd: I64 = k
            let body: String = s.Slice(bodyStart, bodyEnd)
            this.checkUtf8(body, pos)
            let bp: Token.Pos = Token.Pos.New(pos.File, pos.Line, pos.Col + if (raw) { 2 } else { 1 })
            this.splitBody(body, raw, bp, ps)
            while (this.i < bodyEnd + 1) {
                this.advance()
            }
        }
        mut t: Token.Token = this.push(Token.Tk.Str, pos)
        t.Parts = ps
    }

    // Tokenizes the whole text.
    mut fn Run() -> Array<Token.Token> {
        // skip a UTF-8 BOM
        if (this.n >= 3 && byteAt(this.s, 0) == 239 && byteAt(this.s, 1) == 187 && byteAt(this.s, 2) == 191) {
            this.i = 3
        }
        while (this.i < this.n) {
            let c: I32 = this.peekc(0)
            let pos: Token.Pos = this.here()
            if (c == 32 || c == 9 || c == 13) {
                this.skip()
            } else if (c == 10) {
                this.advance()
                this.newline(pos)
            } else if (c == 59) {
                this.advance()
                if (!this.toks.IsEmpty() && this.toks[this.toks.Len() - 1].Kind != Token.Tk.Nl) {
                    this.push(Token.Tk.Nl, pos)
                }
            } else if (c == 47 && this.peekc(1) == 47) {
                while (this.i < this.n && this.peekc(0) != 10) {
                    this.advance()
                }
            } else if (c == 47 && this.peekc(1) == 42) {
                this.skipBlockComment()
            } else if (isIdentStart(c)) {
                this.lexIdent()
            } else if (isDigit(c)) {
                this.lexNumber()
            } else if (c == 34) {
                this.lexString(false)
            } else if (c == 39) {
                this.lexChar(false)
            } else if (c == 96) {
                this.lexBacktick()
            } else {
                this.lexOp()
            }
        }
        if (!this.toks.IsEmpty() && this.toks[this.toks.Len() - 1].Kind != Token.Tk.Nl) {
            this.push(Token.Tk.Nl, this.here())
        }
        this.push(Token.Tk.Eof, this.here())
        this.toks
    }
}

// Tokenizes `text` (`line` and `col` are the position of its first character).
fn Lex(mut diag: Diag.Diag, file: I32, text: String, line: I32, col: I32) -> Array<Token.Token> {
    mut lx: Lexer = Lexer.New(diag, file, text, line, col)
    lx.Run()
}
