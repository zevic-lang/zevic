module Zevic1.Resolve

// Loading files and resolving modules and imports: a port of zevic0/module.c.

import Zevic.Console
import Zevic.Env
import Zevic.Fs
import Zevic.Text
import Zevic1.Ast as Ast
import Zevic1.Diag as Diag
import Zevic1.Parser as Parser
import Zevic1.Token as Token
import Zevic1.Types as Types

class Decl {
    Node: Ast.Node
    Name: String
    Abi: String = ""
    HasAbi: Bool = false
    IsPub: Bool = false
    // for the hidden function of a `test "name" { }` block: the name
    TestName: String = ""
    // the module and the file the declaration is in
    ModName: String = ""
    ModIsStd: Bool = false
    File: Option<FileInfo> = None
    // a default method taken from this interface type (with its type arguments)
    Iface: Option<Types.Type> = None

    fn Init(node: Ast.Node, name: String) {
        this.Node = node
        this.Name = name
    }

    // the unique name of the declaration
    fn Key() -> String { "${this.ModName}::${this.Name}" }

    fn FileInfo() -> FileInfo {
        match (this.File) {
            Some(f) => f,
            None => Panic("declaration without a file"),
        }
    }
}

class Module {
    Id: I64 = 0
    Name: String
    Files: Array<FileInfo> = []
    Decls: Map<String, Decl> = Map.New()
    // one hidden function per `test` block, in source order
    Tests: Array<Decl> = []
    Deps: Array<Module> = []
    IsStd: Bool = false
    // cycle detection
    Visit: I32 = 0

    fn Init(name: String, isStd: Bool) {
        this.Name = name
        this.IsStd = isStd
    }
}

// A parsed file together with what the resolver learns about it.
class FileInfo {
    Sf: Ast.SourceFile
    Mod: Option<Module> = None
    // the name used in the source -> the module
    ImportMap: Map<String, Module> = Map.New()

    fn Init(sf: Ast.SourceFile) {
        this.Sf = sf
    }
}

class Program {
    Modules: Array<Module> = []
    ModByName: Map<String, Module> = Map.New()
    Files: Array<FileInfo> = []
    // the directory holding the standard library, e.g. .../stdlib
    StdDir: String
    SearchDirs: Array<String> = []

    fn Init(stdDir: String) {
        this.StdDir = stdDir
    }

    fn FindModule(name: String) -> Option<Module> { this.ModByName.Get(name) }

    mut fn moduleGet(name: String, isStd: Bool) -> Module {
        match (this.ModByName.Get(name)) {
            Some(m) => return m,
            None => {},
        }
        mut m: Module = Module.New(name, isStd)
        m.Id = this.Modules.Len()
        this.ModByName.Set(name, m)
        this.Modules.Push(m)
        m
    }
}

fn reservedName(n: String) -> Bool {
    let names: Array<String> = ["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64", "Bool", "Char", "String", "Unit", "Array", "Map", "Option", "Result", "Error", "ErrorKind", "StringBuilder", "Some", "None", "Ok", "Err", "Panic", "Same"]
    for (x in names) {
        if (x == n) { return true }
    }
    false
}

fn isUpper(name: String) -> Bool {
    if (name.Len() == 0) { return false }
    let c: I32 = name.ByteAt(0).ToI32Wrap()
    c >= 65 && c <= 90
}

fn addDecl(mut diag: Diag.Diag, mut m: Module, info: FileInfo, n: Ast.Node, abi: Option<String>) {
    if (n.Kind == Ast.NK.DTest) {
        // a test becomes a function `test.N` that no name can reach; it is only built by `--test`
        mut tf: Ast.Node = Ast.Node.New(Ast.NK.DFn, n.Pos)
        tf.SetName("test.${m.Tests.Len()}")
        tf.B = n.B
        mut t: Decl = Decl.New(tf, tf.Name)
        t.TestName = n.Name
        t.ModName = m.Name
        t.ModIsStd = m.IsStd
        t.File = Some(info)
        m.Tests.Push(t)
        return
    }
    mut d: Decl = Decl.New(n, n.Name)
    d.ModName = m.Name
    d.ModIsStd = m.IsStd
    d.File = Some(info)
    match (abi) {
        Some(a) => {
            d.Abi = a
            d.HasAbi = true
        },
        None => {},
    }
    d.IsPub = isUpper(n.Name)
    match (m.Decls.Get(n.Name)) {
        Some(old) => {
            diag.Error(n.Pos, "`${n.Name}` is already defined in module ${m.Name}")
            diag.Note("the first definition is at ${diag.Name(old.Node.Pos.File)}:${old.Node.Pos.Line}")
            return
        },
        None => {},
    }
    m.Decls.Set(n.Name, d)
}

// Parses and registers a file. None when it cannot be read.
fn LoadFile(mut pg: Program, mut diag: Diag.Diag, path: String, isStd: Bool) -> Option<FileInfo> {
    let text: String = match (Fs.ReadAll(path)) {
        Ok(t) => t,
        Err(_) => return None,
    }
    let file: I32 = diag.AddSource(path, text)
    mut sf: Ast.SourceFile = Parser.ParseFile(diag, file, text)
    sf.IsStd = isStd
    mut info: FileInfo = FileInfo.New(sf)
    pg.Files.Push(info)
    if (!sf.HasModule) { return Some(info) }
    // user code cannot define the reserved `Zevic` root
    if (!isStd && (sf.Module == "Zevic" || Text.StartsWith(sf.Module, "Zevic."))) {
        diag.Error(sf.ModulePos, "module names starting with `Zevic` are reserved for the standard library")
    }
    mut m: Module = pg.moduleGet(sf.Module, isStd)
    info.Mod = Some(m)
    m.Files.Push(info)
    for (d in sf.Decls) {
        if (d.Kind == Ast.NK.DExtern) {
            for (e in d.List) {
                addDecl(diag, m, info, e, Some(d.Name))
            }
            continue
        }
        if (!isStd && d.HasName && reservedName(d.Name)) {
            diag.Error(d.Pos, "`${d.Name}` is a reserved name (it is part of the prelude)")
        }
        addDecl(diag, m, info, d, None)
    }
    Some(info)
}

fn toSlashPath(dotted: String) -> String { Text.Replace(dotted, ".", "/") }

// The part of `name` after the first `.`.
fn afterFirstDot(s: String) -> Option<String> {
    mut i: I64 = 0
    while (i < s.Len()) {
        if (s.ByteAt(i).ToI32Wrap() == 46) { return Some(s.Slice(i + 1, s.Len())) }
        i += 1
    }
    None
}

fn tryLoadModule(mut pg: Program, mut diag: Diag.Diag, name: String) {
    let rel: String = toSlashPath(name)
    if (Text.StartsWith(name, "Zevic.")) {
        let path: String = "${pg.StdDir}/${rel.Slice(6, rel.Len())}.zev"
        if (Fs.IsFile(path)) {
            let r: Option<FileInfo> = LoadFile(pg, diag, path, true)
        }
        return
    }
    for (dir in pg.SearchDirs) {
        let p1: String = "${dir}/${rel}.zev"
        if (Fs.IsFile(p1)) {
            let r: Option<FileInfo> = LoadFile(pg, diag, p1, false)
            return
        }
        let p2: String = "${dir}/src/${rel}.zev"
        if (Fs.IsFile(p2)) {
            let r: Option<FileInfo> = LoadFile(pg, diag, p2, false)
            return
        }
        // the package name is the first segment: allow <dir>/<rest>.zev
        match (afterFirstDot(name)) {
            Some(rest) => {
                let p3: String = "${dir}/${toSlashPath(rest)}.zev"
                if (Fs.IsFile(p3)) {
                    let r: Option<FileInfo> = LoadFile(pg, diag, p3, false)
                    return
                }
            },
            None => {},
        }
    }
}

fn resolveFileImports(mut pg: Program, mut diag: Diag.Diag, mut info: FileInfo) {
    let sf: Ast.SourceFile = info.Sf
    mut self: Module = match (info.Mod) {
        Some(m) => m,
        None => return,
    }
    for (im in sf.Imports) {
        let name: String = Ast.PathJoin(im.Path, ".")
        if (!sf.IsStd && Text.StartsWith(name, "Zevic.Intrinsics")) {
            diag.Error(im.Pos, "`Zevic.Intrinsics` is only for the standard library")
            continue
        }
        if (pg.FindModule(name).IsNone()) {
            tryLoadModule(pg, diag, name)
        }
        let m: Module = match (pg.FindModule(name)) {
            Some(x) => x,
            None => {
                diag.Error(im.Pos, "cannot find module `${name}`")
                if (Text.StartsWith(name, "Zevic.")) {
                    diag.Note("looked for the standard library file ${pg.StdDir}/${toSlashPath(name).Slice(6, toSlashPath(name).Len())}.zev")
                }
                continue
            },
        }
        if (m.Id == self.Id) {
            diag.Error(im.Pos, "a module cannot import itself")
            continue
        }
        let key: String = if (im.HasName) { im.Name } else { name }
        if (info.ImportMap.Contains(key)) {
            diag.Error(im.Pos, "`${key}` is already imported (or the name is used by another import)")
            continue
        }
        info.ImportMap.Set(key, m)
        if (!im.HasName && m.IsStd && Text.StartsWith(name, "Zevic.")) {
            // the standard library may be written without the leading `Zevic.`
            let short: String = name.Slice(6, name.Len())
            if (info.ImportMap.Contains(short)) {
                diag.Error(im.Pos, "the short name `${short}` clashes with another import; use the full name or `as`")
            } else {
                info.ImportMap.Set(short, m)
            }
        }
        mut seen: Bool = false
        for (d in self.Deps) {
            if (d.Id == m.Id) { seen = true }
        }
        if (!seen) { self.Deps.Push(m) }
    }
}

// Returns true when a cycle is found; `stack` then ends with the module that closes it.
fn dfsCycle(mut m: Module, mut stack: Array<Module>) -> Bool {
    if (m.Visit == 2) { return false }
    stack.Push(m)
    if (m.Visit == 1) { return true }
    m.Visit = 1
    for (d in m.Deps) {
        if (dfsCycle(d, stack)) { return true }
    }
    m.Visit = 2
    stack.Pop()
    false
}

fn Resolve(mut pg: Program, mut diag: Diag.Diag) {
    // `fn Main(args: Array<String>)` gets its arguments from Zevic.Env, which the program need not import
    match (pg.FindModule("Main")) {
        Some(mm) => {
            match (mm.Decls.Get("Main")) {
                Some(md) => {
                    if (md.Node.Kind == Ast.NK.DFn && md.Node.List.Len() == 1 && pg.FindModule("Zevic.Env").IsNone()) {
                        tryLoadModule(pg, diag, "Zevic.Env")
                    }
                },
                None => {},
            }
        },
        None => {},
    }
    // `async` and `await` are sugar for Zevic.Async, which the program need not import
    mut usesAsync: Bool = false
    for (f in pg.Files) {
        if (f.Sf.UsesAsync) { usesAsync = true }
    }
    if (usesAsync && pg.FindModule("Zevic.Async").IsNone()) {
        tryLoadModule(pg, diag, "Zevic.Async")
    }
    // the file list grows while it is walked: files loaded for an import are resolved too
    mut i: I64 = 0
    while (i < pg.Files.Len()) {
        resolveFileImports(pg, diag, pg.Files[i])
        i += 1
    }
    for (m in pg.Modules) {
        mut stack: Array<Module> = []
        if (dfsCycle(m, stack)) {
            let last: Module = stack[stack.Len() - 1]
            mut text: String = ""
            mut on: Bool = false
            for (x in stack) {
                if (x.Id == last.Id) { on = true }
                if (on) { text += "${if (text.Len() > 0) { " -> " } else { "" }}${x.Name}" }
            }
            let pos: Token.Pos = if (last.Files.Len() > 0) { last.Files[0].Sf.ModulePos } else { Token.Pos.New(0, 0, 0) }
            diag.Error(pos, "circular import: ${text}")
            return
        }
    }
}
