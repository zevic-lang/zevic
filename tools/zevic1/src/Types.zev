module Zevic1.Types

// Semantic types (port of zevic0/types.c). Types are interned in a TypeTable: equal types are the same object.

import Zevic.Text

enum TKind {
    I8, I16, I32, I64, U8, U16, U32, U64,
    F32, F64, Bool, Char, Str, Unit, Never,
    Tuple, // Args = element types
    Fn, // Args = parameter types, Ret = result
    Struct, Class, Enum,
    Ptr, // Args[0] = pointee (C interop)
    Buf, // Zevic.Intrinsics.Buf<T>
    Iface, // an interface value: { object, method table }
    CType, // C types: Name says which
    Param, // an unbound type parameter
    Union, // A | B: Args = the members in the order of their names; variants[i] holds Args[i]

    fn IsInt() -> Bool {
        match (this) {
            TKind.I8 | TKind.I16 | TKind.I32 | TKind.I64 | TKind.U8 | TKind.U16 | TKind.U32 | TKind.U64 => true,
            _ => false,
        }
    }

    fn IsSigned() -> Bool {
        match (this) {
            TKind.I8 | TKind.I16 | TKind.I32 | TKind.I64 => true,
            _ => false,
        }
    }
}

class Field {
    Name: String
    T: Type

    fn Init(name: String, t: Type) {
        this.Name = name
        this.T = t
    }
}

class Variant {
    Name: String
    Tag: I32
    Named: Bool = false
    Fields: Array<Field> = []
    // the tuple type of the field types, None when there is no data
    Payload: Option<Type> = None

    fn Init(name: String, tag: I32) {
        this.Name = name
        this.Tag = tag
    }
}

class Type {
    Kind: TKind
    // display name, also the intern key
    Name: String
    Args: Array<Type> = []
    Ret: Option<Type> = None
    // the declaration of a struct / class / enum (its qualified name; the declaration itself comes with the checker)
    DeclName: String = ""
    Id: I32 = 0
    MembersDone: Bool = false
    Fields: Array<Field> = []
    Variants: Array<Variant> = []
    LaidOut: Bool = false
    Size: I64 = 0
    Align: I64 = 0
    // the LLVM type; empty while it is being computed
    Ll: String = ""
    // enum, union: size of the payload in 8-byte words. C types: 1 for a signed integer.
    PayloadWords: I32 = 0

    fn Init(kind: TKind, name: String) {
        this.Kind = kind
        this.Name = name
    }

    fn IsInt() -> Bool { this.Kind.IsInt() }
    fn IsSigned() -> Bool { this.Kind.IsSigned() }
    fn IsFloat() -> Bool { this.Kind == TKind.F32 || this.Kind == TKind.F64 }
    fn IsCType() -> Bool { this.Kind == TKind.CType }
    fn IsNumeric() -> Bool { this.IsInt() || this.IsFloat() }
    fn IsRef() -> Bool { this.Kind == TKind.Class }

    // struct, enum, union, tuple and string are values that live in registers and are copied
    fn IsValueAgg() -> Bool {
        match (this.Kind) {
            TKind.Struct | TKind.Enum | TKind.Union | TKind.Tuple | TKind.Str => true,
            _ => false,
        }
    }

    // integer width
    fn Bits() -> I32 {
        match (this.Kind) {
            TKind.I8 | TKind.U8 => 8,
            TKind.I16 | TKind.U16 => 16,
            TKind.I32 | TKind.U32 => 32,
            TKind.I64 | TKind.U64 => 64,
            _ => 0,
        }
    }
}

// the number of the kind (the order of the C enum), for the tests
fn KindNo(k: TKind) -> I32 {
    match (k) {
        TKind.I8 => 0, TKind.I16 => 1, TKind.I32 => 2, TKind.I64 => 3, TKind.U8 => 4, TKind.U16 => 5, TKind.U32 => 6, TKind.U64 => 7,
        TKind.F32 => 8, TKind.F64 => 9, TKind.Bool => 10, TKind.Char => 11, TKind.Str => 12, TKind.Unit => 13, TKind.Never => 14,
        TKind.Tuple => 15, TKind.Fn => 16, TKind.Struct => 17, TKind.Class => 18, TKind.Enum => 19, TKind.Ptr => 20, TKind.Buf => 21,
        TKind.Iface => 22, TKind.CType => 23, TKind.Param => 24, TKind.Union => 25,
    }
}

fn roundUp(n: I64, a: I64) -> I64 { (n + a - 1) / a * a }

class CTypeRow {
    Name: String
    // 0: depends on the platform (long)
    Bytes: I64
    // 0 unsigned int, 1 signed int, 2 float, 3 bool, 4 string, 5 void
    Kind: I32

    fn Init(name: String, bytes: I64, kind: I32) {
        this.Name = name
        this.Bytes = bytes
        this.Kind = kind
    }
}

class TypeTable {
    types: Map<String, Type> = Map.New()
    nextId: I32 = 0
    // set when a layout needs a type that contains itself by value (infinite size)
    Cycle: Option<Type> = None
    // widths of the C compiler of the platform the program is built on
    longBytes: I64
    cRows: Array<CTypeRow> = []

    I8: Type
    I16: Type
    I32: Type
    I64: Type
    U8: Type
    U16: Type
    U32: Type
    U64: Type
    F32: Type
    F64: Type
    Bool: Type
    Char: Type
    Str: Type
    Unit: Type
    Never: Type

    fn Init(longBytes: I64) {
        this.longBytes = longBytes
        this.nextId = 0
        this.I8 = this.prim(TKind.I8, "I8")
        this.I16 = this.prim(TKind.I16, "I16")
        this.I32 = this.prim(TKind.I32, "I32")
        this.I64 = this.prim(TKind.I64, "I64")
        this.U8 = this.prim(TKind.U8, "U8")
        this.U16 = this.prim(TKind.U16, "U16")
        this.U32 = this.prim(TKind.U32, "U32")
        this.U64 = this.prim(TKind.U64, "U64")
        this.F32 = this.prim(TKind.F32, "F32")
        this.F64 = this.prim(TKind.F64, "F64")
        this.Bool = this.prim(TKind.Bool, "Bool")
        this.Char = this.prim(TKind.Char, "Char")
        this.Str = this.prim(TKind.Str, "String")
        this.Unit = this.prim(TKind.Unit, "Unit")
        this.Never = this.prim(TKind.Never, "Never")
        let rows: Array<(String, I64, I32)> = [
            ("CChar", 1, 1), ("CSChar", 1, 1), ("CUChar", 1, 0), ("CShort", 2, 1), ("CUShort", 2, 0),
            ("CInt", 4, 1), ("CUInt", 4, 0), ("CLong", 0, 1), ("CULong", 0, 0),
            ("CLongLong", 8, 1), ("CULongLong", 8, 0),
            ("CSizeT", 8, 0), ("CSSizeT", 8, 1), ("CPtrDiff", 8, 1), ("CIntPtr", 8, 1), ("CUIntPtr", 8, 0),
            ("CFloat", 4, 2), ("CDouble", 8, 2), ("CBool", 1, 3), ("CString", 8, 4), ("CVoid", 0, 5),
        ]
        for (r in rows) {
            let (n, b, k): (String, I64, I32) = r
            this.cRows.Push(CTypeRow.New(n, b, k))
        }
    }

    // The type with this name, or the new one.
    mut fn intern(mut t: Type) -> Type {
        match (this.types.Get(t.Name)) {
            Some(old) => old,
            None => {
                t.Id = this.nextId
                this.nextId += 1
                this.types.Set(t.Name, t)
                t
            },
        }
    }

    mut fn prim(kind: TKind, name: String) -> Type {
        this.intern(Type.New(kind, name))
    }

    fn PrimByName(name: String) -> Option<Type> {
        match (name) {
            "I8" | "I16" | "I32" | "I64" | "U8" | "U16" | "U32" | "U64" | "F32" | "F64" | "Bool" | "Char" | "String" | "Unit" => this.types.Get(name),
            _ => None,
        }
    }

    // CInt, CString, CVoid, ...
    mut fn CByName(name: String) -> Option<Type> {
        for (row in this.cRows) {
            if (row.Name != name) {
                continue
            }
            let bytes: I64 = if (row.Bytes != 0) { row.Bytes } else { this.longBytes }
            match (this.types.Get(name)) {
                Some(t) => return Some(t),
                None => {},
            }
            mut t: Type = Type.New(TKind.CType, name)
            t.LaidOut = true
            match (row.Kind) {
                0 | 1 => {
                    t.Size = bytes
                    t.Align = bytes
                    t.PayloadWords = row.Kind
                    t.Ll = "i${bytes * 8}"
                },
                2 => {
                    t.Size = bytes
                    t.Align = bytes
                    t.Ll = if (bytes == 4) { "float" } else { "double" }
                },
                3 => {
                    t.Size = 1
                    t.Align = 1
                    t.Ll = "i8"
                },
                4 => {
                    t.Size = 8
                    t.Align = 8
                    t.Ll = "ptr"
                },
                _ => {
                    t.Size = 0
                    t.Align = 0
                    t.Ll = "void"
                },
            }
            this.types.Set(name, t)
            return Some(t)
        }
        None
    }

    mut fn Tuple(elems: Array<Type>) -> Type {
        mut names: Array<String> = []
        for (e in elems) {
            names.Push(e.Name)
        }
        mut t: Type = Type.New(TKind.Tuple, "(${names.Join(", ")})")
        t.Args = elems
        this.intern(t)
    }

    mut fn Fn(params: Array<Type>, ret: Type) -> Type {
        mut names: Array<String> = []
        for (p in params) {
            names.Push(p.Name)
        }
        mut t: Type = Type.New(TKind.Fn, "fn(${names.Join(", ")}) -> ${ret.Name}")
        t.Args = params
        t.Ret = Some(ret)
        this.intern(t)
    }

    mut fn Ptr(pointee: Type) -> Type {
        mut t: Type = Type.New(TKind.Ptr, "*${pointee.Name}")
        t.Args.Push(pointee)
        this.intern(t)
    }

    mut fn Param(name: String) -> Type {
        this.intern(Type.New(TKind.Param, "'${name}"))
    }

    mut fn CType(name: String, size: I64, isSigned: Bool) -> Type {
        mut t: Type = Type.New(TKind.CType, name)
        t.Size = size
        t.Align = size
        t.LaidOut = true
        t.PayloadWords = if (isSigned) { 1 } else { 0 }
        t.Ll = "i${size * 8}"
        this.intern(t)
    }

    // A struct, class or enum, with its type arguments: `Qualified.Name<A, B>`.
    mut fn Named(kind: TKind, declName: String, qualified: String, args: Array<Type>) -> Type {
        mut name: String = qualified
        if (args.Len() > 0) {
            mut names: Array<String> = []
            for (a in args) {
                names.Push(a.Name)
            }
            name = "${qualified}<${names.Join(", ")}>"
        }
        mut t: Type = Type.New(kind, name)
        t.Args = args
        t.DeclName = declName
        this.intern(t)
    }

    // The union of the given types: nested unions are flattened, duplicates dropped and the members put in the order
    // of their names, so `A | B` and `B | A` are the same type. One member left: that member itself.
    mut fn Union(members: Array<Type>) -> Type {
        mut flat: Array<Type> = []
        for (m in members) {
            if (m.Kind == TKind.Union) {
                for (k in m.Args) {
                    flat.Push(k)
                }
            } else {
                flat.Push(m)
            }
        }
        flat.SortBy((a: Type, b: Type) => a.Name.Compare(b.Name))
        mut uniq: Array<Type> = []
        mut i: I64 = 0
        while (i < flat.Len()) {
            if (i == 0 || !(flat[i].Id == flat[i - 1].Id)) {
                uniq.Push(flat[i])
            }
            i += 1
        }
        if (uniq.Len() == 1) {
            return uniq[0]
        }
        mut names: Array<String> = []
        for (m in uniq) {
            // a function type needs parentheses inside a union: fn(A) -> B | C reads as a function returning a union
            names.Push(if (m.Kind == TKind.Fn) { "(${m.Name})" } else { m.Name })
        }
        let name: String = names.Join(" | ")
        match (this.types.Get(name)) {
            Some(old) => return old,
            None => {},
        }
        mut t: Type = Type.New(TKind.Union, name)
        t.Args = uniq
        t.MembersDone = true
        mut tag: I32 = 0
        for (m in uniq) {
            mut v: Variant = Variant.New(m.Name, tag)
            v.Fields.Push(Field.New("0", m))
            mut one: Array<Type> = []
            one.Push(m)
            v.Payload = Some(this.Tuple(one))
            t.Variants.Push(v)
            tag += 1
        }
        this.intern(t)
    }

    // ---- layout ----

    // The size and alignment of fields laid out one after another (a cyclic field is skipped and recorded).
    mut fn structLayout(types: Array<Type>) -> (I64, I64) {
        mut off: I64 = 0
        mut al: I64 = 1
        for (ft in types) {
            if (ft.LaidOut && ft.Ll == "") {
                this.Cycle = Some(ft)
                continue
            }
            this.Layout(ft)
            off = roundUp(off, ft.Align)
            off += ft.Size
            if (ft.Align > al) {
                al = ft.Align
            }
        }
        (roundUp(off, al), al)
    }

    mut fn Layout(mut t: Type) {
        if (t.LaidOut) {
            return
        }
        t.LaidOut = true
        match (t.Kind) {
            TKind.I8 | TKind.U8 => { t.Size = 1; t.Align = 1; t.Ll = "i8" },
            TKind.I16 | TKind.U16 => { t.Size = 2; t.Align = 2; t.Ll = "i16" },
            TKind.I32 | TKind.U32 => { t.Size = 4; t.Align = 4; t.Ll = "i32" },
            TKind.I64 | TKind.U64 => { t.Size = 8; t.Align = 8; t.Ll = "i64" },
            TKind.F32 => { t.Size = 4; t.Align = 4; t.Ll = "float" },
            TKind.F64 => { t.Size = 8; t.Align = 8; t.Ll = "double" },
            TKind.Bool => { t.Size = 1; t.Align = 1; t.Ll = "i1" },
            TKind.Char => { t.Size = 4; t.Align = 4; t.Ll = "i32" },
            TKind.Str => { t.Size = 16; t.Align = 8; t.Ll = "{ ptr, i64 }" },
            TKind.Unit | TKind.Never => { t.Size = 0; t.Align = 1; t.Ll = "{}" },
            TKind.Class | TKind.Ptr | TKind.Buf => { t.Size = 8; t.Align = 8; t.Ll = "ptr" },
            TKind.Fn | TKind.Iface => { t.Size = 16; t.Align = 8; t.Ll = "{ ptr, ptr }" },
            TKind.Tuple => {
                mut parts: Array<String> = []
                for (e in t.Args) {
                    if (e.LaidOut && e.Ll == "") {
                        this.Cycle = Some(e)
                        parts.Push("{}")
                        continue
                    }
                    this.Layout(e)
                    parts.Push(e.Ll)
                }
                t.Ll = "{ ${parts.Join(", ")}${if (t.Args.Len() > 0) { " }" } else { "}" }}"
                let (size, align): (I64, I64) = this.structLayout(t.Args)
                t.Size = size
                t.Align = align
            },
            TKind.Struct => {
                mut ts: Array<Type> = []
                mut parts: Array<String> = []
                for (f in t.Fields) {
                    if (f.T.LaidOut && f.T.Ll == "") {
                        this.Cycle = Some(f.T)
                        continue
                    }
                    this.Layout(f.T)
                    ts.Push(f.T)
                    parts.Push(f.T.Ll)
                }
                t.Ll = "{ ${parts.Join(", ")}${if (t.Fields.Len() > 0) { " }" } else { "}" }}"
                let (size, align): (I64, I64) = this.structLayout(ts)
                t.Size = size
                t.Align = align
            },
            TKind.Enum | TKind.Union => {
                mut max: I64 = 0
                for (v in t.Variants) {
                    match (v.Payload) {
                        Some(p) => {
                            if (p.LaidOut && p.Ll == "") {
                                this.Cycle = Some(t)
                                continue
                            }
                            this.Layout(p)
                            if (p.Size > max) {
                                max = p.Size
                            }
                        },
                        None => {},
                    }
                }
                t.PayloadWords = ((max + 7) / 8).ToI32Wrap()
                if (t.PayloadWords == 0) {
                    t.Ll = "{ i32 }"
                    t.Size = 4
                    t.Align = 4
                } else {
                    t.Ll = "{ i32, [${t.PayloadWords} x i64] }"
                    t.Size = 8 + 8 * t.PayloadWords.ToI64()
                    t.Align = 8
                }
            },
            _ => {
                t.Size = 8
                t.Align = 8
                t.Ll = "ptr"
            },
        }
    }

    mut fn LlOf(t: Type) -> String {
        this.Layout(t)
        t.Ll
    }

    mut fn SizeOf(t: Type) -> I64 {
        this.Layout(t)
        t.Size
    }

    mut fn AlignOf(t: Type) -> I64 {
        this.Layout(t)
        t.Align
    }
}
