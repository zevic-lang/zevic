module Zevic1.Driver

// Running clang: a port of zevic0/driver.c (driver_find_clang, driver_build, driver_build_lib).

import Zevic.Console
import Zevic.Convert
import Zevic.Env
import Zevic.Fs
import Zevic.Process
import Zevic.Text
import Zevic.Time
import Zevic1.Gen as Gen
import Zevic1.Home as Home

class BuildOpts {
    mut Opt: Option<String> = None
    mut Debug: Bool = false
    mut KeepLl: Bool = false
    mut Pic: Bool = false
    mut Cc: Option<String> = None
    mut Cxx: Option<String> = None
    mut Libs: Array<String> = []
    mut LibDirs: Array<String> = []
    mut IncDirs: Array<String> = []
    mut Defines: Array<String> = []
    // .c .cpp .o .a ... files given on the command line
    mut Inputs: Array<String> = []
    // The LLVM triple to build for; empty means the machine zevic runs on.
    mut Target: String = ""
    mut Sysroot: String = ""
}

// The triple of a target name (`linux-arm64`), or of a full triple given as it is. None for an unknown name.
fn TargetTriple(name: String) -> Option<String> {
    if (name == "host") { return Some("") }
    if (name == "linux-x64") { return Some("x86_64-unknown-linux-gnu") }
    if (name == "linux-arm64") { return Some("aarch64-unknown-linux-gnu") }
    if (name == "macos-x64") { return Some("x86_64-apple-darwin") }
    if (name == "macos-arm64") { return Some("arm64-apple-darwin") }
    if (name == "windows-x64") { return Some("x86_64-pc-windows-msvc") }
    if (name == "windows-arm64") { return Some("aarch64-pc-windows-msvc") }
    // a full triple: arch-vendor-os(-env)
    if (Text.Contains(name, "-") && !Text.Contains(name, " ") && !Text.Contains(name, "/")) { return Some(name) }
    None
}

// True when the program is built for Windows (the host unless a target is given).
fn TargetWindows(o: BuildOpts) -> Bool {
    if (o.Target == "") { return isWindows() }
    Text.Contains(o.Target, "windows") || Text.Contains(o.Target, "mingw")
}

// The clang options that name the target (and its sysroot).
fn targetFlags(o: BuildOpts) -> Array<String> {
    mut f: Array<String> = []
    if (o.Target != "") { f.Push("--target=${o.Target}") }
    if (o.Sysroot != "") { f.Push("--sysroot=${o.Sysroot}") }
    f
}

fn isWindows() -> Bool {
    match (Env.Get("OS")) {
        Some(v) => v == "Windows_NT",
        None => false,
    }
}

fn endsWith(s: String, suffix: String) -> Bool {
    s.Len() >= suffix.Len() && s.Slice(s.Len() - suffix.Len(), s.Len()) == suffix
}

// ---- zig cc ----

// `zig cc` is accepted in place of clang (ZEVIC_CLANG=/path/to/zig): the program is run as
// `zig cc`, and the LLVM triples that zevic passes become zig targets.
fn isZig(path: String) -> Bool {
    path == "zig" || path == "zig.exe" || endsWith(path, "/zig") || endsWith(path, "\\zig")
        || endsWith(path, "/zig.exe") || endsWith(path, "\\zig.exe")
}

fn zigTarget(t: String) -> String {
    mut cut: I64 = 0
    while (cut < t.Len() && t.ByteAt(cut) != b'-') { cut += 1 }
    mut arch: String = t.Slice(0, cut)
    if (arch == "arm64") { arch = "aarch64" }
    if (Text.Contains(t, "windows") || Text.Contains(t, "mingw")) { return "${arch}-windows-gnu" }
    if (Text.Contains(t, "darwin") || Text.Contains(t, "apple")) { return "${arch}-macos" }
    if (Text.Contains(t, "linux")) { return "${arch}-linux-gnu" }
    t
}

fn zigArgs(args: Array<String>) -> Array<String> {
    mut r: Array<String> = ["cc"]
    mut i: I64 = 0
    while (i < args.Len()) {
        let a: String = args[i]
        if (a.Len() > 9 && a.Slice(0, 9) == "--target=") {
            r.Push("-target")
            r.Push(zigTarget(a.Slice(9, a.Len())))
        } else {
            r.Push(a)
        }
        i += 1
    }
    r
}

// ---- clang ----

// The major version, 0 when unknown, -1 when it does not run.
fn clangMajor(path: String) -> I64 {
    let probe: Array<String> = if (isZig(path)) { ["cc", "--version"] } else { ["--version"] }
    let out: Process.Output = match (Process.Run(path, probe)) {
        Ok(o) => o,
        Err(_) => return -1,
    }
    if (out.Code != 0) {
        return -1
    }
    let text: String = out.Stdout
    if (Text.Contains(text, "Apple clang")) {
        return 99
    }
    match (Text.IndexOf(text, "clang version ")) {
        Some(i) => {
            mut j: I64 = i + 14
            mut v: I64 = 0
            while (j < text.Len() && text.ByteAt(j) >= b'0' && text.ByteAt(j) <= b'9') {
                v = v * 10 + (text.ByteAt(j) - b'0').ToI64()
                j += 1
            }
            v
        },
        None => -1,
    }
}

fn printInstallHelp(why: String) {
    Console.Eprintln("error: ${why}")
    Console.Eprintln("zevic needs clang 15 or newer to build programs. Install LLVM with one of:")
    Console.Eprintln("  Ubuntu / Debian:  sudo apt install clang")
    Console.Eprintln("  Windows:          winget install LLVM.LLVM")
    Console.Eprintln("  macOS:            brew install llvm")
    Console.Eprintln("Then run zevic again. If clang is installed somewhere else, set ZEVIC_CLANG")
    Console.Eprintln("to its path or pass --cc <path>.")
}

fn FindClang(cliCc: Option<String>) -> Option<String> {
    mut cands: Array<String> = []
    match (cliCc) {
        Some(c) => cands.Push(c),
        None => {},
    }
    match (Env.Get("ZEVIC_CLANG")) {
        Some(e) => {
            if (e != "") { cands.Push(e) }
        },
        None => {},
    }
    cands.Push("clang")
    if (isWindows()) {
        cands.Push("C:\\Program Files\\LLVM\\bin\\clang.exe")
        cands.Push("C:\\Program Files (x86)\\LLVM\\bin\\clang.exe")
    } else {
        cands.Push("/opt/homebrew/opt/llvm/bin/clang")
        cands.Push("/usr/local/opt/llvm/bin/clang")
        mut v: I64 = 22
        while (v >= 15) {
            cands.Push("/usr/lib/llvm-${v}/bin/clang")
            v -= 1
        }
    }
    mut foundOld: I64 = 0
    mut i: I64 = 0
    while (i < cands.Len()) {
        let c: String = cands[i]
        let m: I64 = clangMajor(c)
        if (m >= 15 || m == 0) {
            return Some(c)
        }
        if (m > 0 && m < 15) {
            foundOld = m
        }
        if (cliCc.IsSome() && i == 0) {
            printInstallHelp("`${c}` is not a working clang")
            return None
        }
        i += 1
    }
    if (foundOld > 0) {
        printInstallHelp("clang ${foundOld} was found, but clang 15 or newer is required")
    } else {
        printInstallHelp("clang was not found")
    }
    None
}

// ---- the runtime object cache ----

fn fnvAdd(h: U64, s: String) -> U64 {
    mut x: U64 = h
    mut i: I64 = 0
    while (i < s.Len()) {
        x = (x ^ s.ByteAt(i).ToU64()).WrapMul(1099511628211_U64)
        i += 1
    }
    x
}

fn makeDirs(path: String) -> Bool {
    mut i: I64 = 1
    while (i < path.Len()) {
        let c: U8 = path.ByteAt(i)
        if (c == b'/' || c == b'\\') {
            let part: String = path.Slice(0, i)
            if (!Fs.IsDir(part)) {
                let r: Result<Unit, Error> = Fs.CreateDir(part)
            }
        }
        i += 1
    }
    if (!Fs.IsDir(path)) {
        let r: Result<Unit, Error> = Fs.CreateDir(path)
    }
    Fs.IsDir(path)
}

fn cacheDir() -> Option<String> {
    mut dir: Option<String> = None
    match (Env.Get("ZEVIC_CACHE")) {
        Some(e) => {
            if (e != "") { dir = Some(e) }
        },
        None => {},
    }
    if (dir.IsNone()) {
        if (isWindows()) {
            match (Env.Get("LOCALAPPDATA")) {
                Some(b) => {
                    if (b != "") { dir = Some("${b}/zevic/cache") }
                },
                None => {},
            }
        } else {
            let xdg: String = match (Env.Get("XDG_CACHE_HOME")) { Some(x) => x, None => "" }
            let home: String = match (Env.Get("HOME")) { Some(x) => x, None => "" }
            if (xdg != "") {
                dir = Some("${xdg}/zevic")
            } else if (home != "") {
                dir = Some("${home}/.cache/zevic")
            }
        }
    }
    match (dir) {
        Some(d) => if (makeDirs(d)) { Some(d) } else { None },
        None => None,
    }
}

fn threadFlags(win: Bool) -> Array<String> {
    if (win) {
        return ["-DGC_THREADS", "-DGC_BUILTIN_ATOMIC", "-DNO_MSGBOX_ON_ERROR"]
    }
    ["-DGC_THREADS", "-DGC_BUILTIN_ATOMIC", "-pthread"]
}

fn run(cmd: String, args: Array<String>) -> I32 {
    match (Process.Inherit(cmd, if (isZig(cmd)) { zigArgs(args) } else { args })) {
        Ok(c) => c,
        Err(_) => 127,
    }
}

// The path of a cached object for `src`, compiling it first if needed. None when it cannot be cached.
fn cachedObject(clang: String, label: String, src: String, keyFiles: Array<String>, cflags: Array<String>) -> Option<String> {
    let dir: String = match (cacheDir()) {
        Some(d) => d,
        None => return None,
    }
    mut h: U64 = 1469598103934665603_U64
    h = fnvAdd(h, clang)
    h = fnvAdd(h, cflags.Join(" "))
    for (k in keyFiles) {
        match (Fs.ReadAll(k)) {
            Ok(text) => { h = fnvAdd(h, text) },
            Err(_) => return None,
        }
    }
    let obj: String = "${dir}/${label}-${Gen.HexN(h, 16)}.o"
    if (Fs.Exists(obj)) {
        return Some(obj)
    }
    let tmp: String = "${obj}.tmp${Time.UnixMillis()}"
    mut args: Array<String> = ["-c", "-x", "c"]
    for (f in cflags) {
        args.Push(f)
    }
    args.Push(src)
    args.Push("-o")
    args.Push(tmp)
    if (run(clang, args) != 0) {
        let r: Result<Unit, Error> = Fs.Remove(tmp)
        return None
    }
    match (Fs.Rename(tmp, obj)) {
        Ok(_) => Some(obj),
        Err(_) => {
            let r: Result<Unit, Error> = Fs.Remove(tmp)
            if (Fs.Exists(obj)) { Some(obj) } else { None }
        },
    }
}

fn isCppFile(f: String) -> Bool { endsWith(f, ".cpp") || endsWith(f, ".cc") || endsWith(f, ".cxx") }

// "clang" -> "clang++", "clang.exe" -> "clang++.exe", "clang-18" -> "clang++-18".
fn siblingCxx(clang: String) -> String {
    mut n: I64 = clang.Len()
    mut exe: String = ""
    if (endsWith(clang, ".exe")) {
        exe = ".exe"
        n -= 4
    }
    mut dash: I64 = -1
    mut i: I64 = n
    while (i > 0 && clang.ByteAt(i - 1) != b'/' && clang.ByteAt(i - 1) != b'\\') {
        if (clang.ByteAt(i - 1) == b'-') {
            dash = i - 1
            i = 0
        } else {
            i -= 1
        }
    }
    let stem: I64 = if (dash >= 0) { dash } else { n }
    "${clang.Slice(0, stem)}++${clang.Slice(stem, n)}${exe}"
}

class Runtime {
    mut Inc: String = ""
    mut RtSrc: String = ""
    mut GcSrc: String = ""
    mut RtObj: Option<String> = None
    mut GcObj: Option<String> = None
}

fn prepareRuntime(clang: String, home: String, pic: Bool, o: BuildOpts) -> Runtime {
    mut rt: Runtime = Runtime.New()
    rt.Inc = "${home}/runtime/third_party/bgc/include"
    rt.RtSrc = "${home}/runtime/zevic_rt.c"
    rt.GcSrc = "${home}/runtime/third_party/bgc/extra/gc.c"
    mut cflags: Array<String> = ["-O2", "-w"]
    for (f in threadFlags(TargetWindows(o))) {
        cflags.Push(f)
    }
    for (f in targetFlags(o)) {
        cflags.Push(f)
    }
    if (pic) { cflags.Push("-fPIC") }
    cflags.Push("-I${rt.Inc}")
    rt.RtObj = cachedObject(clang, "zevic_rt", rt.RtSrc, [rt.RtSrc, "${home}/runtime/zevic_rt.h"], cflags)
    rt.GcObj = cachedObject(clang, "bgc", rt.GcSrc, ["${home}/runtime/third_party/bgc/VENDORED.txt"], cflags)
    rt
}

fn Build(clang: String, home: String, llPath: String, outPath: String, o: BuildOpts) -> I32 {
    mut hasCpp: Bool = false
    for (f in o.Inputs) {
        if (isCppFile(f)) { hasCpp = true }
    }
    let driver: String = if (hasCpp) { match (o.Cxx) { Some(x) => x, None => siblingCxx(clang) } } else { clang }
    mut args: Array<String> = [match (o.Opt) { Some(x) => x, None => "-O0" }, "-w", "-Wno-override-module"]
    if (o.Debug) { args.Push("-g") }
    for (f in targetFlags(o)) { args.Push(f) }
    if (o.Target != "") { args.Push("-fuse-ld=lld") }
    args.Push(llPath)
    let rt: Runtime = prepareRuntime(clang, home, false, o)
    match (rt.RtObj) {
        Some(x) => args.Push(x),
        None => {
            args.Push("-x")
            args.Push("c")
            args.Push(rt.RtSrc)
            args.Push("-x")
            args.Push("none")
            args.Push("-I${rt.Inc}")
        },
    }
    match (rt.GcObj) {
        Some(x) => args.Push(x),
        None => {
            args.Push("-x")
            args.Push("c")
            args.Push(rt.GcSrc)
            args.Push("-x")
            args.Push("none")
            args.Push("-I${rt.Inc}")
        },
    }
    for (f in o.Inputs) {
        // clang++ would read a .c file as C++
        if (endsWith(f, ".c") && hasCpp) {
            args.Push("-x")
            args.Push("c")
            args.Push(f)
            args.Push("-x")
            args.Push("none")
        } else {
            args.Push(f)
        }
    }
    for (d in o.IncDirs) { args.Push("-I${d}") }
    for (d in o.Defines) { args.Push("-D${d}") }
    for (d in o.LibDirs) { args.Push("-L${d}") }
    for (l in o.Libs) { args.Push("-l${l}") }
    args.Push("-o")
    args.Push(outPath)
    if (TargetWindows(o)) {
        args.Push("-lws2_32")
    } else {
        args.Push("-lm")
        args.Push("-pthread")
    }
    run(driver, args)
}

fn siblingTool(clang: String, name: String) -> Option<String> {
    mut last: I64 = -1
    mut i: I64 = 0
    while (i < clang.Len()) {
        if (clang.ByteAt(i) == b'/' || clang.ByteAt(i) == b'\\') { last = i }
        i += 1
    }
    if (last < 0) {
        return None
    }
    let path: String = "${clang.Slice(0, last)}/${name}${if (isWindows()) { ".exe" } else { "" }}"
    if (Fs.Exists(path)) { Some(path) } else { None }
}

fn compileObject(driver: String, o: BuildOpts, src: String, obj: String, forceC: Bool) -> I32 {
    mut args: Array<String> = ["-c", "-w", "-Wno-override-module", match (o.Opt) { Some(x) => x, None => "-O0" }]
    if (o.Debug) { args.Push("-g") }
    if (o.Pic) { args.Push("-fPIC") }
    for (f in targetFlags(o)) { args.Push(f) }
    if (forceC) {
        args.Push("-x")
        args.Push("c")
    }
    args.Push(src)
    for (d in o.IncDirs) { args.Push("-I${d}") }
    for (d in o.Defines) { args.Push("-D${d}") }
    args.Push("-o")
    args.Push(obj)
    run(driver, args)
}

// The static library. On Windows llvm-lib comes first: it writes the symbol table that lld-link needs for every COFF
// machine (the `ar` of Git for Windows and llvm-ar leave it empty for Windows on Arm objects, and the library cannot be
// linked). The tools are taken from the directory of clang when it is known, otherwise from PATH.
fn makeArchive(clang: String, outPath: String, objs: Array<String>) -> I32 {
    mut tools: Array<String> = []
    if (isWindows()) {
        match (siblingTool(clang, "llvm-lib")) { Some(x) => tools.Push(x), None => tools.Push("llvm-lib") }
    }
    match (siblingTool(clang, "llvm-ar")) { Some(x) => tools.Push(x), None => tools.Push(if (isWindows()) { "llvm-ar" } else { "ar" }) }
    if (isWindows()) {
        tools.Push("ar")
    }
    mut rc: I32 = 1
    for (t in tools) {
        if (rc != 0) {
            let r0: Result<Unit, Error> = Fs.Remove(outPath)
            let isLib: Bool = Text.Contains(t, "llvm-lib")
            mut args: Array<String> = if (isLib) { ["/OUT:${outPath}"] } else { ["rcs", outPath] }
            for (x in objs) { args.Push(x) }
            rc = run(t, args)
        }
    }
    rc
}

fn BuildLib(clang: String, home: String, llPath: String, outPath: String, o: BuildOpts) -> I32 {
    mut objs: Array<String> = []
    let base: String = "${outPath}.objs"
    let madeBase: Bool = makeDirs(base)
    let mainObj: String = "${base}/zevic.o"
    if (compileObject(clang, o, llPath, mainObj, false) != 0) {
        return 1
    }
    objs.Push(mainObj)
    mut i: I64 = 0
    while (i < o.Inputs.Len()) {
        let f: String = o.Inputs[i]
        if (endsWith(f, ".o")) {
            objs.Push(f)
            i += 1
            continue
        }
        if (endsWith(f, ".a") || endsWith(f, ".lib")) {
            Console.Eprintln("error: a library (`${f}`) cannot be put into another library; pass it with -l when you link")
            return 1
        }
        let obj: String = "${base}/native${i}.o"
        let drv: String = if (isCppFile(f)) { match (o.Cxx) { Some(x) => x, None => siblingCxx(clang) } } else { clang }
        if (compileObject(drv, o, f, obj, false) != 0) {
            return 1
        }
        objs.Push(obj)
        i += 1
    }
    // the runtime and the garbage collector travel with the library, so the C side needs nothing else
    let rt: Runtime = prepareRuntime(clang, home, o.Pic, o)
    mut rtOpts: BuildOpts = BuildOpts.New()
    rtOpts.Opt = Some("-O2")
    rtOpts.Pic = o.Pic
    rtOpts.IncDirs.Push(rt.Inc)
    let rtObj: String = match (rt.RtObj) {
        Some(x) => x,
        None => {
            let p: String = "${base}/zevic_rt.o"
            if (compileObject(clang, rtOpts, rt.RtSrc, p, true) != 0) {
                return 1
            }
            p
        },
    }
    let gcObj: String = match (rt.GcObj) {
        Some(x) => x,
        None => {
            let p: String = "${base}/bgc.o"
            if (compileObject(clang, rtOpts, rt.GcSrc, p, true) != 0) {
                return 1
            }
            p
        },
    }
    objs.Push(rtObj)
    objs.Push(gcObj)
    let rc: I32 = makeArchive(clang, outPath, objs)
    if (rc != 0) {
        Console.Eprintln("error: cannot make the archive (`llvm-lib`, `llvm-ar` and `ar` all failed; install LLVM or binutils)")
    }
    if (!o.KeepLl) {
        let a: Result<Unit, Error> = Fs.Remove(mainObj)
        mut k: I64 = 0
        while (k < o.Inputs.Len()) {
            let b: Result<Unit, Error> = Fs.Remove("${base}/native${k}.o")
            k += 1
        }
        let c: Result<Unit, Error> = Fs.Remove("${base}/zevic_rt.o")
        let d: Result<Unit, Error> = Fs.Remove("${base}/bgc.o")
        let e: Result<Unit, Error> = Fs.Remove(base)
    }
    rc
}

fn IsWindows() -> Bool { isWindows() }

// The executable suffix of the target.
fn ExeSuffix(o: BuildOpts) -> String { if (TargetWindows(o)) { ".exe" } else { "" } }
