module Zevic1.Driver

// Running clang: a port of zevic0/driver.c (driver_find_clang, driver_build, driver_build_lib).

import Zevic.Console
import Zevic.Convert
import Zevic.Env
import Zevic.Fs
import Zevic.Process
import Zevic.Text
import Zevic.Time
import Zevic1.Gen as Gen
import Zevic1.Home as Home

class BuildOpts {
    Opt: Option<String> = None
    Debug: Bool = false
    KeepLl: Bool = false
    Cc: Option<String> = None
    Cxx: Option<String> = None
    Libs: Array<String> = []
    LibDirs: Array<String> = []
    IncDirs: Array<String> = []
    Defines: Array<String> = []
    // .c .cpp .o .a ... files given on the command line
    Inputs: Array<String> = []
}

fn isWindows() -> Bool {
    match (Env.Get("OS")) {
        Some(v) => v == "Windows_NT",
        None => false,
    }
}

fn endsWith(s: String, suffix: String) -> Bool {
    s.Len() >= suffix.Len() && s.Slice(s.Len() - suffix.Len(), s.Len()) == suffix
}

// ---- clang ----

// The major version, 0 when unknown, -1 when it does not run.
fn clangMajor(path: String) -> I64 {
    let out: Process.Output = match (Process.Run(path, ["--version"])) {
        Ok(o) => o,
        Err(_) => return -1,
    }
    if (out.Code != 0) {
        return -1
    }
    let text: String = out.Stdout
    if (Text.Contains(text, "Apple clang")) {
        return 99
    }
    match (Text.IndexOf(text, "clang version ")) {
        Some(i) => {
            mut j: I64 = i + 14
            mut v: I64 = 0
            while (j < text.Len() && text.ByteAt(j) >= b'0' && text.ByteAt(j) <= b'9') {
                v = v * 10 + (text.ByteAt(j) - b'0').ToI64()
                j += 1
            }
            v
        },
        None => -1,
    }
}

fn printInstallHelp(why: String) {
    Console.Eprintln("error: ${why}")
    Console.Eprintln("zevic needs clang 15 or newer to build programs. Install LLVM with one of:")
    Console.Eprintln("  Ubuntu / Debian:  sudo apt install clang")
    Console.Eprintln("  Windows:          winget install LLVM.LLVM")
    Console.Eprintln("  macOS:            brew install llvm")
    Console.Eprintln("Then run zevic again. If clang is installed somewhere else, set ZEVIC_CLANG")
    Console.Eprintln("to its path or pass --cc <path>.")
}

fn FindClang(cliCc: Option<String>) -> Option<String> {
    mut cands: Array<String> = []
    match (cliCc) {
        Some(c) => cands.Push(c),
        None => {},
    }
    match (Env.Get("ZEVIC_CLANG")) {
        Some(e) => {
            if (e != "") { cands.Push(e) }
        },
        None => {},
    }
    cands.Push("clang")
    if (isWindows()) {
        cands.Push("C:\\Program Files\\LLVM\\bin\\clang.exe")
        cands.Push("C:\\Program Files (x86)\\LLVM\\bin\\clang.exe")
    } else {
        cands.Push("/opt/homebrew/opt/llvm/bin/clang")
        cands.Push("/usr/local/opt/llvm/bin/clang")
        mut v: I64 = 22
        while (v >= 15) {
            cands.Push("/usr/lib/llvm-${v}/bin/clang")
            v -= 1
        }
    }
    mut foundOld: I64 = 0
    mut i: I64 = 0
    while (i < cands.Len()) {
        let c: String = cands[i]
        let m: I64 = clangMajor(c)
        if (m >= 15 || m == 0) {
            return Some(c)
        }
        if (m > 0 && m < 15) {
            foundOld = m
        }
        if (cliCc.IsSome() && i == 0) {
            printInstallHelp("`${c}` is not a working clang")
            return None
        }
        i += 1
    }
    if (foundOld > 0) {
        printInstallHelp("clang ${foundOld} was found, but clang 15 or newer is required")
    } else {
        printInstallHelp("clang was not found")
    }
    None
}

// ---- the runtime object cache ----

fn fnvAdd(h: U64, s: String) -> U64 {
    mut x: U64 = h
    mut i: I64 = 0
    while (i < s.Len()) {
        x = (x ^ s.ByteAt(i).ToU64()).WrapMul(1099511628211_U64)
        i += 1
    }
    x
}

fn makeDirs(path: String) -> Bool {
    mut i: I64 = 1
    while (i < path.Len()) {
        let c: U8 = path.ByteAt(i)
        if (c == b'/' || c == b'\\') {
            let part: String = path.Slice(0, i)
            if (!Fs.IsDir(part)) {
                let r: Result<Unit, Error> = Fs.CreateDir(part)
            }
        }
        i += 1
    }
    if (!Fs.IsDir(path)) {
        let r: Result<Unit, Error> = Fs.CreateDir(path)
    }
    Fs.IsDir(path)
}

fn cacheDir() -> Option<String> {
    mut dir: Option<String> = None
    match (Env.Get("ZEVIC_CACHE")) {
        Some(e) => {
            if (e != "") { dir = Some(e) }
        },
        None => {},
    }
    if (dir.IsNone()) {
        if (isWindows()) {
            match (Env.Get("LOCALAPPDATA")) {
                Some(b) => {
                    if (b != "") { dir = Some("${b}/zevic/cache") }
                },
                None => {},
            }
        } else {
            let xdg: String = match (Env.Get("XDG_CACHE_HOME")) { Some(x) => x, None => "" }
            let home: String = match (Env.Get("HOME")) { Some(x) => x, None => "" }
            if (xdg != "") {
                dir = Some("${xdg}/zevic")
            } else if (home != "") {
                dir = Some("${home}/.cache/zevic")
            }
        }
    }
    match (dir) {
        Some(d) => if (makeDirs(d)) { Some(d) } else { None },
        None => None,
    }
}

fn threadFlags() -> Array<String> {
    if (isWindows()) {
        return ["-DGC_THREADS", "-DGC_BUILTIN_ATOMIC", "-DNO_MSGBOX_ON_ERROR"]
    }
    ["-DGC_THREADS", "-DGC_BUILTIN_ATOMIC", "-pthread"]
}

fn run(cmd: String, args: Array<String>) -> I32 {
    match (Process.Inherit(cmd, args)) {
        Ok(c) => c,
        Err(_) => 127,
    }
}

// The path of a cached object for `src`, compiling it first if needed. None when it cannot be cached.
fn cachedObject(clang: String, label: String, src: String, keyFiles: Array<String>, cflags: Array<String>) -> Option<String> {
    let dir: String = match (cacheDir()) {
        Some(d) => d,
        None => return None,
    }
    mut h: U64 = 1469598103934665603_U64
    h = fnvAdd(h, clang)
    h = fnvAdd(h, cflags.Join(" "))
    for (k in keyFiles) {
        match (Fs.ReadAll(k)) {
            Ok(text) => { h = fnvAdd(h, text) },
            Err(_) => return None,
        }
    }
    let obj: String = "${dir}/${label}-${Gen.HexN(h, 16)}.o"
    if (Fs.Exists(obj)) {
        return Some(obj)
    }
    let tmp: String = "${obj}.tmp${Time.UnixMillis()}"
    mut args: Array<String> = ["-c", "-x", "c"]
    for (f in cflags) {
        args.Push(f)
    }
    args.Push(src)
    args.Push("-o")
    args.Push(tmp)
    if (run(clang, args) != 0) {
        let r: Result<Unit, Error> = Fs.Remove(tmp)
        return None
    }
    match (Fs.Rename(tmp, obj)) {
        Ok(_) => Some(obj),
        Err(_) => {
            let r: Result<Unit, Error> = Fs.Remove(tmp)
            if (Fs.Exists(obj)) { Some(obj) } else { None }
        },
    }
}

fn isCppFile(f: String) -> Bool { endsWith(f, ".cpp") || endsWith(f, ".cc") || endsWith(f, ".cxx") }

// "clang" -> "clang++", "clang.exe" -> "clang++.exe", "clang-18" -> "clang++-18".
fn siblingCxx(clang: String) -> String {
    mut n: I64 = clang.Len()
    mut exe: String = ""
    if (endsWith(clang, ".exe")) {
        exe = ".exe"
        n -= 4
    }
    mut dash: I64 = -1
    mut i: I64 = n
    while (i > 0 && clang.ByteAt(i - 1) != b'/' && clang.ByteAt(i - 1) != b'\\') {
        if (clang.ByteAt(i - 1) == b'-') {
            dash = i - 1
            i = 0
        } else {
            i -= 1
        }
    }
    let stem: I64 = if (dash >= 0) { dash } else { n }
    "${clang.Slice(0, stem)}++${clang.Slice(stem, n)}${exe}"
}

class Runtime {
    Inc: String = ""
    RtSrc: String = ""
    GcSrc: String = ""
    RtObj: Option<String> = None
    GcObj: Option<String> = None
}

fn prepareRuntime(clang: String, home: String) -> Runtime {
    mut rt: Runtime = Runtime.New()
    rt.Inc = "${home}/runtime/third_party/bgc/include"
    rt.RtSrc = "${home}/runtime/zevic_rt.c"
    rt.GcSrc = "${home}/runtime/third_party/bgc/extra/gc.c"
    mut cflags: Array<String> = ["-O2", "-w"]
    for (f in threadFlags()) {
        cflags.Push(f)
    }
    cflags.Push("-I${rt.Inc}")
    rt.RtObj = cachedObject(clang, "zevic_rt", rt.RtSrc, [rt.RtSrc, "${home}/runtime/zevic_rt.h"], cflags)
    rt.GcObj = cachedObject(clang, "bgc", rt.GcSrc, ["${home}/runtime/third_party/bgc/VENDORED.txt"], cflags)
    rt
}

fn Build(clang: String, home: String, llPath: String, outPath: String, o: BuildOpts) -> I32 {
    mut hasCpp: Bool = false
    for (f in o.Inputs) {
        if (isCppFile(f)) { hasCpp = true }
    }
    let driver: String = if (hasCpp) { match (o.Cxx) { Some(x) => x, None => siblingCxx(clang) } } else { clang }
    mut args: Array<String> = [match (o.Opt) { Some(x) => x, None => "-O1" }, "-w", "-Wno-override-module"]
    if (o.Debug) { args.Push("-g") }
    args.Push(llPath)
    let rt: Runtime = prepareRuntime(clang, home)
    match (rt.RtObj) {
        Some(x) => args.Push(x),
        None => {
            args.Push("-x")
            args.Push("c")
            args.Push(rt.RtSrc)
            args.Push("-x")
            args.Push("none")
            args.Push("-I${rt.Inc}")
        },
    }
    match (rt.GcObj) {
        Some(x) => args.Push(x),
        None => {
            args.Push("-x")
            args.Push("c")
            args.Push(rt.GcSrc)
            args.Push("-x")
            args.Push("none")
            args.Push("-I${rt.Inc}")
        },
    }
    for (f in o.Inputs) {
        // clang++ would read a .c file as C++
        if (endsWith(f, ".c") && hasCpp) {
            args.Push("-x")
            args.Push("c")
            args.Push(f)
            args.Push("-x")
            args.Push("none")
        } else {
            args.Push(f)
        }
    }
    for (d in o.IncDirs) { args.Push("-I${d}") }
    for (d in o.Defines) { args.Push("-D${d}") }
    for (d in o.LibDirs) { args.Push("-L${d}") }
    for (l in o.Libs) { args.Push("-l${l}") }
    args.Push("-o")
    args.Push(outPath)
    if (isWindows()) {
        args.Push("-lws2_32")
    } else {
        args.Push("-lm")
        args.Push("-pthread")
    }
    run(driver, args)
}

fn siblingTool(clang: String, name: String) -> Option<String> {
    mut last: I64 = -1
    mut i: I64 = 0
    while (i < clang.Len()) {
        if (clang.ByteAt(i) == b'/' || clang.ByteAt(i) == b'\\') { last = i }
        i += 1
    }
    if (last < 0) {
        return None
    }
    let path: String = "${clang.Slice(0, last)}/${name}${if (isWindows()) { ".exe" } else { "" }}"
    if (Fs.Exists(path)) { Some(path) } else { None }
}

fn compileObject(driver: String, o: BuildOpts, src: String, obj: String, forceC: Bool) -> I32 {
    mut args: Array<String> = ["-c", "-w", "-Wno-override-module", match (o.Opt) { Some(x) => x, None => "-O1" }]
    if (o.Debug) { args.Push("-g") }
    if (forceC) {
        args.Push("-x")
        args.Push("c")
    }
    args.Push(src)
    for (d in o.IncDirs) { args.Push("-I${d}") }
    for (d in o.Defines) { args.Push("-D${d}") }
    args.Push("-o")
    args.Push(obj)
    run(driver, args)
}

fn BuildLib(clang: String, home: String, llPath: String, outPath: String, o: BuildOpts) -> I32 {
    mut objs: Array<String> = []
    let base: String = "${outPath}.objs"
    let madeBase: Bool = makeDirs(base)
    let mainObj: String = "${base}/zevic.o"
    if (compileObject(clang, o, llPath, mainObj, false) != 0) {
        return 1
    }
    objs.Push(mainObj)
    mut i: I64 = 0
    while (i < o.Inputs.Len()) {
        let f: String = o.Inputs[i]
        if (endsWith(f, ".o")) {
            objs.Push(f)
            i += 1
            continue
        }
        if (endsWith(f, ".a") || endsWith(f, ".lib")) {
            Console.Eprintln("error: a library (`${f}`) cannot be put into another library; pass it with -l when you link")
            return 1
        }
        let obj: String = "${base}/native${i}.o"
        let drv: String = if (isCppFile(f)) { match (o.Cxx) { Some(x) => x, None => siblingCxx(clang) } } else { clang }
        if (compileObject(drv, o, f, obj, false) != 0) {
            return 1
        }
        objs.Push(obj)
        i += 1
    }
    // the runtime and the garbage collector travel with the library, so the C side needs nothing else
    let rt: Runtime = prepareRuntime(clang, home)
    mut rtOpts: BuildOpts = BuildOpts.New()
    rtOpts.Opt = Some("-O2")
    rtOpts.IncDirs.Push(rt.Inc)
    let rtObj: String = match (rt.RtObj) {
        Some(x) => x,
        None => {
            let p: String = "${base}/zevic_rt.o"
            if (compileObject(clang, rtOpts, rt.RtSrc, p, true) != 0) {
                return 1
            }
            p
        },
    }
    let gcObj: String = match (rt.GcObj) {
        Some(x) => x,
        None => {
            let p: String = "${base}/bgc.o"
            if (compileObject(clang, rtOpts, rt.GcSrc, p, true) != 0) {
                return 1
            }
            p
        },
    }
    objs.Push(rtObj)
    objs.Push(gcObj)
    let ar: Option<String> = siblingTool(clang, "llvm-ar")
    let r0: Result<Unit, Error> = Fs.Remove(outPath)
    mut args: Array<String> = ["rcs", outPath]
    for (x in objs) { args.Push(x) }
    let tool: String = match (ar) { Some(x) => x, None => "ar" }
    let rc: I32 = run(tool, args)
    if (rc != 0) {
        Console.Eprintln("error: cannot make the archive (`${if (ar.IsSome()) { "llvm-ar" } else { "ar" }}` failed; install binutils or LLVM)")
    }
    if (!o.KeepLl) {
        let a: Result<Unit, Error> = Fs.Remove(mainObj)
        mut k: I64 = 0
        while (k < o.Inputs.Len()) {
            let b: Result<Unit, Error> = Fs.Remove("${base}/native${k}.o")
            k += 1
        }
        let c: Result<Unit, Error> = Fs.Remove("${base}/zevic_rt.o")
        let d: Result<Unit, Error> = Fs.Remove("${base}/bgc.o")
        let e: Result<Unit, Error> = Fs.Remove(base)
    }
    rc
}

fn IsWindows() -> Bool { isWindows() }
