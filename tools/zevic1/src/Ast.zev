module Zevic1.Ast

// The syntax tree, as in zevic0/ast.h: one `Node` class whose fields mean different things for each kind
// (the comments say how). `Dump` prints the tree in the format of `zevic0 --dump-ast`.

import Zevic.Console
import Zevic.Text
import Zevic1.Token as Token

enum NK {
    TypeName,
    TypeTuple,
    TypeFn,
    TypePtr,
    TypeUnion,
    Is,
    PType,
    Int,
    Float,
    Bool,
    Char,
    Byte,
    Str,
    StrLit,
    Unit,
    Ident,
    This,
    Member,
    Call,
    Index,
    Try,
    Unary,
    Binary,
    Range,
    If,
    Match,
    Arm,
    Block,
    Lambda,
    Async,
    Await,
    Array,
    MapLit,
    Pair,
    Tuple,
    StructLit,
    Let,
    Assign,
    ExprStmt,
    Return,
    Break,
    Continue,
    Defer,
    While,
    Loop,
    For,
    PWild,
    PBind,
    PLit,
    PRange,
    PTuple,
    PVariant,
    PField,
    POr,
    DFn,
    DStruct,
    DClass,
    DEnum,
    DInterface,
    DExtern,
    DConst,
    DTest,
    Field,
    Variant,
    Param,
    TParam,
    Import,

    fn Name() -> String {
        match (this) {
            NK.TypeName => "TypeName",
            NK.TypeTuple => "TypeTuple",
            NK.TypeFn => "TypeFn",
            NK.TypePtr => "TypePtr",
            NK.TypeUnion => "TypeUnion",
            NK.Is => "Is",
            NK.PType => "PType",
            NK.Int => "Int",
            NK.Float => "Float",
            NK.Bool => "Bool",
            NK.Char => "Char",
            NK.Byte => "Byte",
            NK.Str => "String",
            NK.StrLit => "Lit",
            NK.Unit => "Unit",
            NK.Ident => "Ident",
            NK.This => "This",
            NK.Member => "Member",
            NK.Call => "Call",
            NK.Index => "Index",
            NK.Try => "Try",
            NK.Unary => "Unary",
            NK.Binary => "Binary",
            NK.Range => "Range",
            NK.If => "If",
            NK.Match => "Match",
            NK.Arm => "Arm",
            NK.Block => "Block",
            NK.Lambda => "Lambda",
            NK.Async => "Async",
            NK.Await => "Await",
            NK.Array => "Array",
            NK.MapLit => "MapLit",
            NK.Pair => "Pair",
            NK.Tuple => "Tuple",
            NK.StructLit => "StructLit",
            NK.Let => "Let",
            NK.Assign => "Assign",
            NK.ExprStmt => "ExprStmt",
            NK.Return => "Return",
            NK.Break => "Break",
            NK.Continue => "Continue",
            NK.Defer => "Defer",
            NK.While => "While",
            NK.Loop => "Loop",
            NK.For => "For",
            NK.PWild => "PWild",
            NK.PBind => "PBind",
            NK.PLit => "PLit",
            NK.PRange => "PRange",
            NK.PTuple => "PTuple",
            NK.PVariant => "PVariant",
            NK.PField => "PField",
            NK.POr => "POr",
            NK.DFn => "Fn",
            NK.DStruct => "Struct",
            NK.DClass => "Class",
            NK.DEnum => "Enum",
            NK.DInterface => "Interface",
            NK.DExtern => "Extern",
            NK.DConst => "Const",
            NK.DTest => "Test",
            NK.Field => "Field",
            NK.Variant => "Variant",
            NK.Param => "Param",
            NK.TParam => "TParam",
            NK.Import => "Import",
        }
    }

    // Declarations that can have type parameters (`D_FN` to `D_INTERFACE` in C).
    fn IsTypeDecl() -> Bool {
        match (this) {
            NK.DFn | NK.DStruct | NK.DClass | NK.DEnum | NK.DInterface => true,
            _ => false,
        }
    }
}

class Node {
    Kind: NK
    Pos: Token.Pos
    // An identifier, string bytes, an alias, a label. `HasName` tells "no name" from the empty name.
    Name: String = ""
    HasName: Bool = false
    Name2: String = "" // the C name of an extern function
    Op: Token.Tk = Token.Tk.Eof
    Ival: U64 = 0_U64
    Fval: F64 = 0.0
    Suffix: String = ""
    Flag: Bool = false
    Flag2: Bool = false
    Flag3: Bool = false
    IsStatic: Bool = false
    IsMutFn: Bool = false
    IsExport: Bool = false
    A: Option<Node> = None
    B: Option<Node> = None
    C: Option<Node> = None
    D: Option<Node> = None
    List: Array<Node> = []
    List2: Array<Node> = []
    List3: Array<Node> = []
    Path: Array<String> = []

    fn Init(kind: NK, pos: Token.Pos) {
        this.Kind = kind
        this.Pos = pos
    }

    mut fn SetName(name: String) {
        this.Name = name
        this.HasName = true
    }
}

class SourceFile {
    File: I32
    Pos: Token.Pos
    Module: String = ""
    HasModule: Bool = false
    ModulePos: Token.Pos
    Imports: Array<Node> = []
    Decls: Array<Node> = []
    IsStd: Bool = false
    // The text has `async` or `await`: Zevic.Async is loaded for the program.
    UsesAsync: Bool = false

    fn Init(file: I32) {
        this.File = file
        this.Pos = Token.Pos.New(file, 0, 0)
        this.ModulePos = Token.Pos.New(file, 0, 0)
    }
}

fn PathJoin(path: Array<String>, sep: String) -> String { Text.Join(path, sep) }

// ---- the dump ----

fn indent(n: I64) {
    mut i: I64 = 0
    while (i < n) {
        Console.Print("  ")
        i += 1
    }
}

fn dumpList(label: String, v: Array<Node>, ind: I64) {
    if (v.IsEmpty()) {
        return
    }
    indent(ind)
    Console.Print("${label}:\n")
    for (n in v) {
        dump(n, ind + 1)
    }
}

fn dumpChild(label: String, n: Option<Node>, ind: I64) {
    match (n) {
        Some(x) => {
            indent(ind)
            Console.Print("${label}:\n")
            dump(x, ind + 1)
        },
        None => {},
    }
}

fn dumpStr(s: String) {
    Console.Print("\"")
    mut i: I64 = 0
    while (i < s.Len()) {
        let c: I32 = s.ByteAt(i).ToI32()
        // the bytes are valid UTF-8: a multi-byte character is printed whole
        let len: I64 = utf8Len(s, i)
        let step: I64 = if (len == 0) { 1 } else { len }
        if (c == 10) { Console.Print("\\n") } else if (c == 34) { Console.Print("\\\"") } else if (c < 32) { Console.Printf("\\x%02x", c) } else if (len > 0) { Console.Print(s.Slice(i, i + step)) }
        i += step
    }
    Console.Print("\"")
}

fn utf8Len(s: String, i: I64) -> I64 {
    let c: I32 = s.ByteAt(i).ToI32()
    if (c < 128) { return 1 }
    let len: I64 = if (c / 32 == 6) { 2 } else if (c / 16 == 14) { 3 } else if (c / 8 == 30) { 4 } else { 0 }
    if (len == 0 || i + len > s.Len()) { 0 } else { len }
}

fn dump(n: Node, ind: I64) {
    indent(ind)
    Console.Print(n.Kind.Name())
    if (!n.Path.IsEmpty()) {
        Console.Print(" ${PathJoin(n.Path, ".")}")
    }
    match (n.Kind) {
        NK.Int => Console.Print(" ${n.Ival}${if (n.Suffix != "") { "_" + n.Suffix } else { "" }}"),
        NK.Float => Console.Print(" ${n.Fval}${if (n.Suffix != "") { "_" + n.Suffix } else { "" }}"),
        NK.Bool | NK.Char | NK.Byte => Console.Print(" ${n.Ival}"),
        NK.StrLit => {
            Console.Print(" ")
            dumpStr(n.Name)
        },
        NK.Unary | NK.Binary | NK.Assign => Console.Print(" ${n.Op.Name()}"),
        NK.Range | NK.PRange => Console.Print(if (n.Flag) { " (inclusive)" } else { "" }),
        NK.Is => Console.Print(if (n.Flag) { " (negated)" } else { "" }),
        NK.Let => Console.Print(if (n.Flag) { " mut" } else { " let" }),
        _ => {
            if (n.HasName) {
                Console.Print(" ${n.Name}")
            }
        },
    }
    if (n.Kind == NK.DFn) {
        if (n.IsStatic) { Console.Print(" static") }
        if (n.IsMutFn) { Console.Print(" mut") }
        if (n.IsExport) { Console.Print(" export") }
    }
    if (n.Kind == NK.Param) {
        if (n.Flag) { Console.Print(" mut") }
        if (n.Flag2) { Console.Print(" params") }
        if (n.Flag3) { Console.Print(" ...") }
    }
    Console.Print("\n")
    if (n.Kind.IsTypeDecl()) {
        dumpList("tparams", n.List2, ind + 1)
    }
    match (n.Kind) {
        NK.DFn => {
            dumpList("params", n.List, ind + 1)
            dumpChild("ret", n.A, ind + 1)
            dumpChild("body", n.B, ind + 1)
        },
        NK.If => {
            dumpChild("cond", n.A, ind + 1)
            dumpChild("then", n.B, ind + 1)
            dumpChild("else", n.C, ind + 1)
        },
        NK.Let => {
            dumpChild("pattern", n.A, ind + 1)
            dumpChild("type", n.B, ind + 1)
            dumpChild("init", n.C, ind + 1)
        },
        NK.For => {
            dumpChild("index", n.C, ind + 1)
            dumpChild("pattern", n.A, ind + 1)
            dumpChild("iter", n.D, ind + 1)
            dumpChild("body", n.B, ind + 1)
        },
        NK.Block => {
            dumpList("stmts", n.List, ind + 1)
            dumpChild("tail", n.A, ind + 1)
        },
        NK.Arm => {
            dumpChild("pattern", n.A, ind + 1)
            dumpChild("guard", n.B, ind + 1)
            dumpChild("body", n.C, ind + 1)
        },
        _ => {
            dumpChild("a", n.A, ind + 1)
            dumpChild("b", n.B, ind + 1)
            dumpChild("c", n.C, ind + 1)
            dumpChild("d", n.D, ind + 1)
            dumpList("list", n.List, ind + 1)
        },
    }
    if (n.Kind != NK.DFn) {
        dumpList("implements", n.List3, ind + 1)
    }
    if (n.Kind == NK.PVariant || n.Kind == NK.Variant) {
        dumpList("fields", n.List2, ind + 1)
    }
}

fn Dump(f: SourceFile) {
    Console.Print("module ${if (f.HasModule) { f.Module } else { "?" }}\n")
    for (im in f.Imports) {
        Console.Print("import ${PathJoin(im.Path, ".")}${if (im.HasName) { " as " + im.Name } else { "" }}\n")
    }
    for (d in f.Decls) {
        dump(d, 0)
    }
}
