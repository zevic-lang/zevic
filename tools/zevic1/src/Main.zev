module Main

import Zevic.Console
import Zevic.Env
import Zevic.Fs
import Zevic1.Ast as Ast
import Zevic1.Diag as Diag
import Zevic1.Home as Home
import Zevic1.Lexer as Lexer
import Zevic1.Parser as Parser
import Zevic1.Resolve as Resolve
import Zevic1.Token as Token
import Zevic1.Types as Types

fn dumpTokens(path: String) -> I32 {
    let text: String = match (Fs.ReadAll(path)) {
        Ok(t) => t,
        Err(_) => {
            Console.Eprintln("zevic: error: cannot read ${path}")
            return 2
        },
    }
    mut diag: Diag.Diag = Diag.Diag.New()
    let file: I32 = diag.AddSource(path, text)
    let toks: Array<Token.Token> = Lexer.Lex(diag, file, text, 1, 1)
    for (t in toks) {
        Console.Print("${t.Pos.Line}:${t.Pos.Col} ${t.Kind.Name()}")
        match (t.Kind) {
            Token.Tk.Ident => { Console.Print(" ${t.Text}${if (t.Quoted) { " (quoted)" } else { "" }}") },
            Token.Tk.Int | Token.Tk.Char | Token.Tk.Byte => {
                Console.Print(" ${t.Ival}")
                if (t.Suffix != "") { Console.Print(" _${t.Suffix}") }
            },
            Token.Tk.Float => {
                Console.Print(" ${t.Fval}")
                if (t.Suffix != "") { Console.Print(" _${t.Suffix}") }
            },
            Token.Tk.Str => {
                for (p in t.Parts) {
                    Console.Print(" ${if (p.IsExpr) { "expr" } else { "text" }}[")
                    mut k: I64 = 0
                    while (k < p.Text.Len()) {
                        let c: I32 = p.Text.ByteAt(k).ToI32()
                        // the text is valid UTF-8: print a whole character at a time
                        let len: I64 = Lexer.Utf8Len(p.Text, k, p.Text.Len())
                        let step: I64 = if (len == 0) { 1 } else { len }
                        if (c == 10) { Console.Print("\\n") } else if (c < 32) { Console.Printf("\\x%02x", c) } else if (len > 0) { Console.Print(p.Text.Slice(k, k + step)) }
                        k += step
                    }
                    Console.Print("]")
                }
            },
            _ => {},
        }
        Console.Println("")
    }
    if (diag.Errors > 0) { 1 } else { 0 }
}

fn dumpAst(path: String) -> I32 {
    let text: String = match (Fs.ReadAll(path)) {
        Ok(t) => t,
        Err(_) => {
            Console.Eprintln("zevic: error: cannot read ${path}")
            return 2
        },
    }
    mut diag: Diag.Diag = Diag.Diag.New()
    let file: I32 = diag.AddSource(path, text)
    let sf: Ast.SourceFile = Parser.ParseFile(diag, file, text)
    if (diag.Errors == 0) {
        Ast.Dump(sf)
    }
    if (diag.Errors > 0) { 1 } else { 0 }
}

fn dumpModules(files: Array<String>) -> I32 {
    let home: String = match (Home.Find()) {
        Some(h) => h,
        None => {
            Console.Eprintln("zevic: error: cannot find the Zevic standard library")
            return 2
        },
    }
    mut diag: Diag.Diag = Diag.Diag.New()
    mut pg: Resolve.Program = Resolve.Program.New("${home}/stdlib")
    pg.SearchDirs.Push(Home.DirOf(files[0]))
    pg.SearchDirs.Push(".")
    for (f in files) {
        match (Resolve.LoadFile(pg, diag, f, false)) {
            Some(_) => {},
            None => {
                Console.Eprintln("zevic: error: cannot read ${f}")
                return 2
            },
        }
    }
    let core: String = "${home}/stdlib/Core.zev"
    if (Fs.IsFile(core)) {
        let r: Option<Resolve.FileInfo> = Resolve.LoadFile(pg, diag, core, true)
    }
    Resolve.Resolve(pg, diag)
    if (diag.Errors > 0) { return 1 }
    for (info in pg.Files) {
        Console.Println("file ${diag.Name(info.Sf.Pos.File)}${if (info.Sf.IsStd) { " std" } else { "" }}")
    }
    for (m in pg.Modules) {
        Console.Println("module ${m.Name}${if (m.IsStd) { " std" } else { "" }}")
        for (d in m.Deps) {
            Console.Println("  dep ${d.Name}")
        }
        for (info in m.Files) {
            let sf: Ast.SourceFile = info.Sf
            Console.Println("  source ${diag.Name(sf.Pos.File)}")
            for (im in sf.Imports) {
                let name: String = Ast.PathJoin(im.Path, ".")
                let key: String = if (im.HasName) { im.Name } else { name }
                let t: String = match (info.ImportMap.Get(key)) {
                    Some(x) => x.Name,
                    None => "?",
                }
                Console.Println("    import ${key} -> ${t}")
                if (!im.HasName && name.Len() >= 6 && name.Slice(0, 6) == "Zevic.") {
                    let short: String = name.Slice(6, name.Len())
                    let t2: String = match (info.ImportMap.Get(short)) {
                        Some(x) => x.Name,
                        None => "?",
                    }
                    Console.Println("    import ${short} -> ${t2}")
                }
            }
            for (d in sf.Decls) {
                if (d.Kind == Ast.NK.DTest) { continue }
                if (d.Kind == Ast.NK.DExtern) {
                    for (e in d.List) {
                        let x: Option<Resolve.Decl> = m.Decls.Get(e.Name)
                        let pub: String = match (x) {
                            Some(y) => if (y.IsPub) { "pub" } else { "priv" },
                            None => "priv",
                        }
                        let abi: String = match (x) {
                            Some(y) => if (y.HasAbi) { y.Abi } else { "-" },
                            None => "-",
                        }
                        Console.Println("    decl ${e.Name} ${pub} abi=${abi}")
                    }
                    continue
                }
                let pub: String = match (m.Decls.Get(d.Name)) {
                    Some(y) => if (y.IsPub) { "pub" } else { "priv" },
                    None => "priv",
                }
                Console.Println("    decl ${d.Name} ${pub}")
            }
        }
        for (t in m.Tests) {
            Console.Println("  test ${t.Name} ${t.TestName}")
        }
    }
    0
}

// `--selftest-types`: builds a fixed set of types and prints their names, sizes and LLVM types (same as zevic0)
fn stShow(mut tt: Types.TypeTable, t: Types.Type) {
    tt.Layout(t)
    Console.Println("${t.Name} | size=${t.Size} align=${t.Align} ll=${t.Ll} words=${t.PayloadWords} id=${t.Id}")
}

fn stField(mut t: Types.Type, name: String, ft: Types.Type) {
    t.Fields.Push(Types.Field.New(name, ft))
}

fn stVariant(mut tt: Types.TypeTable, mut t: Types.Type, name: String, tag: I32, fts: Array<Types.Type>) {
    mut v: Types.Variant = Types.Variant.New(name, tag)
    mut i: I64 = 0
    while (i < fts.Len()) {
        v.Fields.Push(Types.Field.New("${i}", fts[i]))
        i += 1
    }
    if (fts.Len() > 0) {
        v.Payload = Some(tt.Tuple(fts))
    }
    t.Variants.Push(v)
}

fn b2i(b: Bool) -> I32 { if (b) { 1 } else { 0 } }

fn selftestTypes() -> I32 {
    mut tt: Types.TypeTable = Types.TypeTable.New(8)
    let all: Array<Types.Type> = [tt.I8, tt.I16, tt.I32, tt.I64, tt.U8, tt.U16, tt.U32, tt.U64, tt.F32, tt.F64, tt.Bool, tt.Char, tt.Str, tt.Unit, tt.Never]
    for (t in all) { stShow(tt, t) }
    stShow(tt, tt.Tuple([tt.I32, tt.Str]))
    stShow(tt, tt.Tuple([]))
    stShow(tt, tt.Tuple([tt.I8, tt.I64, tt.U16]))
    let fnt: Types.Type = tt.Fn([tt.I32, tt.Bool], tt.Unit)
    stShow(tt, fnt)
    stShow(tt, tt.Ptr(tt.I8))
    stShow(tt, tt.Param("T"))
    for (n in ["CChar", "CInt", "CUInt", "CLong", "CULong", "CSizeT", "CString", "CVoid", "CBool", "CDouble", "CFloat"]) {
        match (tt.CByName(n)) {
            Some(t) => stShow(tt, t),
            None => Console.Println("missing ${n}"),
        }
    }
    Console.Println("cbyname unknown: ${match (tt.CByName("CNope")) { Some(_) => "found", None => "none" }}")
    stShow(tt, tt.CType("MyC", 2, true))
    Console.Println("prim String: ${match (tt.PrimByName("String")) { Some(_) => "yes", None => "no" }}, prim Never: ${match (tt.PrimByName("Never")) { Some(_) => "yes", None => "no" }}")
    let u1: Types.Type = tt.Union([tt.Str, tt.I32])
    stShow(tt, u1)
    let u2: Types.Type = tt.Union([tt.I32, tt.Str, tt.Bool])
    stShow(tt, u2)
    let u3: Types.Type = tt.Union([tt.Union([tt.I32, tt.Bool]), tt.Str])
    Console.Println("same: ${if (u2.Id == u3.Id) { "yes" } else { "no" }}")
    Console.Println("one member: ${tt.Union([tt.I32, tt.I32]).Name}")
    stShow(tt, tt.Union([fnt, tt.I32]))
    stShow(tt, tt.Union([tt.Unit, tt.I32]))
    stShow(tt, tt.Union([tt.Unit, tt.Bool]))
    stShow(tt, tt.Union([tt.Tuple([tt.I32, tt.I32, tt.I32]), tt.I8]))
    for (v in u2.Variants) {
        let pn: String = match (v.Payload) { Some(p) => p.Name, None => "" }
        Console.Println("  variant ${v.Name} tag=${v.Tag} payload=${pn}")
    }
    mut pt: Types.Type = tt.Named(Types.TKind.Struct, "", "Main.Point", [])
    stField(pt, "X", tt.I32)
    stField(pt, "Y", tt.F64)
    stShow(tt, pt)
    stShow(tt, tt.Named(Types.TKind.Struct, "", "Main.Empty", []))
    mut holder: Types.Type = tt.Named(Types.TKind.Struct, "", "Main.Holder", [])
    stField(holder, "A", tt.Bool)
    stField(holder, "U", u2)
    stField(holder, "P", pt)
    stShow(tt, holder)
    mut sh: Types.Type = tt.Named(Types.TKind.Enum, "", "Main.Shape", [])
    stVariant(tt, sh, "Circle", 0, [tt.F64])
    stVariant(tt, sh, "Rect", 1, [tt.F64, tt.F64])
    stVariant(tt, sh, "Dot", 2, [])
    stShow(tt, sh)
    mut color: Types.Type = tt.Named(Types.TKind.Enum, "", "Main.Color", [])
    stVariant(tt, color, "Red", 0, [])
    stVariant(tt, color, "Blue", 1, [])
    stShow(tt, color)
    let box: Types.Type = tt.Named(Types.TKind.Class, "", "Main.Box", [tt.I32])
    stShow(tt, box)
    stShow(tt, tt.Named(Types.TKind.Class, "", "Main.Map", [tt.Str, tt.Union([tt.I32, tt.Str])]))
    stShow(tt, tt.Fn([u1], u2))
    Console.Println("is_int ${b2i(tt.U8.IsInt())}${b2i(tt.F32.IsInt())}${b2i(tt.Bool.IsInt())} signed ${b2i(tt.I8.IsSigned())}${b2i(tt.U8.IsSigned())} float ${b2i(tt.F32.IsFloat())}${b2i(tt.I32.IsFloat())} value_agg ${b2i(u2.IsValueAgg())}${b2i(box.IsValueAgg())}${b2i(tt.Str.IsValueAgg())} bits ${tt.I8.Bits()}${tt.U16.Bits()}${tt.I32.Bits()}${tt.Bool.Bits()}")
    0
}

fn Main(args: Array<String>) {
    if (args.Len() == 1 && args[0] == "--selftest-types") {
        Env.Exit(selftestTypes())
    }
    if (args.Len() == 2 && args[0] == "--dump-tokens") {
        Env.Exit(dumpTokens(args[1]))
    }
    if (args.Len() == 2 && args[0] == "--dump-ast") {
        Env.Exit(dumpAst(args[1]))
    }
    if (args.Len() >= 2 && args[0] == "--dump-modules") {
        Env.Exit(dumpModules(args.Slice(1, args.Len())))
    }
    Console.Eprintln("usage: zevic1 --dump-tokens <file> | --dump-ast <file> | --dump-modules <file>...")
    Env.Exit(2)
}
