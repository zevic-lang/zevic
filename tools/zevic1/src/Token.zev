module Zevic1.Token

// Tokens, as in zevic0/lexer.h. The names printed by `Name()` are the ones zevic0 prints.

enum Tk {
    Eof,
    Nl,
    Ident,
    Int,
    Float,
    Char,
    Byte,
    Str,

    // keywords
    Module,
    Import,
    As,
    Fn,
    Let,
    Mut,
    Class,
    Struct,
    Enum,
    Interface,
    Static,
    SelfT,
    Extern,
    Export,
    If,
    Else,
    While,
    Loop,
    For,
    In,
    Match,
    Return,
    Break,
    Continue,
    Defer,
    Async,
    Await,
    True,
    False,
    This,

    // punctuation and operators
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Amp,
    Pipe,
    Caret,
    Tilde,
    Bang,
    Shl,
    Shr,
    AndAnd,
    OrOr,
    Assign,
    EqEq,
    Neq,
    Lt,
    Gt,
    Le,
    Ge,
    PlusEq,
    MinusEq,
    StarEq,
    SlashEq,
    PercentEq,
    AmpEq,
    PipeEq,
    CaretEq,
    ShlEq,
    ShrEq,
    Dot,
    DotDot,
    DotDotEq,
    Ellipsis,
    Comma,
    Colon,
    Arrow,
    FatArrow,
    Question,
    At,
    LParen,
    RParen,
    LBrack,
    RBrack,
    LBrace,
    RBrace,

    fn Name() -> String {
        match (this) {
            Tk.Eof => "end of file",
            Tk.Nl => "newline",
            Tk.Ident => "identifier",
            Tk.Int => "integer",
            Tk.Float => "number",
            Tk.Char => "character",
            Tk.Byte => "byte",
            Tk.Str => "string",
            Tk.Module => "module",
            Tk.Import => "import",
            Tk.As => "as",
            Tk.Fn => "fn",
            Tk.Let => "let",
            Tk.Mut => "mut",
            Tk.Class => "class",
            Tk.Struct => "struct",
            Tk.Enum => "enum",
            Tk.Interface => "interface",
            Tk.Static => "static",
            Tk.SelfT => "Self",
            Tk.Extern => "extern",
            Tk.Export => "export",
            Tk.If => "if",
            Tk.Else => "else",
            Tk.While => "while",
            Tk.Loop => "loop",
            Tk.For => "for",
            Tk.In => "in",
            Tk.Match => "match",
            Tk.Return => "return",
            Tk.Break => "break",
            Tk.Continue => "continue",
            Tk.Defer => "defer",
            Tk.Async => "async",
            Tk.Await => "await",
            Tk.True => "true",
            Tk.False => "false",
            Tk.This => "this",
            Tk.Plus => "+",
            Tk.Minus => "-",
            Tk.Star => "*",
            Tk.Slash => "/",
            Tk.Percent => "%",
            Tk.Amp => "&",
            Tk.Pipe => "|",
            Tk.Caret => "^",
            Tk.Tilde => "~",
            Tk.Bang => "!",
            Tk.Shl => "<<",
            Tk.Shr => ">>",
            Tk.AndAnd => "&&",
            Tk.OrOr => "||",
            Tk.Assign => "=",
            Tk.EqEq => "==",
            Tk.Neq => "!=",
            Tk.Lt => "<",
            Tk.Gt => ">",
            Tk.Le => "<=",
            Tk.Ge => ">=",
            Tk.PlusEq => "+=",
            Tk.MinusEq => "-=",
            Tk.StarEq => "*=",
            Tk.SlashEq => "/=",
            Tk.PercentEq => "%=",
            Tk.AmpEq => "&=",
            Tk.PipeEq => "|=",
            Tk.CaretEq => "^=",
            Tk.ShlEq => "<<=",
            Tk.ShrEq => ">>=",
            Tk.Dot => ".",
            Tk.DotDot => "..",
            Tk.DotDotEq => "..=",
            Tk.Ellipsis => "...",
            Tk.Comma => ",",
            Tk.Colon => ":",
            Tk.Arrow => "->",
            Tk.FatArrow => "=>",
            Tk.Question => "?",
            Tk.At => "@",
            Tk.LParen => "(",
            Tk.RParen => ")",
            Tk.LBrack => "[",
            Tk.RBrack => "]",
            Tk.LBrace => "{",
            Tk.RBrace => "}",
        }
    }
}

// A place in a source file (the file is a number in the list of loaded files; lines and columns count from 1).
struct Pos {
    File: I32
    Line: I32
    Col: I32

    fn Init(file: I32, line: I32, col: I32) {
        this.File = file
        this.Line = line
        this.Col = col
    }
}

// One piece of a string literal: literal text, or the source of a `${...}` expression.
class StrPart {
    IsExpr: Bool
    Text: String
    Pos: Pos

    fn Init(isExpr: Bool, text: String, pos: Pos) {
        this.IsExpr = isExpr
        this.Text = text
        this.Pos = pos
    }
}

class Token {
    Kind: Tk
    Pos: Pos
    Text: String = "" // an identifier's name
    Ival: U64 = 0_U64 // Int, Char, Byte
    Fval: F64 = 0.0 // Float
    Suffix: String = "" // "I32", "F64", ... or ""
    Parts: Array<StrPart> = []
    Quoted: Bool = false // an identifier written with backticks
    GenericClose: Bool = false // a `>` that closes type arguments (it does not continue the line)

    fn Init(kind: Tk, pos: Pos) {
        this.Kind = kind
        this.Pos = pos
    }
}
