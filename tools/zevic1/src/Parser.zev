module Zevic1.Parser

// The parser: a port of zevic0/parser.c (recursive descent, the same messages, the same recovery).
// C uses `longjmp` for errors; here every function returns a `Result`, and the `Err` only says "reported already".

import Zevic.Text
import Zevic1.Ast as Ast
import Zevic1.Diag as Diag
import Zevic1.Lexer as Lexer
import Zevic1.Token as T

fn isUpper(s: String) -> Bool { s.Len() > 0 && s.ByteAt(0).ToI32() >= 65 && s.ByteAt(0).ToI32() <= 90 }

fn newNode(kind: Ast.NK, pos: T.Pos) -> Ast.Node { Ast.Node.New(kind, pos) }

fn binprec(k: T.Tk) -> I64 {
    match (k) {
        T.Tk.OrOr => 1,
        T.Tk.AndAnd => 2,
        T.Tk.EqEq | T.Tk.Neq | T.Tk.Lt | T.Tk.Gt | T.Tk.Le | T.Tk.Ge => 3,
        T.Tk.Pipe => 4,
        T.Tk.Caret => 5,
        T.Tk.Amp => 6,
        T.Tk.Shl | T.Tk.Shr => 7,
        T.Tk.Plus | T.Tk.Minus => 8,
        T.Tk.Star | T.Tk.Slash | T.Tk.Percent => 9,
        _ => 0,
    }
}

fn isAssignOp(k: T.Tk) -> Bool {
    match (k) {
        T.Tk.Assign | T.Tk.PlusEq | T.Tk.MinusEq | T.Tk.StarEq | T.Tk.SlashEq => true,
        T.Tk.PercentEq | T.Tk.AmpEq | T.Tk.PipeEq | T.Tk.CaretEq | T.Tk.ShlEq | T.Tk.ShrEq => true,
        _ => false,
    }
}

fn startsExpr(k: T.Tk) -> Bool {
    match (k) {
        T.Tk.Nl | T.Tk.Eof | T.Tk.Comma | T.Tk.RBrace | T.Tk.RParen | T.Tk.RBrack => false,
        T.Tk.FatArrow | T.Tk.Else | T.Tk.Colon => false,
        _ => true,
    }
}

// The error value that means "an error was reported; unwind to the nearest recovery point".
fn failed() -> Error { Error.New(ErrorKind.Parse, "syntax error") }

class Parser {
    file: I32
    toks: Array<T.Token>
    i: I64 = 0
    diag: Diag.Diag
    // A speculative parse: errors are not printed.
    quiet: Bool = false
    // A recursion guard.
    depth: I64 = 0
    // Parsing the pattern of a `match` arm: `n: Type` is allowed there.
    armPat: Bool = false
    // The text has `async` or `await`.
    UsesAsync: Bool = false

    fn Init(diag: Diag.Diag, file: I32, toks: Array<T.Token>) {
        this.diag = diag
        this.file = file
        this.toks = toks
    }

    // ---- helpers ----

    fn peek() -> T.Token { this.toks[this.i] }

    fn peekAt(k: I64) -> T.Token {
        mut j: I64 = this.i + k
        if (j >= this.toks.Len()) {
            j = this.toks.Len() - 1
        }
        this.toks[j]
    }

    fn kind() -> T.Tk { this.toks[this.i].Kind }

    mut fn next() -> T.Token {
        let t: T.Token = this.toks[this.i]
        if (this.i < this.toks.Len() - 1) {
            this.i += 1
        }
        t
    }

    // Reports an error (unless the parse is speculative) and gives the error value to return.
    mut fn perr(pos: T.Pos, msg: String) -> Error {
        if (!this.quiet) {
            this.diag.Error(pos, msg)
        }
        failed()
    }

    fn describe(t: T.Token) -> String {
        match (t.Kind) {
            T.Tk.Ident => "`${t.Text}`",
            T.Tk.Int | T.Tk.Float => "a number",
            T.Tk.Str => "a string",
            T.Tk.Char | T.Tk.Byte => "a character",
            T.Tk.Nl => "the end of the line",
            T.Tk.Eof => "the end of the file",
            _ => "`${t.Kind.Name()}`",
        }
    }

    mut fn skip() {
        let t: T.Token = this.next()
    }

    mut fn skipNl() {
        while (this.kind() == T.Tk.Nl) {
            this.next()
        }
    }

    mut fn accept(k: T.Tk) -> Bool {
        if (this.kind() == k) {
            this.next()
            return true
        }
        false
    }

    mut fn expect(k: T.Tk, what: String) -> Result<T.Token, Error> {
        if (this.kind() != k) {
            return Err(this.perr(this.peek().Pos, "expected ${what}, found ${this.describe(this.peek())}"))
        }
        Ok(this.next())
    }

    mut fn expectIdent(what: String) -> Result<String, Error> {
        let t: T.Token = this.expect(T.Tk.Ident, what)?
        Ok(t.Text)
    }

    // `>>` closing two generic lists: the token is split and its first half is used.
    mut fn expectGt() -> Result<Unit, Error> {
        if (this.kind() == T.Tk.Gt) {
            this.skip()
        } else if (this.kind() == T.Tk.Shr) {
            mut t: T.Token = this.peek()
            t.Kind = T.Tk.Gt
            t.Pos = T.Pos.New(t.Pos.File, t.Pos.Line, t.Pos.Col + 1)
        } else if (this.kind() == T.Tk.Ge) {
            mut t: T.Token = this.peek()
            t.Kind = T.Tk.Assign
            t.Pos = T.Pos.New(t.Pos.File, t.Pos.Line, t.Pos.Col + 1)
        } else {
            return Err(this.perr(this.peek().Pos, "expected `>`, found ${this.describe(this.peek())}"))
        }
        Ok(())
    }

    // ---- types ----

    mut fn parseTypeList(mut out: Array<Ast.Node>, close: T.Tk) -> Result<Unit, Error> {
        this.skipNl()
        while (this.kind() != close) {
            let ty: Ast.Node = this.parseType()?
            out.Push(ty)
            this.skipNl()
            if (!this.accept(T.Tk.Comma)) {
                break
            }
            this.skipNl()
        }
        Ok(())
    }

    mut fn unitType(pos: T.Pos) -> Ast.Node {
        mut u: Ast.Node = newNode(Ast.NK.TypeName, pos)
        u.Path.Push("Unit")
        u
    }

    // A | B | C: a union of two or more types
    mut fn parseType() -> Result<Ast.Node, Error> {
        let first: Ast.Node = this.parseTypeAtom()?
        if (this.kind() != T.Tk.Pipe) {
            return Ok(first)
        }
        mut u: Ast.Node = newNode(Ast.NK.TypeUnion, first.Pos)
        u.List.Push(first)
        while (this.accept(T.Tk.Pipe)) {
            let m: Ast.Node = this.parseTypeAtom()?
            u.List.Push(m)
        }
        Ok(u)
    }

    mut fn parseTypeAtom() -> Result<Ast.Node, Error> {
        let t: T.Token = this.peek()
        let pos: T.Pos = t.Pos
        this.depth += 1
        if (this.depth > 200) {
            return Err(this.perr(pos, "type is nested too deeply"))
        }
        mut res: Ast.Node = newNode(Ast.NK.TypeName, pos)
        if (t.Kind == T.Tk.LParen) {
            this.next()
            mut n: Ast.Node = newNode(Ast.NK.TypeTuple, pos)
            this.parseTypeList(n.List, T.Tk.RParen)?
            this.expect(T.Tk.RParen, "`)`")?
            if (n.List.IsEmpty()) {
                n = this.unitType(pos)
            } else if (n.List.Len() == 1) {
                n = n.List[0]
            }
            res = n
        } else if (t.Kind == T.Tk.Fn) {
            this.next()
            mut n: Ast.Node = newNode(Ast.NK.TypeFn, pos)
            this.expect(T.Tk.LParen, "`(`")?
            this.parseTypeList(n.List, T.Tk.RParen)?
            this.expect(T.Tk.RParen, "`)`")?
            if (this.accept(T.Tk.Arrow)) {
                let r: Ast.Node = this.parseType()?
                n.A = Some(r)
            } else {
                n.A = Some(this.unitType(pos))
            }
            res = n
        } else if (t.Kind == T.Tk.Star) {
            this.next()
            mut n: Ast.Node = newNode(Ast.NK.TypePtr, pos)
            let inner: Ast.Node = this.parseTypeAtom()?
            n.A = Some(inner)
            res = n
        } else if (t.Kind == T.Tk.SelfT) {
            this.next()
            mut n: Ast.Node = newNode(Ast.NK.TypeName, pos)
            n.Path.Push("Self")
            res = n
        } else if (t.Kind == T.Tk.Ident) {
            mut n: Ast.Node = newNode(Ast.NK.TypeName, pos)
            n.Path.Push(this.next().Text)
            while (this.kind() == T.Tk.Dot && this.peekAt(1).Kind == T.Tk.Ident) {
                this.next()
                n.Path.Push(this.next().Text)
            }
            if (this.kind() == T.Tk.Lt) {
                this.next()
                this.parseTypeList(n.List, T.Tk.Gt)?
                this.expectGt()?
            }
            res = n
        } else {
            return Err(this.perr(pos, "expected a type, found ${this.describe(t)}"))
        }
        this.depth -= 1
        Ok(res)
    }

    // <T, K: Hashable + Comparable>
    mut fn parseTparams(mut out: Array<Ast.Node>) -> Result<Unit, Error> {
        if (this.kind() != T.Tk.Lt) {
            return Ok(())
        }
        this.next()
        loop {
            let t: T.Token = this.expect(T.Tk.Ident, "a type parameter name")?
            mut tp: Ast.Node = newNode(Ast.NK.TParam, t.Pos)
            tp.SetName(t.Text)
            if (this.accept(T.Tk.Colon)) {
                let b: Ast.Node = this.parseType()?
                tp.List.Push(b)
                while (this.accept(T.Tk.Plus)) {
                    let b2: Ast.Node = this.parseType()?
                    tp.List.Push(b2)
                }
            }
            out.Push(tp)
            if (!this.accept(T.Tk.Comma)) {
                break
            }
        }
        this.expectGt()?
        Ok(())
    }

    // ---- expressions ----

    mut fn parseStringNode(t: T.Token) -> Result<Ast.Node, Error> {
        mut n: Ast.Node = newNode(Ast.NK.Str, t.Pos)
        for (sp in t.Parts) {
            if (!sp.IsExpr) {
                mut lit: Ast.Node = newNode(Ast.NK.StrLit, sp.Pos)
                lit.SetName(sp.Text)
                n.List.Push(lit)
                continue
            }
            // the ${...} source is parsed with a sub-parser
            let toks: Array<T.Token> = Lexer.Lex(this.diag, this.file, sp.Text, sp.Pos.Line, sp.Pos.Col)
            mut sub: Parser = Parser.New(this.diag, this.file, toks)
            sub.quiet = this.quiet
            match (sub.interpolation(sp.Pos)) {
                Ok(e) => n.List.Push(e),
                Err(_) => {
                    if (this.quiet) {
                        return Err(failed())
                    }
                    n.List.Push(newNode(Ast.NK.Unit, sp.Pos))
                },
            }
            if (sub.UsesAsync) {
                this.UsesAsync = true
            }
        }
        Ok(n)
    }

    // The expression inside `${...}`.
    mut fn interpolation(pos: T.Pos) -> Result<Ast.Node, Error> {
        this.skipNl()
        if (this.kind() == T.Tk.Eof) {
            return Err(this.perr(pos, "empty `\${}` in a string"))
        }
        let e: Ast.Node = this.parseExpr()?
        this.skipNl()
        if (this.kind() != T.Tk.Eof) {
            return Err(this.perr(this.peek().Pos, "unexpected ${this.describe(this.peek())} in `\${...}`"))
        }
        Ok(e)
    }

    fn isLambdaAhead() -> Bool {
        mut depth: I64 = 0
        mut j: I64 = this.i
        while (j < this.toks.Len()) {
            let k: T.Tk = this.toks[j].Kind
            if (k == T.Tk.LParen || k == T.Tk.LBrack || k == T.Tk.LBrace) {
                depth += 1
            } else if (k == T.Tk.RParen || k == T.Tk.RBrack || k == T.Tk.RBrace) {
                depth -= 1
                if (depth == 0) {
                    return j + 1 < this.toks.Len() && this.toks[j + 1].Kind == T.Tk.FatArrow
                }
                if (depth < 0) {
                    return false
                }
            } else if (k == T.Tk.Eof) {
                return false
            }
            j += 1
        }
        false
    }

    mut fn parseLambda() -> Result<Ast.Node, Error> {
        mut n: Ast.Node = newNode(Ast.NK.Lambda, this.peek().Pos)
        this.expect(T.Tk.LParen, "`(`")?
        while (this.kind() != T.Tk.RParen) {
            let t: T.Token = this.expect(T.Tk.Ident, "a parameter name")?
            mut pm: Ast.Node = newNode(Ast.NK.Param, t.Pos)
            pm.SetName(t.Text)
            if (!this.accept(T.Tk.Colon)) {
                return Err(this.perr(this.peek().Pos, "the type of the lambda parameter `${t.Text}` must be written (`(${t.Text}: Type) => ...`)"))
            }
            let ty: Ast.Node = this.parseType()?
            pm.A = Some(ty)
            n.List.Push(pm)
            if (!this.accept(T.Tk.Comma)) {
                break
            }
        }
        this.expect(T.Tk.RParen, "`)`")?
        this.expect(T.Tk.FatArrow, "`=>`")?
        if (this.kind() == T.Tk.LBrace) {
            let b: Ast.Node = this.parseBlock()?
            n.B = Some(b)
        } else {
            let b: Ast.Node = this.parseExpr()?
            n.B = Some(b)
        }
        Ok(n)
    }

    mut fn parseIf() -> Result<Ast.Node, Error> {
        mut n: Ast.Node = newNode(Ast.NK.If, this.next().Pos)
        this.expect(T.Tk.LParen, "`(` after `if` (conditions are written in parentheses)")?
        let c: Ast.Node = this.parseExpr()?
        n.A = Some(c)
        this.expect(T.Tk.RParen, "`)`")?
        if (this.kind() != T.Tk.LBrace) {
            return Err(this.perr(this.peek().Pos, "expected `{` (the body of an `if` must be in braces)"))
        }
        let b: Ast.Node = this.parseBlock()?
        n.B = Some(b)
        // `else` may follow on the next line
        let save: I64 = this.i
        this.skipNl()
        if (this.kind() == T.Tk.Else) {
            this.next()
            if (this.kind() == T.Tk.If) {
                let e: Ast.Node = this.parseIf()?
                n.C = Some(e)
            } else if (this.kind() == T.Tk.LBrace) {
                let e: Ast.Node = this.parseBlock()?
                n.C = Some(e)
            } else {
                return Err(this.perr(this.peek().Pos, "expected `if` or `{` after `else`"))
            }
        } else {
            this.i = save
        }
        Ok(n)
    }

    mut fn parseMatch() -> Result<Ast.Node, Error> {
        mut n: Ast.Node = newNode(Ast.NK.Match, this.next().Pos)
        this.expect(T.Tk.LParen, "`(` after `match` (the scrutinee is written in parentheses)")?
        let s: Ast.Node = this.parseExpr()?
        n.A = Some(s)
        this.expect(T.Tk.RParen, "`)`")?
        this.expect(T.Tk.LBrace, "`{`")?
        this.skipNl()
        while (this.kind() != T.Tk.RBrace) {
            if (this.kind() == T.Tk.Eof) {
                return Err(this.perr(this.peek().Pos, "unterminated `match`: expected `}`"))
            }
            mut arm: Ast.Node = newNode(Ast.NK.Arm, this.peek().Pos)
            this.armPat = true
            let pat: Ast.Node = this.parsePattern()?
            this.armPat = false
            arm.A = Some(pat)
            if (this.accept(T.Tk.If)) {
                this.expect(T.Tk.LParen, "`(` (a guard condition is written in parentheses)")?
                let g: Ast.Node = this.parseExpr()?
                arm.B = Some(g)
                this.expect(T.Tk.RParen, "`)`")?
            }
            this.expect(T.Tk.FatArrow, "`=>`")?
            if (this.kind() == T.Tk.LBrace) {
                let body: Ast.Node = this.parseBlock()?
                arm.C = Some(body)
            } else {
                let body: Ast.Node = this.parseExpr()?
                arm.C = Some(body)
            }
            n.List.Push(arm)
            mut sep: Bool = false
            while (this.kind() == T.Tk.Nl || this.kind() == T.Tk.Comma) {
                sep = true
                this.next()
            }
            if (!sep && this.kind() != T.Tk.RBrace) {
                return Err(this.perr(this.peek().Pos, "expected `,` or a new line after a match arm, found ${this.describe(this.peek())}"))
            }
        }
        this.next()
        Ok(n)
    }

    mut fn parsePrimary() -> Result<Ast.Node, Error> {
        let t: T.Token = this.peek()
        let pos: T.Pos = t.Pos
        match (t.Kind) {
            T.Tk.Int => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Int, pos)
                n.Ival = t.Ival
                n.Suffix = t.Suffix
                Ok(n)
            },
            T.Tk.Float => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Float, pos)
                n.Fval = t.Fval
                n.Suffix = t.Suffix
                Ok(n)
            },
            T.Tk.Char | T.Tk.Byte => {
                this.next()
                mut n: Ast.Node = newNode(if (t.Kind == T.Tk.Char) { Ast.NK.Char } else { Ast.NK.Byte }, pos)
                n.Ival = t.Ival
                Ok(n)
            },
            T.Tk.Str => {
                this.next()
                this.parseStringNode(t)
            },
            T.Tk.True | T.Tk.False => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Bool, pos)
                n.Ival = if (t.Kind == T.Tk.True) { 1_U64 } else { 0_U64 }
                Ok(n)
            },
            T.Tk.This => {
                this.next()
                Ok(newNode(Ast.NK.This, pos))
            },
            T.Tk.Ident => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Ident, pos)
                n.SetName(t.Text)
                Ok(n)
            },
            T.Tk.SelfT => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Ident, pos)
                n.SetName("Self")
                Ok(n)
            },
            T.Tk.LParen => {
                if (this.isLambdaAhead()) {
                    return this.parseLambda()
                }
                this.next()
                if (this.accept(T.Tk.RParen)) {
                    return Ok(newNode(Ast.NK.Unit, pos))
                }
                mut e: Ast.Node = this.parseExpr()?
                if (this.kind() == T.Tk.Comma) {
                    mut tup: Ast.Node = newNode(Ast.NK.Tuple, pos)
                    tup.List.Push(e)
                    while (this.accept(T.Tk.Comma)) {
                        if (this.kind() == T.Tk.RParen) {
                            break
                        }
                        let x: Ast.Node = this.parseExpr()?
                        tup.List.Push(x)
                    }
                    this.expect(T.Tk.RParen, "`)`")?
                    return Ok(tup)
                }
                this.expect(T.Tk.RParen, "`)`")?
                e.Flag3 = e.Flag3 || e.Kind == Ast.NK.Int || e.Kind == Ast.NK.Float // a parenthesised literal
                Ok(e)
            },
            T.Tk.LBrack => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Array, pos)
                while (this.kind() != T.Tk.RBrack) {
                    let x: Ast.Node = this.parseExpr()?
                    n.List.Push(x)
                    if (!this.accept(T.Tk.Comma)) {
                        break
                    }
                }
                this.expect(T.Tk.RBrack, "`]`")?
                Ok(n)
            },
            T.Tk.LBrace => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.MapLit, pos)
                while (this.kind() != T.Tk.RBrace) {
                    mut pr: Ast.Node = newNode(Ast.NK.Pair, this.peek().Pos)
                    let k: Ast.Node = this.parseExpr()?
                    pr.A = Some(k)
                    this.expect(T.Tk.Colon, "`:` in a map literal")?
                    let v: Ast.Node = this.parseExpr()?
                    pr.B = Some(v)
                    n.List.Push(pr)
                    if (!this.accept(T.Tk.Comma)) {
                        break
                    }
                }
                this.expect(T.Tk.RBrace, "`}`")?
                Ok(n)
            },
            T.Tk.If => this.parseIf(),
            T.Tk.Match => this.parseMatch(),
            T.Tk.Return => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Return, pos)
                if (startsExpr(this.kind())) {
                    let e: Ast.Node = this.parseExpr()?
                    n.A = Some(e)
                }
                Ok(n)
            },
            T.Tk.Async => {
                this.next()
                if (this.kind() != T.Tk.LBrace) {
                    return Err(this.perr(this.peek().Pos, "expected `{` after `async` (an `async` block: `async { ... }`)"))
                }
                mut n: Ast.Node = newNode(Ast.NK.Async, pos)
                let b: Ast.Node = this.parseBlock()?
                n.B = Some(b)
                this.UsesAsync = true
                Ok(n)
            },
            T.Tk.Break | T.Tk.Continue => {
                let kw: T.Token = this.peek()
                this.next()
                mut n: Ast.Node = newNode(if (kw.Kind == T.Tk.Break) { Ast.NK.Break } else { Ast.NK.Continue }, pos)
                match (this.parseJumpLabel(kw, if (kw.Kind == T.Tk.Break) { "break" } else { "continue" })?) {
                    Some(name) => n.SetName(name),
                    None => {},
                }
                Ok(n)
            },
            _ => Err(this.perr(pos, "expected an expression, found ${this.describe(t)}")),
        }
    }

    // Speculatively parses `<T, U>` after a name; it works only if `(` or `.` follows.
    mut fn tryTypeArgs(mut out: Array<Ast.Node>) -> Bool {
        let save: I64 = this.i
        let wasQuiet: Bool = this.quiet
        this.quiet = true
        mut args: Array<Ast.Node> = []
        let ok: Bool = this.typeArgsAttempt(args)
        this.quiet = wasQuiet
        if (!ok) {
            this.i = save
            return false
        }
        for (a in args) {
            out.Push(a)
        }
        true
    }

    mut fn typeArgsAttempt(mut args: Array<Ast.Node>) -> Bool {
        match (this.expect(T.Tk.Lt, "`<`")) {
            Ok(_) => {},
            Err(_) => return false,
        }
        match (this.parseTypeList(args, T.Tk.Gt)) {
            Ok(_) => {},
            Err(_) => return false,
        }
        match (this.expectGt()) {
            Ok(_) => {},
            Err(_) => return false,
        }
        (this.kind() == T.Tk.LParen || this.kind() == T.Tk.Dot) && args.Len() > 0
    }

    mut fn parsePostfix() -> Result<Ast.Node, Error> {
        mut e: Ast.Node = this.parsePrimary()?
        loop {
            let pos: T.Pos = this.peek().Pos
            let k: T.Tk = this.kind()
            if (k == T.Tk.Dot) {
                this.next()
                mut m: Ast.Node = newNode(Ast.NK.Member, pos)
                m.A = Some(e)
                if (this.kind() == T.Tk.Ident) {
                    m.SetName(this.next().Text)
                } else if (this.kind() == T.Tk.Int && this.peek().Suffix == "") {
                    m.SetName("${this.next().Ival}")
                } else {
                    return Err(this.perr(this.peek().Pos, "expected a member name after `.`, found ${this.describe(this.peek())}"))
                }
                e = m
            } else if (k == T.Tk.LParen) {
                this.next()
                mut c: Ast.Node = newNode(Ast.NK.Call, pos)
                c.A = Some(e)
                while (this.kind() != T.Tk.RParen) {
                    let x: Ast.Node = this.parseExpr()?
                    c.List.Push(x)
                    if (!this.accept(T.Tk.Comma)) {
                        break
                    }
                }
                this.expect(T.Tk.RParen, "`)` after the arguments")?
                e = c
            } else if (k == T.Tk.LBrack) {
                this.next()
                mut ix: Ast.Node = newNode(Ast.NK.Index, pos)
                ix.A = Some(e)
                let b: Ast.Node = this.parseExpr()?
                ix.B = Some(b)
                this.expect(T.Tk.RBrack, "`]`")?
                e = ix
            } else if (k == T.Tk.LBrace) {
                // Shape.Named { Name: "x", Size: 3 }: a capitalised path followed by `{ name :`
                let isPath: Bool = e.Kind == Ast.NK.Ident || e.Kind == Ast.NK.Member
                if (!isPath || !isUpper(e.Name) || this.peekAt(1).Kind != T.Tk.Ident || this.peekAt(2).Kind != T.Tk.Colon) {
                    return Ok(e)
                }
                this.next()
                mut lit: Ast.Node = newNode(Ast.NK.StructLit, e.Pos)
                lit.A = Some(e)
                this.skipNl()
                while (this.kind() != T.Tk.RBrace) {
                    let ft: T.Token = this.expect(T.Tk.Ident, "a field name")?
                    mut f: Ast.Node = newNode(Ast.NK.Field, ft.Pos)
                    f.SetName(ft.Text)
                    this.expect(T.Tk.Colon, "`:` after the field name")?
                    let v: Ast.Node = this.parseExpr()?
                    f.B = Some(v)
                    lit.List.Push(f)
                    this.skipNl()
                    if (!this.accept(T.Tk.Comma)) {
                        break
                    }
                    this.skipNl()
                }
                this.skipNl()
                this.expect(T.Tk.RBrace, "`}` (fields are separated by commas)")?
                e = lit
            } else if (k == T.Tk.Question) {
                this.next()
                mut t: Ast.Node = newNode(Ast.NK.Try, pos)
                t.A = Some(e)
                e = t
            } else if (k == T.Tk.Lt) {
                if ((e.Kind == Ast.NK.Ident || e.Kind == Ast.NK.Member) && this.tryTypeArgs(e.List2)) {
                    continue
                }
                return Ok(e)
            } else {
                return Ok(e)
            }
        }
    }

    mut fn parseUnary() -> Result<Ast.Node, Error> {
        let t: T.Token = this.peek()
        if (t.Kind == T.Tk.Await) {
            this.depth += 1
            if (this.depth > 200) {
                return Err(this.perr(t.Pos, "expression is nested too deeply"))
            }
            this.next()
            mut n: Ast.Node = newNode(Ast.NK.Await, t.Pos)
            let a: Ast.Node = this.parseUnary()?
            n.A = Some(a)
            this.depth -= 1
            this.UsesAsync = true
            return Ok(n)
        }
        if (t.Kind == T.Tk.Minus || t.Kind == T.Tk.Bang || t.Kind == T.Tk.Tilde || t.Kind == T.Tk.Amp) {
            this.depth += 1
            if (this.depth > 200) {
                return Err(this.perr(t.Pos, "expression is nested too deeply"))
            }
            this.next()
            mut n: Ast.Node = newNode(Ast.NK.Unary, t.Pos)
            n.Op = t.Kind
            let a: Ast.Node = this.parseUnary()?
            n.A = Some(a)
            this.depth -= 1
            return Ok(n)
        }
        this.parsePostfix()
    }

    // `is` is a word only here, after an operand: it stays usable as a name everywhere else
    fn atIs() -> Bool {
        let t: T.Token = this.peek()
        if (t.Kind == T.Tk.Ident && !t.Quoted && t.Text == "is") {
            return true
        }
        if (t.Kind == T.Tk.Bang) {
            let u: T.Token = this.peekAt(1)
            return u.Kind == T.Tk.Ident && !u.Quoted && u.Text == "is"
        }
        false
    }

    mut fn parseBinary(minprec: I64) -> Result<Ast.Node, Error> {
        mut left: Ast.Node = this.parseUnary()?
        loop {
            if (3 >= minprec && this.atIs()) {
                let pos: T.Pos = this.peek().Pos
                let neg: Bool = this.kind() == T.Tk.Bang
                if (neg) {
                    this.next()
                }
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Is, pos)
                n.A = Some(left)
                let ty: Ast.Node = this.parseTypeAtom()?
                n.B = Some(ty)
                n.Flag = neg
                left = n
                if (binprec(this.kind()) == 3 || this.atIs()) {
                    return Err(this.perr(this.peek().Pos, "comparison operators cannot be chained (write `a < b && b < c`)"))
                }
                continue
            }
            let k: T.Tk = this.kind()
            let prec: I64 = binprec(k)
            if (prec == 0 || prec < minprec) {
                return Ok(left)
            }
            let pos: T.Pos = this.next().Pos
            let right: Ast.Node = this.parseBinary(prec + 1)?
            mut n: Ast.Node = newNode(Ast.NK.Binary, pos)
            n.Op = k
            n.A = Some(left)
            n.B = Some(right)
            left = n
            if (prec == 3 && binprec(this.kind()) == 3) {
                return Err(this.perr(this.peek().Pos, "comparison operators cannot be chained (write `a < b && b < c`)"))
            }
        }
    }

    mut fn parseRangeExpr() -> Result<Ast.Node, Error> {
        let lhs: Ast.Node = this.parseBinary(1)?
        if (this.kind() == T.Tk.DotDot || this.kind() == T.Tk.DotDotEq) {
            let op: T.Token = this.next()
            mut r: Ast.Node = newNode(Ast.NK.Range, op.Pos)
            r.Flag = op.Kind == T.Tk.DotDotEq
            r.A = Some(lhs)
            let rhs: Ast.Node = this.parseBinary(1)?
            r.B = Some(rhs)
            if (this.kind() == T.Tk.DotDot || this.kind() == T.Tk.DotDotEq) {
                return Err(this.perr(this.peek().Pos, "ranges cannot be chained"))
            }
            return Ok(r)
        }
        Ok(lhs)
    }

    mut fn parseExpr() -> Result<Ast.Node, Error> {
        this.depth += 1
        if (this.depth > 200) {
            return Err(this.perr(this.peek().Pos, "expression is nested too deeply"))
        }
        let n: Ast.Node = this.parseRangeExpr()?
        this.depth -= 1
        Ok(n)
    }

    // ---- patterns ----

    mut fn parseLiteralPattern() -> Result<Ast.Node, Error> {
        let t: T.Token = this.peek()
        if (t.Kind == T.Tk.Minus) {
            this.next()
            let inner: Ast.Node = this.parsePrimary()?
            if (inner.Kind != Ast.NK.Int && inner.Kind != Ast.NK.Float) {
                return Err(this.perr(t.Pos, "`-` in a pattern must be followed by a number"))
            }
            mut lit: Ast.Node = newNode(Ast.NK.Unary, t.Pos)
            lit.Op = T.Tk.Minus
            lit.A = Some(inner)
            return Ok(lit)
        }
        this.parsePrimary()
    }

    mut fn parsePatternAtom() -> Result<Ast.Node, Error> {
        let t: T.Token = this.peek()
        let pos: T.Pos = t.Pos
        match (t.Kind) {
            T.Tk.Int | T.Tk.Float | T.Tk.Char | T.Tk.Byte | T.Tk.Str | T.Tk.True | T.Tk.False | T.Tk.Minus => {
                let lit: Ast.Node = this.parseLiteralPattern()?
                if (this.kind() == T.Tk.DotDot || this.kind() == T.Tk.DotDotEq) {
                    let op: T.Token = this.next()
                    mut r: Ast.Node = newNode(Ast.NK.PRange, pos)
                    r.Flag = op.Kind == T.Tk.DotDotEq
                    r.A = Some(lit)
                    let hi: Ast.Node = this.parseLiteralPattern()?
                    r.B = Some(hi)
                    return Ok(r)
                }
                mut n: Ast.Node = newNode(Ast.NK.PLit, pos)
                n.A = Some(lit)
                Ok(n)
            },
            T.Tk.LParen => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.PTuple, pos)
                while (this.kind() != T.Tk.RParen) {
                    let p: Ast.Node = this.parsePattern()?
                    n.List.Push(p)
                    if (!this.accept(T.Tk.Comma)) {
                        break
                    }
                }
                this.expect(T.Tk.RParen, "`)`")?
                if (n.List.Len() == 1) {
                    return Ok(n.List[0])
                }
                Ok(n)
            },
            T.Tk.Ident => {
                this.next()
                if (this.armPat && this.kind() == T.Tk.Colon && !isUpper(t.Text)) {
                    // `n: I32`, `_: Error`: matches one member of a union
                    this.next()
                    mut pt: Ast.Node = newNode(Ast.NK.PType, pos)
                    pt.SetName(t.Text)
                    let ty: Ast.Node = this.parseTypeAtom()?
                    pt.A = Some(ty)
                    return Ok(pt)
                }
                if (t.Text == "_" && !t.Quoted) {
                    return Ok(newNode(Ast.NK.PWild, pos))
                }
                let qualified: Bool = this.kind() == T.Tk.Dot && this.peekAt(1).Kind == T.Tk.Ident
                let args: Bool = this.kind() == T.Tk.LParen
                let fields: Bool = this.kind() == T.Tk.LBrace && isUpper(t.Text)
                if (!qualified && !args && !fields && !isUpper(t.Text)) {
                    mut n: Ast.Node = newNode(Ast.NK.PBind, pos)
                    n.SetName(t.Text)
                    return Ok(n)
                }
                mut n: Ast.Node = newNode(Ast.NK.PVariant, pos)
                n.Path.Push(t.Text)
                while (this.kind() == T.Tk.Dot && this.peekAt(1).Kind == T.Tk.Ident) {
                    this.next()
                    n.Path.Push(this.next().Text)
                }
                if (this.kind() == T.Tk.LParen) {
                    this.next()
                    n.Flag = true
                    while (this.kind() != T.Tk.RParen) {
                        let p: Ast.Node = this.parsePattern()?
                        n.List.Push(p)
                        if (!this.accept(T.Tk.Comma)) {
                            break
                        }
                    }
                    let t: T.Token = this.expect(T.Tk.RParen, "`)`")?
                } else if (this.kind() == T.Tk.LBrace) {
                    this.next()
                    n.Flag2 = true
                    this.skipNl()
                    while (this.kind() != T.Tk.RBrace) {
                        if (this.accept(T.Tk.DotDot)) {
                            n.Flag3 = true
                        } else {
                            let ft: T.Token = this.expect(T.Tk.Ident, "a field name")?
                            mut f: Ast.Node = newNode(Ast.NK.PField, ft.Pos)
                            f.SetName(ft.Text)
                            this.expect(T.Tk.Colon, "`:` after the field name in a pattern")?
                            let p: Ast.Node = this.parsePattern()?
                            f.A = Some(p)
                            n.List2.Push(f)
                        }
                        this.skipNl()
                        if (!this.accept(T.Tk.Comma)) {
                            break
                        }
                        this.skipNl()
                    }
                    this.skipNl()
                    this.expect(T.Tk.RBrace, "`}`")?
                }
                Ok(n)
            },
            _ => Err(this.perr(pos, "expected a pattern, found ${this.describe(t)}")),
        }
    }

    mut fn parsePattern() -> Result<Ast.Node, Error> {
        let first: Ast.Node = this.parsePatternAtom()?
        if (this.kind() != T.Tk.Pipe) {
            return Ok(first)
        }
        mut alt: Ast.Node = newNode(Ast.NK.POr, first.Pos)
        alt.List.Push(first)
        while (this.accept(T.Tk.Pipe)) {
            let p: Ast.Node = this.parsePatternAtom()?
            alt.List.Push(p)
        }
        Ok(alt)
    }

    // ---- statements and blocks ----

    mut fn parseSimpleStmt() -> Result<Ast.Node, Error> {
        let pos: T.Pos = this.peek().Pos
        let e: Ast.Node = this.parseExpr()?
        if (isAssignOp(this.kind())) {
            let op: T.Token = this.next()
            mut a: Ast.Node = newNode(Ast.NK.Assign, op.Pos)
            a.Op = op.Kind
            a.A = Some(e)
            let v: Ast.Node = this.parseExpr()?
            a.B = Some(v)
            return Ok(a)
        }
        mut s: Ast.Node = newNode(Ast.NK.ExprStmt, pos)
        s.A = Some(e)
        Ok(s)
    }

    // `name@ while/loop/for`: the label is glued to the name and the loop keyword follows on the same line
    fn atLabel() -> Bool {
        let a: T.Token = this.peekAt(1)
        let b: T.Token = this.peekAt(2)
        this.kind() == T.Tk.Ident && a.Kind == T.Tk.At && (b.Kind == T.Tk.While || b.Kind == T.Tk.Loop || b.Kind == T.Tk.For)
    }

    // The `@name` after `break` / `continue` (None when there is none). `@` and the name must touch the keyword.
    mut fn parseJumpLabel(kw: T.Token, what: String) -> Result<Option<String>, Error> {
        if (this.kind() != T.Tk.At) {
            return Ok(None)
        }
        let at: T.Token = this.peek()
        let id: T.Token = this.peekAt(1)
        if (at.Pos.Line != kw.Pos.Line || at.Pos.Col != kw.Pos.Col + what.Len().ToI32Wrap()) {
            return Err(this.perr(at.Pos, "write `${what}@label` without a blank before `@`"))
        }
        if (id.Kind != T.Tk.Ident || id.Pos.Line != at.Pos.Line || id.Pos.Col != at.Pos.Col + 1) {
            return Err(this.perr(at.Pos, "expected a label name right after `@` (like `${what}@outer`)"))
        }
        this.next()
        let name: String = id.Text
        this.next()
        Ok(Some(name))
    }

    mut fn parseStmt() -> Result<Ast.Node, Error> {
        this.armPat = false // a failed match arm may have left it set
        let t: T.Token = this.peek()
        let pos: T.Pos = t.Pos
        if (this.atLabel()) {
            let id: T.Token = this.peek()
            let b: T.Token = this.peekAt(2)
            let at: T.Token = this.peekAt(1)
            if (at.Pos.Line != id.Pos.Line || at.Pos.Col != id.Pos.Col + id.Text.Len().ToI32Wrap() || b.Pos.Line != at.Pos.Line) {
                return Err(this.perr(at.Pos, "write the label as `name@ loop` on one line, with `@` right after the name"))
            }
            let label: String = id.Text
            this.next()
            this.next()
            mut n: Ast.Node = this.parseStmt()?
            n.SetName(label)
            return Ok(n)
        }
        match (t.Kind) {
            T.Tk.Let | T.Tk.Mut => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Let, pos)
                n.Flag = t.Kind == T.Tk.Mut
                let pat: Ast.Node = this.parsePattern()?
                n.A = Some(pat)
                if (!this.accept(T.Tk.Colon)) {
                    return Err(this.perr(this.peek().Pos, "a variable needs a type: write `${if (t.Kind == T.Tk.Mut) { "mut" } else { "let" }} name: Type = value`"))
                }
                let ty: Ast.Node = this.parseType()?
                n.B = Some(ty)
                this.expect(T.Tk.Assign, "`=` and an initial value (a variable must be initialised)")?
                let init: Ast.Node = this.parseExpr()?
                n.C = Some(init)
                Ok(n)
            },
            T.Tk.Defer => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Defer, pos)
                if (this.kind() == T.Tk.LBrace) {
                    let b: Ast.Node = this.parseBlock()?
                    n.A = Some(b)
                } else {
                    let s: Ast.Node = this.parseSimpleStmt()?
                    n.A = Some(s)
                }
                Ok(n)
            },
            T.Tk.While => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.While, pos)
                this.expect(T.Tk.LParen, "`(` after `while` (conditions are written in parentheses)")?
                let c: Ast.Node = this.parseExpr()?
                n.A = Some(c)
                this.expect(T.Tk.RParen, "`)`")?
                if (this.kind() != T.Tk.LBrace) {
                    return Err(this.perr(this.peek().Pos, "expected `{` (the body of a loop must be in braces)"))
                }
                let b: Ast.Node = this.parseBlock()?
                n.B = Some(b)
                Ok(n)
            },
            T.Tk.Loop => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.Loop, pos)
                if (this.kind() != T.Tk.LBrace) {
                    return Err(this.perr(this.peek().Pos, "expected `{` after `loop`"))
                }
                let b: Ast.Node = this.parseBlock()?
                n.B = Some(b)
                Ok(n)
            },
            T.Tk.For => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.For, pos)
                this.expect(T.Tk.LParen, "`(` after `for`")?
                let first: Ast.Node = this.parsePattern()?
                n.A = Some(first)
                if (this.accept(T.Tk.Comma)) {
                    n.C = Some(first) // the index pattern
                    let second: Ast.Node = this.parsePattern()?
                    n.A = Some(second)
                }
                this.expect(T.Tk.In, "`in`")?
                let it: Ast.Node = this.parseExpr()?
                n.D = Some(it)
                this.expect(T.Tk.RParen, "`)`")?
                if (this.kind() != T.Tk.LBrace) {
                    return Err(this.perr(this.peek().Pos, "expected `{` (the body of a loop must be in braces)"))
                }
                let b: Ast.Node = this.parseBlock()?
                n.B = Some(b)
                Ok(n)
            },
            T.Tk.Fn | T.Tk.Struct | T.Tk.Class | T.Tk.Enum | T.Tk.Interface => {
                Err(this.perr(pos, "declarations are only allowed at the top level (use a lambda for a local function)"))
            },
            _ => this.parseSimpleStmt(),
        }
    }

    // Skips to the end of the statement after an error.
    mut fn syncStmt() {
        mut depth: I64 = 0
        while (this.kind() != T.Tk.Eof) {
            let k: T.Tk = this.kind()
            if (k == T.Tk.LBrace) {
                depth += 1
            } else if (k == T.Tk.RBrace) {
                if (depth == 0) {
                    return
                }
                depth -= 1
            } else if (k == T.Tk.Nl && depth == 0) {
                return
            }
            this.next()
        }
    }

    // One statement and what must follow it.
    mut fn stmtAndEnd() -> Result<Ast.Node, Error> {
        let s: Ast.Node = this.parseStmt()?
        if (this.kind() != T.Tk.Nl && this.kind() != T.Tk.RBrace) {
            return Err(this.perr(this.peek().Pos, "expected a new line or `}` after the statement, found ${this.describe(this.peek())}"))
        }
        Ok(s)
    }

    mut fn parseBlock() -> Result<Ast.Node, Error> {
        let open: T.Token = this.expect(T.Tk.LBrace, "`{`")?
        mut b: Ast.Node = newNode(Ast.NK.Block, open.Pos)
        this.skipNl()
        while (this.kind() != T.Tk.RBrace) {
            if (this.kind() == T.Tk.Eof) {
                return Err(this.perr(open.Pos, "this `{` is never closed"))
            }
            match (this.stmtAndEnd()) {
                Ok(s) => b.List.Push(s),
                Err(e) => {
                    if (this.quiet) {
                        return Err(e)
                    }
                    this.syncStmt()
                },
            }
            this.skipNl()
        }
        this.next()
        if (!b.List.IsEmpty()) {
            let last: Ast.Node = b.List[b.List.Len() - 1]
            if (last.Kind == Ast.NK.ExprStmt) {
                b.A = last.A
                b.List.Pop()
            }
        }
        Ok(b)
    }

    // ---- declarations ----

    mut fn parseFn(allowNobody: Bool) -> Result<Ast.Node, Error> {
        let fnt: T.Token = this.expect(T.Tk.Fn, "`fn`")?
        mut n: Ast.Node = newNode(Ast.NK.DFn, fnt.Pos)
        let name: T.Token = this.expect(T.Tk.Ident, "a function name")?
        n.SetName(name.Text)
        n.Pos = name.Pos
        this.parseTparams(n.List2)?
        this.expect(T.Tk.LParen, "`(` after the function name")?
        while (this.kind() != T.Tk.RParen) {
            if (this.kind() == T.Tk.Ellipsis) {
                mut pm: Ast.Node = newNode(Ast.NK.Param, this.next().Pos)
                pm.Flag3 = true
                n.List.Push(pm)
                break
            }
            mut pm: Ast.Node = newNode(Ast.NK.Param, this.peek().Pos)
            if (this.kind() == T.Tk.Mut) {
                this.next()
                pm.Flag = true
            } else if (this.kind() == T.Tk.Ident && this.peek().Text == "params" && this.peekAt(1).Kind == T.Tk.Ident) {
                this.next()
                pm.Flag2 = true
            }
            pm.Pos = this.peek().Pos
            pm.SetName(this.expectIdent("a parameter name")?)
            this.expect(T.Tk.Colon, "`:` and the parameter's type (parameter types are required)")?
            let ty: Ast.Node = this.parseType()?
            pm.A = Some(ty)
            n.List.Push(pm)
            if (!this.accept(T.Tk.Comma)) {
                break
            }
        }
        this.expect(T.Tk.RParen, "`)` after the parameters")?
        if (this.accept(T.Tk.Arrow)) {
            let r: Ast.Node = this.parseType()?
            n.A = Some(r)
        }
        if (this.kind() == T.Tk.Assign && allowNobody) {
            this.next()
            let s: T.Token = this.expect(T.Tk.Str, "the C name as a string")?
            n.Name2 = if (s.Parts.IsEmpty()) { "" } else { s.Parts[0].Text }
        }
        if (this.kind() == T.Tk.LBrace) {
            let b: Ast.Node = this.parseBlock()?
            n.B = Some(b)
        } else if (!allowNobody) {
            return Err(this.perr(this.peek().Pos, "expected `{` and the body of function `${n.Name}`"))
        }
        Ok(n)
    }

    mut fn parseImplements(mut n: Ast.Node) -> Result<Unit, Error> {
        if (this.accept(T.Tk.Colon)) {
            let first: Ast.Node = this.parseType()?
            n.List3.Push(first)
            while (this.accept(T.Tk.Comma)) {
                let more: Ast.Node = this.parseType()?
                n.List3.Push(more)
            }
        }
        Ok(())
    }

    mut fn parseField(isStatic: Bool) -> Result<Ast.Node, Error> {
        let name: T.Token = this.expect(T.Tk.Ident, "a field name")?
        mut f: Ast.Node = newNode(Ast.NK.Field, name.Pos)
        f.SetName(name.Text)
        f.Flag = isStatic
        this.expect(T.Tk.Colon, "`:` and the field's type")?
        let ty: Ast.Node = this.parseType()?
        f.A = Some(ty)
        if (this.accept(T.Tk.Assign)) {
            let v: Ast.Node = this.parseExpr()?
            f.B = Some(v)
        }
        Ok(f)
    }

    // One member of a struct, class, enum or interface body.
    mut fn parseMember(mut decl: Ast.Node, dk: Ast.NK) -> Result<Unit, Error> {
        mut isStatic: Bool = false
        mut isMut: Bool = false
        if (this.kind() == T.Tk.Static) {
            this.next()
            isStatic = true
        } else if (this.kind() == T.Tk.Mut) {
            this.next()
            isMut = true
        }
        if (this.kind() == T.Tk.Fn) {
            mut fnode: Ast.Node = this.parseFn(dk == Ast.NK.DInterface)?
            fnode.IsStatic = isStatic
            fnode.IsMutFn = isMut
            decl.List.Push(fnode)
            return Ok(())
        }
        if (isStatic || isMut) {
            if (isStatic && this.kind() == T.Tk.Ident) {
                let f: Ast.Node = this.parseField(true)?
                decl.List.Push(f)
                return Ok(())
            }
            return Err(this.perr(this.peek().Pos, "expected `fn` after `${if (isStatic) { "static" } else { "mut" }}`"))
        }
        if (dk == Ast.NK.DEnum) {
            let name: T.Token = this.expect(T.Tk.Ident, "a variant name or `fn`")?
            mut v: Ast.Node = newNode(Ast.NK.Variant, name.Pos)
            v.SetName(name.Text)
            if (this.accept(T.Tk.LParen)) {
                this.parseTypeList(v.List, T.Tk.RParen)?
                let t: T.Token = this.expect(T.Tk.RParen, "`)`")?
            } else if (this.kind() == T.Tk.LBrace) {
                this.next()
                v.Flag = true
                this.skipNl()
                while (this.kind() != T.Tk.RBrace) {
                    let f: Ast.Node = this.parseField(false)?
                    v.List2.Push(f)
                    this.skipNl()
                    if (!this.accept(T.Tk.Comma)) {
                        break
                    }
                    this.skipNl()
                }
                this.expect(T.Tk.RBrace, "`}`")?
            }
            decl.List.Push(v)
            return Ok(())
        }
        if (dk == Ast.NK.DInterface) {
            return Err(this.perr(this.peek().Pos, "an interface can only contain methods"))
        }
        let f: Ast.Node = this.parseField(false)?
        decl.List.Push(f)
        Ok(())
    }

    // One member and what must follow it.
    mut fn memberAndEnd(mut n: Ast.Node, dk: Ast.NK) -> Result<Unit, Error> {
        this.parseMember(n, dk)?
        if (this.kind() != T.Tk.Nl && this.kind() != T.Tk.RBrace && this.kind() != T.Tk.Comma) {
            return Err(this.perr(this.peek().Pos, "expected a new line or `}` after the member, found ${this.describe(this.peek())}"))
        }
        Ok(())
    }

    mut fn parseTypeDecl(dk: Ast.NK) -> Result<Ast.Node, Error> {
        let kw: T.Token = this.next()
        mut n: Ast.Node = newNode(dk, kw.Pos)
        let name: T.Token = this.expect(T.Tk.Ident, "a type name")?
        n.SetName(name.Text)
        n.Pos = name.Pos
        this.parseTparams(n.List2)?
        this.parseImplements(n)?
        this.expect(T.Tk.LBrace, "`{` and the body of the type")?
        this.skipNl()
        while (this.kind() != T.Tk.RBrace) {
            if (this.kind() == T.Tk.Eof) {
                return Err(this.perr(kw.Pos, "this `{` is never closed"))
            }
            match (this.memberAndEnd(n, dk)) {
                Ok(_) => {},
                Err(e) => {
                    if (this.quiet) {
                        return Err(e)
                    }
                    this.syncStmt()
                },
            }
            while (this.kind() == T.Tk.Nl || this.kind() == T.Tk.Comma) {
                this.next()
            }
        }
        this.next()
        Ok(n)
    }

    mut fn parseExtern() -> Result<Ast.Node, Error> {
        let kw: T.Token = this.next()
        mut n: Ast.Node = newNode(Ast.NK.DExtern, kw.Pos)
        let abi: T.Token = this.expect(T.Tk.Str, "the ABI string (`\"C\"`)")?
        n.SetName(if (abi.Parts.IsEmpty()) { "" } else { abi.Parts[0].Text })
        if (this.kind() != T.Tk.LBrace) {
            return Err(this.perr(this.peek().Pos, "expected `{` after `extern \"C\"`"))
        }
        this.next()
        this.skipNl()
        while (this.kind() != T.Tk.RBrace) {
            if (this.kind() == T.Tk.Fn) {
                let f: Ast.Node = this.parseFn(true)?
                n.List.Push(f)
            } else if (this.kind() == T.Tk.Struct) {
                let s: Ast.Node = this.parseTypeDecl(Ast.NK.DStruct)?
                n.List.Push(s)
            } else {
                return Err(this.perr(this.peek().Pos, "an `extern` block can contain only `fn` and `struct` declarations"))
            }
            this.skipNl()
        }
        this.next()
        Ok(n)
    }

    mut fn parseDecl() -> Result<Ast.Node, Error> {
        let t: T.Token = this.peek()
        match (t.Kind) {
            T.Tk.Fn => this.parseFn(false),
            T.Tk.Struct => this.parseTypeDecl(Ast.NK.DStruct),
            T.Tk.Class => this.parseTypeDecl(Ast.NK.DClass),
            T.Tk.Enum => this.parseTypeDecl(Ast.NK.DEnum),
            T.Tk.Interface => this.parseTypeDecl(Ast.NK.DInterface),
            T.Tk.Extern => this.parseExtern(),
            T.Tk.Export => {
                this.next()
                let abi: T.Token = this.expect(T.Tk.Str, "the ABI string (`\"C\"`)")?
                mut f: Ast.Node = this.parseFn(false)?
                f.IsExport = true
                f.Name2 = if (abi.Parts.IsEmpty()) { "C" } else { abi.Parts[0].Text }
                Ok(f)
            },
            T.Tk.Let => {
                this.next()
                mut n: Ast.Node = newNode(Ast.NK.DConst, t.Pos)
                let name: T.Token = this.expect(T.Tk.Ident, "a constant name")?
                n.SetName(name.Text)
                n.Pos = name.Pos
                this.expect(T.Tk.Colon, "`:` and the constant's type")?
                let ty: Ast.Node = this.parseType()?
                n.A = Some(ty)
                this.expect(T.Tk.Assign, "`=` and the value")?
                let v: Ast.Node = this.parseExpr()?
                n.B = Some(v)
                Ok(n)
            },
            T.Tk.Mut => Err(this.perr(t.Pos, "`mut` is not allowed at the top level (global mutable state is not supported)")),
            T.Tk.Ident => {
                if (t.Text == "test" && this.peekAt(1).Kind == T.Tk.Str) {
                    this.next()
                    let s: T.Token = this.next()
                    mut n: Ast.Node = newNode(Ast.NK.DTest, t.Pos)
                    n.SetName(if (s.Parts.IsEmpty()) { "" } else { s.Parts[0].Text })
                    let b: Ast.Node = this.parseBlock()?
                    n.B = Some(b)
                    return Ok(n)
                }
                Err(this.perr(t.Pos, "unexpected ${this.describe(t)} at the top level (expected `fn`, `struct`, `class`, `enum`, `interface`, `extern`, `let` or `test`)"))
            },
            _ => Err(this.perr(t.Pos, "unexpected ${this.describe(t)} at the top level (expected `fn`, `struct`, `class`, `enum`, `interface`, `extern`, `let` or `test`)")),
        }
    }

    // ---- module header ----

    mut fn parseDotted(mut path: Array<String>, what: String) -> Result<Unit, Error> {
        path.Push(this.expectIdent(what)?)
        while (this.kind() == T.Tk.Dot) {
            this.next()
            path.Push(this.expectIdent(what)?)
        }
        Ok(())
    }

    // The `module` line and the imports. An error here ends the file (nothing sensible can follow).
    mut fn parseHeader(mut sf: Ast.SourceFile) -> Result<Unit, Error> {
        if (this.kind() != T.Tk.Module) {
            return Err(this.perr(this.peek().Pos, "a Zevic file must start with `module Name`"))
        }
        sf.Pos = this.next().Pos
        sf.ModulePos = this.peek().Pos
        mut path: Array<String> = []
        this.parseDotted(path, "a module name")?
        sf.Module = Ast.PathJoin(path, ".")
        sf.HasModule = true
        this.skipNl()
        while (this.kind() == T.Tk.Import) {
            mut im: Ast.Node = newNode(Ast.NK.Import, this.next().Pos)
            this.parseDotted(im.Path, "a module name")?
            if (this.accept(T.Tk.As)) {
                im.SetName(this.expectIdent("an alias name")?)
            }
            sf.Imports.Push(im)
            this.skipNl()
        }
        Ok(())
    }

    // Skips to the next top-level declaration keyword after an error.
    mut fn syncDecl() {
        mut depth: I64 = 0
        while (this.kind() != T.Tk.Eof) {
            let k: T.Tk = this.kind()
            if (k == T.Tk.LBrace) {
                depth += 1
            } else if (k == T.Tk.RBrace) {
                if (depth > 0) {
                    depth -= 1
                }
            } else if (depth == 0 && (k == T.Tk.Fn || k == T.Tk.Struct || k == T.Tk.Class || k == T.Tk.Enum || k == T.Tk.Interface || k == T.Tk.Extern || k == T.Tk.Export)) {
                break
            }
            this.next()
        }
    }

    mut fn ParseFile() -> Ast.SourceFile {
        mut sf: Ast.SourceFile = Ast.SourceFile.New(this.file)
        this.skipNl()
        match (this.parseHeader(sf)) {
            Ok(_) => {},
            Err(_) => return sf,
        }
        while (this.kind() != T.Tk.Eof) {
            match (this.parseDecl()) {
                Ok(d) => sf.Decls.Push(d),
                Err(_) => this.syncDecl(),
            }
            this.skipNl()
        }
        sf.UsesAsync = this.UsesAsync
        sf
    }
}

// Parses one source file. Errors go to `diag`; the result is never missing but may be incomplete.
fn ParseFile(mut diag: Diag.Diag, file: I32, text: String) -> Ast.SourceFile {
    let toks: Array<T.Token> = Lexer.Lex(diag, file, text, 1, 1)
    mut p: Parser = Parser.New(diag, file, toks)
    p.ParseFile()
}
