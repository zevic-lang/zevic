module Zevic1.Ctx

// The function context and IR emission: a port of the "Function context and IR emission" part of zevic0/gen.c.

import Zevic.Text
import Zevic1.Ast as Ast
import Zevic1.Gen as Gen
import Zevic1.Resolve as Resolve
import Zevic1.Token as Token
import Zevic1.Types as Types

// A value and its LLVM operand ("%t3", "42", "{ ptr @.str.0, i64 5 }", "zeroinitializer").
class Val {
    T: Types.Type
    V: String

    fn Init(t: Types.Type, v: String) {
        this.T = t
        this.V = v
    }
}

class Local {
    Name: String
    T: Types.Type
    Mut: Bool
    // the address of the value
    Ptr: String
    Pos: Token.Pos

    fn Init(name: String, t: Types.Type, isMut: Bool, ptr: String, pos: Token.Pos) {
        this.Name = name
        this.T = t
        this.Mut = isMut
        this.Ptr = ptr
        this.Pos = pos
    }
}

class Scope {
    Up: Option<Scope> = None
    Locals: Array<Local> = []
    Defers: Array<Ast.Node> = []
}

class Loop {
    Brk: String
    Cont: String
    Scope: Scope
    // some `break` jumps to `brk`
    BrkUsed: Bool = false
    // `name@ for ...`
    Label: Option<String> = None

    fn Init(brk: String, cont: String, scope: Scope) {
        this.Brk = brk
        this.Cont = cont
        this.Scope = scope
    }
}

// Where a value lives, and whether it may be changed through this path.
class Place {
    // the address of the value
    Ptr: String
    T: Types.Type
    Mut: Bool

    fn Init(ptr: String, t: Types.Type, isMut: Bool) {
        this.Ptr = ptr
        this.T = t
        this.Mut = isMut
    }
}

// Pieces of text that are joined at the end (cheaper than growing one string).
class Sb {
    Parts: Array<String> = []

    mut fn Put(s: String) {
        this.Parts.Push(s)
    }

    fn String() -> String { this.Parts.Join("") }
}

class FnCtx {
    G: Gen.Gen
    Inst: Gen.Inst
    File: Resolve.FileInfo
    Env: Gen.Env
    Code: Sb = Sb.New()
    Allocas: Sb = Sb.New()
    Cold: Sb = Sb.New()
    NTmp: I64 = 0
    NLbl: I64 = 0
    NSlot: I64 = 0
    // `xs[i].F = v` on a struct element: the element expression whose copy must be stored back, and the local that holds that copy
    WbElem: Option<Ast.Node> = None
    WbName: String = ""
    Cur: String = ""
    Term: Bool = false
    Ret: Types.Type
    Scope: Option<Scope> = None
    Loops: Array<Loop> = []
    // inside a method
    HasThis: Bool = false
    // address of the `this` value (a slot holding the pointer, for classes)
    ThisSlot: String = ""
    ThisT: Option<Types.Type> = None
    // may `this` be changed? (mut fn and Init)
    ThisMut: Bool = false
    // names of variables that a lambda may capture: they live in heap cells
    Heap: Map<String, Bool> = Map.New()

    fn Init(g: Gen.Gen, inst: Gen.Inst, file: Resolve.FileInfo, ret: Types.Type) {
        this.G = g
        this.Inst = inst
        this.File = file
        this.Env = inst.Env
        this.Ret = ret
    }

    mut fn Tmp() -> String {
        let s: String = "%t${this.NTmp}"
        this.NTmp += 1
        s
    }

    mut fn NewLabel(hint: String) -> String {
        let s: String = "${hint}.${this.NLbl}"
        this.NLbl += 1
        s
    }

    mut fn StartBlock(label: String) {
        this.Code.Put("${label}:\n")
        this.Cur = label
        this.Term = false
    }

    // One instruction. Unreachable code gets its own block.
    mut fn Emit(line: String) {
        if (this.Term) {
            let l: String = this.NewLabel("dead")
            this.StartBlock(l)
        }
        this.Code.Put("  ${line}\n")
    }

    // Terminates the current block with a branch and starts `label`.
    mut fn GotoBlock(label: String) {
        if (!this.Term) {
            this.Code.Put("  br label %${label}\n")
            this.Term = true
        }
        this.StartBlock(label)
    }

    mut fn Br(label: String) {
        this.Emit("br label %${label}")
        this.Term = true
    }

    mut fn CondBr(cond: String, t: String, f: String) {
        this.Emit("br i1 ${cond}, label %${t}, label %${f}")
        this.Term = true
    }

    mut fn NewSlot(t: Types.Type) -> String {
        let name: String = "%s${this.NSlot}"
        this.NSlot += 1
        mut tt: Types.TypeTable = this.G.Tt
        let al: I64 = tt.AlignOf(t)
        this.Allocas.Put("  ${name} = alloca ${tt.LlOf(t)}, align ${if (al < 1) { 1 } else { al }}\n")
        name
    }

    mut fn LlOf(t: Types.Type) -> String {
        mut tt: Types.TypeTable = this.G.Tt
        tt.LlOf(t)
    }

    fn UnitVal() -> Val { Val.New(this.G.Tt.Unit, "zeroinitializer") }

    fn ErrVal() -> Val { Val.New(this.G.Err, "undef") }

    // The value of an expression that never completes, typed as `want`.
    fn NeverVal(want: Option<Types.Type>) -> Val {
        match (want) {
            Some(w) => Val.New(w, "undef"),
            None => Val.New(this.G.Tt.Never, "undef"),
        }
    }

    // ---- scopes ----

    mut fn PushScope() {
        mut s: Scope = Scope.New()
        s.Up = this.Scope
        this.Scope = Some(s)
    }

    fn FindLocal(name: String) -> Option<Local> {
        mut cur: Option<Scope> = this.Scope
        loop {
            match (cur) {
                Some(s) => {
                    mut i: I64 = s.Locals.Len() - 1
                    while (i >= 0) {
                        if (s.Locals[i].Name == name) {
                            return Some(s.Locals[i])
                        }
                        i -= 1
                    }
                    cur = s.Up
                },
                None => return None,
            }
        }
    }

    mut fn TypeError(pos: Token.Pos, want: Types.Type, got: Types.Type, what: String) {
        if (this.G.IsErr(want) || this.G.IsErr(got)) {
            return
        }
        mut g: Gen.Gen = this.G
        let w: String = if (what != "") { " in ${what}" } else { "" }
        g.Diag.Error(pos, "type mismatch${w}: expected `${want.Name}`, found `${got.Name}`")
    }

    mut fn LoadLocal(l: Local) -> Val {
        if (l.T.Id == this.G.Tt.Unit.Id) {
            return this.UnitVal()
        }
        let t: String = this.Tmp()
        this.Emit("${t} = load ${this.LlOf(l.T)}, ptr ${l.Ptr}")
        Val.New(l.T, t)
    }

    mut fn StoreTo(t: Types.Type, v: Val, ptr: String) {
        this.Emit("store ${this.LlOf(t)} ${v.V}, ptr ${ptr}")
    }

    // Binds a name to an existing cell (a captured variable inside a lambda).
    mut fn BindLocalPtr(name: String, t: Types.Type, isMut: Bool, ptr: String, pos: Token.Pos) -> Local {
        let l: Local = Local.New(name, t, isMut, ptr, pos)
        match (this.Scope) {
            Some(s) => {
                mut sc: Scope = s
                sc.Locals.Push(l)
            },
            None => {},
        }
        l
    }
}
