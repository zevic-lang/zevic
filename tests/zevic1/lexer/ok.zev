    let d: F64 = 1.5e3 + 2E-2 + 3.0_F32.ToF64()
    let e: String = r"raw \n ${no}"
    let f: String = "tab\t nl\n quote\" dollar\$ \u{1F600} \x41 ${a[0][1]} ${"nested ${1}"}"
    let g: Byte = b'\n'
    let h: Char = '\u{e9}'
    let i: String = """
        multi
          line ${c}
        """
