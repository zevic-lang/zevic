module Main

import Zevic.Console
import Zevic.Test

fn Add(a: I32, b: I32) -> I32 { a + b }

fn Main() {
    Console.Println("main ${Add(1, 2)}")
}

test "Add adds two numbers" {
    Test.Equal(Add(1, 2), 3)
}

test "Add overflows" {
    Test.Panics(() => { Add(2147483647, 1); })
}

test "wrong sum" {
    Test.Equal(Add(1, 1), 3)
}

test "plain panic" {
    let xs: Array<I32> = [1]
    Console.Println("before ${xs[5]}")
}

test "options and results" {
    Test.Some(Some(1))
    let n: Option<I32> = None
    Test.None(n)
    let r: Result<I32, String> = Ok(1)
    Test.Ok(r)
    Test.True(1 < 2)
    Test.NotEqual("a", "b")
}

test "panics expected but not" {
    Test.Panics(() => { Add(1, 2); })
}
