module Main

import Zevic.Console

extern "C" {
    fn puts(s: CString) -> CInt
    fn abs(n: CInt) -> CInt
    fn strlen(s: CString) -> CSizeT
    fn labs(n: CLongLong) -> CLongLong
    fn sqrt(x: CDouble) -> CDouble
}

fn Main() {
    let r: CInt = puts("hello from C".ToC())
    // the C standard only says puts returns a non-negative number on success (glibc: the length, macOS: 10)
    Console.Println("puts ok = ${r.ToI32() >= 0}")
    Console.Println("abs = ${abs((-5).ToCInt()).ToI32()}")
    Console.Println("strlen = ${strlen("héllo".ToC()).ToU64()}")
    let big: I64 = -9000000000
    Console.Println("labs = ${labs(big.ToCLongLong()).ToI64()}")
    Console.Println("sqrt = ${sqrt(2.25.ToCDouble()).ToF64()}")
    let wide: I64 = 5000000000
    Console.Println("wrapped = ${wide.ToCIntWrap().ToI32()}")
    match (wide.ToCInt()) {
        Ok(v) => Console.Println("fits ${v.ToI32()}"),
        Err(e) => Console.Println("does not fit"),
    }
}
