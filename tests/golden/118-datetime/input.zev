module Main

import Zevic.Console
import Zevic.DateTime
import Zevic.Time

fn Main() {
    let t: DateTime.DateTime = DateTime.Make(2026, 11, 8, 18, 3, 9).Unwrap()
    Console.Println("${t.ToIso()} ${t.ToUnixSeconds()} ${t.Weekday()} ${t.WeekdayName()} ${t.DayOfYear()} ${t.MonthName()}")
    let jst: DateTime.DateTime = t.InOffset(9 * 3600)
    Console.Println("${jst.ToIso()} ${jst.Day()} ${jst.Hour()} ${jst.SameInstant(t)} ${jst == t} ${jst.ToUtc() == t}")
    Console.Println(DateTime.FromUnixSeconds(0).ToIso())
    Console.Println(DateTime.FromUnixSeconds(-1).ToIso())
    Console.Println(DateTime.FromUnixSeconds(951782400).ToIso())
    Console.Println(DateTime.FromUnixMillis(1700000000123).ToIso())
    Console.Println(DateTime.FromUnixMillis(-1).ToIso())
    Console.Println(DateTime.FromUnixNanos(1700000000123456789).ToIso())
    Console.Println(DateTime.FromUnixNanos(1700000000123456000).ToIso())
    Console.Println(t.InOffset(-(5 * 3600 + 1800)).ToIso())
    Console.Println("${DateTime.IsLeapYear(2000)} ${DateTime.IsLeapYear(1900)} ${DateTime.IsLeapYear(2024)} ${DateTime.DaysInMonth(2023, 2)} ${DateTime.DaysInMonth(2024, 2)} ${DateTime.DaysInMonth(2024, 4)}")
    Console.Println("${DateTime.Make(2023, 2, 29, 0, 0, 0).IsErr()} ${DateTime.Make(2023, 13, 1, 0, 0, 0).IsErr()} ${DateTime.Make(2023, 1, 1, 24, 0, 0).IsErr()} ${DateTime.Date(2024, 2, 29).IsOk()}")
    Console.Println(t.AddDays(30).ToIso())
    Console.Println(t.AddHours(-19).ToIso())
    Console.Println(t.AddMonths(3).ToIso())
    Console.Println(DateTime.Date(2024, 1, 31).Unwrap().AddMonths(1).ToIso())
    Console.Println(DateTime.Date(2024, 3, 31).Unwrap().AddMonths(-1).ToIso())
    Console.Println(DateTime.Date(2024, 2, 29).Unwrap().AddYears(1).ToIso())
    Console.Println(t.AddMonths(-11).ToIso())
    Console.Println(t.AddMillis(1500).ToIso())
    Console.Println(t.AddDuration(Time.Duration.FromSeconds(3600)).ToIso())
    let d: Time.Duration = t.AddDays(2).Sub(t)
    Console.Println("${d.Seconds()} ${t.Sub(t.AddDays(1)).Millis()}")
    Console.Println(t.StartOfDay().ToIso())
    Console.Println("${t.Before(jst.AddHours(1))} ${t.After(t.AddSeconds(-1))} ${t.Compare(t)} ${t.Compare(t.AddSeconds(5))}")
    Console.Println(t.Format("%Y/%m/%d %H:%M:%S %p %I %a %A %b %B %j %u %e|%y|%z|%:z|%Z|%s|%F|%T|%%|%q"))
    Console.Println(jst.Format("%a, %d %b %Y %H:%M:%S %z (%Z) 世界"))
    Console.Println(t.WithNano(123456789).Format("%L %f %N"))
    Console.Println(DateTime.Parse("2026-11-08").Unwrap().ToIso())
    Console.Println(DateTime.Parse("2026-11-08T18:03").Unwrap().ToIso())
    Console.Println(DateTime.Parse("2026-11-08 18:03:09Z").Unwrap().ToIso())
    Console.Println(DateTime.Parse("2026-11-08T18:03:09.25+09:00").Unwrap().ToIso())
    Console.Println(DateTime.Parse("2026-11-08T18:03:09.123456-0530").Unwrap().ToIso())
    Console.Println(DateTime.Parse("2026-11-08T18:03:09.1234567891+01").Unwrap().ToIso())
    Console.Println("${DateTime.Parse("2026-11-09T03:03:09+09:00").Unwrap() == jst} ${DateTime.Parse("2026-11-08T18:03:09Z").Unwrap() == jst}")
    Console.Println("${DateTime.Parse("2026-13-08").IsErr()} ${DateTime.Parse("2026-11-08T25:00").IsErr()} ${DateTime.Parse("2026/11/08").IsErr()} ${DateTime.Parse("2026-11-08T18:03:09x").IsErr()} ${DateTime.Parse("").IsErr()} ${DateTime.Parse("2026-11-08T18:03:09+9").IsErr()}")
    let rt: DateTime.DateTime = DateTime.Parse(t.ToIso()).Unwrap()
    Console.Println("${rt == t}")
    Console.Println(DateTime.ParseFormat("08/11/2026 18:03", "%d/%m/%Y %H:%M").Unwrap().ToIso())
    Console.Println(DateTime.ParseFormat("2026-11-08 6:3:9 +0900", "%Y-%m-%d %H:%M:%S %z").Unwrap().ToIso())
    Console.Println("${DateTime.ParseFormat("2026-11-08", "%Y/%m/%d").IsErr()} ${DateTime.ParseFormat("2026-11-08 extra", "%Y-%m-%d").IsErr()} ${DateTime.ParseFormat("2026", "%Q").IsErr()}")
    Console.Println(DateTime.Make(-44, 3, 15, 12, 0, 0).Unwrap().ToIso())
    Console.Println(DateTime.Make(9999, 12, 31, 23, 59, 59).Unwrap().AddSeconds(1).ToIso())
    let now: DateTime.DateTime = DateTime.NowUtc()
    let local: DateTime.DateTime = DateTime.NowLocal()
    Console.Println("${now.Year() >= 2026} ${local.SameInstant(now.AddSeconds(0)) || local.Sub(now).Seconds() < 2.0} ${local.Offset() > -86400 && local.Offset() < 86400}")
}
