module Main

import Zevic.Unsafe

unsafe fn Danger(p: *I64) -> I64 {
    p.Read(0)
}

struct Holder {
    P: *I64

    fn Init(p: *I64) {
        this.P = p
    }

    unsafe fn Peek() -> I64 { this.P.Read(0) }
}

fn Main() {
    let p: *I64 = unsafe { Unsafe.Alloc<I64>(1) }
    // called outside unsafe
    Danger(p)
    let h: Holder = Holder.New(p)
    h.Peek()
    // as a value
    let f: fn(*I64) -> I64 = Danger
    // a lambda inside unsafe is not unsafe itself
    unsafe {
        let g: fn() -> I64 = () => Danger(p)
    }
}
