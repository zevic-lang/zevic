module Zevic.Core

import Zevic.Convert
import Zevic.Intrinsics

// Core types of the prelude: Option, Result, Error, ErrorKind and Array.
// They are ordinary Zevic code: `Option` and `Result` are enums, `Error` and `Array` are classes.

// ---- standard interfaces ----
// `Equatable`, `Hashable` and `Comparable` use `Self`, so they work as constraints (`<K: Hashable>`).
// The built-in types satisfy them without writing anything.

interface Equatable {
    fn Equals(other: Self) -> Bool
}

interface Hashable : Equatable {
    fn Hash() -> U64
}

interface Comparable : Equatable {
    fn Compare(other: Self) -> I32
}

interface Iterator<T> {
    mut fn Next() -> Option<T>
}

interface Iterable<T> {
    fn Iter() -> Iterator<T>

    fn ToArray() -> Array<T> {
        mut out: Array<T> = []
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => out.Push(v),
                None => break,
            }
        }
        out
    }

    fn Each(f: fn(T) -> Unit) {
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => f(v),
                None => break,
            }
        }
    }

    fn EachIndexed(f: fn(I64, T) -> Unit) {
        mut it: Iterator<T> = this.Iter()
        mut i: I64 = 0
        loop {
            match (it.Next()) {
                Some(v) => {
                    f(i, v)
                    i += 1
                },
                None => break,
            }
        }
    }

    fn Map<U>(f: fn(T) -> U) -> Array<U> {
        mut out: Array<U> = []
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => out.Push(f(v)),
                None => break,
            }
        }
        out
    }

    fn Filter(f: fn(T) -> Bool) -> Array<T> {
        mut out: Array<T> = []
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => {
                    if (f(v)) { out.Push(v) }
                },
                None => break,
            }
        }
        out
    }

    fn Reduce<U>(init: U, f: fn(U, T) -> U) -> U {
        mut acc: U = init
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => { acc = f(acc, v) },
                None => break,
            }
        }
        acc
    }

    fn Find(f: fn(T) -> Bool) -> Option<T> {
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => {
                    if (f(v)) { return Some(v) }
                },
                None => break,
            }
        }
        None
    }

    fn Any(f: fn(T) -> Bool) -> Bool {
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => {
                    if (f(v)) { return true }
                },
                None => break,
            }
        }
        false
    }

    fn All(f: fn(T) -> Bool) -> Bool {
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => {
                    if (!f(v)) { return false }
                },
                None => break,
            }
        }
        true
    }

    fn Count(f: fn(T) -> Bool) -> I64 {
        mut n: I64 = 0
        mut it: Iterator<T> = this.Iter()
        loop {
            match (it.Next()) {
                Some(v) => {
                    if (f(v)) { n += 1 }
                },
                None => break,
            }
        }
        n
    }
}

enum Option<T> {
    Some(T),
    None,

    fn IsSome() -> Bool {
        match (this) {
            Some(_) => true,
            None => false,
        }
    }

    fn IsNone() -> Bool {
        match (this) {
            Some(_) => false,
            None => true,
        }
    }

    fn Unwrap() -> T {
        match (this) {
            Some(v) => v,
            None => Panic("called Unwrap on a None value"),
        }
    }

    fn UnwrapOr(d: T) -> T {
        match (this) {
            Some(v) => v,
            None => d,
        }
    }

    fn OkOr(e: Error) -> Result<T, Error> {
        match (this) {
            Some(v) => Ok(v),
            None => Err(e),
        }
    }
}

enum Result<T, E> {
    Ok(T),
    Err(E),

    fn IsOk() -> Bool {
        match (this) {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    fn IsErr() -> Bool {
        match (this) {
            Ok(_) => false,
            Err(_) => true,
        }
    }

    fn Unwrap() -> T {
        match (this) {
            Ok(v) => v,
            Err(_) => Panic("called Unwrap on an Err value"),
        }
    }

    fn UnwrapOr(d: T) -> T {
        match (this) {
            Ok(v) => v,
            Err(_) => d,
        }
    }

    // Wrap the error in a new one that says what was being done; the old one stays as the cause.
    fn Context(msg: String) -> Result<T, Error> {
        match (this) {
            Ok(v) => Ok(v),
            Err(e) => Err(Error.Wrap(msg, e)),
        }
    }
}

enum ErrorKind {
    NotFound,
    Invalid,
    InvalidFormat,
    OutOfRange,
    Permission,
    Io,
    Parse,
    Timeout,
    Other,

    fn ToString() -> String {
        match (this) {
            ErrorKind.NotFound => "NotFound",
            ErrorKind.Invalid => "Invalid",
            ErrorKind.InvalidFormat => "InvalidFormat",
            ErrorKind.OutOfRange => "OutOfRange",
            ErrorKind.Permission => "Permission",
            ErrorKind.Io => "Io",
            ErrorKind.Parse => "Parse",
            ErrorKind.Timeout => "Timeout",
            ErrorKind.Other => "Other",
        }
    }
}

class Error {
    kind: ErrorKind
    message: String
    cause: Option<Error>

    fn Init(kind: ErrorKind, message: String) {
        this.kind = kind
        this.message = message
        this.cause = None
    }

    static fn Wrap(message: String, cause: Error) -> Error {
        mut e: Error = Error.New(cause.kind, message)
        e.cause = Some(cause)
        e
    }

    fn Kind() -> ErrorKind { this.kind }
    fn Message() -> String { this.message }
    fn Cause() -> Option<Error> { this.cause }

    fn ToString() -> String {
        let head: String = this.kind.ToString() + ": " + this.message
        match (this.cause) {
            Some(c) => head + "\ncaused by: " + c.ToString(),
            None => head,
        }
    }
}

// A growable array. It sits on `Intrinsics.Buf<T>`, a fixed-size block of memory.
//
// The compiler turns the syntax into calls of this class:
//   a[i]            ->  a.Index(i)
//   a[i] = v        ->  a.SetIndex(i, v)
//   for (x in a)    ->  a loop over Len() and Index(i)
//   [1, 2, 3]       ->  builds the object directly, so the fields `buf`, `len` and `cap` below
//                       must keep their names and order.
// The iterator of an Array: Array implements Iterable<T> through it.
class ArrayIter<T> : Iterator<T> {
    arr: Array<T>
    i: I64 = 0

    fn Init(arr: Array<T>) { this.arr = arr }

    mut fn Next() -> Option<T> {
        if (this.i >= this.arr.Len()) {
            return None
        }
        let v: T = this.arr.Index(this.i)
        this.i += 1
        Some(v)
    }
}

class Array<T> : Iterable<T> {
    buf: Intrinsics.Buf<T> = Intrinsics.Buf.New(0)
    len: I64 = 0
    cap: I64 = 0

    fn Len() -> I64 { this.len }

    fn IsEmpty() -> Bool { this.len == 0 }

    fn Iter() -> Iterator<T> { ArrayIter<T>.New(this) }

    // The address of the first element, for C. Valid only until the array grows.
    fn Ptr() -> *T { this.buf.Ptr() }

    fn Index(i: I64) -> T {
        if (i < 0 || i >= this.len) {
            Panic("index ${i} is out of range (length ${this.len})")
        }
        this.buf.Get(i)
    }

    mut fn SetIndex(i: I64, v: T) {
        if (i < 0 || i >= this.len) {
            Panic("index ${i} is out of range (length ${this.len})")
        }
        this.buf.Set(i, v)
    }

    fn Get(i: I64) -> Option<T> {
        if (i < 0 || i >= this.len) {
            None
        } else {
            Some(this.buf.Get(i))
        }
    }

    fn First() -> Option<T> { this.Get(0) }

    fn Last() -> Option<T> { this.Get(this.len - 1) }

    // Make room for at least `need` elements (doubling, so Push is cheap on average).
    mut fn grow(need: I64) {
        if (need <= this.cap) {
            return
        }
        mut nc: I64 = if (this.cap < 4) { 4 } else { this.cap * 2 }
        while (nc < need) {
            nc *= 2
        }
        let nb: Intrinsics.Buf<T> = Intrinsics.Buf.New(nc)
        nb.Copy(this.buf, 0, 0, this.len)
        this.buf = nb
        this.cap = nc
    }

    // Append `n` elements of `src`, starting at `from`.
    mut fn appendRange(src: Array<T>, from: I64, n: I64) {
        this.grow(this.len + n)
        this.buf.Copy(src.buf, from, this.len, n)
        this.len += n
    }

    mut fn Push(x: T) {
        this.grow(this.len + 1)
        this.buf.Set(this.len, x)
        this.len += 1
    }

    mut fn Pop() -> Option<T> {
        if (this.len == 0) {
            return None
        }
        this.len -= 1
        Some(this.buf.Get(this.len))
    }

    mut fn Insert(i: I64, x: T) {
        if (i < 0 || i > this.len) {
            Panic("insert position ${i} is out of range (length ${this.len})")
        }
        this.grow(this.len + 1)
        this.buf.Copy(this.buf, i, i + 1, this.len - i)
        this.buf.Set(i, x)
        this.len += 1
    }

    mut fn RemoveAt(i: I64) -> T {
        if (i < 0 || i >= this.len) {
            Panic("index ${i} is out of range (length ${this.len})")
        }
        let v: T = this.buf.Get(i)
        this.buf.Copy(this.buf, i + 1, i, this.len - i - 1)
        this.len -= 1
        v
    }

    // Empty the array and let go of the old storage.
    mut fn Clear() {
        this.buf = Intrinsics.Buf.New(0)
        this.len = 0
        this.cap = 0
    }

    mut fn Reverse() {
        mut i: I64 = 0
        mut j: I64 = this.len - 1
        while (i < j) {
            let t: T = this.buf.Get(i)
            this.buf.Set(i, this.buf.Get(j))
            this.buf.Set(j, t)
            i += 1
            j -= 1
        }
    }

    mut fn Extend(other: Array<T>) {
        this.appendRange(other, 0, other.len)
    }

    // For an `Array<String>`: the elements with `sep` between them.
    fn Join(sep: String) -> String {
        mut out: String = ""
        mut i: I64 = 0
        while (i < this.len) {
            if (i > 0) {
                out = out + sep
            }
            out = out + this.buf.Get(i)
            i += 1
        }
        out
    }

    // Sorts the array in place. The sort is stable. `T` must be `Comparable`.
    mut fn Sort() {
        this.SortBy((a: T, b: T) => a.Compare(b))
    }

    // Sorts in place with `cmp`, which gives a negative, zero or positive number like `Compare`.
    // Equal elements keep their order (a merge sort).
    mut fn SortBy(cmp: fn(T, T) -> I32) {
        let n: I64 = this.len
        if (n < 2) {
            return
        }
        mut from: Intrinsics.Buf<T> = this.buf
        mut into: Intrinsics.Buf<T> = Intrinsics.Buf.New(n)
        mut flipped: Bool = false
        mut width: I64 = 1
        while (width < n) {
            mut lo: I64 = 0
            while (lo < n) {
                mut mid: I64 = lo + width
                if (mid > n) { mid = n }
                mut hi: I64 = lo + 2 * width
                if (hi > n) { hi = n }
                mut i: I64 = lo
                mut j: I64 = mid
                mut k: I64 = lo
                while (i < mid && j < hi) {
                    if (cmp(from.Get(j), from.Get(i)) < 0) {
                        into.Set(k, from.Get(j))
                        j += 1
                    } else {
                        into.Set(k, from.Get(i))
                        i += 1
                    }
                    k += 1
                }
                while (i < mid) {
                    into.Set(k, from.Get(i))
                    i += 1
                    k += 1
                }
                while (j < hi) {
                    into.Set(k, from.Get(j))
                    j += 1
                    k += 1
                }
                lo += 2 * width
            }
            let t: Intrinsics.Buf<T> = from
            from = into
            into = t
            flipped = !flipped
            width *= 2
        }
        if (flipped) {
            this.buf.Copy(from, 0, 0, n)
        }
    }

    fn Slice(from: I64, to: I64) -> Array<T> {
        if (from < 0 || to > this.len || from > to) {
            Panic("slice ${from}..${to} is out of range (length ${this.len})")
        }
        mut r: Array<T> = Array.New()
        r.appendRange(this, from, to - from)
        r
    }

    // Element by element: `a == b` calls this.
    fn Equals(other: Array<T>) -> Bool {
        if (this.len != other.len) {
            return false
        }
        mut i: I64 = 0
        while (i < this.len) {
            if (this.buf.Get(i) != other.buf.Get(i)) {
                return false
            }
            i += 1
        }
        true
    }

    fn Concat(other: Array<T>) -> Array<T> {
        mut r: Array<T> = Array.New()
        r.appendRange(this, 0, this.len)
        r.appendRange(other, 0, other.len)
        r
    }
}

// ---- Map and Set ----
// An insertion-ordered hash table. `keys`, `vals` and `alive` hold the entries in the order they were added;
// `idx` is an open-addressing table of entry numbers (-1 empty, -2 deleted). Removing marks an entry dead,
// and the entries are compacted the next time the table is rebuilt.

class Map<K: Hashable, V> : Iterable<(K, V)> {
    keys: Array<K> = []
    vals: Array<V> = []
    alive: Array<Bool> = []
    idx: Array<I64> = []
    count: I64 = 0
    version: I64 = 0

    fn Len() -> I64 { this.count }

    fn IsEmpty() -> Bool { this.count == 0 }

    // The position in `idx` that holds key `k`, or -1.
    fn slotOf(k: K) -> I64 {
        let size: I64 = this.idx.Len()
        if (size == 0) {
            return -1
        }
        let mask: I64 = size - 1
        mut pos: I64 = k.Hash().ToI64Wrap() & mask
        loop {
            let e: I64 = this.idx[pos]
            if (e == -1) {
                return -1
            }
            if (e >= 0) {
                let key: K = this.keys[e]
                if (key.Equals(k)) {
                    return pos
                }
            }
            pos = (pos + 1) & mask
        }
    }

    // Record that entry `e` (with key `k`) lives in `idx`.
    mut fn place(k: K, e: I64) {
        let mask: I64 = this.idx.Len() - 1
        mut pos: I64 = k.Hash().ToI64Wrap() & mask
        while (this.idx[pos] >= 0) {
            pos = (pos + 1) & mask
        }
        this.idx[pos] = e
    }

    // Drop dead entries and build an index with at least `slots` positions.
    mut fn rebuild(slots: I64) {
        mut nk: Array<K> = []
        mut nv: Array<V> = []
        mut na: Array<Bool> = []
        mut i: I64 = 0
        while (i < this.keys.Len()) {
            if (this.alive[i]) {
                nk.Push(this.keys[i])
                nv.Push(this.vals[i])
                na.Push(true)
            }
            i += 1
        }
        mut size: I64 = 8
        while (size < slots) {
            size = size * 2
        }
        mut table: Array<I64> = []
        i = 0
        while (i < size) {
            table.Push(-1)
            i += 1
        }
        this.keys = nk
        this.vals = nv
        this.alive = na
        this.idx = table
        i = 0
        while (i < nk.Len()) {
            this.place(nk[i], i)
            i += 1
        }
    }

    fn Get(k: K) -> Option<V> {
        let s: I64 = this.slotOf(k)
        if (s < 0) {
            return None
        }
        let e: I64 = this.idx[s]
        Some(this.vals[e])
    }

    fn Contains(k: K) -> Bool {
        this.slotOf(k) >= 0
    }

    fn Index(k: K) -> V {
        let s: I64 = this.slotOf(k)
        if (s < 0) {
            Panic("key not found in Map")
        }
        let e: I64 = this.idx[s]
        this.vals[e]
    }

    mut fn Set(k: K, v: V) {
        let s: I64 = this.slotOf(k)
        if (s >= 0) {
            let e: I64 = this.idx[s]
            this.vals[e] = v
            return
        }
        this.version += 1
        if ((this.keys.Len() + 1) * 2 > this.idx.Len()) {
            this.rebuild((this.count + 1) * 2)
        }
        let e: I64 = this.keys.Len()
        this.keys.Push(k)
        this.vals.Push(v)
        this.alive.Push(true)
        this.place(k, e)
        this.count += 1
    }

    mut fn SetIndex(k: K, v: V) {
        this.Set(k, v)
    }

    mut fn Remove(k: K) -> Option<V> {
        let s: I64 = this.slotOf(k)
        if (s < 0) {
            return None
        }
        let e: I64 = this.idx[s]
        this.idx[s] = -2
        this.alive[e] = false
        this.count -= 1
        this.version += 1
        Some(this.vals[e])
    }

    mut fn Clear() {
        this.keys = []
        this.vals = []
        this.alive = []
        this.idx = []
        this.count = 0
        this.version += 1
    }

    fn Keys() -> Array<K> {
        mut out: Array<K> = []
        mut i: I64 = 0
        while (i < this.keys.Len()) {
            if (this.alive[i]) {
                out.Push(this.keys[i])
            }
            i += 1
        }
        out
    }

    fn Values() -> Array<V> {
        mut out: Array<V> = []
        mut i: I64 = 0
        while (i < this.vals.Len()) {
            if (this.alive[i]) {
                out.Push(this.vals[i])
            }
            i += 1
        }
        out
    }

    fn Iter() -> Iterator<(K, V)> { MapIter<K, V>.New(this) }
}

class MapIter<K: Hashable, V> : Iterator<(K, V)> {
    m: Map<K, V>
    i: I64 = 0
    ver: I64 = 0

    fn Init(m: Map<K, V>) {
        this.m = m
        this.ver = m.version
    }

    mut fn Next() -> Option<(K, V)> {
        if (this.m.version != this.ver) {
            Panic("the Map was changed while looping over it")
        }
        while (this.i < this.m.keys.Len()) {
            let e: I64 = this.i
            this.i += 1
            if (this.m.alive[e]) {
                let k: K = this.m.keys[e]
                let v: V = this.m.vals[e]
                return Some((k, v))
            }
        }
        None
    }
}

class Set<T: Hashable> : Iterable<T> {
    m: Map<T, Bool> = Map.New()

    fn Len() -> I64 { this.m.Len() }

    fn IsEmpty() -> Bool { this.m.IsEmpty() }

    fn Contains(x: T) -> Bool { this.m.Contains(x) }

    mut fn Add(x: T) -> Bool {
        if (this.m.Contains(x)) {
            return false
        }
        this.m.Set(x, true)
        true
    }

    mut fn Remove(x: T) -> Bool {
        match (this.m.Remove(x)) {
            Some(_) => true,
            None => false,
        }
    }

    mut fn Clear() { this.m.Clear() }

    fn Iter() -> Iterator<T> { SetIter<T>.New(this.m.Keys()) }
}

class SetIter<T: Hashable> : Iterator<T> {
    items: Array<T>
    i: I64 = 0

    fn Init(items: Array<T>) { this.items = items }

    mut fn Next() -> Option<T> {
        if (this.i >= this.items.Len()) {
            return None
        }
        let v: T = this.items[this.i]
        this.i += 1
        Some(v)
    }
}

// ---- Handle ----
// Lets C keep a number instead of a Zevic object. While a Handle is registered, the collector keeps the
// object alive. The number goes to C (`h.Id()`) and comes back as `Handle.Get<T>(id)`; `Release` unregisters it.
// A number that was released may be handed out again: do not use it after `Release`.

extern "zevic" {
    fn zevic_handle_new(p: *CVoid) -> CULong
    fn zevic_handle_get(id: CULong) -> *CVoid
    fn zevic_handle_release(id: CULong)
}

class Handle<T> {
    id: CULong = 0

    fn Init(x: T) {
        this.id = zevic_handle_new(Intrinsics.ObjPtr(x))
    }

    fn Id() -> CULong { this.id }

    fn Release() {
        zevic_handle_release(this.id)
    }

    // The object behind a number that came back from C; None if the number is not registered.
    static fn Get(id: CULong) -> Option<T> {
        let p: *CVoid = zevic_handle_get(id)
        if (p == Null) { None } else { Some(Intrinsics.PtrObj<T>(p)) }
    }
}
