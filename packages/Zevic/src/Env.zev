module Zevic.Env

// The process environment: variables, the command line and the exit code.

extern "zevic" {
    fn zevic_env_has(name: String) -> I32
    fn zevic_env_get(name: String) -> String
    fn zevic_env_set(name: String, value: String) -> I32
    fn zevic_argc() -> I32
    fn zevic_arg(i: I32) -> String
    fn zevic_exit(code: I32) -> Never
    fn zevic_exe_path() -> String
    fn zevic_cwd() -> String
    fn zevic_os_name() -> String
}

// The operating system the program was built for: "linux", "macos", "windows" (or "unix" for any other).
fn OS() -> String { zevic_os_name() }

fn IsWindows() -> Bool { zevic_os_name() == "windows" }

// The value of an environment variable; None if it is not set.
fn Get(name: String) -> Option<String> {
    if (zevic_env_has(name) == 0) {
        None
    } else {
        Some(zevic_env_get(name))
    }
}

fn Set(name: String, value: String) -> Result<Unit, Error> {
    if (zevic_env_set(name, value) == 0) {
        Err(Error.New(ErrorKind.Invalid, "cannot set the environment variable \"${name}\""))
    } else {
        Ok(())
    }
}

// The name the program was started with.
fn ProgramName() -> String { zevic_arg(0) }

// The full path of the running program; empty if the system does not tell.
fn ExePath() -> String { zevic_exe_path() }

// The current directory.
fn CurrentDir() -> String { zevic_cwd() }

// The command line arguments, without the program name.
fn RawArgs() -> Array<String> {
    mut out: Array<String> = []
    let n: I32 = zevic_argc()
    mut i: I32 = 1
    while (i < n) {
        out.Push(zevic_arg(i))
        i += 1
    }
    out
}

// Ends the program with this exit code. Deferred calls do not run.
fn Exit(code: I32) -> Never { zevic_exit(code) }
