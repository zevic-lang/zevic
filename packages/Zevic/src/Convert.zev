module Zevic.Convert

// GENERATED by tools/gen_convert.py - do not edit by hand.
// Conversions that can fail. The compiler calls them for `x.ToI32()` (integers) and `s.ToI32()` (strings).

fn I8ToU8(x: I8) -> Result<U8, Error> {
    let v: I64 = x.ToI64()
    if (v < 0 || v > 255) {
        return Err(Error.New(ErrorKind.OutOfRange, "${x} does not fit in U8"))
    }
    Ok(x.ToU8Wrap())
}

fn I8ToU16(x: I8) -> Result<U16, Error> {
    let v: I64 = x.ToI64()
    if (v < 0 || v > 65535) {
        return Err(Error.New(ErrorKind.OutOfRange, "${x} does not fit in U16"))
    }
    Ok(x.ToU16Wrap())
}

