module Zevic.Encoding

import Zevic.Bytes

// Text forms of bytes: hexadecimal, Base64 (RFC 4648) and percent-encoding for URLs and forms.
// The Decode functions return an error for text that is not valid; they never panic.

let hexLower: String = "0123456789abcdef"
let hexUpper: String = "0123456789ABCDEF"
let b64Std: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let b64Url: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn invalid(what: String) -> Error { Error.New(ErrorKind.Invalid, what) }

fn hexWith(b: Array<U8>, digits: String) -> String {
    mut sb: StringBuilder = StringBuilder.New()
    for (x in b) {
        let hi: I64 = (x >> 4).ToI64()
        let lo: I64 = (x & 15).ToI64()
        sb.Append(digits.Slice(hi, hi + 1))
        sb.Append(digits.Slice(lo, lo + 1))
    }
    sb.ToString()
}

// Two lower case hex digits per byte: [1, 255] gives "01ff".
fn HexEncode(b: Array<U8>) -> String { hexWith(b, hexLower) }

fn HexEncodeUpper(b: Array<U8>) -> String { hexWith(b, hexUpper) }

// The hex digits of the UTF-8 bytes of a text.
fn HexEncodeString(s: String) -> String { hexWith(Bytes.FromString(s), hexLower) }

// The value of a hex digit, or -1.
fn hexVal(c: U8) -> I32 {
    if (c >= b'0' && c <= b'9') { return (c - b'0').ToI32() }
    if (c >= b'a' && c <= b'f') { return (c - b'a').ToI32() + 10 }
    if (c >= b'A' && c <= b'F') { return (c - b'A').ToI32() + 10 }
    -1
}

// The bytes of hex digits (upper or lower case). An odd number of digits or another character is an error.
fn HexDecode(s: String) -> Result<Array<U8>, Error> {
    let n: I64 = s.Len()
    if (n % 2 != 0) {
        return Err(invalid("hex text must have an even number of digits (got ${n})"))
    }
    mut out: Array<U8> = []
    mut i: I64 = 0
    while (i < n) {
        let hi: I32 = hexVal(s.ByteAt(i))
        let lo: I32 = hexVal(s.ByteAt(i + 1))
        if (hi < 0 || lo < 0) {
            return Err(invalid("invalid hex digit at position ${if (hi < 0) { i } else { i + 1 }}"))
        }
        out.Push((hi * 16 + lo).ToU8Wrap())
        i += 2
    }
    Ok(out)
}

fn b64Encode(b: Array<U8>, table: String, pad: Bool) -> String {
    mut sb: StringBuilder = StringBuilder.New()
    let n: I64 = b.Len()
    mut i: I64 = 0
    while (i < n) {
        let b0: U32 = b[i].ToU32()
        let b1: U32 = if (i + 1 < n) { b[i + 1].ToU32() } else { 0 }
        let b2: U32 = if (i + 2 < n) { b[i + 2].ToU32() } else { 0 }
        let v: U32 = (b0 << 16) | (b1 << 8) | b2
        let c0: I64 = ((v >> 18) & 63).ToI64()
        let c1: I64 = ((v >> 12) & 63).ToI64()
        let c2: I64 = ((v >> 6) & 63).ToI64()
        let c3: I64 = (v & 63).ToI64()
        sb.Append(table.Slice(c0, c0 + 1))
        sb.Append(table.Slice(c1, c1 + 1))
        if (i + 1 < n) {
            sb.Append(table.Slice(c2, c2 + 1))
        } else if (pad) {
            sb.Append("=")
        }
        if (i + 2 < n) {
            sb.Append(table.Slice(c3, c3 + 1))
        } else if (pad) {
            sb.Append("=")
        }
        i += 3
    }
    sb.ToString()
}

// Base64 with the standard alphabet (`+` and `/`) and `=` padding: "Man" gives "TWFu".
fn Base64Encode(b: Array<U8>) -> String { b64Encode(b, b64Std, true) }

// Base64 for URLs and file names: `-` and `_` instead of `+` and `/`, no padding.
fn Base64UrlEncode(b: Array<U8>) -> String { b64Encode(b, b64Url, false) }

fn Base64EncodeString(s: String) -> String { b64Encode(Bytes.FromString(s), b64Std, true) }

fn b64Val(c: U8, url: Bool) -> I32 {
    if (c >= b'A' && c <= b'Z') { return (c - b'A').ToI32() }
    if (c >= b'a' && c <= b'z') { return (c - b'a').ToI32() + 26 }
    if (c >= b'0' && c <= b'9') { return (c - b'0').ToI32() + 52 }
    if (!url && c == b'+') { return 62 }
    if (!url && c == b'/') { return 63 }
    if (url && c == b'-') { return 62 }
    if (url && c == b'_') { return 63 }
    -1
}

fn b64Decode(s: String, url: Bool) -> Result<Array<U8>, Error> {
    mut n: I64 = s.Len()
    mut padding: I64 = 0
    while (n > 0 && s.ByteAt(n - 1) == b'=') {
        n -= 1
        padding += 1
    }
    if (padding > 2 || (padding > 0 && (n + padding) % 4 != 0)) {
        return Err(invalid("Base64: wrong padding"))
    }
    if (n % 4 == 1) {
        return Err(invalid("Base64: the length is not valid"))
    }
    mut out: Array<U8> = []
    mut acc: U32 = 0
    mut bits: I32 = 0
    mut i: I64 = 0
    while (i < n) {
        let v: I32 = b64Val(s.ByteAt(i), url)
        if (v < 0) {
            return Err(invalid("Base64: invalid character at position ${i}"))
        }
        acc = (acc << 6) | v.ToU32Wrap()
        bits += 6
        if (bits >= 8) {
            bits -= 8
            out.Push(((acc >> bits) & 255).ToU8Wrap())
        }
        i += 1
    }
    Ok(out)
}

// The bytes of standard Base64 text. The `=` padding may be left out.
fn Base64Decode(s: String) -> Result<Array<U8>, Error> { b64Decode(s, false) }

// The bytes of URL-safe Base64 text (`-` and `_`).
fn Base64UrlDecode(s: String) -> Result<Array<U8>, Error> { b64Decode(s, true) }

// Base64 text of a text that was encoded from a String: the String back.
fn Base64DecodeString(s: String) -> Result<String, Error> {
    let b: Array<U8> = Base64Decode(s)?
    Bytes.ToString(b)
}

fn isUnreserved(c: U8) -> Bool {
    (c >= b'A' && c <= b'Z') || (c >= b'a' && c <= b'z') || (c >= b'0' && c <= b'9') || c == b'-' || c == b'.' || c == b'_' || c == b'~'
}

fn percentEncode(s: String, plusForSpace: Bool) -> String {
    mut sb: StringBuilder = StringBuilder.New()
    let b: Array<U8> = Bytes.FromString(s)
    mut i: I64 = 0
    while (i < b.Len()) {
        let c: U8 = b[i]
        if (isUnreserved(c)) {
            sb.AppendChar(c.ToU32().ToCharUnchecked())
        } else if (plusForSpace && c == b' ') {
            sb.Append("+")
        } else {
            sb.Append("%")
            sb.Append(hexUpper.Slice((c >> 4).ToI64(), (c >> 4).ToI64() + 1))
            sb.Append(hexUpper.Slice((c & 15).ToI64(), (c & 15).ToI64() + 1))
        }
        i += 1
    }
    sb.ToString()
}

// Percent-encoding: letters, digits and `-` `.` `_` `~` stay; every other byte of the UTF-8 text becomes `%XX`.
// A space is "%20".
fn UrlEncode(s: String) -> String { percentEncode(s, false) }

// Like UrlEncode, but a space is "+" (the form of a query string and of HTML forms).
fn FormEncode(s: String) -> String { percentEncode(s, true) }

fn percentDecode(s: String, plusForSpace: Bool) -> Result<String, Error> {
    let n: I64 = s.Len()
    mut out: Array<U8> = []
    mut i: I64 = 0
    while (i < n) {
        let c: U8 = s.ByteAt(i)
        if (c == b'%') {
            if (i + 2 >= n) {
                return Err(invalid("percent-encoding: \"%\" at position ${i} needs two hex digits"))
            }
            let hi: I32 = hexVal(s.ByteAt(i + 1))
            let lo: I32 = hexVal(s.ByteAt(i + 2))
            if (hi < 0 || lo < 0) {
                return Err(invalid("percent-encoding: \"%\" at position ${i} needs two hex digits"))
            }
            out.Push((hi * 16 + lo).ToU8Wrap())
            i += 3
        } else if (plusForSpace && c == b'+') {
            out.Push(b' ')
            i += 1
        } else {
            out.Push(c)
            i += 1
        }
    }
    match (Bytes.ToString(out)) {
        Ok(t) => Ok(t),
        Err(_) => Err(invalid("percent-encoding: the result is not valid UTF-8")),
    }
}

// The text of percent-encoded text ("%41" is "A"). "+" stays "+".
fn UrlDecode(s: String) -> Result<String, Error> { percentDecode(s, false) }

// Like UrlDecode, but "+" is a space.
fn FormDecode(s: String) -> Result<String, Error> { percentDecode(s, true) }
