module Zevic.DateTime

import Zevic.Text
import Zevic.Time

// Dates and times on the proleptic Gregorian calendar (no leap seconds), with a time zone given as a fixed offset
// from UTC. A `DateTime` is one moment (Unix seconds and nanoseconds) plus the offset it is shown in.
//
//     let t: DateTime.DateTime = DateTime.Make(2026, 11, 8, 18, 3, 0).Unwrap()    // 2026-11-08 18:03:00 UTC
//     let jst: DateTime.DateTime = t.InOffset(9 * 3600)                           // the same moment in +09:00
//     Console.Println(jst.ToIso())                                                // 2026-11-09T03:03:00+09:00
//
// `a == b` is true only when the moment and the offset are both the same; `SameInstant` ignores the offset.
// `Compare`, `Before` and `After` order moments. Names of days and months are English.

extern "zevic" {
    fn zevic_time_unix_ns() -> I64
    fn zevic_local_offset(unix_seconds: I64) -> I32
}

let monthNames: Array<String> = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
let dayNames: Array<String> = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

fn invalid(what: String) -> Error { Error.New(ErrorKind.Invalid, what) }

// Division and remainder that round toward negative infinity (so that times before 1970 work).
fn floorDiv(a: I64, b: I64) -> I64 {
    let q: I64 = a / b
    if ((a % b != 0) && ((a < 0) != (b < 0))) { q - 1 } else { q }
}

fn floorMod(a: I64, b: I64) -> I64 { a - floorDiv(a, b) * b }

fn IsLeapYear(year: I32) -> Bool {
    (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
}

// The number of days in the month (month 1 to 12).
fn DaysInMonth(year: I32, month: I32) -> I32 {
    if (month == 2) { return if (IsLeapYear(year)) { 29 } else { 28 } }
    if (month == 4 || month == 6 || month == 9 || month == 11) { return 30 }
    31
}

// Days since 1970-01-01 of a calendar date.
fn daysFromCivil(year: I64, month: I64, day: I64) -> I64 {
    let y: I64 = if (month <= 2) { year - 1 } else { year }
    let era: I64 = floorDiv(y, 400)
    let yoe: I64 = y - era * 400
    let mp: I64 = if (month > 2) { month - 3 } else { month + 9 }
    let doy: I64 = (153 * mp + 2) / 5 + day - 1
    let doe: I64 = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

// The calendar date (year, month, day) of a number of days since 1970-01-01.
fn civilFromDays(days: I64) -> (I64, I64, I64) {
    let z: I64 = days + 719468
    let era: I64 = floorDiv(z, 146097)
    let doe: I64 = z - era * 146097
    let yoe: I64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy: I64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp: I64 = (5 * doy + 2) / 153
    let d: I64 = doy - (153 * mp + 2) / 5 + 1
    let m: I64 = if (mp < 10) { mp + 3 } else { mp - 9 }
    let y: I64 = yoe + era * 400
    (if (m <= 2) { y + 1 } else { y }, m, d)
}

fn pad(n: I64, width: I64) -> String {
    let s: String = "${if (n < 0) { -n } else { n }}"
    let sign: String = if (n < 0) { "-" } else { "" }
    sign + Text.PadLeft(s, width, '0')
}

fn offsetText(offset: I32, colon: Bool) -> String {
    let sign: String = if (offset < 0) { "-" } else { "+" }
    let a: I64 = if (offset < 0) { -offset.ToI64() } else { offset.ToI64() }
    let h: I64 = a / 3600
    let m: I64 = (a % 3600) / 60
    sign + pad(h, 2) + (if (colon) { ":" } else { "" }) + pad(m, 2)
}

struct DateTime : Comparable {
    secs: I64
    nano: I32
    offset: I32

    // The moment `secs` seconds and `nano` nanoseconds (0 to 999999999) after 1970-01-01 00:00:00 UTC, shown in the
    // zone `offset` seconds east of UTC. Prefer `DateTime.Make`, `FromUnixSeconds` and the other constructors.
    fn Init(secs: I64, nano: I32, offset: I32) {
        this.secs = secs
        this.nano = nano
        this.offset = offset
    }

    // The seconds of the local clock since 1970 (as if the local time were UTC).
    fn localSecs() -> I64 { this.secs + this.offset.ToI64() }

    fn date() -> (I64, I64, I64) { civilFromDays(floorDiv(this.localSecs(), 86400)) }

    fn Year() -> I32 {
        let (y, _, _): (I64, I64, I64) = this.date()
        y.ToI32Wrap()
    }

    // 1 to 12.
    fn Month() -> I32 {
        let (_, m, _): (I64, I64, I64) = this.date()
        m.ToI32Wrap()
    }

    // 1 to 31.
    fn Day() -> I32 {
        let (_, _, d): (I64, I64, I64) = this.date()
        d.ToI32Wrap()
    }

    fn Hour() -> I32 { (floorMod(this.localSecs(), 86400) / 3600).ToI32Wrap() }

    fn Minute() -> I32 { (floorMod(this.localSecs(), 3600) / 60).ToI32Wrap() }

    fn Second() -> I32 { floorMod(this.localSecs(), 60).ToI32Wrap() }

    // The part of the second, in nanoseconds (0 to 999999999).
    fn Nano() -> I32 { this.nano }

    fn Millisecond() -> I32 { this.nano / 1000000 }

    // The zone: seconds east of UTC.
    fn Offset() -> I32 { this.offset }

    // The day of the week by ISO 8601: Monday is 1, Sunday is 7.
    fn Weekday() -> I32 {
        // 1970-01-01 was a Thursday (4)
        (floorMod(floorDiv(this.localSecs(), 86400) + 3, 7) + 1).ToI32Wrap()
    }

    fn WeekdayName() -> String { dayNames[(this.Weekday() - 1).ToI64()] }

    fn MonthName() -> String { monthNames[(this.Month() - 1).ToI64()] }

    // The day of the year: 1 for January 1st.
    fn DayOfYear() -> I32 {
        let (y, _, _): (I64, I64, I64) = this.date()
        (floorDiv(this.localSecs(), 86400) - daysFromCivil(y, 1, 1) + 1).ToI32Wrap()
    }

    fn ToUnixSeconds() -> I64 { this.secs }

    fn ToUnixMillis() -> I64 { this.secs * 1000 + (this.nano / 1000000).ToI64() }

    // Nanoseconds since 1970 (only for years 1678 to 2262; other moments overflow).
    fn ToUnixNanos() -> I64 { this.secs * 1000000000 + this.nano.ToI64() }

    // The same moment shown in another zone.
    fn InOffset(offset: I32) -> DateTime { DateTime.New(this.secs, this.nano, offset) }

    fn ToUtc() -> DateTime { DateTime.New(this.secs, this.nano, 0) }

    // The same moment in the time zone of the computer.
    fn ToLocal() -> DateTime { DateTime.New(this.secs, this.nano, zevic_local_offset(this.secs)) }

    // The same local clock reading with another nanosecond part.
    fn WithNano(nano: I32) -> DateTime {
        if (nano < 0 || nano > 999999999) {
            Panic("DateTime.WithNano: ${nano} is out of range")
        }
        DateTime.New(this.secs, nano, this.offset)
    }

    fn AddSeconds(n: I64) -> DateTime { DateTime.New(this.secs + n, this.nano, this.offset) }

    fn AddMinutes(n: I64) -> DateTime { this.AddSeconds(n * 60) }

    fn AddHours(n: I64) -> DateTime { this.AddSeconds(n * 3600) }

    // Whole days of 24 hours (the zone is fixed, so there is no daylight saving to worry about).
    fn AddDays(n: I64) -> DateTime { this.AddSeconds(n * 86400) }

    fn AddMillis(n: I64) -> DateTime { this.AddNanos(n * 1000000) }

    fn AddNanos(n: I64) -> DateTime {
        let total: I64 = this.nano.ToI64() + n
        let carry: I64 = floorDiv(total, 1000000000)
        DateTime.New(this.secs + carry, floorMod(total, 1000000000).ToI32Wrap(), this.offset)
    }

    fn AddDuration(d: Time.Duration) -> DateTime { this.AddNanos(d.Nanos()) }

    // `n` months later (earlier if negative), on the same day of the month; if that month is shorter, its last day.
    fn AddMonths(n: I64) -> DateTime {
        let (y, m, d): (I64, I64, I64) = this.date()
        let total: I64 = y * 12 + (m - 1) + n
        let ny: I64 = floorDiv(total, 12)
        let nm: I64 = floorMod(total, 12) + 1
        let dim: I64 = DaysInMonth(ny.ToI32Wrap(), nm.ToI32Wrap()).ToI64()
        let nd: I64 = if (d > dim) { dim } else { d }
        let tod: I64 = floorMod(this.localSecs(), 86400)
        let local: I64 = daysFromCivil(ny, nm, nd) * 86400 + tod
        DateTime.New(local - this.offset.ToI64(), this.nano, this.offset)
    }

    fn AddYears(n: I64) -> DateTime { this.AddMonths(n * 12) }

    // The time from `earlier` to this moment (negative if `earlier` is later). Only about 292 years fit in a `Duration`.
    fn Sub(earlier: DateTime) -> Time.Duration {
        Time.Duration.New((this.secs - earlier.secs) * 1000000000 + (this.nano - earlier.nano).ToI64())
    }

    // Midnight of the same local day.
    fn StartOfDay() -> DateTime {
        DateTime.New(this.secs - floorMod(this.localSecs(), 86400), 0, this.offset)
    }

    // The same moment and the same zone: `a == b` calls this.
    fn Equals(other: DateTime) -> Bool {
        this.secs == other.secs && this.nano == other.nano && this.offset == other.offset
    }

    // Does this DateTime show the same moment as `other` (in whatever zone)?
    fn SameInstant(other: DateTime) -> Bool { this.secs == other.secs && this.nano == other.nano }

    fn Before(other: DateTime) -> Bool { this.Compare(other) < 0 }

    fn After(other: DateTime) -> Bool { this.Compare(other) > 0 }

    // Negative, zero or positive by which moment is earlier.
    fn Compare(other: DateTime) -> I32 {
        if (this.secs != other.secs) { return if (this.secs < other.secs) { -1 } else { 1 } }
        if (this.nano != other.nano) { return if (this.nano < other.nano) { -1 } else { 1 } }
        0
    }

    // ISO 8601 / RFC 3339: "2026-11-08T18:03:00Z", "2026-11-09T03:03:00.250+09:00". The fraction is written only
    // when it is not zero (3, 6 or 9 digits).
    fn ToIso() -> String {
        let (y, m, d): (I64, I64, I64) = this.date()
        mut out: String = pad(y, 4) + "-" + pad(m, 2) + "-" + pad(d, 2) + "T" + pad(this.Hour().ToI64(), 2) + ":" + pad(this.Minute().ToI64(), 2) + ":" + pad(this.Second().ToI64(), 2)
        if (this.nano != 0) {
            if (this.nano % 1000000 == 0) {
                out = out + "." + pad((this.nano / 1000000).ToI64(), 3)
            } else if (this.nano % 1000 == 0) {
                out = out + "." + pad((this.nano / 1000).ToI64(), 6)
            } else {
                out = out + "." + pad(this.nano.ToI64(), 9)
            }
        }
        out + (if (this.offset == 0) { "Z" } else { offsetText(this.offset, true) })
    }

    fn ToString() -> String { this.ToIso() }

    // Text by a pattern. The letters after `%`:
    //   %Y year (4 digits)  %y year (2 digits)  %m month 01-12  %d day 01-31  %e day, space-padded
    //   %H hour 00-23  %I hour 01-12  %M minute  %S second  %L milliseconds  %f microseconds  %N nanoseconds
    //   %p AM or PM  %a Mon  %A Monday  %b Jan  %B January  %j day of the year  %u weekday 1-7 (Monday is 1)
    //   %z +0900  %:z +09:00  %Z "UTC" or +09:00  %s Unix seconds  %F same as %Y-%m-%d  %T same as %H:%M:%S  %% a percent sign
    // Anything else after a `%` is written as it is.
    fn Format(pattern: String) -> String {
        mut sb: StringBuilder = StringBuilder.New()
        let n: I64 = pattern.Len()
        mut i: I64 = 0
        while (i < n) {
            let c: U8 = pattern.ByteAt(i)
            if (c != b'%' || i + 1 >= n) {
                // copy whole characters: find where this one ends
                mut j: I64 = i + 1
                while (j < n && (pattern.ByteAt(j) & 0xC0) == 0x80) { j += 1 }
                sb.Append(pattern.Slice(i, j))
                i = j
                continue
            }
            mut spec: U8 = pattern.ByteAt(i + 1)
            mut colon: Bool = false
            mut used: I64 = 2
            if (spec == b':' && i + 2 < n && pattern.ByteAt(i + 2) == b'z') {
                colon = true
                spec = b'z'
                used = 3
            }
            let (y, _, _): (I64, I64, I64) = this.date()
            if (spec == b'Y') { sb.Append(pad(y, 4)) }
            else if (spec == b'y') { sb.Append(pad(floorMod(y, 100), 2)) }
            else if (spec == b'm') { sb.Append(pad(this.Month().ToI64(), 2)) }
            else if (spec == b'd') { sb.Append(pad(this.Day().ToI64(), 2)) }
            else if (spec == b'e') { sb.Append(Text.PadLeft("${this.Day()}", 2, ' ')) }
            else if (spec == b'H') { sb.Append(pad(this.Hour().ToI64(), 2)) }
            else if (spec == b'I') {
                let h12: I32 = this.Hour() % 12
                let shown: I32 = if (h12 == 0) { 12 } else { h12 }
                sb.Append(pad(shown.ToI64(), 2))
            }
            else if (spec == b'M') { sb.Append(pad(this.Minute().ToI64(), 2)) }
            else if (spec == b'S') { sb.Append(pad(this.Second().ToI64(), 2)) }
            else if (spec == b'L') { sb.Append(pad((this.nano / 1000000).ToI64(), 3)) }
            else if (spec == b'f') { sb.Append(pad((this.nano / 1000).ToI64(), 6)) }
            else if (spec == b'N') { sb.Append(pad(this.nano.ToI64(), 9)) }
            else if (spec == b'p') { sb.Append(if (this.Hour() < 12) { "AM" } else { "PM" }) }
            else if (spec == b'a') { sb.Append(this.WeekdayName().Slice(0, 3)) }
            else if (spec == b'A') { sb.Append(this.WeekdayName()) }
            else if (spec == b'b') { sb.Append(this.MonthName().Slice(0, 3)) }
            else if (spec == b'B') { sb.Append(this.MonthName()) }
            else if (spec == b'j') { sb.Append(pad(this.DayOfYear().ToI64(), 3)) }
            else if (spec == b'u') { sb.Append("${this.Weekday()}") }
            else if (spec == b'z') { sb.Append(offsetText(this.offset, colon)) }
            else if (spec == b'Z') { sb.Append(if (this.offset == 0) { "UTC" } else { offsetText(this.offset, true) }) }
            else if (spec == b's') { sb.Append("${this.secs}") }
            else if (spec == b'F') { sb.Append(this.Format("%Y-%m-%d")) }
            else if (spec == b'T') { sb.Append(this.Format("%H:%M:%S")) }
            else if (spec == b'%') { sb.Append("%") }
            else { sb.Append(pattern.Slice(i, i + used)) }
            i += used
        }
        sb.ToString()
    }
}

// The moment and the zone from the parts of a local clock reading, checked: month 1-12, a day that exists,
// hour 0-23, minute 0-59, second 0-59, and a zone of at most a day.
fn MakeIn(year: I32, month: I32, day: I32, hour: I32, minute: I32, second: I32, offset: I32) -> Result<DateTime, Error> {
    if (month < 1 || month > 12) {
        return Err(invalid("month ${month} is not in 1 to 12"))
    }
    if (day < 1 || day > DaysInMonth(year, month)) {
        return Err(invalid("day ${day} does not exist in ${year}-${pad(month.ToI64(), 2)}"))
    }
    if (hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59) {
        return Err(invalid("the time ${hour}:${minute}:${second} is not valid"))
    }
    if (offset <= -86400 || offset >= 86400) {
        return Err(invalid("the zone offset ${offset} seconds is not valid"))
    }
    let local: I64 = daysFromCivil(year.ToI64(), month.ToI64(), day.ToI64()) * 86400 + (hour * 3600 + minute * 60 + second).ToI64()
    Ok(DateTime.New(local - offset.ToI64(), 0, offset))
}

// A moment in UTC from date and time parts.
fn Make(year: I32, month: I32, day: I32, hour: I32, minute: I32, second: I32) -> Result<DateTime, Error> {
    MakeIn(year, month, day, hour, minute, second, 0)
}

// Midnight UTC of a date.
fn Date(year: I32, month: I32, day: I32) -> Result<DateTime, Error> {
    MakeIn(year, month, day, 0, 0, 0, 0)
}

fn FromUnixSeconds(secs: I64) -> DateTime { DateTime.New(secs, 0, 0) }

fn FromUnixMillis(ms: I64) -> DateTime {
    DateTime.New(floorDiv(ms, 1000), (floorMod(ms, 1000) * 1000000).ToI32Wrap(), 0)
}

fn FromUnixNanos(ns: I64) -> DateTime {
    DateTime.New(floorDiv(ns, 1000000000), floorMod(ns, 1000000000).ToI32Wrap(), 0)
}

// The wall clock now, in UTC.
fn NowUtc() -> DateTime { FromUnixNanos(zevic_time_unix_ns()) }

// The wall clock now, in the time zone of the computer.
fn NowLocal() -> DateTime { NowUtc().ToLocal() }

// ---- reading text ----

// A reader over the bytes of a text: `pos` is the next byte.
class Reader {
    s: String
    pos: I64 = 0

    fn Init(s: String) { this.s = s }

    fn AtEnd() -> Bool { this.pos >= this.s.Len() }

    fn Peek() -> Option<U8> {
        if (this.pos >= this.s.Len()) { None } else { Some(this.s.ByteAt(this.pos)) }
    }

    // `n` digits as a number; None if they are not all digits.
    mut fn Digits(n: I64) -> Option<I64> {
        if (this.pos + n > this.s.Len()) { return None }
        mut v: I64 = 0
        mut i: I64 = 0
        while (i < n) {
            let c: U8 = this.s.ByteAt(this.pos + i)
            if (c < b'0' || c > b'9') { return None }
            v = v * 10 + (c - b'0').ToI64()
            i += 1
        }
        this.pos += n
        Some(v)
    }

    // As many digits as there are (at least one, at most `max`).
    mut fn DigitsUpTo(max: I64) -> Option<(I64, I64)> {
        mut v: I64 = 0
        mut n: I64 = 0
        while (n < max && this.pos + n < this.s.Len()) {
            let c: U8 = this.s.ByteAt(this.pos + n)
            if (c < b'0' || c > b'9') { break }
            v = v * 10 + (c - b'0').ToI64()
            n += 1
        }
        if (n == 0) { return None }
        this.pos += n
        Some((v, n))
    }

    // Skip the byte `c` if it is next.
    mut fn Eat(c: U8) -> Bool {
        match (this.Peek()) {
            Some(b) => {
                if (b == c) {
                    this.pos += 1
                    true
                } else {
                    false
                }
            },
            None => false,
        }
    }
}

fn nanosFromFraction(value: I64, digits: I64) -> I32 {
    mut v: I64 = value
    mut d: I64 = digits
    while (d < 9) {
        v = v * 10
        d += 1
    }
    while (d > 9) {
        v = v / 10
        d -= 1
    }
    v.ToI32Wrap()
}

// A zone written as Z, +HH:MM, +HHMM or +HH. None if it is not there or not valid.
fn readZone(mut r: Reader) -> Result<Option<I32>, Error> {
    if (r.Eat(b'Z') || r.Eat(b'z')) { return Ok(Some(0)) }
    let sign: I32 = if (r.Eat(b'+')) { 1 } else if (r.Eat(b'-')) { -1 } else { 0 }
    if (sign == 0) { return Ok(None) }
    let h: I64 = match (r.Digits(2)) {
        Some(v) => v,
        None => return Err(invalid("a zone needs two digits for the hours")),
    }
    mut m: I64 = 0
    let hadColon: Bool = r.Eat(b':')
    match (r.Digits(2)) {
        Some(v) => { m = v },
        None => {
            if (hadColon) { return Err(invalid("a zone needs two digits for the minutes")) }
        },
    }
    if (h > 23 || m > 59) { return Err(invalid("the zone is not valid")) }
    Ok(Some(sign * (h * 3600 + m * 60).ToI32Wrap()))
}

// Reads ISO 8601 / RFC 3339 text: `2026-11-08`, `2026-11-08T18:03`, `2026-11-08T18:03:00`, with a fraction
// (`.25`, up to 9 digits) and a zone (`Z`, `+09:00`, `-0500`). A space may stand for the `T`. Text without a zone is UTC.
fn Parse(text: String) -> Result<DateTime, Error> {
    mut r: Reader = Reader.New(text)
    let bad: Error = invalid("not a date and time in ISO 8601 form: \"${text}\"")
    let year: I64 = match (r.Digits(4)) {
        Some(v) => v,
        None => return Err(bad),
    }
    if (!r.Eat(b'-')) { return Err(bad) }
    let month: I64 = match (r.Digits(2)) {
        Some(v) => v,
        None => return Err(bad),
    }
    if (!r.Eat(b'-')) { return Err(bad) }
    let day: I64 = match (r.Digits(2)) {
        Some(v) => v,
        None => return Err(bad),
    }
    mut hour: I64 = 0
    mut minute: I64 = 0
    mut second: I64 = 0
    mut nano: I32 = 0
    mut zone: I32 = 0
    if (!r.AtEnd()) {
        if (!(r.Eat(b'T') || r.Eat(b't') || r.Eat(b' '))) { return Err(bad) }
        hour = match (r.Digits(2)) {
            Some(v) => v,
            None => return Err(bad),
        }
        if (!r.Eat(b':')) { return Err(bad) }
        minute = match (r.Digits(2)) {
            Some(v) => v,
            None => return Err(bad),
        }
        if (r.Eat(b':')) {
            second = match (r.Digits(2)) {
                Some(v) => v,
                None => return Err(bad),
            }
            if (r.Eat(b'.')) {
                match (r.DigitsUpTo(18)) {
                    Some((v, k)) => { nano = nanosFromFraction(v, k) },
                    None => return Err(bad),
                }
            }
        }
        match (readZone(r)?) {
            Some(z) => { zone = z },
            None => {},
        }
        if (!r.AtEnd()) { return Err(bad) }
    }
    let t: DateTime = MakeIn(year.ToI32Wrap(), month.ToI32Wrap(), day.ToI32Wrap(), hour.ToI32Wrap(), minute.ToI32Wrap(), second.ToI32Wrap(), zone)?
    Ok(t.WithNano(nano))
}

// Reads text written by a pattern. The letters after `%` that can be read: %Y (4 digits), %m, %d, %H, %M, %S
// (2 digits, or 1), %L (milliseconds), %f (microseconds), %N (nanoseconds) and %z (Z, +09:00 or +0900), and
// %% . Every other character must be the same in the text. Missing parts are 1970-01-01 00:00:00 UTC.
fn ParseFormat(text: String, pattern: String) -> Result<DateTime, Error> {
    mut r: Reader = Reader.New(text)
    let bad: Error = invalid("\"${text}\" does not match the pattern \"${pattern}\"")
    mut year: I64 = 1970
    mut month: I64 = 1
    mut day: I64 = 1
    mut hour: I64 = 0
    mut minute: I64 = 0
    mut second: I64 = 0
    mut nano: I32 = 0
    mut zone: I32 = 0
    let n: I64 = pattern.Len()
    mut i: I64 = 0
    while (i < n) {
        let c: U8 = pattern.ByteAt(i)
        if (c != b'%' || i + 1 >= n) {
            if (!r.Eat(c)) { return Err(bad) }
            i += 1
            continue
        }
        let spec: U8 = pattern.ByteAt(i + 1)
        i += 2
        if (spec == b'Y') {
            year = match (r.Digits(4)) { Some(v) => v, None => return Err(bad) }
        } else if (spec == b'm') {
            month = match (r.DigitsUpTo(2)) { Some((v, _)) => v, None => return Err(bad) }
        } else if (spec == b'd') {
            day = match (r.DigitsUpTo(2)) { Some((v, _)) => v, None => return Err(bad) }
        } else if (spec == b'H') {
            hour = match (r.DigitsUpTo(2)) { Some((v, _)) => v, None => return Err(bad) }
        } else if (spec == b'M') {
            minute = match (r.DigitsUpTo(2)) { Some((v, _)) => v, None => return Err(bad) }
        } else if (spec == b'S') {
            second = match (r.DigitsUpTo(2)) { Some((v, _)) => v, None => return Err(bad) }
        } else if (spec == b'L') {
            nano = match (r.Digits(3)) { Some(v) => (v * 1000000).ToI32Wrap(), None => return Err(bad) }
        } else if (spec == b'f') {
            nano = match (r.Digits(6)) { Some(v) => (v * 1000).ToI32Wrap(), None => return Err(bad) }
        } else if (spec == b'N') {
            nano = match (r.Digits(9)) { Some(v) => v.ToI32Wrap(), None => return Err(bad) }
        } else if (spec == b'z') {
            match (readZone(r)?) {
                Some(z) => { zone = z },
                None => return Err(bad),
            }
        } else if (spec == b'%') {
            if (!r.Eat(b'%')) { return Err(bad) }
        } else {
            return Err(invalid("the pattern \"${pattern}\" has an unknown letter after %"))
        }
    }
    if (!r.AtEnd()) { return Err(bad) }
    let t: DateTime = MakeIn(year.ToI32Wrap(), month.ToI32Wrap(), day.ToI32Wrap(), hour.ToI32Wrap(), minute.ToI32Wrap(), second.ToI32Wrap(), zone)?
    Ok(t.WithNano(nano))
}
