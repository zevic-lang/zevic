module Kernel

import Zevic.Unsafe

// The UART of QEMU's `virt` machine for RISC-V. A volatile write is a store the compiler must keep.
let UartBase: U64 = 0x10000000

fn putc(c: U8) {
    unsafe {
        Unsafe.At<U8>(UartBase).WriteVolatile(0, c)
    }
}

// The digits of n, most significant first. No String and no Array: there is no heap.
fn putNumber(n: U64) {
    mut div: U64 = 1
    while (n / div >= 10) {
        div *= 10
    }
    mut rest: U64 = n
    while (div > 0) {
        putc(48 + (rest / div).ToU8Wrap())
        rest = rest % div
        div /= 10
    }
}

// What a failed check does: there is nobody to tell, so say it and stop.
export "C" fn zevic_panic(msg: *U8, len: CLongLong, file: *U8, line: CInt) {
    unsafe {
        mut i: I64 = 0
        while (i < len.ToI64()) {
            putc(msg.Read(i))
            i += 1
        }
    }
    putc(10)
    while (true) {}
}

// Called from native/boot.S once the stack is set.
export "C" fn kmain() {
    putc(90) // Z
    putc(101) // e
    putc(118) // v
    putc(105) // i
    putc(99) // c
    putc(32)
    putNumber(2026)
    putc(10)
}
